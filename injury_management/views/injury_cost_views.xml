<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_injury_cost_list" model="ir.ui.view">
        <field name="name">injury.cost.list</field>
        <field name="model">injury.cost</field>
        <field name="arch" type="xml">
            <list string="Costs" default_order="cost_date desc">
                <field name="case_id"/>
                <field name="cost_date"/>
                <field name="cost_type"/>
                <field name="description"/>
                <field name="payee" optional="show"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="reimbursed" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_injury_cost_form" model="ir.ui.view">
        <field name="name">injury.cost.form</field>
        <field name="model">injury.cost</field>
        <field name="arch" type="xml">
            <form string="Cost Record">
                <sheet>
                    <group>
                        <group>
                            <field name="case_id" options="{'no_create': True}"/>
                            <field name="cost_date"/>
                            <field name="cost_type"/>
                            <field name="description"/>
                        </group>
                        <group>
                            <field name="payee"/>
                            <field name="invoice_reference"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="reimbursed"/>
                            <field name="reimbursement_date" invisible="not reimbursed"/>
                        </group>
                    </group>
                    <separator string="Notes"/>
                    <field name="notes" nolabel="0" widget="text"
                           placeholder="Additional notes about this cost…"/>
                    <separator string="Attachments"/>
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_injury_cost_all" model="ir.actions.act_window">
        <field name="name">Costs</field>
        <field name="res_model">injury.cost</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
