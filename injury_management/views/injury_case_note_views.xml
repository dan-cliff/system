<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_injury_case_note_list" model="ir.ui.view">
        <field name="name">injury.case.note.list</field>
        <field name="model">injury.case.note</field>
        <field name="arch" type="xml">
            <list string="Case Notes" default_order="note_date desc">
                <field name="case_id"/>
                <field name="note_date"/>
                <field name="note_type"/>
                <field name="author_id"/>
                <field name="content"/>
                <field name="is_confidential" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_injury_case_note_form" model="ir.ui.view">
        <field name="name">injury.case.note.form</field>
        <field name="model">injury.case.note</field>
        <field name="arch" type="xml">
            <form string="Case Note">
                <sheet>
                    <group>
                        <group>
                            <field name="case_id" options="{'no_create': True}"/>
                            <field name="note_date"/>
                            <field name="note_type"/>
                        </group>
                        <group>
                            <field name="author_id" options="{'no_create': True}"/>
                            <field name="is_confidential"/>
                        </group>
                    </group>
                    <separator string="Note Content"/>
                    <field name="content" nolabel="0" widget="text"
                           placeholder="Enter note content…"/>
                    <separator string="Attachments"/>
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_injury_case_note_all" model="ir.actions.act_window">
        <field name="name">Case Notes</field>
        <field name="res_model">injury.case.note</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
