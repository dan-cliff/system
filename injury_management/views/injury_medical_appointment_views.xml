<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_injury_medical_appointment_list" model="ir.ui.view">
        <field name="name">injury.medical.appointment.list</field>
        <field name="model">injury.medical.appointment</field>
        <field name="arch" type="xml">
            <list string="Medical Appointments" default_order="appointment_date desc">
                <field name="case_id"/>
                <field name="appointment_date"/>
                <field name="appointment_type"/>
                <field name="provider_name"/>
                <field name="clinic_location" optional="show"/>
                <field name="attended" optional="show"/>
                <field name="follow_up_required" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_injury_medical_appointment_form" model="ir.ui.view">
        <field name="name">injury.medical.appointment.form</field>
        <field name="model">injury.medical.appointment</field>
        <field name="arch" type="xml">
            <form string="Medical Appointment">
                <sheet>
                    <group>
                        <group>
                            <field name="case_id" options="{'no_create': True}"/>
                            <field name="appointment_date"/>
                            <field name="appointment_type"/>
                            <field name="attended"/>
                        </group>
                        <group>
                            <field name="provider_name"/>
                            <field name="clinic_location"/>
                            <field name="next_appointment_date"/>
                            <field name="follow_up_required"/>
                        </group>
                    </group>
                    <separator string="Purpose of Appointment"/>
                    <field name="appointment_purpose" nolabel="0" widget="text"
                           placeholder="Describe the purpose of this appointment…"/>
                    <separator string="Outcome / Findings"/>
                    <field name="outcome" nolabel="0" widget="text"
                           placeholder="Record the outcome, findings, and any recommendations from the appointment…"/>
                    <div invisible="not follow_up_required">
                        <separator string="Follow-up Notes"/>
                        <field name="follow_up_notes" nolabel="0" widget="text"
                               placeholder="Describe any required follow-up actions…"/>
                    </div>
                    <separator string="Attachments"/>
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_injury_medical_appointment_all" model="ir.actions.act_window">
        <field name="name">Medical Appointments</field>
        <field name="res_model">injury.medical.appointment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
