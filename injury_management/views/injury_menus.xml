<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level application menu -->
    <menuitem id="menu_injury_root"
              name="Injury Management"
              sequence="50"
              groups="injury_management.group_injury_user"
              web_icon="injury_management,static/description/icon.png"/>

    <!-- RTW Cases (top level) -->
    <menuitem id="menu_injury_rtw_cases"
              name="RTW Cases"
              parent="menu_injury_root"
              action="action_injury_rtw_case_all"
              sequence="10"
              groups="injury_management.group_injury_user"/>

    <!-- Registers parent -->
    <menuitem id="menu_injury_registers"
              name="Registers"
              parent="menu_injury_root"
              sequence="20"
              groups="injury_management.group_injury_user"/>

    <menuitem id="menu_injury_case_notes"
              name="Case Notes"
              parent="menu_injury_registers"
              action="action_injury_case_note_all"
