    <menuitem id="menu_injury_rtw_plans"
              name="RTW Plans"
              parent="menu_injury_registers"
              action="action_injury_rtw_plan_all"
              sequence="60"
              groups="injury_management.group_injury_user"/>

    <menuitem id="menu_injury_medical_certificates"
              name="Medical Certificates"
              parent="menu_injury_registers"
              action="action_injury_medical_certificate_all"
