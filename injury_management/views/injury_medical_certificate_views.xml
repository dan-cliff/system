<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_injury_medical_certificate_list" model="ir.ui.view">
        <field name="name">injury.medical.certificate.list</field>
        <field name="model">injury.medical.certificate</field>
        <field name="arch" type="xml">
            <list string="Medical Certificates" default_order="valid_from desc">
                <field name="case_id"/>
                <field name="certificate_type"/>
                <field name="issue_date"/>
                <field name="valid_from"/>
                <field name="valid_to" optional="show"/>
                <field name="doctor_name"/>
                <field name="clinic" optional="show"/>
                <field name="capacity_hours" optional="show"/>
                <field name="received_date" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_injury_medical_certificate_form" model="ir.ui.view">
        <field name="name">injury.medical.certificate.form</field>
        <field name="model">injury.medical.certificate</field>
        <field name="arch" type="xml">
            <form string="Medical Certificate">
                <sheet>
                    <group>
                        <group>
                            <field name="case_id" options="{'no_create': True}"/>
                            <field name="certificate_type"/>
                            <field name="issue_date"/>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                            <field name="received_date"/>
                        </group>
                        <group>
                            <field name="doctor_name"/>
                            <field name="clinic"/>
                            <field name="diagnosis"/>
                            <field name="capacity_hours"/>
                        </group>
                    </group>
                    <separator string="Restrictions / Conditions"/>
                    <field name="restrictions" nolabel="0" widget="text"
                           placeholder="List any restrictions or conditions specified on the certificate…"/>
                    <separator string="Notes"/>
                    <field name="notes" nolabel="0" widget="text"
                           placeholder="Additional notes about this medical certificate…"/>
                    <separator string="Attachments"/>
                    <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_injury_medical_certificate_all" model="ir.actions.act_window">
        <field name="name">Medical Certificates</field>
        <field name="res_model">injury.medical.certificate</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
