<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_injury_management" model="ir.module.category">
            <field name="name">Injury Management</field>
            <field name="sequence">25</field>
        </record>

        <record id="res_groups_privilege_injury" model="res.groups.privilege">
            <field name="name">Injury Management</field>
            <field name="sequence">25</field>
            <field name="category_id" ref="module_category_injury_management"/>
        </record>

        <record id="group_injury_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_injury"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_injury_case_manager" model="res.groups">
            <field name="name">Case Manager</field>
            <field name="privilege_id" ref="res_groups_privilege_injury"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_injury_user'))]"/>
        </record>

        <record id="group_injury_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="res_groups_privilege_injury"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_injury_case_manager'))]"/>
        </record>

        <!-- injury.case.document is a SQL view model (read-only).
             This rule grants all group members access to all document rows.
             If row-level rules are added to injury.rtw.case in the future,
             add a corresponding sub-select here to respect those restrictions. -->
        <record id="rule_injury_case_document_group_user" model="ir.rule">
            <field name="name">Injury Case Document: group access</field>
            <field name="model_id" ref="model_injury_case_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('injury_management.group_injury_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
