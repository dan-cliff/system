            (4, ref('group_injury_case_note_create')),
            (4, ref('group_injury_case_note_update')),
            (4, ref('group_injury_case_note_delete')),
            (4, ref('group_injury_medical_appointment_view')),
            (4, ref('group_injury_medical_appointment_create')),
            (4, ref('group_injury_medical_appointment_update')),
            (4, ref('group_injury_medical_appointment_delete')),
            (4, ref('group_injury_meeting_view')),
            (4, ref('group_injury_meeting_create')),
            (4, ref('group_injury_meeting_update')),
            (4, ref('group_injury_meeting_delete')),
            (4, ref('group_injury_file_note_view')),
