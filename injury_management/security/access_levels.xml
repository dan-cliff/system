            (4, ref('group_injury_rtw_plan_create')),
            (4, ref('group_injury_rtw_plan_update')),
            (4, ref('group_injury_rtw_plan_delete')),
            (4, ref('group_injury_medical_certificate_view')),
            (4, ref('group_injury_medical_certificate_create')),
            (4, ref('group_injury_medical_certificate_update')),
            (4, ref('group_injury_medical_certificate_delete')),
            (4, ref('group_injury_case_document_view')),
            (4, ref('group_injury_case_document_create')),
            (4, ref('group_injury_case_document_update')),
            (4, ref('group_injury_case_document_delete')),
        ]"/>
