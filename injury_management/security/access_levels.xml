        <field name="name">Case Documents</field>
        <field name="category_id" ref="module_category_injury_management"/>
        <field name="sequence">90</field>
    </record>
    <record id="group_injury_case_document_view" model="res.groups">
        <field name="name">View Only</field>
        <field name="privilege_id" ref="privilege_injury_case_document"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_injury_case_document_create" model="res.groups">
        <field name="name">Create</field>
        <field name="privilege_id" ref="privilege_injury_case_document"/>
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_injury_case_document_view'))]"/>
    </record>
    <record id="group_injury_case_document_own" model="res.groups">
        <field name="name">Create and Edit Own Only</field>
        <field name="privilege_id" ref="privilege_injury_case_document"/>
        <field name="sequence">30</field>
        <field name="implied_ids" eval="[(4, ref('group_injury_case_document_view'))]"/>
    </record>
    <record id="group_injury_case_document_update" model="res.groups">
        <field name="name">Update</field>
        <field name="privilege_id" ref="privilege_injury_case_document"/>
        <field name="sequence">40</field>
        <field name="implied_ids" eval="[(4, ref('group_injury_case_document_view'))]"/>
    </record>
    <record id="group_injury_case_document_delete" model="res.groups">
        <field name="name">Delete</field>
        <field name="privilege_id" ref="privilege_injury_case_document"/>
        <field name="sequence">50</field>
        <field name="implied_ids" eval="[(4, ref('group_injury_case_document_view'))]"/>
    </record>
    <record id="rule_injury_case_document_own_only" model="ir.rule">
        <field name="name">Case Documents: Create and Edit Own Only</field>
        <field name="model_id" ref="model_injury_case_document"/>
        <field name="groups" eval="[(4, ref('group_injury_case_document_own'))]"/>
        <field name="domain_force">['|', '|', ('case_id.create_uid', 'in', [user.id]), ('case_id.case_manager_id', 'in', [user.id]), ('case_id.employee_id.user_id', 'in', [user.id])]</field>
    </record>
    <record id="rule_injury_case_document_all_records" model="ir.rule">
        <field name="name">Case Documents: any record (Update or Delete)</field>
        <field name="model_id" ref="model_injury_case_document"/>
        <field name="groups" eval="[(4, ref('group_injury_case_document_update')), (4, ref('group_injury_case_document_delete'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- The database administrator gets full access on install and every upgrade. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[
            (4, ref('group_injury_rtw_case_view')),
            (4, ref('group_injury_rtw_case_create')),
            (4, ref('group_injury_rtw_case_update')),
