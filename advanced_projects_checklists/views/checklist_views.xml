<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Templates: the "Available in Projects" feature. -->
    <record id="checklist_template_view_form_project" model="ir.ui.view">
        <field name="name">checklist.template.form.project</field>
        <field name="model">checklist.template</field>
        <field name="inherit_id" ref="checklists.checklist_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='features']/group[@name='feature_public']" position="before">
                <group string="Projects" name="feature_projects">
                    <field name="project_available" widget="boolean_toggle"/>
                    <p class="text-muted" colspan="2" invisible="not project_available">
                        Project tasks can require this checklist. Completing it for a task marks the task
                        as done.
                    </p>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Checklists: the project and task they belong to. -->
    <record id="checklist_view_form_project" model="ir.ui.view">
        <field name="name">checklist.checklist.form.project</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='checklist']/field[@name='template_id']" position="after">
                <field name="advanced_project_id" invisible="not advanced_project_id"/>
                <field name="advanced_task_id" invisible="not advanced_task_id" readonly="state == 'done'"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="checklist_view_list_project" model="ir.ui.view">
        <field name="name">checklist.checklist.list.project</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_list"/>
        <field name="arch" type="xml">
            <field name="template_id" position="after">
                <field name="advanced_project_id" optional="show"/>
                <field name="advanced_task_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="checklist_view_search_project" model="ir.ui.view">
        <field name="name">checklist.checklist.search.project</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_search"/>
        <field name="arch" type="xml">
            <field name="template_id" position="after">
                <field name="advanced_project_id"/>
                <field name="advanced_task_id"/>
            </field>
            <filter name="group_template" position="after">
                <filter name="group_project" string="Project" context="{'group_by': 'advanced_project_id'}"/>
                <filter name="group_task" string="Project Task" context="{'group_by': 'advanced_task_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
