<odoo>
    <record id="view_partner_form_kennel" model="ir.ui.view">
        <field name="name">res.partner.form.boarding_kennel_manager</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_kennel_residents" type="object" class="oe_stat_button" icon="fa-paw"
                        groups="boarding_kennel_manager.group_kennel_keeper">
                    <field name="kennel_resident_count" widget="statinfo" string="Residents"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
