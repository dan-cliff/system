<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.boarding_kennel_manager</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="91"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Boarding Kennel Manager" id="boarding_kennel_manager" string="Boarding Kennel Manager"
                     name="boarding_kennel_manager" groups="boarding_kennel_manager.group_kennel_manager">
                    <block title="Daily To-Do List" id="kennel_daily_tasks">
                        <setting id="kennel_observation_times" string="Observation Rounds"
                                 help="Times of day (24-hour, separated by commas) when every checked-in animal gets an observation task. Feed and medication times come from each Frequency.">
                            <field name="kennel_observation_times" placeholder="e.g. 09:00, 16:00"/>
                        </setting>
                    </block>
                    <block title="Integrations" id="kennel_integrations">
                        <setting id="kennel_invoicing" string="Integrate Bookings with Invoicing"
                                 help="When enabled, bookings will have the ability to raise an invoice in the Accounting app and reflect the payment status in the booking.">
                            <field name="kennel_invoicing"/>
                            <div class="content-group" invisible="not kennel_invoicing">
                                <div class="row mt16">
                                    <label for="kennel_warehouse_ids" string="Warehouse/s" class="col-lg-4 o_light_label"/>
                                    <field name="kennel_warehouse_ids" widget="many2many_tags" class="col-lg-8"
                                           options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="kennel_product_categ_ids" string="Product Categories" class="col-lg-4 o_light_label"/>
                                    <field name="kennel_product_categ_ids" widget="many2many_tags" class="col-lg-8"
                                           options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="kennel_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'boarding_kennel_manager', 'bin_size': False}</field>
    </record>
</odoo>
