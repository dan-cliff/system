<odoo>
    <record id="kennel_yard_view_list" model="ir.ui.view">
        <field name="name">kennel.yard.list</field>
        <field name="model">kennel.yard</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="yard_type_id"/>
                <field name="species_ids" widget="many2many_tags"/>
                <field name="feature_ids" widget="many2many_tags" optional="show"/>
                <field name="capacity"/>
                <field name="occupant_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="kennel_yard_view_form" model="ir.ui.view">
        <field name="name">kennel.yard.form</field>
        <field name="model">kennel.yard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_control_plane" type="object" string="Control Plane"
                            class="btn-primary" icon="fa-desktop"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_stays" type="object" class="oe_stat_button" icon="fa-paw">
                            <field name="occupant_count" widget="statinfo" string="Checked In"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Run 1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="yard_type_id" options="{'no_create': True}"/>
                            <field name="species_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="capacity"/>
                            <field name="area"/>
                            <field name="feature_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="kennel_yard_view_search" model="ir.ui.view">
        <field name="name">kennel.yard.search</field>
        <field name="model">kennel.yard</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="yard_type_id"/>
                <field name="species_ids"/>
                <field name="feature_ids"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Type" name="group_type" context="{'group_by': 'yard_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kennel_yard_action" model="ir.actions.act_window">
        <field name="name">Yards</field>
        <field name="res_model">kennel.yard</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
