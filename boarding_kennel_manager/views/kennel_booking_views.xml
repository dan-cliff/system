<odoo>
    <record id="kennel_booking_view_list" model="ir.ui.view">
        <field name="name">kennel.booking.list</field>
        <field name="model">kennel.booking</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('checked_out', 'cancelled')" decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="resident_ids" widget="many2many_tags"/>
                <field name="arrival_datetime" options="{'numeric': True}"/>
                <field name="departure_datetime" options="{'numeric': True}"/>
                <field name="nights" optional="show"/>
                <field name="user_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-primary="state == 'confirmed'" decoration-success="state == 'checked_in'"
                       decoration-muted="state in ('checked_out', 'cancelled')"/>
            </list>
        </field>
    </record>

    <record id="kennel_booking_view_calendar" model="ir.ui.view">
        <field name="name">kennel.booking.calendar</field>
        <field name="model">kennel.booking</field>
        <field name="arch" type="xml">
            <calendar date_start="arrival_datetime" date_stop="departure_datetime" color="partner_id"
                      mode="month" event_open_popup="1" quick_create="0">
                <field name="partner_id" filters="1"/>
                <field name="resident_ids" widget="many2many_tags"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="kennel_booking_view_form" model="ir.ui.view">
        <field name="name">kennel.booking.form</field>
        <field name="model">kennel.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_check_in" type="object" string="Check In" class="btn-primary"
                            invisible="state != 'confirmed'"/>
                    <button name="action_check_out" type="object" string="Check Out" class="btn-primary"
                            invisible="state != 'checked_in'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancelled', 'confirmed')"/>
                    <button name="action_portal_invite" type="object" string="Invite Customer to Portal"
                            groups="boarding_kennel_manager.group_kennel_portal_user"/>
                    <button name="action_portal_preview" type="object" string="Customer Preview"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,checked_in,checked_out"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not vaccination_warning">
                    <field name="vaccination_warning"/>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-check-square-o">
                            <field name="task_todo_count" widget="statinfo" string="To Do"/>
                        </button>
                        <button name="action_view_medication_log" type="object" class="oe_stat_button" icon="fa-medkit"
                                invisible="not medication_count">
                            <field name="medication_count" widget="statinfo" string="Medications"/>
                        </button>
                        <button name="action_view_observations" type="object" class="oe_stat_button" icon="fa-eye">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="observation_count"/></span>
                                <span class="o_stat_text">Observations</span>
                                <span class="o_stat_text text-danger" invisible="not concern_count">
                                    <field name="concern_count"/> concern(s)
                                </span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state in ('checked_out', 'cancelled')"/>
                            <field name="resident_ids" widget="many2many_tags"
                                   context="{'default_partner_id': partner_id}"
                                   readonly="not partner_id or state in ('checked_out', 'cancelled')"
                                   placeholder="Pick the customer first"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="arrival_datetime" options="{'numeric': True}"/>
                            <field name="departure_datetime" options="{'numeric': True}"/>
                            <field name="nights"/>
                            <field name="checked_in_datetime" options="{'numeric': True}" invisible="not checked_in_datetime"/>
                            <field name="checked_out_datetime" options="{'numeric': True}" invisible="not checked_out_datetime"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Animals &amp; Feeding" name="animals">
                            <field name="line_ids" context="{'default_booking_id': id}">
                                <list create="0">
                                    <field name="partner_id" column_invisible="1"/>
                                    <field name="species_id" column_invisible="1"/>
                                    <field name="vaccination_expired" column_invisible="1"/>
                                    <field name="resident_id" readonly="1" force_save="1"/>
                                    <field name="yard_id" options="{'no_create': True}"/>
                                    <field name="diet_id" options="{'no_create': True}"/>
                                    <field name="food"/>
                                    <field name="quantity"/>
                                    <field name="frequency_id" options="{'no_create': True}"/>
                                    <field name="owner_supplied_food" optional="show"/>
                                    <field name="vaccination_expiry_date" options="{'numeric': True}" optional="show"
                                           decoration-danger="vaccination_expired"/>
                                    <field name="medical_notes" optional="show"/>
                                    <button name="action_custom_diet" type="object" title="Custom Diet"
                                            icon="fa-cutlery" class="btn-link"/>
                                </list>
                                <form>
                                    <group>
                                        <group>
                                            <field name="partner_id" invisible="1"/>
                                            <field name="species_id" invisible="1"/>
                                            <field name="resident_id" readonly="1" force_save="1"/>
                                            <field name="yard_id" options="{'no_create': True}"/>
                                            <field name="vaccination_expiry_date" options="{'numeric': True}"
                                                   decoration-danger="vaccination_expired"/>
                                            <field name="vaccination_expired" invisible="1"/>
                                        </group>
                                        <group string="Feeding">
                                            <field name="diet_id" options="{'no_create': True}"/>
                                            <field name="food"/>
                                            <field name="quantity"/>
                                            <field name="frequency_id" options="{'no_create': True}"/>
                                            <field name="owner_supplied_food"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="feeding_instructions"/>
                                        <field name="medical_notes"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Medical Care" name="medical">
                            <p class="text-muted">
                                Each animal's medical care requirements are on its line in Animals &amp; Feeding.
                            </p>
                            <group string="Medication to Administer">
                                <field name="medication_ids" nolabel="1" colspan="2" context="{'default_booking_id': id}">
                                    <list editable="bottom">
                                        <field name="resident_id" domain="[('id', 'in', parent.resident_ids)]"
                                               options="{'no_create': True}"/>
                                        <field name="name"/>
                                        <field name="dose"/>
                                        <field name="route_id" options="{'no_create': True}" optional="show"/>
                                        <field name="frequency_id" options="{'no_create': True}"/>
                                        <field name="times"/>
                                        <field name="start_date" options="{'numeric': True}" optional="hide"/>
                                        <field name="end_date" options="{'numeric': True}" optional="hide"/>
                                        <field name="instructions" optional="hide"/>
                                        <field name="last_given_datetime" options="{'numeric': True}" optional="show"/>
                                        <button name="action_record_dose" type="object" title="Record Dose"
                                                icon="fa-check" class="btn-link"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Medication Log">
                                <field name="administration_ids" nolabel="1" colspan="2" context="{'default_booking_id': id}">
                                    <list editable="top" decoration-danger="problem">
                                        <field name="administered_datetime" options="{'numeric': True}"/>
                                        <field name="medication_id" domain="[('booking_id', '=', parent.id)]"
                                               options="{'no_create': True}"/>
                                        <field name="dose_given"/>
                                        <field name="outcome_id" options="{'no_create': True}"/>
                                        <field name="problem" column_invisible="1"/>
                                        <field name="user_id"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Observations" name="observations">
                            <field name="observation_ids" context="{'default_booking_id': id}">
                                <list editable="top" decoration-danger="concern">
                                    <field name="observation_datetime" options="{'numeric': True}"/>
                                    <field name="resident_id" domain="[('id', 'in', parent.resident_ids)]"
                                           options="{'no_create': True}"/>
                                    <field name="type_id" options="{'no_create': True}"/>
                                    <field name="summary"/>
                                    <field name="details" optional="show"/>
                                    <field name="concern"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="kennel_booking_view_search" model="ir.ui.view">
        <field name="name">kennel.booking.search</field>
        <field name="model">kennel.booking</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="resident_ids"/>
                <filter string="Upcoming" name="filter_upcoming" domain="[('state', 'in', ('draft', 'confirmed'))]"/>
                <filter string="Checked In" name="filter_checked_in" domain="[('state', '=', 'checked_in')]"/>
                <filter string="Checked Out" name="filter_checked_out" domain="[('state', '=', 'checked_out')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Arrival" name="filter_arrival" date="arrival_datetime"/>
                <filter string="Departure" name="filter_departure" date="departure_datetime"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Arrival" name="group_arrival" context="{'group_by': 'arrival_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kennel_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">kennel.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Book animals in</p>
            <p>Pick the customer, their animals and the arrival and departure times.</p>
        </field>
    </record>

    <!-- Every animal's stay, e.g. who is in which yard. -->
    <record id="kennel_booking_line_view_list" model="ir.ui.view">
        <field name="name">kennel.booking.line.list</field>
        <field name="model">kennel.booking.line</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="vaccination_expired">
                <field name="booking_id"/>
                <field name="resident_id"/>
                <field name="partner_id"/>
                <field name="yard_id"/>
                <field name="arrival_datetime" options="{'numeric': True}"/>
                <field name="departure_datetime" options="{'numeric': True}"/>
                <field name="diet_id"/>
                <field name="food" optional="show"/>
                <field name="quantity" optional="show"/>
                <field name="frequency_id" optional="show"/>
                <field name="vaccination_expired" column_invisible="1"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="kennel_booking_line_view_search" model="ir.ui.view">
        <field name="name">kennel.booking.line.search</field>
        <field name="model">kennel.booking.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="resident_id"/>
                <field name="partner_id"/>
                <field name="yard_id"/>
                <field name="booking_id"/>
                <filter string="Current &amp; Upcoming" name="filter_current"
                        domain="[('state', 'in', ('draft', 'confirmed', 'checked_in'))]"/>
                <filter string="Checked In" name="filter_checked_in" domain="[('state', '=', 'checked_in')]"/>
                <group>
                    <filter string="Yard" name="group_yard" context="{'group_by': 'yard_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kennel_booking_line_action" model="ir.actions.act_window">
        <field name="name">In the Kennels</field>
        <field name="res_model">kennel.booking.line</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_checked_in': 1, 'search_default_group_yard': 1}</field>
    </record>
</odoo>
