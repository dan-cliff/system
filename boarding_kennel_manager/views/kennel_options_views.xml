<odoo>
    <!-- Editable lists for the configurable choice lists under Configuration. -->

    <record id="kennel_species_view_list" model="ir.ui.view">
        <field name="name">kennel.species.list</field>
        <field name="model">kennel.species</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="kennel_species_view_search" model="ir.ui.view">
        <field name="name">kennel.species.search</field>
        <field name="model">kennel.species</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="kennel_species_action" model="ir.actions.act_window">
        <field name="name">Species</field>
        <field name="res_model">kennel.species</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>

