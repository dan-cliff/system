<odoo>
    <record id="kennel_observation_view_list" model="ir.ui.view">
        <field name="name">kennel.observation.list</field>
        <field name="model">kennel.observation</field>
        <field name="arch" type="xml">
            <list decoration-danger="concern">
                <field name="observation_datetime" options="{'numeric': True}"/>
                <field name="booking_id"/>
                <field name="resident_id"/>
                <field name="type_id"/>
                <field name="summary"/>
                <field name="concern"/>
                <field name="user_id"/>
                <field name="activity_ids" widget="list_activity" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="kennel_observation_view_form" model="ir.ui.view">
        <field name="name">kennel.observation.form</field>
        <field name="model">kennel.observation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="summary" placeholder="e.g. Ate all breakfast"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="booking_id" readonly="context.get('default_booking_id')"/>
                            <field name="resident_id" options="{'no_create': True}"/>
                            <field name="type_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="observation_datetime" options="{'numeric': True}"/>
                            <field name="user_id"/>
                            <field name="concern"/>
                        </group>
                    </group>
                    <field name="details" placeholder="What you saw"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="kennel_observation_view_search" model="ir.ui.view">
        <field name="name">kennel.observation.search</field>
        <field name="model">kennel.observation</field>
        <field name="arch" type="xml">
            <search>
                <field name="summary"/>
                <field name="resident_id"/>
                <field name="booking_id"/>
                <field name="type_id"/>
                <field name="user_id"/>
                <filter string="Concerns" name="filter_concern" domain="[('concern', '=', True)]"/>
                <separator/>
                <filter string="Date" name="filter_date" date="observation_datetime"/>
                <group>
                    <filter string="Animal" name="group_resident" context="{'group_by': 'resident_id'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'type_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="kennel_observation_action" model="ir.actions.act_window">
        <field name="name">Observations</field>
        <field name="res_model">kennel.observation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
