<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Insert Text Block" above the eCommerce Description. -->
    <record id="product_template_form_text_block_ecommerce" model="ir.ui.view">
        <field name="name">product.template.form.text.block.ecommerce</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="website_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='ecom_description']/field[@name='description_ecommerce']" position="before">
                <widget name="text_block_insert" colspan="2" options="{'field': 'description_ecommerce'}"/>
            </xpath>
        </field>
    </record>
</odoo>
