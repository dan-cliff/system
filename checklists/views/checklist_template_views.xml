<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Question ─────────────────────────────────────────────────── -->
    <record id="checklist_question_view_form" model="ir.ui.view">
        <field name="name">checklist.question.form</field>
        <field name="model">checklist.question</field>
        <field name="arch" type="xml">
            <form string="Question">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="question_type"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe what should be checked..."
                           invisible="question_type in ('section_break', 'instructions')"/>
                    <!-- Section Title: a full-width box with the title and description. -->
                    <group string="Box" invisible="question_type != 'section_title'">
                        <field name="layout_text_color" widget="color"/>
                        <field name="layout_bg_color" widget="color"/>
                        <field name="layout_border_color" widget="color"/>
                    </group>
                    <!-- Section Break: a full-width line, with the title above, below or not shown. -->
                    <group string="Line" invisible="question_type != 'section_break'">
                        <field name="layout_line_color" widget="color"/>
                        <field name="layout_title_position" widget="radio"/>
                    </group>
                    <!-- Instructions: formatted text shown as is on the checklist. -->
                    <field name="instructions" widget="html" invisible="question_type != 'instructions'"
                           placeholder="Write the instructions..." class="o_checklist_instructions_editor"/>
                    <group invisible="question_type not in ('many2one', 'many2many')">
                        <field name="relation_model_id" options="{'no_create': True, 'no_open': True}"
                               required="question_type in ('many2one', 'many2many')"/>
                        <field name="relation_model" invisible="1"/>
                        <field name="relation_domain" widget="domain" invisible="not relation_model_id"
                               options="{'model': 'relation_model', 'in_dialog': True}"/>
                    </group>
                    <separator string="Options" invisible="question_type not in ('buttons', 'select', 'radio', 'slider', 'multi_select', 'multi_checkbox')"/>
                    <field name="option_ids" invisible="question_type not in ('buttons', 'select', 'radio', 'slider', 'multi_select', 'multi_checkbox')">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="color" widget="color"/>
                        </list>
                    </field>
                    <separator string="Conditional Display"/>
                    <group>
                        <field name="conditional" widget="boolean_toggle"/>
                        <field name="condition_logic" widget="radio" options="{'horizontal': True}"
                               invisible="not conditional"/>
                    </group>
                    <div invisible="not conditional">
                        <p class="text-muted mb-1">Shown when the answers, the current user and the checklist
                            meet the conditions below (only the ones set count). Answer conditions can look at
                            this template's other questions once they are saved.</p>
                        <label for="condition_ids" class="fw-bold"/>
                        <field name="condition_ids" context="{'default_question_id': id}">
                            <list editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="source_question_id" options="{'no_create': True, 'no_open': True}"
                                       domain="[('template_id', '=', parent.template_id), ('id', '!=', parent.id),
                                                ('question_type', 'not in', ('section_title', 'section_break', 'instructions'))]"/>
                                <field name="source_question_type" column_invisible="1"/>
                                <field name="operator"/>
                                <field name="value"
                                       invisible="operator in ('set', 'not_set') or source_question_type in
                                                  ('buttons', 'select', 'radio', 'slider', 'multi_select', 'multi_checkbox')"/>
                                <field name="option_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       invisible="operator in ('set', 'not_set') or source_question_type not in
                                                  ('buttons', 'select', 'radio', 'slider', 'multi_select', 'multi_checkbox')"/>
                            </list>
                        </field>
                        <group>
                            <field name="condition_user_domain" widget="domain"
                                   options="{'model': 'res.users', 'in_dialog': True}"/>
                            <field name="condition_record_domain" widget="domain"
                                   options="{'model': 'checklist.checklist', 'in_dialog': True}"/>
                        </group>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Template ─────────────────────────────────────────────────── -->
    <record id="checklist_template_view_list" model="ir.ui.view">
        <field name="name">checklist.template.list</field>
        <field name="model">checklist.template</field>
        <field name="arch" type="xml">
            <list string="Checklist Templates">
                <header>
                    <button name="%(checklists.action_checklist_template_import_wizard)d" type="action"
                            string="Import JSON" display="always"
                            groups="checklists.group_checklist_admin"/>
                    <!-- Shown once templates are selected: one downloads as .json, several as a .zip. -->
                    <button name="action_export_json" type="object" string="Export JSON"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="group_ids" widget="many2many_tags"/>
                <field name="question_count"/>
            </list>
        </field>
    </record>

    <record id="checklist_template_view_form" model="ir.ui.view">
        <field name="name">checklist.template.form</field>
        <field name="model">checklist.template</field>
        <field name="arch" type="xml">
            <form string="Checklist Template">
                <header>
                    <button name="action_export_json" type="object" string="Export JSON"/>
                    <button name="action_import_json" type="object" string="Import JSON"
                            groups="checklists.group_checklist_admin"
                            help="Update this template's questions from a JSON file (matched by their hidden GUIDs)."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Daily Vehicle Pre-Start Check"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                    <field name="description" placeholder="What this template is used for..."/>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids" context="{'default_template_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="question_type"/>
                                    <field name="option_ids" widget="many2many_tags"
                                           invisible="question_type not in ('buttons', 'select', 'radio', 'slider', 'multi_select', 'multi_checkbox')"/>
                                    <field name="conditional" string="Conditional" widget="boolean" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="checklist_template_view_search" model="ir.ui.view">
        <field name="name">checklist.template.search</field>
        <field name="model">checklist.template</field>
        <field name="arch" type="xml">
            <search string="Checklist Templates">
                <field name="name"/>
                <field name="group_ids"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <!-- Pick a Checklist Group to list its templates (values and
                     counters come from checklist.template.search_panel_select_range). -->
                <searchpanel>
                    <field name="group_ids" string="Checklist Group" enable_counters="1" expand="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_checklist_template" model="ir.actions.act_window">
        <field name="name">Checklist Templates</field>
        <field name="res_model">checklist.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="checklist_template_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Checklist Template</p>
            <p>Add the questions people answer when filling in the checklist.</p>
        </field>
    </record>

</odoo>
