<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="checklists.AiGenerateButton">
        <button type="button" class="btn btn-primary" t-on-click="generate">
            <i class="fa fa-magic me-1"/>Generate Checklist
        </button>
    </t>

    <t t-name="checklists.AiGeneratingOverlay">
        <div t-if="state.active" class="o_checklist_ai_overlay" role="status" aria-live="polite">
            <div class="o_checklist_ai_card">
                <div class="o_checklist_ai_clipboard" aria-hidden="true">
                    <div class="o_checklist_ai_clip"/>
                    <div t-foreach="[0, 1, 2, 3]" t-as="row" t-key="row" class="o_checklist_ai_row"
                         t-attf-style="--row: {{ row }};">
                        <span class="o_checklist_ai_tick"><i class="fa fa-check"/></span>
                        <span class="o_checklist_ai_line"/>
                    </div>
                </div>
                <h3 class="mt-3 mb-1">Checklist Generating</h3>
                <p class="mb-1">AI is writing your checklist template. This may take a few minutes.</p>
                <p class="text-muted small mb-0">Please keep this page open. <t t-esc="elapsed"/></p>
            </div>
        </div>
    </t>
</templates>
