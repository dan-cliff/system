<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Details, then each check's question, description and answer, then the notes. -->
    <template id="report_checklist_document">
        <t t-call="web.external_layout">
            <div class="page">
                <h2>
                    <span>Checklist</span>
                    <span t-field="doc.name"/>
                </h2>
                <table class="table table-sm table-borderless mb-4">
                    <tr>
                        <th class="w-25">Template</th>
                        <td><span t-field="doc.template_id"/></td>
                    </tr>
                    <tr>
                        <th>Date</th>
                        <td><span t-field="doc.checklist_date" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                    </tr>
                    <tr t-if="doc.date_due">
                        <th>Due Date</th>
                        <td><span t-field="doc.date_due" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></td>
                    </tr>
                    <tr>
                        <th>Completed By</th>
                        <td><span t-field="doc.user_id"/></td>
                    </tr>
                    <tr>
                        <th>Status</th>
                        <td><span t-field="doc.state"/></td>
                    </tr>
                </table>

                <h4>Checks</h4>
                <div t-foreach="doc.line_ids" t-as="line" class="border-bottom py-2" style="page-break-inside: avoid;">
                    <div><strong t-esc="line.name"/></div>
                    <div t-if="line.description" class="text-muted" style="white-space: pre-line;" t-esc="line.description"/>
                    <t t-set="answer" t-value="line._answer_display()"/>
                    <t t-set="badge_style" t-value="line._answer_badge_style()"/>
                    <div class="mt-1">
                        <span t-if="answer and badge_style" class="badge rounded-pill" t-att-style="badge_style" t-esc="answer"/>
                        <span t-elif="answer" style="white-space: pre-line;" t-esc="answer"/>
                        <em t-else="" class="text-muted">Not answered</em>
                    </div>
                </div>

                <t t-if="doc.notes">
                    <h4 class="mt-4">Notes</h4>
                    <div t-field="doc.notes"/>
                </t>
            </div>
        </t>
    </template>

    <template id="report_checklist">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="checklists.report_checklist_document"/>
            </t>
        </t>
    </template>

    <record id="action_report_checklist" model="ir.actions.report">
        <field name="name">Checklist</field>
        <field name="model">checklist.checklist</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">checklists.report_checklist</field>
        <field name="report_file">checklists.report_checklist</field>
        <field name="print_report_name">'Checklist - %s' % object.name.replace('/', '-')</field>
        <field name="binding_model_id" ref="model_checklist_checklist"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
