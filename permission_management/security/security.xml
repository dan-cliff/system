<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Module Category -->
        <record id="module_category_permission_management" model="ir.module.category">
            <field name="name">Permission Management</field>
            <field name="description">Role and Profile-based permission management across all Odoo modules.</field>
            <field name="sequence">20</field>
        </record>

        <!-- Privilege (Odoo 19 way to link groups to a category) -->
        <record id="privilege_permission_management" model="res.groups.privilege">
            <field name="name">Permission Management</field>
            <field name="category_id" ref="module_category_permission_management"/>
            <field name="sequence">10</field>
        </record>

        <!-- Security Group -->
        <record id="group_permission_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_permission_management"/>
            <field name="sequence">10</field>
            <field name="comment">Full access to Permission Management roles and profiles.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>

    </data>
</odoo>
