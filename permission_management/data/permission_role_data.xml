<?xml version="1.0" encoding="utf-8"?>
<!--
    This file is intentionally left as a safe no-op stub.

    Role data is seeded via the post_init_hook in hooks.py, which resolves
    each privilege/group XML ID with raise_if_not_found=False and silently
    skips any whose module is not installed on this build.

    Keeping this file prevents git merge conflicts from restoring an older
    version of the file that contained hard ref() calls to optional modules.
-->
<odoo>
    <data noupdate="1">
        <function model="permission.role" name="_load_role_library"/>
    </data>
</odoo>
