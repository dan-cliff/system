<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ───────────────────────────────────────────────── -->
    <record id="view_permission_role_list" model="ir.ui.view">
        <field name="name">permission.role.list</field>
        <field name="model">permission.role</field>
        <field name="arch" type="xml">
            <list string="Roles">
                <field name="id" string="ID"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ───────────────────────────────────────────────── -->
    <record id="view_permission_role_form" model="ir.ui.view">
        <field name="name">permission.role.form</field>
        <field name="model">permission.role</field>
        <field name="arch" type="xml">
            <form string="Role">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Role name…"/></h1>
                    </div>
                    <group>
                        <field name="description" placeholder="Describe what this role grants…"/>
                    </group>
                    <notebook>
                        <page string="Privileges" name="privileges">
                            <field name="line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="id" string="ID"/>
                                    <field name="privilege_id" string="Privilege"/>
                                    <field name="group_id" string="Access Level"/>
                                </list>
                            </field>
                        </page>
                        <page string="Profiles" name="profiles">
                            <field name="profile_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="id" string="ID"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ─────────────────────────────────────────────── -->
    <record id="view_permission_role_search" model="ir.ui.view">
        <field name="name">permission.role.search</field>
        <field name="model">permission.role</field>
        <field name="arch" type="xml">
            <search string="Search Roles">
                <field name="name"/>
                <field name="description"/>
            </search>
        </field>
    </record>

</odoo>
