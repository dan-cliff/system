<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Wizard Form ───────────────────────────────────────────────────── -->
    <record id="view_video_idea_ai_wizard_form" model="ir.ui.view">
        <field name="name">video.idea.ai.wizard.form</field>
        <field name="model">video.idea.ai.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Content Ideas with AI" js_class="video_idea_ai_wizard_form">
                <sheet>
                    <div class="alert alert-info d-flex align-items-center mb-3" role="status">
                        <i class="fa fa-magic me-2"/>
                        <span>
                            Provide a context or search query to run using AI.
                            The resultant ideas will be added to the Content Ideas list.
                            If you don't specify a number of ideas, 10 will be generated by default.
                        </span>
                    </div>
                    <group>
                        <field name="idea_prompt"
                               nolabel="1"
                               placeholder="e.g. Beginner-friendly woodworking tutorials for people with limited tools and space, focusing on quick weekend projects..."
                               style="min-height: 120px;"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_generate_ideas"
                            string="Generate Ideas"
                            type="object"
                            class="btn-primary"
                            data-hotkey="s"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ── Wizard Action ─────────────────────────────────────────────────── -->
    <record id="action_video_idea_ai_wizard" model="ir.actions.act_window">
        <field name="name">Generate Content Ideas with AI</field>
        <field name="res_model">video.idea.ai.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_video_idea_ai_wizard_form"/>
        <field name="target">new</field>
    </record>

</odoo>
