<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Search ────────────────────────────────────────────────────── -->
    <record id="view_video_metadata_search" model="ir.ui.view">
        <field name="name">video.metadata.search</field>
        <field name="model">video.metadata</field>
        <field name="arch" type="xml">
            <search string="Search Metadata">
                <field name="youtube_title"/>
                <field name="production_id"/>
                <filter string="Public" name="public" domain="[('visibility','=','public')]"/>
                <filter string="Private" name="private" domain="[('visibility','=','private')]"/>
                <filter string="Published" name="published" domain="[('date_published','!=',False)]"/>
                <filter string="Scheduled" name="scheduled"
                        domain="[('scheduled_publish_dt','!=',False),('date_published','=',False)]"/>
                <filter string="High SEO Score" name="high_seo"
                        domain="[('seo_score','&gt;=',70)]"/>
                <group name="group_by">
                    <filter string="Production" name="group_production"
                            context="{'group_by': 'production_id'}"/>
                    <filter string="Visibility" name="group_visibility"
                            context="{'group_by': 'visibility'}"/>
                    <filter string="Category" name="group_category"
                            context="{'group_by': 'youtube_category'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── List ──────────────────────────────────────────────────────── -->
    <record id="view_video_metadata_list" model="ir.ui.view">
        <field name="name">video.metadata.list</field>
        <field name="model">video.metadata</field>
        <field name="arch" type="xml">
            <list string="Video Metadata" default_order="scheduled_publish_dt desc">
                <field name="thumbnail_image" widget="image" options="{'size': [32, 32]}"
                       nolabel="1" optional="show"/>
                <field name="production_id"/>
                <field name="youtube_title"/>
                <field name="visibility"/>
                <field name="youtube_category" optional="show"/>
                <field name="scheduled_publish_dt" options="{'numeric': True}"/>
                <field name="date_published" options="{'numeric': True}"/>
                <field name="seo_score" widget="progressbar"
                       options="{'editable': false, 'overflow_class': 'text-bg-success'}"/>
                <field name="youtube_url" widget="url" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────────── -->
    <record id="view_video_metadata_form" model="ir.ui.view">
        <field name="name">video.metadata.form</field>
        <field name="model">video.metadata</field>
        <field name="arch" type="xml">
            <form string="YouTube Metadata &amp; Thumbnail" js_class="video_metadata_ai_form">
                <header>
                    <button name="action_suggest_by_ai"
                            string="Suggest by AI"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-magic"
                            title="Use Gemini AI to suggest a YouTube title, description, tags and category based on the linked production."/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_create_social_post" type="object"
                                class="oe_stat_button" icon="fa-share-alt"
                                invisible="show_social_integration == False">
                            <span>Create Social Post</span>
                        </button>
                        <button name="action_view_social_posts" type="object"
                                class="oe_stat_button" icon="fa-rss"
                                invisible="social_post_count == 0">
                            <field name="social_post_count" widget="statinfo" string="Social Posts"/>
                        </button>
                    </div>
                    <field name="show_social_integration" invisible="1"/>
                    <div class="oe_title">
                        <label for="production_id"/>
                        <h2>
                            <field name="production_id" readonly="context.get('from_production')"/>
                        </h2>
                    </div>
                    <!-- SEO Score bar at top -->
                    <group>
                        <group>
                            <label for="seo_score"/>
                            <div>
                                <field name="seo_score" widget="progressbar"
                                       options="{'editable': false, 'overflow_class': 'text-bg-success'}"/>
                                <div class="d-flex align-items-center gap-2 mt-1">
                                    <small class="text-muted">
                                        SEO Score (0–100 based on title, description, tags, thumbnail)
                                    </small>
                                    <button name="action_open_seo_suggest"
                                            string="Suggest Improvements"
                                            type="object"
                                            class="btn btn-link p-0 small"
                                            title="Use Gemini AI to analyse your metadata and suggest improvements to boost your SEO score"
                                            invisible="seo_score >= 90"/>
                                </div>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="YouTube Details" name="youtube">
                            <group>
                                <group string="Title &amp; Description">
                                    <field name="youtube_title"
                                           placeholder="Max 100 characters — be descriptive and keyword-rich"/>
                                    <field name="youtube_description"
                                           placeholder="Describe your video. First 125 chars show in search."/>
                                    <field name="youtube_tags"
                                           placeholder="tag1, tag2, tag3, …"/>
                                    <field name="chapter_timestamps"
                                           placeholder="0:00 Intro&#10;1:30 Main Topic"/>
                                </group>
                                <group string="Classification">
                                    <field name="youtube_category"/>
                                    <field name="platform_id"/>
                                    <field name="channel_id"
                                           domain="[('platform_id', '=', platform_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="playlist_id"
                                           domain="['|', ('platform_id', '=', platform_id), ('channel_id', '=', channel_id)]"
                                           options="{'no_create': True}"/>
                                    <field name="language"/>
                                    <field name="visibility"/>
                                    <field name="made_for_kids"/>
                                    <field name="age_restricted"/>
                                    <field name="allow_comments"/>
                                    <field name="allow_ratings"/>
                                </group>
                            </group>
                        </page>
                        <page string="Thumbnail" name="thumbnail">
                            <group>
                                <field name="thumbnail_image" widget="image"
                                       options="{'size': [640, 360]}"
                                       class="d-block mb8"/>
                                <field name="thumbnail_alt_text"
                                       placeholder="Describe the thumbnail image…"/>
                            </group>
                        </page>
                        <page string="Publishing" name="publishing">
                            <group string="Scheduling">
                                <field name="scheduled_publish_dt" options="{'numeric': True}"/>
                            </group>
                            <group string="Published Info" invisible="not date_published">
                                <field name="youtube_url" widget="url"/>
                                <field name="youtube_video_id"/>
                                <field name="date_published" options="{'numeric': True}"/>
                            </group>
                            <group string="Social Media" invisible="not show_social_integration">
                                <field name="social_notes"
                                       placeholder="Notes for social media posts related to this publish…"/>
                            </group>
                        </page>
                        <page string="SEO &amp; Extras" name="seo">
                            <group>
                                <group string="End Screen">
                                    <field name="end_screen_notes"
                                           placeholder="Notes on end screen elements to configure…"/>
                                </group>
                                <group string="Cards">
                                    <field name="cards_notes"
                                           placeholder="Timestamps and card content to add…"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Actions ───────────────────────────────────────────────────── -->
    <record id="action_video_metadata" model="ir.actions.act_window">
        <field name="name">Metadata &amp; Thumbnails</field>
        <field name="res_model">video.metadata</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No metadata yet!
            </p>
            <p>
                Add YouTube titles, descriptions, tags, thumbnails and
                publishing schedules for your productions.
            </p>
        </field>
    </record>

</odoo>
