<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ──────────────────────────────────────────────────────── -->
    <record id="view_video_idea_stage_list" model="ir.ui.view">
        <field name="name">video.idea.stage.list</field>
        <field name="model">video.idea.stage</field>
        <field name="arch" type="xml">
            <list string="Idea Stages" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="is_won"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────────── -->
    <record id="view_video_idea_stage_form" model="ir.ui.view">
        <field name="name">video.idea.stage.form</field>
        <field name="model">video.idea.stage</field>
        <field name="arch" type="xml">
            <form string="Idea Stage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="fold"/>
                        <field name="is_won"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────── -->
    <record id="action_video_idea_stage" model="ir.actions.act_window">
        <field name="name">Idea Stages</field>
        <field name="res_model">video.idea.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
