<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_teleprompter_send_wizard_form" model="ir.ui.view">
        <field name="name">teleprompter.send.wizard.form</field>
        <field name="model">teleprompter.send.wizard</field>
        <field name="arch" type="xml">
            <form string="Teleprompter">
                <sheet>

                    <!-- Script banner -->
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-3" role="status">
                        <i class="fa fa-film fa-lg"/>
                        <span>
                            <field name="script_id" invisible="1"/>
                            <field name="script_name" readonly="1" nolabel="1"/>
                        </span>
                    </div>

                    <!-- Delivery choice -->
                    <group string="How would you like to open it?">
                        <field name="delivery" widget="radio" nolabel="1"/>
                    </group>

                </sheet>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="📺 Open Teleprompter"
                            class="btn-primary"
                            close="1"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_teleprompter_send_wizard" model="ir.actions.act_window">
        <field name="name">Teleprompter</field>
        <field name="res_model">teleprompter.send.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
