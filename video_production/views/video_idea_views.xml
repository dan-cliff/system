<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Search ────────────────────────────────────────────────────── -->
    <record id="view_video_idea_search" model="ir.ui.view">
        <field name="name">video.idea.search</field>
        <field name="model">video.idea</field>
        <field name="arch" type="xml">
            <search string="Search Ideas">
                <field name="name" string="Title / Concept"/>
                <field name="author_id"/>
                <field name="niche"/>
                <field name="tag_ids"/>
                <filter string="My Ideas" name="my_ideas" domain="[('author_id','=',uid)]"/>
                <filter string="Not Promoted" name="not_promoted" domain="[('production_id','=',False)]"/>
                <filter string="Promoted" name="promoted" domain="[('production_id','!=',False)]"/>
                <separator/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <group name="group_by">
                    <filter string="Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Author" name="group_author" context="{'group_by': 'author_id'}"/>
                    <filter string="Content Type" name="group_type" context="{'group_by': 'video_type'}"/>
                    <filter string="Niche" name="group_niche" context="{'group_by': 'niche'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── List ──────────────────────────────────────────────────────── -->
    <record id="view_video_idea_list" model="ir.ui.view">
        <field name="name">video.idea.list</field>
        <field name="model">video.idea</field>
        <field name="arch" type="xml">
            <list string="Content Ideas" multi_edit="1">
                <header>
                    <button name="action_open_ai_idea_wizard"
                            string="Generate AI Ideas"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-magic"
                            display="always"
                            title="Use our AI subscription to create a catalogue of video ideas, along with Concept and Audience metrics."/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="reference" optional="show"/>
                <field name="name"/>
                <field name="stage_id"/>
                <field name="video_type"/>
                <field name="niche" optional="show"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="tag_ids" widget="many2many_tags" optional="show"
                       options="{'color_field': 'color'}"/>
                <field name="production_id" optional="show"/>
                <field name="date_promoted" optional="show" options="{'numeric': True}"/>
                <field name="kanban_state" widget="kanban_state_selection" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────────── -->
    <record id="view_video_idea_form" model="ir.ui.view">
        <field name="name">video.idea.form</field>
        <field name="model">video.idea</field>
        <field name="arch" type="xml">
            <form string="Content Idea">
                <header>
                    <button name="action_promote_to_production"
                            string="Approve &amp; Create Production"
                            type="object"
                            class="btn-primary"
                            invisible="production_id"
                            confirm="This will mark the idea as Approved and create a new Production record. Continue?"/>
                    <field name="stage_id" widget="statusbar"
                           options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_production" type="object"
                                class="oe_stat_button" icon="fa-film"
                                invisible="not production_id">
                            <span>Production</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Top 10 Budget Camera Lenses 2025"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Content Details">
                            <field name="video_type"/>
                            <field name="niche"/>
                            <field name="estimated_duration_min"/>
                            <field name="author_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Pipeline">
                            <field name="reference" readonly="1"/>
                            <field name="stage_id"/>
                            <field name="kanban_state" widget="kanban_state_selection"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options="{'color_field': 'color'}"/>
                            <field name="production_id"/>
                            <field name="date_promoted" options="{'numeric': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Concept" name="concept">
                            <field name="description" placeholder="Describe your idea…"/>
                        </page>
                        <page string="Audience &amp; SEO" name="seo">
                            <group>
                                <field name="target_audience" placeholder="Who is this video for?"/>
                                <field name="keywords"
                                       placeholder="One keyword or phrase per line&#10;budget lenses&#10;photography for beginners"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────── -->
    <record id="action_video_idea" model="ir.actions.act_window">
        <field name="name">Content Ideas</field>
        <field name="res_model">video.idea</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_promoted': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first content idea!
            </p>
            <p>
                Capture video ideas, plan your content pipeline, and
                promote ideas to full productions when you're ready.
            </p>
        </field>
    </record>

</odoo>
