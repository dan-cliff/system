<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Search ────────────────────────────────────────────────────── -->
    <record id="view_video_edit_job_search" model="ir.ui.view">
        <field name="name">video.edit.job.search</field>
        <field name="model">video.edit.job</field>
        <field name="arch" type="xml">
            <search string="Search Edit Jobs">
                <field name="name"/>
                <field name="production_id"/>
                <field name="editor_id"/>
                <filter string="Pending" name="pending" domain="[('state','=','pending')]"/>
                <filter string="In Progress" name="in_progress"
                        domain="[('state','=','in_progress')]"/>
                <filter string="Pending Review" name="review" domain="[('state','=','review')]"/>
                <filter string="Overdue" name="overdue" domain="[('is_overdue','=',True)]"/>
                <filter string="My Jobs" name="mine" domain="[('editor_id','=',uid)]"/>
                <group name="group_by">
                    <filter string="Production" name="group_production"
                            context="{'group_by': 'production_id'}"/>
                    <filter string="Editor" name="group_editor"
                            context="{'group_by': 'editor_id'}"/>
                    <filter string="Status" name="group_state"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Kanban ─────────────────────────────────────────────────────── -->
    <record id="view_video_edit_job_kanban" model="ir.ui.view">
        <field name="name">video.edit.job.kanban</field>
        <field name="model">video.edit.job</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="editor_id"/>
                <field name="production_id"/>
                <field name="date_deadline"/>
                <field name="is_overdue"/>
                <field name="current_version"/>
                <templates>
                    <t t-name="card">
                        <div>
                            <div class="o_kanban_record_top mb4">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <small class="text-muted">
                                        <field name="production_id"/>
                                    </small>
                                </div>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <t t-if="record.date_deadline.raw_value">
                                    <span t-attf-class="small #{record.is_overdue.raw_value ? 'text-danger fw-bold' : 'text-muted'}">
                                        📅 <field name="date_deadline" options="{'numeric': True}"/>
                                    </span>
                                </t>
                                <t t-if="record.current_version.raw_value">
                                    <span class="badge text-bg-secondary ms-2">
                                        v<t t-esc="record.current_version.raw_value"/>
                                    </span>
                                </t>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left"/>
                                <div class="oe_kanban_bottom_right">
                                    <field name="editor_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── List ──────────────────────────────────────────────────────── -->
    <record id="view_video_edit_job_list" model="ir.ui.view">
        <field name="name">video.edit.job.list</field>
        <field name="model">video.edit.job</field>
        <field name="arch" type="xml">
            <list string="Edit Jobs" default_order="date_deadline">
                <field name="priority" widget="priority" nolabel="1"/>
                <field name="name"/>
                <field name="production_id"/>
                <field name="editor_id" widget="many2one_avatar_user"/>
                <field name="state"/>
                <field name="date_deadline"
                       decoration-danger="is_overdue"
                       decoration-warning="state == 'pending'"
                       options="{'numeric': True}"/>
                <field name="current_version" string="Ver."/>
                <field name="is_overdue" optional="show"/>
                <field name="delivery_format" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Edit Version List ─────────────────────────────────────────── -->
    <record id="view_video_edit_version_list" model="ir.ui.view">
        <field name="name">video.edit.version.list</field>
        <field name="model">video.edit.version</field>
        <field name="arch" type="xml">
            <list string="Edit Versions" default_order="version_number desc">
                <field name="version_number" string="Ver."/>
                <field name="name"/>
                <field name="edit_job_id"/>
                <field name="submitted_by_id" widget="many2one_avatar_user"/>
                <field name="date_submitted" options="{'numeric': True}"/>
                <field name="state"/>
                <field name="duration_display" string="Duration"/>
                <field name="file_url" widget="url" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────────── -->
    <record id="view_video_edit_job_form" model="ir.ui.view">
        <field name="name">video.edit.job.form</field>
        <field name="model">video.edit.job</field>
        <field name="arch" type="xml">
            <form string="Edit Job">
                <header>
                    <button name="action_start" type="object"
                            string="Start Editing" class="btn-primary"
                            invisible="state != 'pending'"/>
                    <button name="action_submit_review" type="object"
                            string="Submit for Review" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_approve" type="object"
                            string="Approve" class="btn-success"
                            invisible="state != 'review'"
                            groups="video_production.group_vp_edit_job_update"/>
                    <button name="action_done" type="object"
                            string="Mark Done" class="btn-success"
                            invisible="state != 'approved'"
                            groups="video_production.group_vp_edit_job_update"/>
                    <button name="action_reset" type="object"
                            string="Reset to Pending"
                            invisible="state in ('pending', 'done')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,in_progress,review,approved,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Edit job name…"/>
                        </h1>
                        <field name="priority" widget="priority"/>
                    </div>
                    <group>
                        <group string="Assignment">
                            <field name="production_id"/>
                            <field name="editor_id" widget="many2one_avatar_user"/>
                            <field name="date_assigned" options="{'numeric': True}"/>
                            <field name="date_deadline"
                                   decoration-danger="is_overdue"
                                   options="{'numeric': True}"/>
                        </group>
                        <group string="Delivery">
                            <field name="delivery_format"/>
                            <field name="current_version" readonly="1"/>
                            <field name="is_overdue" readonly="1"
                                   widget="boolean_toggle"
                                   invisible="not is_overdue"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Brief" name="brief">
                            <field name="brief" placeholder="Edit brief and instructions…"/>
                        </page>
                        <page string="Versions" name="versions">
                            <div class="mb8">
                                <button name="action_add_version" type="object"
                                        string="Add Version" class="btn btn-sm btn-secondary"/>
                            </div>
                            <field name="version_ids">
                                <list default_order="version_number desc">
                                    <field name="version_number" string="Ver."/>
                                    <field name="name"/>
                                    <field name="submitted_by_id" widget="many2one_avatar_user"/>
                                    <field name="date_submitted" options="{'numeric': True}"/>
                                    <field name="state"/>
                                    <field name="duration_display" string="Duration"/>
                                    <field name="file_url" widget="url"/>
                                    <field name="feedback"/>
                                </list>
                            </field>
                        </page>
                        <page string="Revision Notes" name="revisions">
                            <field name="revision_notes"
                                   placeholder="Notes on required revisions…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Version Form ──────────────────────────────────────────────── -->
    <record id="view_video_edit_version_form" model="ir.ui.view">
        <field name="name">video.edit.version.form</field>
        <field name="model">video.edit.version</field>
        <field name="arch" type="xml">
            <form string="Edit Version">
                <sheet>
                    <group>
                        <field name="edit_job_id" readonly="1"/>
                        <field name="version_number"/>
                        <field name="name"/>
                        <field name="submitted_by_id" widget="many2one_avatar_user"/>
                        <field name="date_submitted" options="{'numeric': True}"/>
                        <field name="state"/>
                        <field name="file_url" widget="url"/>
                        <field name="duration_sec"/>
                        <field name="duration_display" readonly="1"/>
                    </group>
                    <group string="Feedback">
                        <field name="feedback" nolabel="1"/>
                    </group>
                    <group string="Editor Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Actions ───────────────────────────────────────────────────── -->
    <record id="action_video_edit_job" model="ir.actions.act_window">
        <field name="name">Edit Jobs</field>
        <field name="res_model">video.edit.job</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No editing jobs yet!
            </p>
            <p>Assign editing jobs to editors and track their progress.</p>
        </field>
    </record>

    <record id="action_video_edit_version" model="ir.actions.act_window">
        <field name="name">Edit Versions</field>
        <field name="res_model">video.edit.version</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
