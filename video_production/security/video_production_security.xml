<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Module Category ───────────────────────────────────────── -->
        <record id="module_category_video_production" model="ir.module.category">
            <field name="name">Video Production</field>
            <field name="description">Manage YouTube video production from idea to publish.</field>
            <field name="sequence">72</field>
        </record>

        <!-- ── Privilege (Odoo 19 Settings group UI) ──────────────────── -->
        <record id="privilege_video_production" model="res.groups.privilege">
            <field name="name">Video Production</field>
            <field name="category_id" ref="module_category_video_production"/>
            <field name="sequence">10</field>
        </record>

        <!-- ── User Group ─────────────────────────────────────────────── -->
        <record id="group_video_production_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_video_production"/>
            <field name="sequence">10</field>
            <field name="comment">
                Can create ideas, manage productions, view scripts, log shoots,
                submit edit jobs, and participate in reviews.
            </field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- ── Manager Group ──────────────────────────────────────────── -->
        <record id="group_video_production_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_video_production"/>
            <field name="sequence">20</field>
            <field name="comment">
                Full access including approvals, publishing, stage configuration,
                and integration settings.
            </field>
            <field name="implied_ids" eval="[(4, ref('video_production.group_video_production_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
