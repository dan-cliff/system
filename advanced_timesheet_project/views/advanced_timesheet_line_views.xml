<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_timesheet_line_view_list" model="ir.ui.view">
        <field name="name">advanced.timesheet.line.list.project</field>
        <field name="model">advanced.timesheet.line</field>
        <field name="inherit_id" ref="advanced_timesheet.advanced_timesheet_line_view_list"/>
        <field name="arch" type="xml">
            <field name="work_type_id" position="before">
                <field name="project_id" optional="show"/>
                <field name="task_id" optional="show" context="{'default_project_id': project_id}"/>
            </field>
        </field>
    </record>

    <record id="advanced_timesheet_line_view_form" model="ir.ui.view">
        <field name="name">advanced.timesheet.line.form.project</field>
        <field name="model">advanced.timesheet.line</field>
        <field name="inherit_id" ref="advanced_timesheet.advanced_timesheet_line_view_form"/>
        <field name="arch" type="xml">
            <field name="work_type_id" position="before">
                <field name="project_id"/>
                <field name="task_id" context="{'default_project_id': project_id}"/>
            </field>
        </field>
    </record>
</odoo>
