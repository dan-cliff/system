<odoo>
    <record id="view_mandrill_reply_route_list" model="ir.ui.view">
        <field name="name">mandrill.reply.route.list</field>
        <field name="model">mandrill.reply.route</field>
        <field name="arch" type="xml">
            <list string="Reply-To Addresses" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_id" options="{'no_create': True}"/>
                <field name="alias_id" options="{'no_create': True}"/>
                <field name="email" readonly="alias_id" placeholder="e.g. accounts@example.com"/>
                <field name="reply_to"/>
                <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_mandrill_reply_route_form" model="ir.ui.view">
        <field name="name">mandrill.reply.route.form</field>
        <field name="model">mandrill.reply.route</field>
        <field name="arch" type="xml">
            <form string="Reply-To Address">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="alias_id" options="{'no_create': True}"/>
                            <field name="email" invisible="alias_id" placeholder="e.g. accounts@example.com"/>
                            <field name="reply_to"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mandrill_reply_route_search" model="ir.ui.view">
        <field name="name">mandrill.reply.route.search</field>
        <field name="model">mandrill.reply.route</field>
        <field name="arch" type="xml">
            <search string="Reply-To Addresses">
                <field name="model_id"/>
                <field name="reply_to"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_mandrill_reply_route" model="ir.actions.act_window">
        <field name="name">Reply-To Addresses</field>
        <field name="res_model">mandrill.reply.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set a reply-to address per model</p>
            <p>Emails sent from these models through Mailchimp Transactional ask recipients to reply
               to the address set here. Other models use the default reply-to from Settings.</p>
        </field>
    </record>

    <menuitem id="menu_mandrill_reply_route"
              name="Mailchimp Transactional Reply-To"
              parent="base.menu_email"
              action="action_mandrill_reply_route"
              sequence="51"
              groups="mandrill_mail.group_mandrill_reply_route_create,mandrill_mail.group_mandrill_reply_route_update,mandrill_mail.group_mandrill_reply_route_delete,base.group_system"/>
</odoo>
