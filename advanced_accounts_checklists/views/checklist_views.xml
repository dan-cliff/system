<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="checklist_view_form" model="ir.ui.view">
        <field name="name">checklist.checklist.form.advanced_accounts</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='checklist_details']" position="inside">
                <field name="adv_account_id" options="{'no_quick_create': True}"/>
                <field name="adv_contact_id" options="{'no_quick_create': True}"
                       context="{'default_account_id': adv_account_id}"/>
            </xpath>
        </field>
    </record>

    <record id="checklist_view_list" model="ir.ui.view">
        <field name="name">checklist.checklist.list.advanced_accounts</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_list"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id" optional="show"/>
                <field name="adv_contact_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="checklist_view_search" model="ir.ui.view">
        <field name="name">checklist.checklist.search.advanced_accounts</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id"/>
                <field name="adv_contact_id"/>
            </field>
            <xpath expr="//filter[@name='group_partner']" position="after">
                <filter name="group_adv_account" string="Account" context="{'group_by': 'adv_account_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
