<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payroll_rule_view_form_accounting" model="ir.ui.view">
        <field name="name">payroll.rule.form.accounting</field>
        <field name="model">payroll.rule</field>
        <field name="inherit_id" ref="advanced_payroll.payroll_rule_view_form"/>
        <field name="arch" type="xml">
            <group name="rule" position="inside">
                <field name="account_id" options="{'no_create': True}" placeholder="Company default"/>
                <field name="expense_account_id" options="{'no_create': True}" placeholder="Company default"
                       invisible="category != 'employer'"/>
            </group>
        </field>
    </record>

    <record id="payroll_rule_view_list_accounting" model="ir.ui.view">
        <field name="name">payroll.rule.list.accounting</field>
        <field name="model">payroll.rule</field>
        <field name="inherit_id" ref="advanced_payroll.payroll_rule_view_list"/>
        <field name="arch" type="xml">
            <field name="tax_table_id" position="after">
                <field name="account_id" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
