<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every list under Personnel › Configuration starts with the record ID. -->
    <record id="personnel_employee_category_view_list" model="ir.ui.view">
        <field name="name">hr.employee.category.list.personnel</field>
        <field name="model">hr.employee.category</field>
        <field name="inherit_id" ref="hr.view_employee_category_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="personnel_departure_reason_view_list" model="ir.ui.view">
        <field name="name">hr.departure.reason.list.personnel</field>
        <field name="model">hr.departure.reason</field>
        <field name="inherit_id" ref="hr.hr_departure_reason_view_list"/>
        <field name="arch" type="xml">
            <field name="sequence" position="after">
                <field name="id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="personnel_work_location_view_list" model="ir.ui.view">
        <field name="name">hr.work.location.list.personnel</field>
        <field name="model">hr.work.location</field>
        <field name="inherit_id" ref="hr.hr_work_location_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" optional="show"/>
            </xpath>
            <field name="company_id" position="attributes">
                <attribute name="optional">show</attribute>
            </field>
        </field>
    </record>

    <record id="personnel_resource_calendar_view_list" model="ir.ui.view">
        <field name="name">resource.calendar.list.personnel</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.view_resource_calendar_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="personnel_activity_plan_view_list" model="ir.ui.view">
        <field name="name">mail.activity.plan.list.personnel</field>
        <field name="model">mail.activity.plan</field>
        <field name="inherit_id" ref="mail.mail_activity_plan_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="personnel_contract_template_view_list" model="ir.ui.view">
        <field name="name">hr.contract.template.list.personnel</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" optional="show"/>
            </xpath>
            <field name="create_date" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
        </field>
    </record>

    <!-- Job Positions and Contract Types get lists of their own: Talent and the
         job board apps already extend Odoo's. -->
    <record id="personnel_job_view_list" model="ir.ui.view">
        <field name="name">hr.job.list.personnel</field>
        <field name="model">hr.job</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Job Positions" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="department_id" optional="show"/>
                <field name="contract_type_id" optional="hide"/>
                <field name="no_of_employee" string="Employees" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_personnel_job" model="ir.actions.act_window">
        <field name="name">Job Positions</field>
        <field name="res_model">hr.job</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr.view_job_filter"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'sequence': 1, 'view_id': ref('personnel_job_view_list')}),
            (0, 0, {'view_mode': 'form', 'sequence': 2, 'view_id': ref('hr.view_hr_job_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a job position</p>
            <p>Job positions describe the roles employees hold and the ones you recruit for.</p>
        </field>
    </record>

    <record id="personnel_contract_type_view_list" model="ir.ui.view">
        <field name="name">hr.contract.type.list.personnel</field>
        <field name="model">hr.contract.type</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <list string="Contract Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="code" column_invisible="1"/>
                <field name="country_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_personnel_contract_type" model="ir.actions.act_window">
        <field name="name">Contract Types</field>
        <field name="res_model">hr.contract.type</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'sequence': 1, 'view_id': ref('personnel_contract_type_view_list')}),
            (0, 0, {'view_mode': 'form', 'sequence': 2, 'view_id': ref('hr.hr_contract_type_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a contract type</p>
            <p>e.g. Permanent, Fixed Term, Casual.</p>
        </field>
    </record>
</odoo>
