<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="audit_trail_view_list" model="ir.ui.view">
        <field name="name">advanced.hr.audit.trail.list</field>
        <field name="model">advanced.hr.audit.trail</field>
        <field name="arch" type="xml">
            <list string="Audit Trail" create="0" edit="0" delete="0" class="o_personnel_list">
                <field name="id" optional="show"/>
                <field name="date" options="{'numeric': True}"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="operation" widget="badge"
                       decoration-success="operation == 'create'" decoration-info="operation == 'write'"
                       decoration-danger="operation == 'unlink'"/>
                <field name="res_model_name" optional="show"/>
                <field name="record_name"/>
                <field name="changed_fields" optional="show"/>
                <field name="change_count" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="audit_trail_view_form" model="ir.ui.view">
        <field name="name">advanced.hr.audit.trail.form</field>
        <field name="model">advanced.hr.audit.trail</field>
        <field name="arch" type="xml">
            <form string="Audit Trail" create="0" edit="0" delete="0" class="o_personnel_audit_form">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object" class="oe_stat_button" icon="fa-external-link"
                                invisible="operation == 'unlink'" string="Open Record"/>
                    </div>
                    <div class="oe_title">
                        <label for="record_name"/>
                        <h1><field name="record_name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="operation"/>
                            <field name="res_model_name"/>
                            <field name="res_id"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="date" options="{'numeric': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="1">
                        <list>
                            <field name="field_label"/>
                            <field name="old_value"/>
                            <field name="new_value"/>
                            <field name="field_name" optional="hide" groups="base.group_no_one"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="audit_trail_view_search" model="ir.ui.view">
        <field name="name">advanced.hr.audit.trail.search</field>
        <field name="model">advanced.hr.audit.trail</field>
        <field name="arch" type="xml">
            <search string="Audit Trail">
                <field name="record_name"/>
                <field name="user_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="line_ids" string="Field" filter_domain="[('line_ids.field_label', 'ilike', self)]"/>
                <filter name="employees" string="Employees" domain="[('res_model', '=', 'hr.employee')]"/>
                <filter name="departments" string="Departments" domain="[('res_model', '=', 'hr.department')]"/>
                <separator/>
                <filter name="created" string="Created" domain="[('operation', '=', 'create')]"/>
                <filter name="updated" string="Updated" domain="[('operation', '=', 'write')]"/>
                <filter name="deleted" string="Deleted" domain="[('operation', '=', 'unlink')]"/>
                <separator/>
                <filter name="date" string="Changed At" date="date"/>
                <group>
                    <filter name="group_user" string="Changed By" context="{'group_by': 'user_id'}"/>
                    <filter name="group_record" string="Record" context="{'group_by': 'record_name'}"/>
                    <filter name="group_type" string="Record Type" context="{'group_by': 'res_model_name'}"/>
                    <filter name="group_date" string="Changed At" context="{'group_by': 'date:day'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_audit_trail" model="ir.actions.act_window">
        <field name="name">Audit Trail</field>
        <field name="res_model">advanced.hr.audit.trail</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="audit_trail_view_search"/>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No changes recorded yet</p>
            <p>Every save of an employee or a department records who changed what, when, and the original and new values.</p>
        </field>
    </record>

    <!-- Every change of one field, across entries. -->
    <record id="audit_trail_line_view_list" model="ir.ui.view">
        <field name="name">advanced.hr.audit.trail.line.list</field>
        <field name="model">advanced.hr.audit.trail.line</field>
        <field name="arch" type="xml">
            <list string="Changes" create="0" edit="0" delete="0">
                <field name="id" optional="show"/>
                <field name="date" options="{'numeric': True}"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="audit_id" string="Record"/>
                <field name="field_label"/>
                <field name="old_value"/>
                <field name="new_value"/>
            </list>
        </field>
    </record>
</odoo>
