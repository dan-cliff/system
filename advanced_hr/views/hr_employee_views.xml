<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Personnel's employee views extend Odoo's (mode primary), so everything
         other apps add to the Employees views shows here too. -->

    <!-- ── Form ───────────────────────────────────────────────────────── -->
    <record id="personnel_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.form.personnel</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="class" add="o_personnel_employee_form" separator=" "/>
            </xpath>
            <!-- Odoo's "History" is the employee's versions; the change log is the Audit Trail. -->
            <xpath expr="//button[@name='action_open_versions']//div[hasclass('o_stat_info')]" position="replace">
                <div class="o_stat_info">
                    <span class="o_stat_value"><field name="versions_count"/></span>
                    <span class="o_stat_text">Versions</span>
                </div>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_audit_trail" type="object" class="oe_stat_button" icon="fa-history"
                        groups="advanced_hr.group_audit_trail_view" invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="personnel_audit_count"/></span>
                        <span class="o_stat_text">Audit Trail</span>
                    </div>
                </button>
            </xpath>
            <!-- Badges come from Personnel's ID Badges. -->
            <xpath expr="//button[@name='%(hr.hr_employee_print_badge)d']" position="replace">
                <button name="action_print_personnel_badge" string="Print Badge" class="btn btn-link" type="object"
                        invisible="not barcode"/>
            </xpath>
            <!-- dd/mm/yyyy dates -->
            <field name="departure_date" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="birthday" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="visa_expire" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="work_permit_expiration_date" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="passport_expiration_date" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="spouse_birthdate" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="contract_date_start" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="contract_date_end" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
        </field>
    </record>

    <!-- ── List ───────────────────────────────────────────────────────── -->
    <record id="personnel_employee_view_list" model="ir.ui.view">
        <field name="name">hr.employee.list.personnel</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_tree"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="class" add="o_personnel_list" separator=" "/>
            </xpath>
            <xpath expr="//list/field[1]" position="before">
                <field name="id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <field name="contract_date_start" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="contract_date_end" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="birthday" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
        </field>
    </record>

    <record id="personnel_employee_view_list_activities" model="ir.ui.view">
        <field name="name">hr.employee.list.activities.personnel</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_employee_list_activites_view"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <field name="contract_date_start" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="contract_date_end" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="birthday" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
        </field>
    </record>

    <!-- ── Cards ──────────────────────────────────────────────────────── -->
    <record id="personnel_employee_view_kanban" model="ir.ui.view">
        <field name="name">hr.employee.kanban.personnel</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="class" add="o_personnel_kanban" separator=" "/>
            </xpath>
            <xpath expr="//kanban/field[@name='company_id']" position="after">
                <field name="personnel_initials"/>
            </xpath>
            <!-- Employees without a photo get their initials on a coloured tile. -->
            <xpath expr="//aside/div[hasclass('bg-100')]" position="replace">
                <div class="o_personnel_initials d-flex align-items-center justify-content-center"
                     t-attf-data-color="{{ record.id.raw_value % 8 }}">
                    <span t-esc="record.personnel_initials.value"/>
                </div>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='contract_date_start']" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </xpath>
            <xpath expr="//t[@t-name='card']//field[@name='contract_date_end']" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- ── Search ─────────────────────────────────────────────────────── -->
    <record id="personnel_employee_view_search" model="ir.ui.view">
        <field name="name">hr.employee.search.personnel</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_filter"/>
        <field name="mode">primary</field>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <filter name="group_job" position="after">
                <filter name="group_company" string="Company" domain="[]" context="{'group_by': 'company_id'}"
                        groups="base.group_multi_company"/>
            </filter>
        </field>
    </record>

    <!-- ── Actions ────────────────────────────────────────────────────── -->
    <record id="action_personnel_employee" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="path">personnel</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form,activity,graph,pivot</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids)]</field>
        <field name="context">{'personnel_app': True, 'chat_icon': True, 'searchpanel_default_company_id': allowed_company_ids[0]}</field>
        <field name="search_view_id" ref="personnel_employee_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'sequence': 10, 'view_id': ref('personnel_employee_view_kanban')}),
            (0, 0, {'view_mode': 'list', 'sequence': 15, 'view_id': ref('personnel_employee_view_list')}),
            (0, 0, {'view_mode': 'form', 'sequence': 20, 'view_id': ref('personnel_employee_view_form')}),
            (0, 0, {'view_mode': 'activity', 'sequence': 25, 'view_id': ref('hr.hr_employee_view_activity')}),
            (0, 0, {'view_mode': 'graph', 'sequence': 30, 'view_id': ref('hr.hr_employee_view_graph')}),
            (0, 0, {'view_mode': 'pivot', 'sequence': 35, 'view_id': ref('hr.hr_employee_view_pivot')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first employee</p>
            <p>Keep everyone's work details, contracts, documents and badges in one place.</p>
        </field>
    </record>

    <record id="action_personnel_employee_activities" model="ir.actions.act_window">
        <field name="name">Employee Activities</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">activity,list,kanban,form</field>
        <field name="domain">[('company_id', 'in', allowed_company_ids), ('activity_ids', '!=', False)]</field>
        <field name="context">{'personnel_app': True, 'chat_icon': True}</field>
        <field name="search_view_id" ref="personnel_employee_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'activity', 'sequence': 10, 'view_id': ref('hr.hr_employee_view_activity')}),
            (0, 0, {'view_mode': 'list', 'sequence': 15, 'view_id': ref('personnel_employee_view_list_activities')}),
            (0, 0, {'view_mode': 'kanban', 'sequence': 20, 'view_id': ref('personnel_employee_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'sequence': 25, 'view_id': ref('personnel_employee_view_form')})]"/>
    </record>

    <!-- ── Versions (the employee's Versions button) ──────────────────── -->
    <record id="personnel_version_view_list" model="ir.ui.view">
        <field name="name">hr.version.list.personnel</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_version_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[1]" position="before">
                <field name="id" optional="show"/>
            </xpath>
            <field name="date_version" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="contract_date_start" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="contract_date_end" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="create_date" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <field name="last_modified_date" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </field>
            <xpath expr="//field[@name='company_id'][@groups='base.group_multi_company']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>
</odoo>
