<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions). Every permission is its own
         privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Personnel user group, which
         holds the ACLs and a deny rule per operation, so users can only do what
         a permission opens. Employee versions (hr.version) follow their
         employee. "Own" employees are the ones they created or that are theirs
         (user_id); "Own" departments the ones they created or manage.

         Odoo only lets its HR Officers (hr.group_hr_user) manage employees, so
         every Employees permission includes that group, and these rules decide
         which employees (private details included). Outside them, users still
         see everyone's public profile, as in Odoo (models/hr_employee.py), and
         every department's name outside Personnel (models/ir_rule.py). Bank
         accounts of employees follow the same permissions. -->
    <data noupdate="1">
        <record id="module_category_personnel" model="ir.module.category">
            <field name="name">Personnel</field>
            <field name="description">Employees, departments, ID badges and the audit trail.</field>
            <field name="sequence">9</field>
        </record>
    </data>

    <record id="group_personnel_user" model="res.groups">
        <field name="name">Personnel: User</field>
        <field name="comment">Technical: given by every Personnel permission. Opens the app; what users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

