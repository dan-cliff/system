<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_embroidery_bridge_token_wizard_form" model="ir.ui.view">
        <field name="name">embroidery.bridge.token.wizard.form</field>
        <field name="model">embroidery.bridge.token.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert">
                    Copy this now: the token is only shown once.
                </div>
                <p>
                    On the Raspberry Pi (connected to the internet and to the machines' network),
                    open a terminal and run this command. It installs the bridge as a service that
                    starts whenever the Pi is switched on. Running it again on a Pi that already has
                    the bridge replaces its token.
                </p>
                <field name="install_command" widget="CopyClipboardChar" class="font-monospace"/>
                <group string="Setting it up by hand">
                    <field name="bridge_id"/>
                    <field name="odoo_url" widget="CopyClipboardChar"/>
                    <field name="token" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button string="Done" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
