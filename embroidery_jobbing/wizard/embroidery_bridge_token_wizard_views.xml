<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_embroidery_bridge_token_wizard_form" model="ir.ui.view">
        <field name="name">embroidery.bridge.token.wizard.form</field>
        <field name="model">embroidery.bridge.token.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert">
                    Copy the token now: it is only shown once. Put it and the Odoo address in the
                    bridge's <code>config.json</code>, then restart the bridge.
                </div>
                <group>
                    <field name="bridge_id"/>
                    <field name="odoo_url" widget="CopyClipboardChar"/>
                    <field name="token" widget="CopyClipboardChar"/>
                </group>
                <footer>
                    <button string="Done" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
