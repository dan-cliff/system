<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_embroidery_design_kanban" model="ir.ui.view">
        <field name="name">embroidery.design.kanban</field>
        <field name="model">embroidery.design</field>
        <field name="arch" type="xml">
            <kanban>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="o_kanban_aside_full">
                            <field name="image_128" widget="image" options="{'img_class': 'object-fit-contain'}"/>
                        </aside>
                        <main class="ms-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="partner_id" class="text-muted"/>
                            <div class="small">
                                <field name="stitch_count"/> stitches · <field name="color_count"/> colours
                            </div>
                            <field name="size_display" class="small text-muted"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_embroidery_design_list" model="ir.ui.view">
        <field name="name">embroidery.design.list</field>
        <field name="model">embroidery.design</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="design_filename" optional="hide"/>
                <field name="artwork_filename" optional="hide"/>
                <field name="stitch_count" sum="Total"/>
                <field name="color_count"/>
                <field name="size_display"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_embroidery_design_form" model="ir.ui.view">
        <field name="name">embroidery.design.form</field>
        <field name="model">embroidery.design</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_digitise" type="object" string="Digitise Again" class="btn-secondary"
                            invisible="not artwork_file"
                            help="Digitise the artwork again, e.g. after adding or changing thread products."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object" class="oe_stat_button" icon="fa-tasks">
                            <field name="job_count" widget="statinfo" string="Jobs"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" readonly="1"
                           options="{'preview_image': 'image_256'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Club logo - left chest"/></h1>
                    </div>
                    <group>
                        <group string="Design">
                            <field name="artwork_file" filename="artwork_filename"
                                   string="Artwork to Digitise"
                                   options="{'accepted_file_extensions': '.png,.jpg,.jpeg,.svg'}"/>
                            <field name="artwork_filename" invisible="1"/>
                            <field name="design_file" filename="design_filename"
                                   readonly="artwork_file" required="not artwork_file"
                                   options="{'accepted_file_extensions': '.pes'}"/>
                            <field name="design_filename" invisible="1"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="From the File" invisible="not stitch_count">
                            <field name="stitch_count"/>
                            <field name="color_count"/>
                            <field name="size_display"/>
                            <field name="trim_count"/>
                            <field name="jump_count"/>
                            <field name="pes_label"/>
                            <field name="pes_version"/>
                        </group>
                    </group>
                    <div class="alert alert-info mb-3" role="status" invisible="artwork_file or design_file">
                        Upload a Brother <strong>.pes</strong> design file, or a <strong>PNG, JPG or SVG</strong>
                        picture as the <strong>Artwork to Digitise</strong>: it is turned into stitches when you
                        save, with its colours matched to your thread products.
                    </div>
                    <notebook>
                        <page string="Thread Colours" name="colours">
                            <field name="color_ids">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="sequence"/>
                                    <field name="color_hex" widget="color" readonly="1"/>
                                    <field name="name"/>
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="artwork_color_hex" widget="color" readonly="1"
                                           column_invisible="not parent.artwork_file"/>
                                    <field name="color_difference" column_invisible="not parent.artwork_file"
                                           decoration-success="color_difference &lt; 5"
                                           decoration-warning="color_difference &gt;= 5 and color_difference &lt; 10"
                                           decoration-danger="color_difference &gt;= 10"/>
                                    <field name="palette_index" optional="hide"/>
                                    <field name="stitch_count" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Digitising" name="digitising" invisible="not artwork_file">
                            <div class="alert alert-warning mb-3" role="alert" invisible="thread_catalogue_count">
                                No thread products to match, so Brother's standard colours are used. Tick
                                <strong>Includes Threads</strong> on your thread product category, give each thread
                                a <strong>Thread Colour</strong> under <strong>Advanced Details</strong>, then click
                                <strong>Digitise Again</strong>.
                            </div>
                            <group>
                                <group string="Size and Colours">
                                    <field name="digitise_width_mm"/>
                                    <field name="digitise_height_mm"/>
                                    <field name="digitise_max_colors"/>
                                    <field name="digitise_min_area"/>
                                    <field name="digitise_remove_background"/>
                                </group>
                                <group string="Stitches">
                                    <field name="digitise_row_spacing"/>
                                    <field name="digitise_stitch_length"/>
                                    <field name="digitise_fill_angle"/>
                                    <field name="digitise_underlay"/>
                                </group>
                                <group string="Threads to Match">
                                    <field name="digitise_manufacturer_id" options="{'no_create': True}"/>
                                    <field name="digitise_thread_type_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                    <field name="thread_catalogue_count"/>
                                </group>
                            </group>
                            <p class="text-muted">
                                Changes are digitised again when you save. Text in an SVG must be converted to
                                outlines first. Areas are stitched as fills; check fine lines and small text in
                                the preview and tidy them in Embrilliance if needed.
                            </p>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_embroidery_design_search" model="ir.ui.view">
        <field name="name">embroidery.design.search</field>
        <field name="model">embroidery.design</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('design_filename', 'ilike', self), ('artwork_filename', 'ilike', self)]"/>
                <field name="partner_id"/>
                <filter string="Digitised from Artwork" name="digitised" domain="[('artwork_filename', '!=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_embroidery_design" model="ir.actions.act_window">
        <field name="name">Designs</field>
        <field name="res_model">embroidery.design</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Upload your first .pes design, or artwork to digitise</p>
            <p>The stitch count, thread colours, size and a stitch preview are read from the file.
               A PNG, JPG or SVG picture is digitised into stitches, with its colours matched to your
               thread products.</p>
        </field>
    </record>

</odoo>
