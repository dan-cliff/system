<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_embroidery_stitchout_list" model="ir.ui.view">
        <field name="name">embroidery.stitchout.list</field>
        <field name="model">embroidery.stitchout</field>
        <field name="arch" type="xml">
            <list create="0"
                  decoration-muted="state == 'cancelled'"
                  decoration-danger="state == 'error'">
                <field name="name"/>
                <field name="job_id"/>
                <field name="partner_id" optional="hide"/>
                <field name="machine_id"/>
                <field name="design_id" optional="show"/>
                <field name="piece_number" optional="hide"/>
                <field name="date_started" options="{'numeric': True}" optional="show"/>
                <field name="date_done" options="{'numeric': True}" optional="show"/>
                <field name="total_stitches" optional="hide"/>
                <field name="progress" widget="progressbar"/>
                <field name="error_count" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state in ('queued', 'sent', 'stitching')"
                       decoration-warning="state == 'paused'"
                       decoration-danger="state == 'error'"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_embroidery_stitchout_form" model="ir.ui.view">
        <field name="name">embroidery.stitchout.form</field>
        <field name="model">embroidery.stitchout</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_download_design" type="object" string="Download Design"
                            invisible="state not in ('queued', 'sent')"/>
                    <button name="action_operator_start" type="object" string="Start" class="btn-primary"
                            invisible="state not in ('sent', 'paused', 'error')"/>
                    <button name="action_operator_pause" type="object" string="Pause"
                            invisible="state != 'stitching'"/>
                    <button name="action_operator_error" type="object" string="Report a Problem"
                            invisible="state not in ('sent', 'stitching', 'paused', 'error')"/>
                    <button name="action_operator_done" type="object" string="Mark Done" class="btn-success"
                            invisible="state not in ('stitching', 'paused', 'error')"/>
                    <button name="action_operator_cancel" type="object" string="Cancel"
                            invisible="state not in ('queued', 'sent', 'stitching', 'paused', 'error')"
                            confirm="Cancel this stitch out?"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,sent,stitching,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="partner_id"/>
                            <field name="piece_number"/>
                            <field name="design_id"/>
                            <field name="machine_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_queued" options="{'numeric': True}"/>
                            <field name="date_sent" options="{'numeric': True}"/>
                            <field name="date_started" options="{'numeric': True}"/>
                            <field name="date_done" options="{'numeric': True}"/>
                            <field name="has_live_data"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Progress" name="progress">
                            <widget name="embroidery_progress"/>
                        </page>
                        <page string="Event Log" name="events">
                            <field name="event_ids">
                                <list decoration-danger="event_type == 'error'"
                                      decoration-success="event_type == 'done'">
                                    <field name="date" options="{'numeric': True}"/>
                                    <field name="event_type"/>
                                    <field name="code"/>
                                    <field name="message"/>
                                    <field name="stitch"/>
                                    <field name="user_id" widget="many2one_avatar_user"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_embroidery_stitchout_search" model="ir.ui.view">
        <field name="name">embroidery.stitchout.search</field>
        <field name="model">embroidery.stitchout</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="job_id"/>
                <field name="machine_id"/>
                <field name="design_id"/>
                <filter string="Open" name="open"
                        domain="[('state', 'in', ('queued', 'sent', 'stitching', 'paused', 'error'))]"/>
                <filter string="With Errors" name="with_errors" domain="[('error_count', '>', 0)]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Started" name="date_started" date="date_started"/>
                <group>
                    <filter string="Machine" name="group_machine" context="{'group_by': 'machine_id'}"/>
                    <filter string="Job" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_embroidery_stitchout" model="ir.actions.act_window">
        <field name="name">Stitch Outs</field>
        <field name="res_model">embroidery.stitchout</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No stitch outs yet</p>
            <p>A stitch out is created each time a job's design is sent to a machine.</p>
        </field>
    </record>

</odoo>
