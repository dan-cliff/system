<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_embroidery_thread_type_list" model="ir.ui.view">
        <field name="name">embroidery.thread.type.list</field>
        <field name="model">embroidery.thread.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="description" optional="show"/>
                <field name="product_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_embroidery_thread_type_form" model="ir.ui.view">
        <field name="name">embroidery.thread.type.form</field>
        <field name="model">embroidery.thread.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Polyester 40wt"/></h1>
                    </div>
                    <group>
                        <field name="description" placeholder="What the thread is made of and what it is used for"/>
                        <field name="product_count"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_embroidery_thread_type_search" model="ir.ui.view">
        <field name="name">embroidery.thread.type.search</field>
        <field name="model">embroidery.thread.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_embroidery_thread_type" model="ir.actions.act_window">
        <field name="name">Thread Types</field>
        <field name="res_model">embroidery.thread.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a thread type</p>
            <p>Thread types (Polyester, Rayon, Metallic, ...) are picked on thread products under
               Advanced Details, and digitised designs can be limited to them.</p>
        </field>
    </record>

</odoo>
