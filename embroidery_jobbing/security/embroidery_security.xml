<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Module Category ───────────────────────────────────────────── -->
        <record id="module_category_embroidery" model="ir.module.category">
            <field name="name">Embroidery</field>
            <field name="description">Embroidery jobs, designs and machines.</field>
            <field name="sequence">82</field>
        </record>

        <!-- ── Privilege ────────────────────────────────────────────────── -->
        <record id="privilege_embroidery" model="res.groups.privilege">
            <field name="name">Embroidery</field>
            <field name="category_id" ref="module_category_embroidery"/>
            <field name="sequence">10</field>
        </record>

        <!-- ── Security Groups ───────────────────────────────────────────── -->
        <record id="group_embroidery_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_embroidery"/>
            <field name="sequence">10</field>
            <field name="comment">Can create jobs and designs, send designs to the machines and report progress.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_embroidery_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_embroidery"/>
            <field name="sequence">20</field>
            <field name="comment">Full access, including machines, bridges and the Configuration lists.</field>
            <field name="implied_ids" eval="[(4, ref('group_embroidery_user'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <!-- ── Multi-company ────────────────────────────────────────────── -->
        <record id="embroidery_machine_company_rule" model="ir.rule">
            <field name="name">Embroidery Machines: multi-company</field>
            <field name="model_id" ref="model_embroidery_machine"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="embroidery_design_company_rule" model="ir.rule">
            <field name="name">Embroidery Designs: multi-company</field>
            <field name="model_id" ref="model_embroidery_design"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="embroidery_job_company_rule" model="ir.rule">
            <field name="name">Embroidery Jobs: multi-company</field>
            <field name="model_id" ref="model_embroidery_job"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="embroidery_stitchout_company_rule" model="ir.rule">
            <field name="name">Embroidery Stitch Outs: multi-company</field>
            <field name="model_id" ref="model_embroidery_stitchout"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
