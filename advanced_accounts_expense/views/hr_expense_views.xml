<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_expense_view_form" model="ir.ui.view">
        <field name="name">hr.expense.form.advanced_accounts</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">
            <field name="vendor_id" position="before">
                <field name="adv_account_id" string="Vendor Account" options="{'no_quick_create': True}"
                       invisible="payment_mode != 'company_account'" readonly="not is_editable"/>
                <field name="adv_contact_id" string="Vendor Contact" options="{'no_quick_create': True}"
                       context="{'default_account_id': adv_account_id}"
                       invisible="payment_mode != 'company_account'" readonly="not is_editable"/>
            </field>
            <field name="vendor_id" position="attributes">
                <attribute name="invisible">payment_mode != 'company_account' or adv_account_id or adv_contact_id or not vendor_id</attribute>
            </field>
        </field>
    </record>
</odoo>
