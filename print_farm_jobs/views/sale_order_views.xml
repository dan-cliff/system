<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add a smart button / Print Jobs count to sale order -->
    <record id="view_sale_order_print_farm_form" model="ir.ui.view">
        <field name="name">sale.order.print.farm.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_print_jobs" type="object"
                        class="oe_stat_button" icon="fa-print"
                        invisible="print_job_count == 0">
                    <field name="print_job_count" widget="statinfo" string="Print Jobs"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
