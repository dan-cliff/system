<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── Top-level App Menu ───────────────────────────────────────────── -->
    <menuitem id="menu_print_farm_root"
              name="Print Farm"
              web_icon="print_farm_jobs,static/description/icon.png"
              sequence="80"/>

    <!-- ─── Jobs ─────────────────────────────────────────────────────────── -->
    <menuitem id="menu_print_farm_jobs"
              name="Jobs"
              parent="menu_print_farm_root"
              sequence="10"/>

    <menuitem id="menu_print_job_list"
              name="Print Jobs"
              parent="menu_print_farm_jobs"
              action="action_print_job"
              sequence="10"
              groups="print_farm_jobs.group_print_farm_job_view"/>

    <!-- ─── Printers ─────────────────────────────────────────────────────── -->
    <menuitem id="menu_print_farm_printers"
              name="Printers"
              parent="menu_print_farm_root"
              sequence="20"/>

    <menuitem id="menu_print_printer_list"
              name="Printers"
              parent="menu_print_farm_printers"
              action="action_print_printer"
              sequence="10"
              groups="print_farm_jobs.group_print_farm_printer_view"/>

    <!-- ─── Inventory ─────────────────────────────────────────────────────── -->
    <menuitem id="menu_print_farm_inventory"
              name="Inventory"
              parent="menu_print_farm_root"
              sequence="30"/>

    <menuitem id="menu_print_spool_list"
              name="Spools"
              parent="menu_print_farm_inventory"
              action="action_print_filament_spool"
              sequence="10"
              groups="print_farm_jobs.group_print_farm_spool_view"/>

    <menuitem id="menu_print_restock_list"
              name="Restock Orders"
              parent="menu_print_farm_inventory"
              action="action_print_restock_order"
              sequence="20"
              groups="print_farm_jobs.group_print_farm_restock_view"/>

    <!-- ─── Settings (Administrator only) ───────────────────────────────── -->
    <menuitem id="menu_print_farm_settings"
              name="Settings"
              parent="menu_print_farm_root"
              sequence="90"/>

    <menuitem id="menu_print_filament_list"
              name="Filament Catalogue"
              parent="menu_print_farm_settings"
              action="action_print_filament"
              sequence="10"
              groups="print_farm_jobs.group_print_farm_filament_create,print_farm_jobs.group_print_farm_filament_update,print_farm_jobs.group_print_farm_filament_delete"/>

</odoo>
