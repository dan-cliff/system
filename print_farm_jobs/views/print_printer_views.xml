<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ─── List ─────────────────────────────────────────────────────────── -->
    <record id="view_print_printer_list" model="ir.ui.view">
        <field name="name">print.printer.list</field>
        <field name="model">print.printer</field>
        <field name="arch" type="xml">
            <list string="Printers" decoration-muted="not active"
                  decoration-success="state == 'idle'"
                  decoration-warning="state in ('paused', 'unknown')"
                  decoration-danger="state in ('error', 'offline')"
                  decoration-info="state == 'printing'">
                <field name="name"/>
                <field name="printer_model"/>
                <field name="location" optional="show"/>
                <field name="serial_number" optional="show"/>
                <field name="local_ip" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'idle'"
                       decoration-warning="state in ('paused', 'unknown')"
                       decoration-danger="state in ('error', 'offline')"
                       decoration-info="state == 'printing'"/>
                <field name="slot_count" string="Slots"/>
                <field name="queued_job_count" string="Queued"/>
                <field name="active" column_invisible="True"/>
                <button name="action_check_status" type="object"
                        string="Ping" icon="fa-wifi" class="btn-sm"/>
            </list>
        </field>
    </record>

    <!-- ─── Form ─────────────────────────────────────────────────────────── -->
    <record id="view_print_printer_form" model="ir.ui.view">
        <field name="name">print.printer.form</field>
        <field name="model">print.printer</field>
        <field name="arch" type="xml">
            <form string="Printer">
                <header>
                    <button name="action_check_status" type="object"
                            string="Check Status" class="btn-secondary"/>
                    <button name="action_view_jobs" type="object"
                            string="View Jobs" class="btn-secondary"/>
                    <button name="action_manage_files" type="object"
                            string="Manage Cached Files" class="btn-secondary"
                            invisible="not agent_url"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="idle,printing,offline"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_jobs" type="object"
                                class="oe_stat_button" icon="fa-print">
                            <field name="job_count" widget="statinfo" string="Total Jobs"/>
                        </button>
                        <button name="action_view_jobs" type="object"
                                class="oe_stat_button" icon="fa-clock-o">
                            <field name="queued_job_count" widget="statinfo" string="Queued"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Bambu X1C – Bay 1"/>
                        </h1>
                    </div>

                    <!-- Identity -->
                    <group>
                        <group string="Printer Details">
                            <field name="printer_model"/>
                            <field name="serial_number"/>
                            <field name="location"/>
                        </group>
                        <group string="Status">
                            <field name="state" widget="badge"
                                   decoration-success="state == 'idle'"
                                   decoration-warning="state in ('paused','unknown')"
                                   decoration-danger="state in ('error','offline')"
                                   decoration-info="state == 'printing'"/>
                            <field name="last_status_check"/>
                            <field name="current_job_id"/>
                        </group>
                    </group>

                    <!-- API Connection -->
                    <notebook>
                        <page string="Connection" name="connection">
                            <group string="Local LAN Settings">
                                <group>
                                    <field name="local_ip" placeholder="192.168.1.100"/>
                                    <field name="access_code"
                                           placeholder="8-digit code shown on printer screen"/>
                                </group>
                                <group>
                                    <field name="local_ftp_port"/>
                                    <field name="local_mqtt_port"/>
                                </group>
                            </group>
                            <div class="alert alert-info mt-2" role="alert">
                                <strong>Local LAN Mode</strong>: Enable LAN mode and
                                <strong>Developer Mode</strong> on the printer
                                (<em>Settings → Network → LAN Mode Liveview</em>, then
                                <em>Settings → General → Developer Mode</em>).
                                The access code is displayed on the printer touchscreen.
                                File upload uses FTPS (port 990) and print commands are
                                sent via MQTT (port 8883).
                            </div>

                            <group string="Print Farm Agent"
                                   help="Required when Odoo is hosted remotely (e.g. Odoo.sh) and cannot reach the printer directly.">
                                <field name="agent_url"
                                       placeholder="https://mypc.tailnet.ts.net"/>
                                <field name="agent_api_key" password="False"
                                       placeholder="Secret key set in AGENT_API_KEY on the agent machine"/>
                            </group>
                            <div class="alert alert-warning mt-2" role="alert"
                                 invisible="not agent_url">
                                <strong>Agent mode active.</strong>
                                Printer communication is routed via the Print Farm Agent at
                                <field name="agent_url" readonly="1" nolabel="1" class="fw-bold"/>.
                                Direct LAN fields (IP, ports) are still sent to the agent —
                                keep them correct.
                            </div>
                            <div class="alert alert-info mt-2" role="alert"
                                 invisible="agent_url">
                                Running Odoo on <strong>Odoo.sh</strong> or another cloud host?
                                Set up the <strong>Print Farm Agent</strong> on a local machine
                                and enter its Tailscale Funnel URL above.
                            </div>
                        </page>

                        <!-- Filament Slots -->
                        <page string="Filament Slots" name="filaments">
                            <div class="alert alert-info mb-3" role="alert">
                                Record which filament is loaded in each AMS slot (or direct spool).
                                Jobs requiring specific filaments will be automatically matched to
                                printers that have those filaments loaded.
                            </div>
                            <field name="filament_slot_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="ams_unit" string="AMS Unit"
                                           help="0 = direct spool, 1 = first AMS, 2 = second AMS, etc."/>
                                    <field name="slot_number" string="Slot"/>
                                    <field name="slot_label" string="Label" readonly="1"/>
                                    <field name="spool_id" string="Spool"
                                           options="{'no_create': False}"/>
                                    <field name="filament_id" string="Filament Type" readonly="1"/>
                                    <field name="color_hex" string="Colour" readonly="1"/>
                                    <field name="is_loaded" string="Loaded"/>
                                    <field name="remaining_weight_g" string="Remaining (g)"
                                           readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Notes -->
                        <page string="Notes" name="notes">
                            <field name="notes"
                                   placeholder="Maintenance notes, quirks, calibration info…"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ─── Kanban ────────────────────────────────────────────────────────── -->
    <record id="view_print_printer_kanban" model="ir.ui.view">
        <field name="name">print.printer.kanban</field>
        <field name="model">print.printer</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="printer_model"/>
                <field name="state"/>
                <field name="location"/>
                <field name="slot_count"/>
                <field name="queued_job_count"/>
                <field name="current_job_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong class="fs-5"><field name="name"/></strong>
                            <span t-attf-class="badge rounded-pill
                                #{record.state.raw_value == 'idle' ? 'text-bg-success' :
                                  record.state.raw_value == 'printing' ? 'text-bg-primary' :
                                  record.state.raw_value == 'offline' ? 'text-bg-danger' :
                                  'text-bg-warning'}">
                                <field name="state"/>
                            </span>
                        </div>
                        <div class="text-muted small mt-1">
                            <field name="printer_model"/>
                            <t t-if="record.location.value"> · <field name="location"/></t>
                        </div>
                        <div class="mt-2 d-flex gap-3">
                            <span><i class="fa fa-th-list me-1" title="Slots"/>
                                <field name="slot_count"/> slots</span>
                            <span><i class="fa fa-clock-o me-1" title="Queued jobs"/>
                                <field name="queued_job_count"/> queued</span>
                        </div>
                        <t t-if="record.current_job_id.value">
                            <div class="mt-1 text-info small">
                                <i class="fa fa-print me-1"/>Printing: <field name="current_job_id"/>
                            </div>
                        </t>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ─── Search ───────────────────────────────────────────────────────── -->
    <record id="view_print_printer_search" model="ir.ui.view">
        <field name="name">print.printer.search</field>
        <field name="model">print.printer</field>
        <field name="arch" type="xml">
            <search string="Printers">
                <field name="name"/>
                <field name="serial_number"/>
                <field name="location"/>
                <filter string="Idle" name="idle" domain="[('state','=','idle')]"/>
                <filter string="Printing" name="printing" domain="[('state','=','printing')]"/>
                <filter string="Offline" name="offline" domain="[('state','=','offline')]"/>
                <filter string="Archived" name="archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Group by Model" name="group_model"
                        context="{'group_by':'printer_model'}"/>
                <filter string="Group by Status" name="group_state"
                        context="{'group_by':'state'}"/>
                <filter string="Group by Location" name="group_location"
                        context="{'group_by':'location'}"/>
            </search>
        </field>
    </record>

    <!-- ─── Action ───────────────────────────────────────────────────────── -->
    <record id="action_print_printer" model="ir.actions.act_window">
        <field name="name">Printers</field>
        <field name="res_model">print.printer</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_print_printer_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first printer
            </p>
            <p>Register your 3D printers and configure their Bambu Labs API credentials.</p>
        </field>
    </record>

</odoo>
