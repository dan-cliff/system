<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_expense_view_form_payroll" model="ir.ui.view">
        <field name="name">advanced.expense.form.payroll</field>
        <field name="model">advanced.expense</field>
        <field name="inherit_id" ref="advanced_expenses.advanced_expense_view_form"/>
        <field name="arch" type="xml">
            <field name="paid_date" position="before">
                <field name="payslip_id" invisible="not payslip_id"/>
            </field>
            <button name="action_mark_paid" position="attributes">
                <attribute name="invisible">not can_pay or payslip_id</attribute>
            </button>
        </field>
    </record>
</odoo>
