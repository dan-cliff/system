<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Root menu ─────────────────────────────────────────────────────── -->
    <menuitem id="menu_meeting_management_root"
              name="Meetings"
              sequence="20"
              web_icon="meeting_management,static/description/icon.png"/>

    <!-- ── Meetings ──────────────────────────────────────────────────────── -->
    <menuitem id="menu_meeting_meetings"
              name="Meetings"
              parent="menu_meeting_management_root"
              sequence="10"/>

    <menuitem id="menu_meeting_all"
              name="All Meetings"
              parent="menu_meeting_meetings"
              action="action_meeting_meeting"
              sequence="10"
              groups="meeting_management.group_meeting_meeting_view"/>

    <!-- ── Configuration ─────────────────────────────────────────────────── -->
    <menuitem id="menu_meeting_config"
              name="Configuration"
              parent="menu_meeting_management_root"
              sequence="90"/>

    <menuitem id="menu_meeting_templates"
              name="Meeting Templates"
              parent="menu_meeting_config"
              action="action_meeting_template"
              sequence="10"
              groups="meeting_management.group_meeting_template_create,meeting_management.group_meeting_template_update,meeting_management.group_meeting_template_delete"/>

    <menuitem id="menu_meeting_notification_templates"
              name="Notification Templates"
              parent="menu_meeting_config"
              action="action_meeting_notification_template"
              sequence="20"
              groups="meeting_management.group_meeting_notification_template_create,meeting_management.group_meeting_notification_template_update,meeting_management.group_meeting_notification_template_delete"/>

    <menuitem id="menu_meeting_settings"
              name="Settings"
              parent="menu_meeting_config"
              action="action_res_config_settings"
              sequence="90"
              groups="base.group_system"/>
</odoo>
