<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- ── Module Category ───────────────────────────────────────────── -->
        <record id="module_category_meeting_management" model="ir.module.category">
            <field name="name">Meeting Management</field>
            <field name="description">Manage meetings, agendas, minutes and action items.</field>
            <field name="sequence">50</field>
        </record>

        <!-- ── Privilege ─────────────────────────────────────────────────── -->
        <record id="privilege_meeting_management" model="res.groups.privilege">
            <field name="name">Meeting Management</field>
            <field name="category_id" ref="module_category_meeting_management"/>
            <field name="sequence">10</field>
        </record>

        <!-- ── Security Groups ───────────────────────────────────────────── -->
        <record id="group_meeting_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_meeting_management"/>
            <field name="sequence">10</field>
            <field name="comment">Can create and manage meetings.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_meeting_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_meeting_management"/>
            <field name="sequence">20</field>
            <field name="comment">Full access including templates and notification settings.</field>
            <field name="implied_ids" eval="[(4, ref('group_meeting_user'))]"/>
        </record>
    </data>
</odoo>
