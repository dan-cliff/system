<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_workcenter_form_manufacturing" model="ir.ui.view">
        <field name="name">mrp.workcenter.form.advanced_manufacturing</field>
        <field name="model">mrp.workcenter</field>
        <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_terminal_events" type="object" class="oe_stat_button" icon="fa-tablet"
                        groups="mrp.group_mrp_manager">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="terminal_failed_count" nolabel="1"/></span>
                        <span class="o_stat_text">App Sync Issues</span>
                    </div>
                </button>
            </xpath>
            <!-- Product Capacities: a product (then optionally its variant) or a product category. -->
            <xpath expr="//field[@name='capacity_ids']/list/field[@name='product_id']" position="replace">
                <field name="product_tmpl_id" widget="stock.forced_placeholder" placeholder="All Products"
                       decoration-it="not product_tmpl_id" invisible="product_categ_id"
                       context="{'default_is_storable': True}" options="{'no_create': True}"/>
                <field name="product_id" groups="product.group_product_variant" optional="show"
                       placeholder="All Variants" options="{'no_create': True}"
                       domain="[('product_tmpl_id', '=', product_tmpl_id)]" readonly="not product_tmpl_id"
                       invisible="product_categ_id"/>
                <field name="product_categ_id" placeholder="Any Category" readonly="product_tmpl_id"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='capacity_ids']/list/field[@name='product_uom_id']" position="attributes">
                <attribute name="readonly">product_id or product_tmpl_id</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Work Centre App" name="terminal">
                    <div class="text-muted mb-3">
                        Open this link on the tablet or computer at the work centre and install it as an app.
                        Workers sign in with their ID badge or their name and PIN (choose how in Manufacturing's Settings),
                        then start, pause and finish this work centre's work orders. It keeps working offline and syncs
                        when the connection returns.
                    </div>
                    <group>
                        <group>
                            <field name="terminal_url" widget="CopyClipboardChar" readonly="1"/>
                            <field name="terminal_last_contact" options="{'numeric': True}"/>
                        </group>
                        <group>
                            <div class="d-flex gap-2" colspan="2">
                                <button name="action_open_terminal" type="object" string="Open Work Centre App"
                                        class="btn-primary" icon="fa-external-link" invisible="not id"/>
                                <button name="action_regenerate_terminal_url" type="object" string="New Link"
                                        class="btn-secondary" groups="mrp.group_mrp_manager" invisible="not id"
                                        confirm="Devices using the current link will stop working until they are set up with the new one. Carry on?"/>
                            </div>
                        </group>
                    </group>
                    <group>
                        <field name="terminal_employee_ids" widget="many2many_tags" options="{'no_create': True}"
                               placeholder="Every employee of the work centre's company and related companies"/>
                        <field name="terminal_message" placeholder="e.g. Wear safety glasses at all times."/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Work Centre App Log -->
    <record id="view_terminal_event_list" model="ir.ui.view">
        <field name="name">advanced.manufacturing.terminal.event.list</field>
        <field name="model">advanced.manufacturing.terminal.event</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="state == 'failed'">
                <field name="id" optional="show"/>
                <field name="event_time" options="{'numeric': True}"/>
                <field name="create_date" options="{'numeric': True}" optional="hide"/>
                <field name="workcenter_id"/>
                <field name="employee_id"/>
                <field name="action"/>
                <field name="production_id" optional="show"/>
                <field name="workorder_id" optional="show"/>
                <field name="offline" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'done'" decoration-danger="state == 'failed'"/>
                <field name="message" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_terminal_event_form" model="ir.ui.view">
        <field name="name">advanced.manufacturing.terminal.event.form</field>
        <field name="model">advanced.manufacturing.terminal.event</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="workcenter_id"/>
                            <field name="employee_id"/>
                            <field name="action"/>
                            <field name="state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="event_time" options="{'numeric': True}"/>
                            <field name="create_date" options="{'numeric': True}"/>
                            <field name="offline"/>
                            <field name="production_id"/>
                            <field name="workorder_id"/>
                        </group>
                    </group>
                    <field name="message"/>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_terminal_event_search" model="ir.ui.view">
        <field name="name">advanced.manufacturing.terminal.event.search</field>
        <field name="model">advanced.manufacturing.terminal.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="workcenter_id"/>
                <field name="employee_id"/>
                <field name="production_id"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="offline" string="Recorded Offline" domain="[('offline', '=', True)]"/>
                <separator/>
                <filter name="event_time" string="Recorded At" date="event_time"/>
                <group>
                    <filter name="group_workcenter" string="Work Centre" context="{'group_by': 'workcenter_id'}"/>
                    <filter name="group_employee" string="Worker" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_action" string="Action" context="{'group_by': 'action'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_terminal_event" model="ir.actions.act_window">
        <field name="name">Work Centre App Log</field>
        <field name="res_model">advanced.manufacturing.terminal.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">Nothing recorded on the Work Centre app yet</p>
            <p>Everything workers record on a work centre's app is listed here, including work recorded offline and synced later.</p>
        </field>
    </record>
</odoo>
