<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings > General Settings > Integrations is base_setup's
         <block name="integration">. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.nextcloud.folders</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='integration']" position="inside">
                <setting id="nextcloud_folders_setting" string="Nextcloud Folders"
                         help="Create a Nextcloud folder for records and open it from the record"
                         documentation="https://docs.nextcloud.com/server/latest/developer_manual/client_apis/WebDAV/basic.html">
                    <div class="content-group">
                        <div class="row mt8">
                            <label for="nextcloud_url" class="col-lg-4 o_light_label"/>
                            <field name="nextcloud_url" placeholder="e.g. https://cloud.mycompany.com"/>
                        </div>
                        <div class="row mt8">
                            <label for="nextcloud_username" class="col-lg-4 o_light_label"/>
                            <field name="nextcloud_username" placeholder="e.g. odoo"/>
                        </div>
                        <div class="row mt8">
                            <label for="nextcloud_app_password" class="col-lg-4 o_light_label"/>
                            <field name="nextcloud_app_password" password="True"/>
                        </div>
                        <div class="row mt8">
                            <label for="nextcloud_root_folder" class="col-lg-4 o_light_label"/>
                            <field name="nextcloud_root_folder" placeholder="e.g. Odoo"/>
                        </div>
                        <div class="mt8">
                            <button name="action_nextcloud_test" type="object" string="Test Connection"
                                    icon="fa-plug" class="btn-secondary"/>
                        </div>
                        <div class="mt8">
                            <button name="action_nextcloud_rules" type="object" icon="oi-arrow-right"
                                    class="btn-link" string="Folder Rules"/>
                            <field name="nextcloud_rule_count" class="oe_inline ms-1" readonly="1"/>
                        </div>
                        <div class="mt8">
                            <button name="action_nextcloud_folders" type="object" icon="oi-arrow-right"
                                    class="btn-link" string="Folders"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
