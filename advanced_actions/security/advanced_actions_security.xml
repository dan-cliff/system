<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every permission below is its
         own privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Actions user group, which holds
         the ACLs and a deny rule, so users can only do what a permission opens.
         "Own" = actions they created or are assigned to.

         Apps that keep their actions here (bridge modules such as
         advanced_actions_incident) add rules for their own groups that follow
         the app's record, so their users keep using actions from the app. -->
    <data noupdate="1">
        <record id="module_category_advanced_actions" model="ir.module.category">
            <field name="name">Actions</field>
            <field name="description">Actions raised in any app, assigned to users, with due dates and required checklists.</field>
            <field name="sequence">55</field>
        </record>
    </data>

    <record id="group_action_user" model="res.groups">
        <field name="name">Actions: User</field>
        <field name="comment">Technical: given by every Actions permission. Opens the app; what users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_action_create_only" model="res.groups.privilege">
        <field name="name">Actions: Create Only</field>
        <field name="category_id" ref="module_category_advanced_actions"/>
        <field name="sequence">20</field>
        <field name="description">Create actions, and view the ones they created or are assigned to (no editing after saving).</field>
    </record>
    <record id="group_action_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_action_create_only"/>
        <field name="comment">Create actions, and view the ones they created or are assigned to (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_action_user'))]"/>
    </record>

    <record id="privilege_action_edit_own" model="res.groups.privilege">
        <field name="name">Actions: Create and Edit Own</field>
        <field name="category_id" ref="module_category_advanced_actions"/>
        <field name="sequence">30</field>
        <field name="description">Create actions, and view and edit the ones they created or are assigned to.</field>
    </record>
    <record id="group_action_edit_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_action_edit_own"/>
        <field name="comment">Create actions, and view and edit the ones they created or are assigned to.</field>
        <field name="implied_ids" eval="[(4, ref('group_action_user'))]"/>
    </record>

    <record id="privilege_action_edit_team" model="res.groups.privilege">
        <field name="name">Actions: Create and Edit My Team</field>
        <field name="category_id" ref="module_category_advanced_actions"/>
        <field name="sequence">40</field>
        <field name="description">Create actions, and view and edit their own and their team&apos;s.</field>
    </record>
    <record id="group_action_edit_team" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_action_edit_team"/>
        <field name="comment">Create actions, and view and edit their own and their team&apos;s.</field>
        <field name="implied_ids" eval="[(4, ref('group_action_user'))]"/>
    </record>

    <record id="privilege_action_edit_all" model="res.groups.privilege">
        <field name="name">Actions: Create and Edit All</field>
        <field name="category_id" ref="module_category_advanced_actions"/>
        <field name="sequence">50</field>
        <field name="description">Create, view and edit every action.</field>
    </record>
    <record id="group_action_edit_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_action_edit_all"/>
        <field name="comment">Create, view and edit every action.</field>
        <field name="implied_ids" eval="[(4, ref('group_action_user'))]"/>
    </record>

    <record id="privilege_action_view_all" model="res.groups.privilege">
        <field name="name">Actions: View All</field>
        <field name="category_id" ref="module_category_advanced_actions"/>
        <field name="sequence">60</field>
        <field name="description">View every action.</field>
    </record>
    <record id="group_action_view_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_action_view_all"/>
        <field name="comment">View every action.</field>
        <field name="implied_ids" eval="[(4, ref('group_action_user'))]"/>
    </record>

    <record id="privilege_action_delete_own" model="res.groups.privilege">
        <field name="name">Actions: Delete Own</field>
        <field name="category_id" ref="module_category_advanced_actions"/>
        <field name="sequence">70</field>
        <field name="description">Delete the actions they created or are assigned to.</field>
    </record>
    <record id="group_action_delete_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_action_delete_own"/>
        <field name="comment">Delete the actions they created or are assigned to.</field>
        <field name="implied_ids" eval="[(4, ref('group_action_user'))]"/>
    </record>

    <record id="privilege_action_delete_all" model="res.groups.privilege">
        <field name="name">Actions: Delete All</field>
        <field name="category_id" ref="module_category_advanced_actions"/>
        <field name="sequence">80</field>
        <field name="description">Delete any action.</field>
    </record>
    <record id="group_action_delete_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_action_delete_all"/>
        <field name="comment">Delete any action.</field>
        <field name="implied_ids" eval="[(4, ref('group_action_user'))]"/>
    </record>

    <record id="privilege_advanced_actions" model="res.groups.privilege">
        <field name="name">Actions</field>
        <field name="category_id" ref="module_category_advanced_actions"/>
        <field name="sequence">10</field>
        <field name="description">Configuration of the Actions app.</field>
    </record>
    <record id="group_action_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_advanced_actions"/>
        <field name="comment">Every Actions permission, including deleting any action, plus Configuration.</field>
        <field name="implied_ids" eval="[(4, ref('group_action_create_only')), (4, ref('group_action_edit_own')), (4, ref('group_action_edit_team')), (4, ref('group_action_edit_all')), (4, ref('group_action_view_all')), (4, ref('group_action_delete_own')), (4, ref('group_action_delete_all'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Without a permission, nothing. Also on every internal user: apps'
         groups get the ACL on actions too, and a user with no rule of their
         own would otherwise see every action. -->
    <record id="rule_advanced_action_deny" model="ir.rule">
        <field name="name">Actions: only through a permission</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('group_action_user')), (4, ref('base.group_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <!-- Whoever an action is assigned to can always see and work on it. -->
    <record id="rule_advanced_action_assigned" model="ir.rule">
        <field name="name">Actions: assigned to them</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_ids', 'in', [user.id])]</field>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_advanced_action_create_only" model="ir.rule">
        <field name="name">Actions: Create Only</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('group_action_create_only'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_advanced_action_edit_own" model="ir.rule">
        <field name="name">Actions: Create and Edit Own</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('group_action_edit_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_ids', 'in', [user.id])]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_advanced_action_edit_team" model="ir.rule">
        <field name="name">Actions: Create and Edit My Team</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('group_action_edit_team'))]"/>
        <field name="domain_force">['|', '|', '|', ('create_uid', '=', user.id), ('user_ids', 'in', [user.id]), ('create_uid.employee_ids', 'child_of', user.employee_ids.ids), ('user_ids.employee_ids', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_advanced_action_edit_all" model="ir.rule">
        <field name="name">Actions: Create and Edit All</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('group_action_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_advanced_action_view_all" model="ir.rule">
        <field name="name">Actions: View All</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('group_action_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_advanced_action_delete_own" model="ir.rule">
        <field name="name">Actions: Delete Own</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('group_action_delete_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_advanced_action_delete_all" model="ir.rule">
        <field name="name">Actions: Delete All</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('group_action_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

    <!-- Checklists: actions raised from a checklist follow it. Users keep
         full use of those from templates in no Checklist Group; each Checklist
         Group's permissions add their own rules (checklist_group_access.py). -->
    <record id="rule_advanced_action_checklist_user" model="ir.rule">
        <field name="name">Actions: Checklists users, checklists in no Checklist Group</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('checklists.group_checklist_user'))]"/>
        <field name="domain_force">[('source_app', '=', 'checklists'), '|', ('source_checklist_id', '=', False), ('source_checklist_id.group_ids', '=', False)]</field>
    </record>
    <record id="rule_advanced_action_checklist_admin" model="ir.rule">
        <field name="name">Actions: Checklists Administrators, all checklist actions</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="groups" eval="[(4, ref('checklists.group_checklist_admin'))]"/>
        <field name="domain_force">[('source_app', '=', 'checklists')]</field>
    </record>

    <!-- Multi-company -->
    <record id="rule_advanced_action_company" model="ir.rule">
        <field name="name">Actions: multi-company</field>
        <field name="model_id" ref="model_advanced_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
