<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_action_tag_list" model="ir.ui.view">
        <field name="name">advanced.action.tag.list</field>
        <field name="model">advanced.action.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_advanced_action_tag_form" model="ir.ui.view">
        <field name="name">advanced.action.tag.form</field>
        <field name="model">advanced.action.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_advanced_action_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">advanced.action.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
</odoo>
