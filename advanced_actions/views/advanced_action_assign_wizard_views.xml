<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_action_assign_wizard_form" model="ir.ui.view">
        <field name="name">advanced.action.assign.wizard.form</field>
        <field name="model">advanced.action.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Create an Action for Each User">
                <div class="alert alert-info" role="alert">
                    Each user below gets their own action (and completes their own copy of the
                    required checklist). To give one action to several users, any of whom can
                    complete it, use Assigned To on the action instead.
                </div>
                <group>
                    <group>
                        <field name="origin_id" invisible="not origin_id"/>
                        <field name="user_ids" widget="many2many_avatar_user"/>
                        <field name="name"/>
                        <field name="date_deadline" options="{'numeric': True}"/>
                    </group>
                    <group>
                        <field name="priority" widget="priority"/>
                        <field name="checklist_template_id"/>
                        <field name="tag_ids" widget="many2many_tags"
                               options="{'color_field': 'color', 'no_create_edit': True}"/>
                    </group>
                </group>
                <field name="description" placeholder="What needs to be done, and how…"/>
                <footer>
                    <button name="action_create" type="object" string="Create Actions" class="btn-primary"/>
                    <button special="cancel" string="Discard"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_advanced_action_assign_wizard" model="ir.actions.act_window">
        <field name="name">Create an Action for Each User</field>
        <field name="res_model">advanced.action.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
