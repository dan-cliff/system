<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="print3d_estimate_company_rule" model="ir.rule">
            <field name="name">3D Print Estimate: multi-company</field>
            <field name="model_id" ref="model_print3d_estimate"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="print3d_estimate_filament_company_rule" model="ir.rule">
            <field name="name">3D Print Estimate Filament: multi-company</field>
            <field name="model_id" ref="model_print3d_estimate_filament"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="print3d_pricing_profile_company_rule" model="ir.rule">
            <field name="name">3D Print Pricing Profile: multi-company</field>
            <field name="model_id" ref="model_print3d_pricing_profile"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
