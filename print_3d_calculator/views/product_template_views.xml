<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_print3d" model="ir.ui.view">
        <field name="name">product.template.form.print3d</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="3D Printing" name="print3d">
                    <group>
                        <group string="Dynamic Pricing">
                            <field name="print3d_dynamic_pricing"/>
                            <field name="print3d_profile_id"/>
                            <div colspan="2" class="text-muted" invisible="not print3d_dynamic_pricing">
                                Customers upload their own file on the website to get a
                                price, and sales lines with a 3D print estimate are priced
                                from it.
                            </div>
                        </group>
                        <group string="Print File">
                            <field name="print3d_file" filename="print3d_filename" widget="binary"/>
                            <field name="print3d_filename" invisible="1"/>
                            <field name="print3d_estimate_id" invisible="not print3d_estimate_id"/>
                            <field name="print3d_state" invisible="not print3d_estimate_id"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="print3d_state != 'error'">
                        <field name="print3d_error" nolabel="1"/>
                    </div>
                    <group string="Print Summary" invisible="print3d_state != 'done'">
                        <group>
                            <field name="print3d_slicer"/>
                            <field name="print3d_filament_count" string="Filaments Required"/>
                            <field name="print3d_total_filament_g" string="Total Filament (g)"/>
                            <field name="print3d_print_time"/>
                        </group>
                        <group>
                            <field name="print3d_currency_id" invisible="1"/>
                            <field name="print3d_cost_total"/>
                            <field name="print3d_price"/>
                            <div colspan="2" class="d-flex gap-2">
                                <button name="action_print3d_set_cost" type="object" string="Use as Product Cost"
                                        class="btn-secondary"/>
                                <button name="action_print3d_set_price" type="object" string="Use as Sales Price"
                                        class="btn-secondary"/>
                                <button name="action_print3d_open_estimate" type="object" string="Open Estimate"
                                        class="btn-link"/>
                            </div>
                        </group>
                    </group>
                    <field name="print3d_line_ids" invisible="print3d_state != 'done'" readonly="1">
                        <list>
                            <field name="slot"/>
                            <field name="colour" widget="color"/>
                            <field name="slicer_material"/>
                            <field name="material_id"/>
                            <field name="length_m" sum="Total"/>
                            <field name="weight_g" sum="Total"/>
                            <field name="cost" sum="Total"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_print3d" model="ir.ui.view">
        <field name="name">product.template.search.print3d</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_to_sell']" position="after">
                <filter string="3D Print Dynamic Pricing" name="print3d_dynamic_pricing"
                        domain="[('print3d_dynamic_pricing', '=', True)]"/>
            </xpath>
        </field>
    </record>

</odoo>
