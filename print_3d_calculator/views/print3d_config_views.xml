<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Materials ─────────────────────────────────────────────────────── -->
    <record id="print3d_material_view_list" model="ir.ui.view">
        <field name="name">print3d.material.list</field>
        <field name="model">print3d.material</field>
        <field name="arch" type="xml">
            <list string="3D Print Materials">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="slicer_names" optional="show"/>
                <field name="colour" widget="color" optional="hide"/>
                <field name="density"/>
                <field name="filament_product_id" optional="show"/>
                <field name="cost_per_kg"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="website_published" optional="show"/>
            </list>
        </field>
    </record>

    <record id="print3d_material_view_form" model="ir.ui.view">
        <field name="name">print3d.material.form</field>
        <field name="model">print3d.material</field>
        <field name="arch" type="xml">
            <form string="3D Print Material">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. PLA"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="slicer_names" placeholder="e.g. PLA, PLA+, PLA Basic"/>
                            <field name="density"/>
                            <field name="colour" widget="color"/>
                            <field name="website_published"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Cost">
                            <field name="filament_product_id"/>
                            <field name="spool_weight_kg" invisible="not filament_product_id"/>
                            <field name="cost_per_kg"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Shown to customers on the website quote…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="print3d_material_view_search" model="ir.ui.view">
        <field name="name">print3d.material.search</field>
        <field name="model">print3d.material</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="slicer_names"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_print3d_material" model="ir.actions.act_window">
        <field name="name">3D Print Materials</field>
        <field name="res_model">print3d.material</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Pricing profiles ──────────────────────────────────────────────── -->
    <record id="print3d_pricing_profile_view_list" model="ir.ui.view">
        <field name="name">print3d.pricing.profile.list</field>
        <field name="model">print3d.pricing.profile</field>
        <field name="arch" type="xml">
            <list string="3D Print Pricing Profiles">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="machine_rate_per_hour"/>
                <field name="setup_fee"/>
                <field name="markup_percent"/>
                <field name="minimum_price"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="print3d_pricing_profile_view_form" model="ir.ui.view">
        <field name="name">print3d.pricing.profile.form</field>
        <field name="model">print3d.pricing.profile</field>
        <field name="arch" type="xml">
            <form string="3D Print Pricing Profile">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Standard"/></h1>
                    </div>
                    <group>
                        <group string="Costs">
                            <field name="default_material_id"/>
                            <field name="machine_rate_per_hour"/>
                            <field name="setup_fee"/>
                            <field name="extra_filament_fee"/>
                            <field name="waste_percent"/>
                        </group>
                        <group string="Price">
                            <field name="markup_percent"/>
                            <field name="minimum_price"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Unsliced Models (STL, OBJ, AMF, 3MF)">
                        <p class="text-muted" colspan="2">
                            Files that have not been sliced carry no filament or time
                            figures, so they are estimated from the model's volume and
                            surface with these settings.
                        </p>
                        <group>
                            <field name="infill_percent"/>
                            <field name="use_project_settings"/>
                            <field name="wall_thickness_mm"/>
                            <field name="support_percent"/>
                        </group>
                        <group>
                            <field name="volumetric_speed"/>
                            <field name="time_overhead_minutes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print3d_pricing_profile" model="ir.actions.act_window">
        <field name="name">3D Print Pricing Profiles</field>
        <field name="res_model">print3d.pricing.profile</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
