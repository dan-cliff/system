<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Sales orders ──────────────────────────────────────────────────── -->
    <record id="view_order_form_print3d" model="ir.ui.view">
        <field name="name">sale.order.form.print3d</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_print3d_estimates" type="object" class="oe_stat_button"
                        icon="fa-cube" invisible="print3d_estimate_count == 0">
                    <field name="print3d_estimate_count" widget="statinfo" string="3D Prints"/>
                </button>
            </div>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="print3d_dynamic_pricing" column_invisible="True"/>
                <field name="print3d_estimate_id" optional="show"
                       readonly="qty_invoiced &gt; 0"
                       options="{'no_create': True}"
                       context="{'default_product_id': product_id, 'default_partner_id': parent.partner_id}"/>
                <field name="print3d_filament_g" optional="hide"/>
                <field name="print3d_print_time" optional="hide"/>
            </xpath>
        </field>
    </record>

    <!-- ── Invoices ──────────────────────────────────────────────────────── -->
    <record id="view_move_form_print3d" model="ir.ui.view">
        <field name="name">account.move.form.print3d</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_print3d_estimates" type="object" class="oe_stat_button"
                        icon="fa-cube" invisible="print3d_estimate_count == 0">
                    <field name="print3d_estimate_count" widget="statinfo" string="3D Prints"/>
                </button>
            </div>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="before">
                <field name="print3d_estimate_id" optional="hide"/>
            </xpath>
            <xpath expr="//page[@id='invoice_tab']" position="after">
                <page id="print3d_tab" name="print3d_tab" string="3D Print Costings"
                      invisible="print3d_estimate_count == 0">
                    <field name="print3d_line_ids" readonly="1">
                        <list>
                            <field name="print3d_estimate_id"/>
                            <field name="product_id" optional="hide"/>
                            <field name="quantity"/>
                            <field name="print3d_filament_count"/>
                            <field name="print3d_filament_g"/>
                            <field name="print3d_print_time"/>
                            <field name="print3d_material_cost" optional="show"/>
                            <field name="print3d_machine_cost" optional="show"/>
                            <field name="print3d_setup_cost" optional="hide"/>
                            <field name="print3d_cost_total"/>
                            <field name="print3d_currency_id" column_invisible="True"/>
                            <field name="price_unit" string="Price per Print"/>
                            <field name="price_subtotal"/>
                            <field name="currency_id" column_invisible="True"/>
                        </list>
                    </field>
                    <group class="oe_subtotal_footer">
                        <field name="print3d_cost_total"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
