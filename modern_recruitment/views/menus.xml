<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Recruitment is called Talent. Recruitment's menus are reloaded when it
         upgrades, and this module (which depends on it) is upgraded with it,
         so the name comes back each time. -->
    <record id="hr_recruitment.menu_hr_recruitment_root" model="ir.ui.menu">
        <field name="name">Talent</field>
        <field name="web_icon">modern_recruitment,static/description/icon.png</field>
    </record>
    <!-- The Talent icon in the Apps list too. A function, as the module
         record is no-update data; Update Apps List restores Recruitment's
         icon and upgrading this module puts it back. -->
    <function model="ir.module.module" name="write"
              eval="[[ref('base.module_hr_recruitment')], {'icon': '/modern_recruitment/static/description/icon.png'}]"/>
    <record id="hr_recruitment.res_groups_privilege_recruitment" model="res.groups.privilege">
        <field name="name">Talent</field>
    </record>

    <!-- Configuration last; Reports (Report Builder's folder) directly before it. -->
    <record id="hr_recruitment.menu_hr_recruitment_configuration" model="ir.ui.menu">
        <field name="sequence">110</field>
    </record>
    <menuitem id="menu_talent_reports" name="Reports"
              parent="hr_recruitment.menu_hr_recruitment_root" sequence="105"/>

    <menuitem id="menu_talent_canned_responses"
              name="Canned Responses"
              parent="hr_recruitment.menu_hr_recruitment_configuration"
              action="action_talent_canned_response"
              sequence="25"/>
</odoo>
