<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.talent</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_recruitment.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_recruitment']" position="attributes">
                <attribute name="string">Talent</attribute>
                <attribute name="data-string">Talent</attribute>
            </xpath>
            <xpath expr="//block[@name='online_posting_setting_container']" position="after">
                <block title="Job Boards" name="talent_job_boards">
                    <setting id="talent_linkedin_setting" string="LinkedIn"
                             help="Publish job positions to LinkedIn through a job feed and share them from the job.">
                        <field name="module_modern_recruitment_linkedin"/>
                    </setting>
                    <setting id="talent_seek_setting" string="SEEK"
                             help="Post job ads to SEEK and receive SEEK applications as applicants.">
                        <field name="module_modern_recruitment_seek"/>
                    </setting>
                    <setting id="talent_jora_setting" string="Jora"
                             help="List job positions on Jora through a job feed.">
                        <field name="module_modern_recruitment_jora"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
