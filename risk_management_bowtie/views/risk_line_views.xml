<odoo>
    <!-- The Bowtie Analysis section on every Risk form, between its Description and Inherent Risk;
         "Fill Empty Fields by AI" also fills in empty Threats and Consequences. -->
    <record id="view_risk_assessment_line_form_bowtie" model="ir.ui.view">
        <field name="name">risk.assessment.line.form.bowtie</field>
        <field name="model">risk.assessment.line</field>
        <field name="inherit_id" ref="risk_management.view_risk_assessment_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inherent_consequence_id']/preceding-sibling::separator[1]" position="before">
                <separator string="Bowtie Analysis"/>
                <p class="text-muted">
                    On the bowtie diagram the Hazard above sits over the Risk, which is the Top Event: the
                    moment control over the Hazard is lost. List the Threats that could cause it, with the
                    Preventive Barriers that stop each one, and the Consequences that could follow, with the
                    Recovery Barriers that limit them.
                </p>
                <div class="mb-2">
                    <button name="action_open_bowtie" type="object" string="Generate Bowtie Diagram"
                            icon="fa-sitemap" class="btn-secondary"/>
                </div>
                <label for="bowtie_threat_ids" string="Threats"/>
                <field name="bowtie_threat_ids" nolabel="1">
                    <list>
                        <field name="id" readonly="1"/>
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="barrier_ids" widget="many2many_tags" string="Preventive Barriers"/>
                    </list>
                </field>
                <label for="bowtie_consequence_ids" string="Consequences"/>
                <field name="bowtie_consequence_ids" nolabel="1">
                    <list>
                        <field name="id" readonly="1"/>
                        <field name="sequence" widget="handle"/>
                        <field name="name"/>
                        <field name="consequence_id"/>
                        <field name="barrier_ids" widget="many2many_tags" string="Recovery Barriers"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>

