<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_jora" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.talent.jora</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="modern_recruitment.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='talent_jora_setting']" position="inside">
                <div class="content-group mt-2" invisible="not module_modern_recruitment_jora">
                    <div class="row">
                        <label for="jora_feed_url" class="col-lg-4 o_light_label"/>
                        <field name="jora_feed_url" class="col-lg-8" widget="CopyClipboardChar" readonly="1"/>
                    </div>
                    <button name="action_jora_new_feed_key" type="object" class="btn-link ps-0 mt-1"
                            icon="fa-refresh" string="New Feed Address"
                            confirm="The current feed address stops working: give Jora the new one. Continue?"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
