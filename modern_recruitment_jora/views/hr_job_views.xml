<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_job_view_form_jora" model="ir.ui.view">
        <field name="name">hr.job.form.jora</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='job_description_page']" position="after">
                <page string="Jora" name="talent_jora_page" groups="hr_recruitment.group_hr_recruitment_user">
                    <field name="website_published" invisible="1"/>
                    <group>
                        <group>
                            <field name="jora_listed"/>
                            <field name="jora_salary" placeholder="e.g. $80,000 – $95,000 per year"/>
                            <field name="jora_expiry_date" options="{'numeric': True}"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                Listed jobs go into the Jora job feed (Settings › Talent › Job Boards)
                                while they are published on the website. The job type comes from the
                                Employment Type.
                            </div>
                            <div class="alert alert-warning mb-0" role="alert" colspan="2"
                                 invisible="not jora_listed or website_published">
                                Publish the job position on the website for Jora to list it.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_job_view_search_jora" model="ir.ui.view">
        <field name="name">hr.job.search.jora</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.view_job_filter_recruitment"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_favorite_jobs']" position="after">
                <filter name="jora_listed" string="Listed on Jora" domain="[('jora_listed', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
