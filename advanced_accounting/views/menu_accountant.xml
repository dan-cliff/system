<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The menus of Accounting, arranged together. Loaded last: every menu it
         moves is defined in the file of its feature.

         Accounting
         ├── Dashboard / Customers / Vendors / Accounting / Review  (core)
         ├── Management   assets, budgets, recurring payments, period closings
         ├── Follow-ups
         ├── Reporting    (core, plus the PDF reports and analyses)
         ├── Reports      Report Builder's folder: only shows once it holds reports
         └── Configuration › Management  the option lists of the above

         Each Management menu shows to the users with a permission on its
         records (see security/advanced_accounting_security.xml). -->

    <menuitem id="account.menu_finance" name="Accounting"
              web_icon="advanced_accounting,static/description/icon.png"/>

    <!-- ============ Management ============ -->
    <menuitem id="menu_accounting_management"
              name="Management"
              parent="account.menu_finance"
              sequence="5"/>

    <record id="menu_action_account_asset_asset_form" model="ir.ui.menu">
        <field name="name">Assets</field>
        <field name="parent_id" ref="menu_accounting_management"/>
        <field name="sequence">10</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_asset_create_only'), ref('group_asset_edit_own'), ref('group_asset_edit_team'), ref('group_asset_edit_all'), ref('group_asset_view_all'), ref('group_asset_delete_own'), ref('group_asset_delete_all')])]"/>
    </record>
    <record id="menu_asset_depreciation_confirmation_wizard" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting_management"/>
        <field name="sequence">15</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_asset_post')])]"/>
    </record>
    <record id="menu_act_crossovered_budget_view" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting_management"/>
        <field name="sequence">20</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_budget_create_only'), ref('group_budget_edit_own'), ref('group_budget_edit_team'), ref('group_budget_edit_all'), ref('group_budget_view_all'), ref('group_budget_delete_own'), ref('group_budget_delete_all')])]"/>
    </record>
    <record id="menu_recurring_payment" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting_management"/>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_recurring_create_only'), ref('group_recurring_edit_own'), ref('group_recurring_edit_team'), ref('group_recurring_edit_all'), ref('group_recurring_view_all'), ref('group_recurring_delete_own'), ref('group_recurring_delete_all')])]"/>
    </record>
    <record id="menu_account_period_closing" model="ir.ui.menu">
        <field name="parent_id" ref="menu_accounting_management"/>
        <field name="sequence">40</field>
        <field name="group_ids" eval="[(6, 0, [ref('group_closing_create_only'), ref('group_closing_edit_own'), ref('group_closing_edit_team'), ref('group_closing_edit_all'), ref('group_closing_view_all'), ref('group_closing_delete_own'), ref('group_closing_delete_all')])]"/>
    </record>

    <!-- Accounting: the closing comes last, after the daily work -->
    <record id="account.account_closing_menu" model="ir.ui.menu">
        <field name="sequence">90</field>
    </record>

    <menuitem id="menu_finance_entries_accounting_journals" name="Journals"
              parent="account.menu_finance_entries" sequence="5">
        <menuitem id="menu_action_account_moves_journal_sales"
                  action="account.action_account_moves_journal_sales"
                  groups="account.group_account_readonly" sequence="1"/>
        <menuitem id="menu_action_account_moves_journal_purchase"
                  action="account.action_account_moves_journal_purchase"
                  groups="account.group_account_readonly" sequence="2"/>
        <menuitem id="menu_action_account_moves_journal_bank_cash"
                  action="account.action_account_moves_journal_bank_cash"
                  groups="account.group_account_readonly" sequence="3"/>
        <menuitem id="menu_action_account_moves_journal_misc"
                  action="account.action_account_moves_journal_misc"
                  groups="account.group_account_readonly" sequence="4"/>
    </menuitem>

    <record id="account.menu_action_account_moves_all" model="ir.ui.menu">
        <field name="group_ids" eval="[(5, 0, 0)]"/>
        <field name="sequence">2</field>
    </record>

    <!-- ============ Follow-ups ============ -->
    <record id="menu_finance_followup" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>

    <!-- ============ Reports (Report Builder) ============ -->
    <!-- No action, no groups: empty, and so hidden, until Report Builder saves a report in it -->
    <menuitem id="menu_accounting_reports"
              name="Reports"
              parent="account.menu_finance"
              sequence="30"/>

    <!-- ============ Configuration ============ -->
    <!-- the Accounting Administrators configure Accounting too -->
    <record id="account.menu_finance_configuration" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_accounting_admin'))]"/>
    </record>

    <!-- empty, and so not shown: kept for the modules that put their own menus in it -->
    <menuitem id="menu_account_templates"
              sequence="100"
              name="Templates"
              parent="account.menu_finance_configuration"
              groups="base.group_no_one"/>

    <!-- Configuration > Management: the option lists of the Management menu -->
    <menuitem id="menu_account_management_config"
              name="Management"
              parent="account.menu_finance_configuration"
              sequence="30"/>

    <record id="menu_action_account_asset_asset_list_normal_purchase" model="ir.ui.menu">
        <field name="parent_id" ref="menu_account_management_config"/>
        <field name="sequence">10</field>
    </record>
    <record id="menu_budget_post_form" model="ir.ui.menu">
        <field name="parent_id" ref="menu_account_management_config"/>
        <field name="sequence">20</field>
    </record>
    <record id="menu_recurring_template" model="ir.ui.menu">
        <field name="parent_id" ref="menu_account_management_config"/>
        <field name="sequence">30</field>
        <field name="group_ids" eval="[(5, 0, 0)]"/>
    </record>
    <record id="menu_account_period_closing_task" model="ir.ui.menu">
        <field name="parent_id" ref="menu_account_management_config"/>
        <field name="sequence">40</field>
        <field name="group_ids" eval="[(5, 0, 0)]"/>
    </record>
    <record id="menu_fiscal_year" model="ir.ui.menu">
        <field name="parent_id" ref="menu_account_management_config"/>
        <field name="sequence">50</field>
    </record>

    <!-- Configuration > Accounting: room between the standard settings for the ones of the apps -->
    <record id="account.menu_action_account_form" model="ir.ui.menu">
        <field name="sequence">10</field>
    </record>
    <record id="account.menu_action_tax_form" model="ir.ui.menu">
        <field name="sequence">20</field>
    </record>
    <record id="account.menu_action_account_journal_form" model="ir.ui.menu">
        <field name="sequence">30</field>
    </record>
    <record id="account.menu_action_currency_form" model="ir.ui.menu">
        <field name="sequence">40</field>
    </record>
    <record id="account.menu_action_account_fiscal_position_form" model="ir.ui.menu">
        <field name="sequence">50</field>
    </record>
    <record id="account.menu_action_account_journal_group_list" model="ir.ui.menu">
        <field name="sequence">80</field>
    </record>
    <record id="account.menu_action_tax_group" model="ir.ui.menu">
        <field name="sequence">90</field>
    </record>
    <record id="account.menu_action_rounding_form_view" model="ir.ui.menu">
        <field name="sequence">100</field>
    </record>

    <!-- Configuration > Invoicing: the payment settings first -->
    <record id="account.menu_action_incoterm_open" model="ir.ui.menu">
        <field name="sequence">50</field>
    </record>
    <record id="account.menu_product_product_categories" model="ir.ui.menu">
        <field name="sequence">60</field>
    </record>
</odoo>
