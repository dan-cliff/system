<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project actions follow the project's permissions (on the project, as for its
         tasks and phases) and the task permissions (on the task they are raised from).
         The Project user group holds the ACL; without one of these rules (or an Actions
         permission) nothing opens. Customers (portal) have no access at all. -->
    <record id="rule_advanced_action_project_create_only" model="ir.rule">
        <field name="name">Actions: Projects Create Only</field>
        <field name="model_id" ref="advanced_actions.model_advanced_action"/>
        <field name="groups" eval="[(4, ref('advanced_projects.group_advanced_project_create_only'))]"/>
        <field name="domain_force">[('project_id', '!=', False), '|', '|', ('project_id.create_uid', '=', user.id), ('project_id.user_id', '=', user.id), ('project_id.collaborator_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_advanced_action_project_task_create_only" model="ir.rule">
        <field name="name">Actions: Project Tasks Create Only</field>
        <field name="model_id" ref="advanced_actions.model_advanced_action"/>
        <field name="groups" eval="[(4, ref('advanced_projects.group_advanced_project_task_create_only'))]"/>
        <field name="domain_force">[('project_task_id', '!=', False), '|', ('project_task_id.create_uid', '=', user.id), ('project_task_id.user_ids', 'in', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
