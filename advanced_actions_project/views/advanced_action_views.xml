<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_action_form_project" model="ir.ui.view">
        <field name="name">advanced.action.form.project</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_checklist_id']" position="after">
                <field name="project_id" invisible="source_app != 'project'"
                       required="source_app == 'project'" options="{'no_create': True}"/>
                <field name="project_task_id" invisible="source_app != 'project'" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="view_advanced_action_search_project" model="ir.ui.view">
        <field name="name">advanced.action.search.project</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='checklist_template_id']" position="after">
                <field name="project_id"/>
                <field name="project_task_id"/>
            </xpath>
            <xpath expr="//filter[@name='app_checklists']" position="after">
                <filter name="app_project" string="Project" domain="[('source_app', '=', 'project')]"/>
            </xpath>
            <xpath expr="//filter[@name='group_app']" position="after">
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_advanced_action_list_project" model="ir.ui.view">
        <field name="name">advanced.action.list.project</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_id" optional="show" column_invisible="context.get('default_project_id')"/>
                <field name="project_task_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='source_app']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='source_display']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Project › Actions (and each project's or task's Actions): filtered to the
         Project app, filter removable. -->
    <record id="action_advanced_action_project" model="ir.actions.act_window">
        <field name="name">Actions</field>
        <field name="res_model">advanced.action</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_advanced_action_list_project')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'}),
            (0, 0, {'view_mode': 'activity'})]"/>
        <field name="context">{'search_default_app_project': 1, 'search_default_my_actions': 1, 'search_default_open': 1, 'default_source_app': 'project'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No project actions yet</p>
            <p>Raise actions from a project or one of its tasks (the Actions button). Remove the Project
               filter to see actions from every app.</p>
        </field>
    </record>

    <menuitem id="menu_advanced_projects_actions" name="Actions" parent="advanced_projects.menu_advanced_projects_root"
              action="action_advanced_action_project" sequence="30" groups="base.group_user"/>
</odoo>
