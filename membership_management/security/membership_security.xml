<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Privilege (under Sales section in Access Rights) ──────────── -->
        <record id="privilege_membership" model="res.groups.privilege">
            <field name="name">Memberships</field>
            <field name="category_id" ref="base.module_category_sales"/>
            <field name="sequence">30</field>
        </record>

        <!-- ── Security Groups ───────────────────────────────────────────── -->

        <!-- Employee: read-only access to membership information -->
        <record id="group_membership_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="privilege_membership"/>
            <field name="sequence">10</field>
            <field name="comment">Read-only access to membership information.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager: can create and manage memberships -->
        <record id="group_membership_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_membership"/>
            <field name="sequence">20</field>
            <field name="comment">Can create and manage memberships.</field>
            <field name="implied_ids" eval="[(4, ref('group_membership_employee'))]"/>
        </record>

        <!-- Memberships Manager: full CRUD on memberships and configuration -->
        <record id="group_membership_memberships_manager" model="res.groups">
            <field name="name">Memberships Manager</field>
            <field name="privilege_id" ref="privilege_membership"/>
            <field name="sequence">30</field>
            <field name="comment">Full management of memberships including configuration.</field>
            <field name="implied_ids" eval="[(4, ref('group_membership_manager'))]"/>
        </record>

        <!-- Administrator: full access including configuration -->
        <record id="group_membership_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_membership"/>
            <field name="sequence">40</field>
            <field name="comment">Full access including all configuration of the membership system.</field>
            <field name="implied_ids" eval="[(4, ref('group_membership_memberships_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

    </data>
</odoo>
