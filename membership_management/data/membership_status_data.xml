<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="membership_status_active" model="membership.status">
            <field name="name">Active</field>
            <field name="sequence">10</field>
            <field name="color">10</field>
            <field name="fold">False</field>
        </record>

        <record id="membership_status_pending" model="membership.status">
            <field name="name">Pending</field>
            <field name="sequence">20</field>
            <field name="color">4</field>
            <field name="fold">True</field>
        </record>

        <record id="membership_status_suspended" model="membership.status">
            <field name="name">Suspended</field>
            <field name="sequence">30</field>
            <field name="color">2</field>
            <field name="fold">True</field>
        </record>

        <record id="membership_status_expired" model="membership.status">
            <field name="name">Expired</field>
            <field name="sequence">40</field>
            <field name="color">1</field>
            <field name="fold">True</field>
        </record>

        <record id="membership_status_cancelled" model="membership.status">
            <field name="name">Cancelled</field>
            <field name="sequence">50</field>
            <field name="color">1</field>
            <field name="fold">True</field>
        </record>

    </data>

    <!-- Backfill QR images (runs outside noupdate) -->
    <data>
        <function model="membership.membership" name="_populate_qr_images"/>
    </data>

</odoo>
