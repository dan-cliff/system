<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="membership_email_wizard_form_view" model="ir.ui.view">
        <field name="name">membership.email.wizard.form</field>
        <field name="model">membership.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Email">
                <sheet>

                    <!-- Template selector at the top -->
                    <div class="alert alert-info mb-3" role="status"
                         invisible="template_id != False">
                        Optionally select an <strong>Email Template</strong> below to
                        auto-populate the subject and body, then customise as needed.
                    </div>
                    <group>
                        <field name="membership_id" invisible="1"/>
                        <field name="template_id"
                               string="Email Template"
                               options="{'no_quick_create': True}"
                               placeholder="Select a template to pre-fill this email…"/>
                    </group>

                    <hr/>

                    <!-- Recipient -->
                    <group string="Recipient" name="recipient">
                        <field name="partner_id"
                               string="To"
                               options="{'no_quick_create': True}"/>
                    </group>

                    <!-- Subject -->
                    <group string="Message" name="message_content">
                        <field name="subject" string="Subject" colspan="2"/>
                    </group>

                    <!-- Body -->
                    <field name="body_html" string="Body" nolabel="1"
                           style="min-height: 250px;"/>

                    <!-- Attachments -->
                    <notebook>
                        <page string="Attachments" name="attachments">
                            <group string="Attach PDF Reports" name="pdf_options">
                                <field name="include_membership_card_pdf"
                                       string="Membership Card PDF"/>
                            </group>
                            <group string="Additional Files" name="manual_attachments">
                                <field name="manual_attachment_ids"
                                       widget="many2many_binary"
                                       string="Upload Files"
                                       nolabel="1"
                                       colspan="2"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
                <footer>
                    <button string="Send Email"
                            name="action_send_email"
                            type="object"
                            class="btn-primary"/>
                    <button string="Discard"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
