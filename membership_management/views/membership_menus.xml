<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── App-level root menu ────────────────────────────────────────────── -->
    <menuitem id="menu_membership_root"
              name="Memberships"
              web_icon="membership_management,static/description/icon.png"
              sequence="50"/>

    <!-- ── Top-level menus under app ─────────────────────────────────────── -->
    <menuitem id="menu_membership_main"
              name="Memberships"
              parent="menu_membership_root"
              sequence="10"
              action="action_membership_list"
              groups="membership_management.group_membership_membership_view"/>

    <!-- ── Configuration submenu ─────────────────────────────────────────── -->
    <menuitem id="menu_membership_config"
              name="Configuration"
              parent="menu_membership_root"
              sequence="90"/>

    <menuitem id="menu_membership_status"
              name="Membership Statuses"
              parent="menu_membership_config"
              sequence="10"
              action="action_membership_status"
              groups="membership_management.group_membership_status_create,membership_management.group_membership_status_update,membership_management.group_membership_status_delete"/>

    <menuitem id="menu_membership_letter_templates"
              name="Letter Templates"
              parent="menu_membership_config"
              sequence="20"
              action="action_membership_letter_templates"
              groups="membership_management.group_membership_letter_template_create,membership_management.group_membership_letter_template_update,membership_management.group_membership_letter_template_delete"/>

    <menuitem id="menu_membership_email_templates"
              name="Email Templates"
              parent="menu_membership_config"
              sequence="30"
              action="action_membership_email_templates"
              groups="membership_management.group_membership_email_template_create,membership_management.group_membership_email_template_update,membership_management.group_membership_email_template_delete"/>

</odoo>
