<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="expense_category_meals" model="advanced.expense.category">
            <field name="name">Meals</field>
            <field name="sequence">10</field>
            <field name="receipt_required" eval="True"/>
            <field name="description">Meals while travelling or with clients. Note who attended.</field>
        </record>
        <record id="expense_category_travel" model="advanced.expense.category">
            <field name="name">Travel</field>
            <field name="sequence">20</field>
            <field name="receipt_required" eval="True"/>
            <field name="description">Flights, trains, taxis, rideshare, parking and tolls.</field>
        </record>
        <record id="expense_category_accommodation" model="advanced.expense.category">
            <field name="name">Accommodation</field>
            <field name="sequence">30</field>
            <field name="receipt_required" eval="True"/>
            <field name="description">Hotels and other overnight stays while travelling for work.</field>
        </record>
        <record id="expense_category_fuel" model="advanced.expense.category">
            <field name="name">Fuel</field>
            <field name="sequence">40</field>
            <field name="receipt_required" eval="True"/>
            <field name="description">Fuel for company vehicles or hire cars.</field>
        </record>
        <record id="expense_category_mileage" model="advanced.expense.category">
            <field name="name">Mileage</field>
            <field name="sequence">50</field>
            <field name="unit_name">km</field>
            <field name="receipt_required" eval="False"/>
            <field name="description">Kilometres driven in your own vehicle for work. Set the Unit Cost to your per-km rate so the total is worked out from the distance.</field>
        </record>
        <record id="expense_category_office" model="advanced.expense.category">
            <field name="name">Office Supplies</field>
            <field name="sequence">60</field>
            <field name="receipt_required" eval="True"/>
        </record>
        <record id="expense_category_phone" model="advanced.expense.category">
            <field name="name">Phone and Internet</field>
            <field name="sequence">70</field>
            <field name="receipt_required" eval="True"/>
        </record>
        <record id="expense_category_training" model="advanced.expense.category">
            <field name="name">Training</field>
            <field name="sequence">80</field>
            <field name="receipt_required" eval="True"/>
            <field name="description">Courses, conferences and books.</field>
        </record>
        <record id="expense_category_other" model="advanced.expense.category">
            <field name="name">Other</field>
            <field name="sequence">900</field>
            <field name="receipt_required" eval="True"/>
        </record>
    </data>
</odoo>
