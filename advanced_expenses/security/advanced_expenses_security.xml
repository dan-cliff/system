<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions). Every permission is its own
         privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Expenses user group, which
         holds the ACLs and a deny rule per operation, so users can only do what
         a permission opens. "Own" expenses are the ones they created or whose
         employee they are; "My Team" adds everyone under them in the org chart.
         Approve, Approve Any and Pay are workflow privileges: the actions check
         them and write with sudo(). -->
    <data noupdate="1">
        <record id="module_category_advanced_expenses" model="ir.module.category">
            <field name="name">Expenses</field>
            <field name="description">Employee expenses, approvals and reimbursement.</field>
            <field name="sequence">71</field>
        </record>
    </data>

    <record id="group_expenses_user" model="res.groups">
        <field name="name">Expenses: User</field>
        <field name="comment">Technical: given by every Expenses permission. Opens the app; what users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ══ Expenses ══ -->
    <record id="privilege_expense_create_only" model="res.groups.privilege">
        <field name="name">Expenses: Create Only</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">120</field>
        <field name="description">Create expenses, and view their own (no editing after saving).</field>
    </record>
    <record id="group_expense_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_create_only"/>
        <field name="comment">Create expenses, and view their own (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <record id="privilege_expense_edit_own" model="res.groups.privilege">
        <field name="name">Expenses: Create and Edit Own</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">130</field>
        <field name="description">Create expenses, and view and edit their own.</field>
    </record>
    <record id="group_expense_edit_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_edit_own"/>
        <field name="comment">Create expenses, and view and edit their own.</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <record id="privilege_expense_edit_team" model="res.groups.privilege">
        <field name="name">Expenses: Create and Edit My Team</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">140</field>
        <field name="description">Create expenses, and view and edit their own and their team&apos;s (everyone under them in the org chart).</field>
    </record>
    <record id="group_expense_edit_team" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_edit_team"/>
        <field name="comment">Create expenses, and view and edit their own and their team&apos;s (everyone under them in the org chart).</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <record id="privilege_expense_edit_all" model="res.groups.privilege">
        <field name="name">Expenses: Create and Edit All</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">150</field>
        <field name="description">Create, view and edit every expense.</field>
    </record>
    <record id="group_expense_edit_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_edit_all"/>
        <field name="comment">Create, view and edit every expense.</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <record id="privilege_expense_view_all" model="res.groups.privilege">
        <field name="name">Expenses: View All</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">160</field>
        <field name="description">View every expense.</field>
    </record>
    <record id="group_expense_view_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_view_all"/>
        <field name="comment">View every expense.</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <record id="privilege_expense_delete_own" model="res.groups.privilege">
        <field name="name">Expenses: Delete Own</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">170</field>
        <field name="description">Delete their own draft or refused expenses.</field>
    </record>
    <record id="group_expense_delete_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_delete_own"/>
        <field name="comment">Delete their own draft or refused expenses.</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <record id="privilege_expense_delete_all" model="res.groups.privilege">
        <field name="name">Expenses: Delete All</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">180</field>
        <field name="description">Delete any draft or refused expense.</field>
    </record>
    <record id="group_expense_delete_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_delete_all"/>
        <field name="comment">Delete any draft or refused expense.</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <!-- ══ Workflow privileges ══ -->
    <record id="privilege_expense_approve" model="res.groups.privilege">
        <field name="name">Expenses: Approve</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">190</field>
        <field name="description">Approve or refuse the expenses of the employees they are Expense Approver for, and of everyone under them in the org chart (never their own).</field>
    </record>
    <record id="group_expense_approve" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_approve"/>
        <field name="comment">Approve or refuse the expenses of the employees they are Expense Approver for, and of everyone under them in the org chart (never their own).</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <record id="privilege_expense_approve_any" model="res.groups.privilege">
        <field name="name">Expenses: Approve Any</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">200</field>
        <field name="description">Approve or refuse any submitted expense (never their own).</field>
    </record>
    <record id="group_expense_approve_any" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_approve_any"/>
        <field name="comment">Approve or refuse any submitted expense (never their own).</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>
    <record id="privilege_expense_pay" model="res.groups.privilege">
        <field name="name">Expenses: Pay</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">210</field>
        <field name="description">Mark approved expenses as paid (with Accounting: create their bills), and see every approved and paid expense.</field>
    </record>
    <record id="group_expense_pay" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_expense_pay"/>
        <field name="comment">Mark approved expenses as paid (with Accounting: create their bills), and see every approved and paid expense.</field>
        <field name="implied_ids" eval="[(4, ref('group_expenses_user'))]"/>
    </record>

    <!-- ══ Expenses Administrator ══ -->
    <record id="privilege_advanced_expenses" model="res.groups.privilege">
        <field name="name">Expenses</field>
        <field name="category_id" ref="module_category_advanced_expenses"/>
        <field name="sequence">10</field>
        <field name="description">Configuration of the Expenses app.</field>
    </record>
    <record id="group_expenses_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_advanced_expenses"/>
        <field name="comment">Every Expenses permission, including deleting any expense, approving any expense (their own too) and paying expenses, plus Configuration (Expense Categories, settings).</field>
        <field name="implied_ids" eval="[(4, ref('group_expense_create_only')), (4, ref('group_expense_edit_own')), (4, ref('group_expense_edit_team')), (4, ref('group_expense_edit_all')), (4, ref('group_expense_view_all')), (4, ref('group_expense_delete_own')), (4, ref('group_expense_delete_all')), (4, ref('group_expense_approve')), (4, ref('group_expense_approve_any')), (4, ref('group_expense_pay'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Expenses: without a permission, nothing -->
    <record id="rule_expense_deny" model="ir.rule">
        <field name="name">Expenses: only through a permission</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expenses_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <record id="rule_expense_create_only" model="ir.rule">
        <field name="name">Expenses: Create Only</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_create_only'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_expense_edit_own" model="ir.rule">
        <field name="name">Expenses: Create and Edit Own</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_edit_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_expense_edit_team" model="ir.rule">
        <field name="name">Expenses: Create and Edit My Team</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_edit_team'))]"/>
        <field name="domain_force">['|', '|', '|', ('create_uid', '=', user.id), ('employee_id.user_id', '=', user.id), ('create_uid.employee_ids', 'child_of', user.employee_ids.ids), ('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_expense_edit_all" model="ir.rule">
        <field name="name">Expenses: Create and Edit All</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_expense_view_all" model="ir.rule">
        <field name="name">Expenses: View All</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_expense_delete_own" model="ir.rule">
        <field name="name">Expenses: Delete Own</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_delete_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('employee_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_expense_delete_all" model="ir.rule">
        <field name="name">Expenses: Delete All</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_expense_approve" model="ir.rule">
        <field name="name">Expenses: Approve (read)</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_approve'))]"/>
        <field name="domain_force">['&amp;', ('state', '!=', 'draft'), '|', ('approver_user_id', '=', user.id), ('employee_id', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_expense_approve_any" model="ir.rule">
        <field name="name">Expenses: Approve Any (read)</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_approve_any'))]"/>
        <field name="domain_force">[('state', '!=', 'draft')]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_expense_pay" model="ir.rule">
        <field name="name">Expenses: Pay (read)</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="groups" eval="[(4, ref('group_expense_pay'))]"/>
        <field name="domain_force">[('state', 'not in', ('draft', 'submitted', 'refused'))]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Multi-company -->
    <record id="rule_expense_company" model="ir.rule">
        <field name="name">Expenses: multi-company</field>
        <field name="model_id" ref="model_advanced_expense"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_expense_category_company" model="ir.rule">
        <field name="name">Expense Categories: multi-company</field>
        <field name="model_id" ref="model_advanced_expense_category"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
