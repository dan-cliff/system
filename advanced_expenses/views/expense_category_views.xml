<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_expense_category_view_list" model="ir.ui.view">
        <field name="name">advanced.expense.category.list</field>
        <field name="model">advanced.expense.category</field>
        <field name="arch" type="xml">
            <list string="Expense Categories">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="cost" optional="show"/>
                <field name="unit_name" optional="show"/>
                <field name="receipt_required" optional="show"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="advanced_expense_category_view_form" model="ir.ui.view">
        <field name="name">advanced.expense.category.form</field>
        <field name="model">advanced.expense.category</field>
        <field name="arch" type="xml">
            <form string="Expense Category">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_expenses" type="object" class="oe_stat_button" icon="fa-money"
                                invisible="not id">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="expense_count"/></span>
                                <span class="o_stat_text">Expenses</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Meals"/></h1>
                    </div>
                    <group>
                        <group name="cost">
                            <field name="cost"/>
                            <field name="unit_name" placeholder="e.g. km"/>
                        </group>
                        <group name="rules">
                            <field name="receipt_required"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Guidelines shown on expenses in this category, e.g. what can be claimed..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="advanced_expense_category_view_search" model="ir.ui.view">
        <field name="name">advanced.expense.category.search</field>
        <field name="model">advanced.expense.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_expense_category" model="ir.actions.act_window">
        <field name="name">Expense Categories</field>
        <field name="res_model">advanced.expense.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an expense category</p>
            <p>Categories group expenses (Meals, Travel, Mileage, ...). Give one a Unit Cost to work the total out from a quantity, e.g. kilometres driven.</p>
        </field>
    </record>
</odoo>
