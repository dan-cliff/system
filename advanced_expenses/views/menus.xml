<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_expenses_root"
              name="Expenses"
              sequence="70"
              web_icon="advanced_expenses,static/description/icon.png"
              groups="advanced_expenses.group_expenses_user"/>

    <menuitem id="menu_expenses_my" name="My Expenses" parent="menu_expenses_root"
              action="action_expense_my" sequence="10"/>

    <menuitem id="menu_expenses_to_approve" name="To Approve" parent="menu_expenses_root"
              action="action_expense_to_approve" sequence="20"
              groups="advanced_expenses.group_expense_approve,advanced_expenses.group_expense_approve_any"/>

    <menuitem id="menu_expenses_to_pay" name="To Pay" parent="menu_expenses_root"
              action="action_expense_to_pay" sequence="30"
              groups="advanced_expenses.group_expense_pay"/>

    <menuitem id="menu_expenses_all" name="All Expenses" parent="menu_expenses_root"
              action="action_expense_all" sequence="40"
              groups="advanced_expenses.group_expense_edit_team,advanced_expenses.group_expense_edit_all,advanced_expenses.group_expense_view_all,advanced_expenses.group_expense_delete_all"/>

    <menuitem id="menu_expenses_reporting" name="Reporting" parent="menu_expenses_root" sequence="80"/>
    <menuitem id="menu_expenses_analysis" name="Expenses Analysis" parent="menu_expenses_reporting"
              action="action_expense_analysis" sequence="10"/>

    <!-- Where Report Builder saves this app's reports (CLAUDE.md > Reports menu).
         It has no action, so Odoo hides it until a report is placed under it. -->
    <menuitem id="menu_expenses_reports" name="Reports" parent="menu_expenses_root" sequence="90"/>

    <menuitem id="menu_expenses_config" name="Configuration" parent="menu_expenses_root" sequence="100"
              groups="advanced_expenses.group_expenses_admin"/>
    <menuitem id="menu_expenses_settings" name="Settings" parent="menu_expenses_config"
              action="advanced_expenses_config_settings_action" sequence="0" groups="base.group_system"/>
    <menuitem id="menu_expenses_categories" name="Expense Categories" parent="menu_expenses_config"
              action="action_expense_category" sequence="10"/>
</odoo>
