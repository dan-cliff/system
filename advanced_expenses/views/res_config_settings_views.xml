<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.advanced_expenses</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="71"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Expenses" id="advanced_expenses" string="Expenses"
                     name="advanced_expenses" groups="advanced_expenses.group_expenses_admin">
                    <block title="Approval" id="expenses_approval_block">
                        <setting id="expense_manager_approval" string="Manager Approval" company_dependent="1"
                                 help="Submitted expenses wait for the employee's Expense Approver (Personnel employee form), or else their manager. Users with Expenses: Approve Any can approve every expense. Off: submitting approves an expense straight away.">
                            <field name="expense_manager_approval"/>
                        </setting>
                        <setting id="expense_duplicate_warning" string="Warn About Duplicates" company_dependent="1"
                                 help="Flag expenses of the same employee with the same date and total.">
                            <field name="expense_duplicate_warning"/>
                        </setting>
                        <setting id="expense_categories" string="Expense Categories"
                                 help="What expenses are for, with unit costs (e.g. mileage), guidelines and whether a receipt is required.">
                            <div class="mt-2">
                                <button name="%(advanced_expenses.action_expense_category)d" type="action"
                                        string="Expense Categories" icon="oi-arrow-right" class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                    <block title="AI" id="expenses_ai_block">
                        <setting id="expenses_ai" string="Read Receipts with AI"
                                 help="Fill in an expense from the photo or PDF of its receipt: description, date, total, tax, currency, vendor and category.">
                            <field name="expenses_ai_available" invisible="1"/>
                            <div class="text-success mt-2" invisible="not expenses_ai_available">
                                <i class="fa fa-check me-1"/>On, using <field name="expenses_ai_provider" class="d-inline"/>.
                            </div>
                            <div class="text-muted mt-2" invisible="expenses_ai_available">
                                <i class="fa fa-info-circle me-1"/>Off: add a Claude AI (preferred) or Google Gemini API key in
                                Settings › General Settings › Integrations, or in the Odoo AI app settings, to switch it on.
                            </div>
                        </setting>
                    </block>
                    <block title="Integrations" id="expenses_integrations_block">
                        <field name="expenses_has_account" invisible="1"/>
                        <field name="expenses_has_sale" invisible="1"/>
                        <field name="expenses_has_project" invisible="1"/>
                        <field name="expenses_has_payroll" invisible="1"/>
                        <setting id="expenses_account" string="Accounting" invisible="not expenses_has_account"
                                 help="Expense accounts on categories, a bill for each approved expense (to the employee, or the vendor for company-paid expenses), and Paid once the bill is paid.">
                            <field name="module_advanced_expenses_account"/>
                        </setting>
                        <setting id="expenses_sale" string="Re-invoice to Customers" invisible="not expenses_has_sale"
                                 help="Link an expense to a customer's sales order: approving it adds it to the order to be invoiced.">
                            <field name="module_advanced_expenses_sale"/>
                        </setting>
                        <setting id="expenses_project" string="Projects" invisible="not expenses_has_project"
                                 help="Book expenses to a project, and see each project's expenses.">
                            <field name="module_advanced_expenses_project"/>
                        </setting>
                        <setting id="expenses_payroll" string="Reimburse through Payroll" invisible="not expenses_has_payroll"
                                 help="Approved expenses paid by employees are added to their next payslip as a reimbursement, and marked Paid when the pay run is paid.">
                            <field name="module_advanced_expenses_payroll"/>
                        </setting>
                        <setting id="expenses_no_integrations" string="Other Apps"
                                 help="Accounting, Sales, Project and Payroll integrations show here when those apps are installed. Vendor Accounts and Contacts are switched on in the Advanced Accounts settings.">
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="advanced_expenses_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'advanced_expenses', 'bin_size': False}</field>
    </record>
</odoo>
