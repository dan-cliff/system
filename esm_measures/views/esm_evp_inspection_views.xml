<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="esm_evp_inspection_view_list" model="ir.ui.view">
        <field name="name">esm.evp.inspection.list</field>
        <field name="model">esm.evp.inspection</field>
        <field name="arch" type="xml">
            <list string="Evacuation Plan Inspections">
                <field name="name"/>
                <field name="inspection_date" options="{'numeric': True}"/>
                <field name="template_id"/>
                <field name="inspector_id" widget="many2one_avatar_user"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'" decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="esm_evp_inspection_view_form" model="ir.ui.view">
        <field name="name">esm.evp.inspection.form</field>
        <field name="model">esm.evp.inspection</field>
        <field name="arch" type="xml">
            <form string="Evacuation Plan Inspection">
                <header>
                    <button name="action_complete" type="object" string="Mark Completed"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" type="object" string="Reset to In Progress"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group name="inspection">
                            <field name="template_id" readonly="state == 'done'"
                                   options="{'no_create': True}"/>
                        </group>
                        <group name="inspection_details">
                            <field name="inspection_date" options="{'numeric': True}"
                                   readonly="state == 'done'"/>
                            <field name="inspector_id" widget="many2one_avatar_user"
                                   readonly="state == 'done'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Checks" name="checks">
                            <field name="line_ids" widget="esm_inspection_checks" class="o_field_highlight"
                                   readonly="state == 'done'">
                                <!-- Rendered by the widget: question, description, then the answer
                                     (o_field_highlight here and on each answer keeps the answer lines visible). -->
                                <kanban limit="1000">
                                    <field name="sequence"/>
                                    <field name="question_id"/>
                                    <field name="question_type"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="value_text"/>
                                    <field name="value_text_area"/>
                                    <field name="value_number"/>
                                    <field name="value_integer"/>
                                    <field name="value_date" options="{'numeric': True}"/>
                                    <field name="value_datetime" options="{'numeric': True}"/>
                                    <field name="value_option_id" widget="selection_badge"
                                           domain="[('question_id', '=', question_id)]"
                                           options="{'no_create': True, 'no_open': True}"/>
                                    <templates>
                                        <t t-name="card">
                                            <field name="name"/>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Anything else found during the inspection..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="esm_evp_inspection_view_search" model="ir.ui.view">
        <field name="name">esm.evp.inspection.search</field>
        <field name="model">esm.evp.inspection</field>
        <field name="arch" type="xml">
            <search string="Evacuation Plan Inspections">
                <field name="name"/>
                <field name="template_id"/>
                <field name="inspector_id"/>
                <filter name="my_inspections" string="My Inspections" domain="[('inspector_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="In Progress" domain="[('state', '=', 'draft')]"/>
                <filter name="done" string="Completed" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="inspection_date" string="Inspection Date" date="inspection_date"/>
                <group>
                    <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                    <filter name="group_inspector" string="Inspector" context="{'group_by': 'inspector_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_esm_evp_inspection" model="ir.actions.act_window">
        <field name="name">Evacuation Plan Inspections</field>
        <field name="res_model">esm.evp.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record a Evacuation Plan Inspection</p>
            <p>Pick a template and work through its checks.</p>
        </field>
    </record>

</odoo>
