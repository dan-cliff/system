<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Question ─────────────────────────────────────────────────── -->
    <record id="esm_evp_question_view_form" model="ir.ui.view">
        <field name="name">esm.evp.question.form</field>
        <field name="model">esm.evp.question</field>
        <field name="arch" type="xml">
            <form string="Question">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="question_type"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe what the inspector should check..."/>
                    <separator string="Button Values" invisible="question_type != 'buttons'"/>
                    <field name="option_ids" invisible="question_type != 'buttons'">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="color" widget="color"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Template ─────────────────────────────────────────────────── -->
    <record id="esm_evp_template_view_list" model="ir.ui.view">
        <field name="name">esm.evp.template.list</field>
        <field name="model">esm.evp.template</field>
        <field name="arch" type="xml">
            <list string="Inspection Templates">
                <header>
                    <button name="%(esm_measures.action_esm_template_import_wizard)d" type="action"
                            string="Import JSON" display="always"
                            context="{'default_template_model': 'esm.evp.template'}"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="question_count"/>
            </list>
        </field>
    </record>

    <record id="esm_evp_template_view_form" model="ir.ui.view">
        <field name="name">esm.evp.template.form</field>
        <field name="model">esm.evp.template</field>
        <field name="arch" type="xml">
            <form string="Inspection Template">
                <header>
                    <button name="action_export_json" type="object" string="Export JSON"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Wall-Mounted Evacuation Diagram"/></h1>
                    </div>
                    <field name="active" invisible="1"/>
                    <field name="description" placeholder="What this template is used for..."/>
                    <notebook>
                        <page string="Questions" name="questions">
                            <field name="question_ids" context="{'default_template_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="description"/>
                                    <field name="question_type"/>
                                    <field name="option_ids" widget="many2many_tags"
                                           invisible="question_type != 'buttons'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="esm_evp_template_view_search" model="ir.ui.view">
        <field name="name">esm.evp.template.search</field>
        <field name="model">esm.evp.template</field>
        <field name="arch" type="xml">
            <search string="Inspection Templates">
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_esm_evp_template" model="ir.actions.act_window">
        <field name="name">Inspection Templates</field>
        <field name="res_model">esm.evp.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Evacuation Plan Inspection template</p>
            <p>Add the questions inspectors answer when checking a evacuation plan.</p>
        </field>
    </record>

</odoo>
