<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="kiosk_app" name="Attendance Kiosk">
        &lt;!DOCTYPE html&gt;
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
                <meta name="theme-color" content="#0f172a"/>
                <meta name="mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-capable" content="yes"/>
                <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent"/>
                <meta name="apple-mobile-web-app-title" t-att-content="kiosk.name"/>
                <meta name="robots" content="noindex, nofollow"/>
                <title t-out="kiosk.name + ' - Sign In'"/>
                <link rel="manifest" t-att-href="'/onsite/%s/manifest.webmanifest' % token"/>
                <link rel="icon" type="image/png" href="/advanced_attendance/static/src/img/icon-192.png"/>
                <link rel="apple-touch-icon" href="/advanced_attendance/static/src/img/icon-192.png"/>
                <link rel="stylesheet" href="/advanced_attendance/static/src/kiosk/kiosk.css"/>
            </head>
            <body t-att-data-token="token">
                <header class="k-header">
                    <div class="k-header-main">
                        <div class="k-kiosk-name" id="k-kiosk-name" t-out="kiosk.name"/>
                        <div class="k-kiosk-place" id="k-kiosk-place"
                             t-out="'%s · %s' % (kiosk.work_location_id.name, kiosk.company_id.name)"/>
                    </div>
                    <div class="k-header-side">
                        <div class="k-clock" id="k-clock"/>
                        <div class="k-date" id="k-date"/>
                    </div>
                </header>

                <main class="k-main">
                    <!-- Home: a scan panel (camera or external reader) beside the name list -->
                    <section class="k-screen k-active" id="screen-home">
                        <div class="k-welcome" id="k-welcome"/>
                        <div class="k-home" id="k-home">
                            <div class="k-scan" id="k-scan" hidden="hidden">
                                <!-- Badge Scan (Camera): always on -->
                                <div class="k-scan-camera" id="k-scan-camera" hidden="hidden">
                                    <div class="k-viewport">
                                        <video id="k-camera-video" playsinline="playsinline" muted="muted" autoplay="autoplay"/>
                                        <div class="k-viewport-frame" aria-hidden="true"/>
                                        <div class="k-viewport-message" id="k-camera-message" hidden="hidden">
                                            <span id="k-camera-message-text"/>
                                            <button type="button" class="k-btn k-btn-light" id="k-camera-retry">Try again</button>
                                        </div>
                                    </div>
                                    <div class="k-scan-prompt">Hold your badge up to the camera</div>
                                </div>
                                <!-- External RFID / Barcode Reader -->
                                <div class="k-scan-reader" id="k-scan-reader" hidden="hidden">
                                    <svg class="k-reader-icon" viewBox="0 0 240 200" role="img" aria-label="Badge reader">
                                        <defs>
                                            <linearGradient id="k-reader-card" x1="0" y1="0" x2="1" y2="1">
                                                <stop offset="0" stop-color="#3BB8FF"/>
                                                <stop offset="1" stop-color="#0A6CF0"/>
                                            </linearGradient>
                                            <linearGradient id="k-reader-wave" x1="0" y1="0" x2="1" y2="1">
                                                <stop offset="0" stop-color="#14C9A5"/>
                                                <stop offset="1" stop-color="#14A3A3"/>
                                            </linearGradient>
                                        </defs>
                                        <rect x="20" y="58" width="150" height="104" rx="18" fill="url(#k-reader-card)"/>
                                        <rect x="34" y="70" width="70" height="10" rx="5" fill="#FFFFFF" opacity=".35"/>
                                        <g fill="#FFFFFF">
                                            <rect x="40" y="96" width="8" height="48" rx="2"/>
                                            <rect x="54" y="96" width="4" height="48" rx="2"/>
                                            <rect x="64" y="96" width="10" height="48" rx="2"/>
                                            <rect x="80" y="96" width="4" height="48" rx="2"/>
                                            <rect x="90" y="96" width="8" height="48" rx="2"/>
                                            <rect x="104" y="96" width="4" height="48" rx="2"/>
                                            <rect x="114" y="96" width="10" height="48" rx="2"/>
                                            <rect x="130" y="96" width="4" height="48" rx="2"/>
                                            <rect x="140" y="96" width="8" height="48" rx="2"/>
                                        </g>
                                        <g fill="none" stroke="url(#k-reader-wave)" stroke-linecap="round" stroke-width="12">
                                            <path class="k-wave k-wave-1" d="M184 84 A30 30 0 0 1 184 136"/>
                                            <path class="k-wave k-wave-2" d="M198 64 A56 56 0 0 1 198 156"/>
                                        </g>
                                    </svg>
                                    <div class="k-scan-prompt">Scan your badge on the reader</div>
                                </div>
                            </div>
                            <div class="k-name-select" id="k-name-select" hidden="hidden">
                                <input type="search" class="k-search" id="k-search" autocomplete="off"
                                       placeholder="Type your name" aria-label="Type your name"/>
                                <div class="k-grid" id="k-grid"/>
                            </div>
                        </div>
                    </section>

                    <!-- PIN -->
                    <section class="k-screen" id="screen-pin">
                        <div class="k-person" id="k-pin-person"/>
                        <div class="k-pin-title">Enter your PIN</div>
                        <div class="k-pin-dots" id="k-pin-dots"/>
                        <div class="k-pin-message" id="k-pin-message"/>
                        <div class="k-keypad" id="k-keypad"/>
                        <button type="button" class="k-btn k-btn-light k-back">Cancel</button>
                    </section>

                    <!-- Employee -->
                    <section class="k-screen" id="screen-employee">
                        <div class="k-person" id="k-emp-person"/>
                        <div class="k-status" id="k-emp-status"/>
                        <ul class="k-notes k-notes-warning" id="k-emp-warnings"/>
                        <ul class="k-notes k-notes-danger" id="k-emp-reasons"/>
                        <div class="k-actions" id="k-emp-actions"/>
                        <button type="button" class="k-btn k-btn-light k-back">Cancel</button>
                    </section>

                    <!-- Questionnaire -->
                    <section class="k-screen" id="screen-questionnaire">
                        <form id="k-questionnaire-form" novalidate="novalidate">
                            <div id="k-questionnaires"/>
                            <div class="k-form-message" id="k-questionnaire-message"/>
                            <div class="k-actions">
                                <button type="submit" class="k-btn k-btn-primary k-btn-lg">Sign In</button>
                            </div>
                        </form>
                        <button type="button" class="k-btn k-btn-light k-back">Cancel</button>
                    </section>

                    <!-- Result -->
                    <section class="k-screen" id="screen-result">
                        <div class="k-result" id="k-result"/>
                        <button type="button" class="k-btn k-btn-light k-back">Done</button>
                    </section>
                </main>

                <footer class="k-footer">
                    <span class="k-conn" id="k-conn">Connecting...</span>
                    <span class="k-pending" id="k-pending" hidden="hidden"/>
                    <button type="button" class="k-btn k-btn-link" id="k-install-btn" hidden="hidden">Install app</button>
                </footer>

                <script src="/advanced_attendance/static/src/kiosk/kiosk.js"/>
            </body>
        </html>
    </template>
</odoo>
