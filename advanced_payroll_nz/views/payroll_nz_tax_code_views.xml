<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payroll_nz_tax_code_view_list" model="ir.ui.view">
        <field name="name">payroll.nz.tax.code.list</field>
        <field name="model">payroll.nz.tax.code</field>
        <field name="arch" type="xml">
            <list string="NZ Tax Codes">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="tax_table_id"/>
                <field name="student_loan"/>
            </list>
        </field>
    </record>

    <record id="payroll_nz_tax_code_view_form" model="ir.ui.view">
        <field name="name">payroll.nz.tax.code.form</field>
        <field name="model">payroll.nz.tax.code</field>
        <field name="arch" type="xml">
            <form string="NZ Tax Code">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. M SL"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="tax_table_id" options="{'no_create': True}"/>
                            <field name="student_loan"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Who this tax code is for..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="payroll_nz_tax_code_view_search" model="ir.ui.view">
        <field name="name">payroll.nz.tax.code.search</field>
        <field name="model">payroll.nz.tax.code</field>
        <field name="arch" type="xml">
            <search string="NZ Tax Codes">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_payroll_nz_tax_code" model="ir.actions.act_window">
        <field name="name">NZ Tax Codes</field>
        <field name="res_model">payroll.nz.tax.code</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a tax code</p>
            <p>Inland Revenue tax codes, from each employee's IR330.</p>
        </field>
    </record>

    <menuitem id="menu_payroll_nz_tax_codes"
              name="NZ Tax Codes"
              parent="advanced_payroll.menu_payroll_config"
              action="action_payroll_nz_tax_code"
              sequence="120"/>
</odoo>
