<odoo>
    <record id="zoo_animal_view_list" model="ir.ui.view">
        <field name="name">zoo.animal.list</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <list decoration-muted="state != 'present'">
                <field name="reference"/>
                <field name="name"/>
                <field name="species_id"/>
                <field name="sex"/>
                <field name="age"/>
                <field name="enclosure_id"/>
                <field name="identifier" optional="hide"/>
                <field name="latest_weight" optional="hide"/>
                <field name="open_health_record_count" string="Open Health Issues" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'present'"
                       decoration-info="state == 'transferred'" decoration-danger="state == 'deceased'"/>
            </list>
        </field>
    </record>

    <record id="zoo_animal_view_kanban" model="ir.ui.view">
        <field name="name">zoo.animal.kanban</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="state"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="d-flex align-items-center me-2">
                            <field name="image_128" widget="image" options="{'img_class': 'object-fit-cover'}"/>
                        </aside>
                        <main>
                            <field class="fw-bolder fs-5" name="name"/>
                            <field name="species_id" class="text-muted"/>
                            <div class="d-flex gap-2">
                                <field name="sex"/>
                                <field name="age"/>
                            </div>
                            <field name="enclosure_id"/>
                            <footer>
                                <field name="reference" class="text-muted"/>
                                <field name="state" widget="badge" class="ms-auto"
                                       decoration-success="state == 'present'" decoration-info="state == 'transferred'"
                                       decoration-danger="state == 'deceased'"/>
                            </footer>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="zoo_animal_view_form" model="ir.ui.view">
        <field name="name">zoo.animal.form</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_health_records" type="object" class="oe_stat_button" icon="fa-medkit">
                            <field name="health_record_count" widget="statinfo" string="Health Records"/>
                        </button>
                        <button name="action_view_weights" type="object" class="oe_stat_button" icon="fa-balance-scale">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="latest_weight"/> kg</span>
                                <span class="o_stat_text">Latest Weight</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Deceased" bg_color="text-bg-danger" invisible="state != 'deceased'"/>
                    <widget name="web_ribbon" title="Transferred" bg_color="text-bg-info" invisible="state != 'transferred'"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Kira"/></h1>
                        <field name="reference" class="text-muted"/>
                    </div>
                    <group>
                        <group string="Animal">
                            <field name="species_id"/>
                            <field name="sex"/>
                            <field name="identifier"/>
                            <label for="date_of_birth"/>
                            <div class="o_row">
                                <field name="date_of_birth"/>
                                <field name="birth_date_estimated" nolabel="1"/>
                                <span class="text-muted">estimated</span>
                            </div>
                            <field name="age"/>
                        </group>
                        <group string="Location &amp; Diet">
                            <field name="enclosure_id"/>
                            <field name="diet_id"/>
                            <field name="latest_weight_date"/>
                        </group>
                        <group string="Origin">
                            <field name="origin"/>
                            <field name="origin_details"/>
                            <field name="arrival_date"/>
                            <field name="sire_id"/>
                            <field name="dam_id"/>
                        </group>
                        <group string="Departure" invisible="state == 'present'">
                            <field name="departure_date"/>
                            <field name="departure_reason"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Health" name="health">
                            <field name="health_record_ids" context="{'default_animal_id': id}">
                                <list decoration-warning="state == 'open'">
                                    <field name="date"/>
                                    <field name="record_type"/>
                                    <field name="summary"/>
                                    <field name="veterinarian"/>
                                    <field name="follow_up_date"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'open'"
                                           decoration-success="state == 'closed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Weights" name="weights">
                            <field name="weight_ids">
                                <list editable="top">
                                    <field name="date"/>
                                    <field name="weight"/>
                                    <field name="user_id"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Diet" name="diet" invisible="not diet_id">
                            <field name="diet_line_ids">
                                <list>
                                    <field name="food"/>
                                    <field name="quantity"/>
                                    <field name="unit"/>
                                    <field name="frequency"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Feedings" name="feedings">
                            <field name="feeding_ids" readonly="1">
                                <list>
                                    <field name="scheduled_datetime"/>
                                    <field name="enclosure_id"/>
                                    <field name="user_id"/>
                                    <field name="consumption"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>
                        <page string="Moves" name="moves">
                            <field name="move_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="from_enclosure_id"/>
                                    <field name="to_enclosure_id"/>
                                    <field name="reason"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zoo_animal_view_search" model="ir.ui.view">
        <field name="name">zoo.animal.search</field>
        <field name="model">zoo.animal</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('reference', 'ilike', self), ('identifier', 'ilike', self)]"/>
                <field name="species_id"/>
                <field name="enclosure_id"/>
                <filter string="In Collection" name="present" domain="[('state', '=', 'present')]"/>
                <filter string="Transferred Out" name="transferred" domain="[('state', '=', 'transferred')]"/>
                <filter string="Deceased" name="deceased" domain="[('state', '=', 'deceased')]"/>
                <separator/>
                <filter string="Open Health Issues" name="open_health" domain="[('health_record_ids.state', '=', 'open')]"/>
                <filter string="No Enclosure" name="no_enclosure" domain="[('enclosure_id', '=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Species" name="group_species" context="{'group_by': 'species_id'}"/>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Enclosure" name="group_enclosure" context="{'group_by': 'enclosure_id'}"/>
                    <filter string="Sex" name="group_sex" context="{'group_by': 'sex'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zoo_animal_action" model="ir.actions.act_window">
        <field name="name">Animals</field>
        <field name="res_model">zoo.animal</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_present': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Register your first animal</p>
            <p>Record each animal in the park with its species, enclosure, diet and history.</p>
        </field>
    </record>

    <!-- Moves -->
    <record id="zoo_animal_move_view_list" model="ir.ui.view">
        <field name="name">zoo.animal.move.list</field>
        <field name="model">zoo.animal.move</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="date"/>
                <field name="animal_id"/>
                <field name="species_id" optional="show"/>
                <field name="from_enclosure_id"/>
                <field name="to_enclosure_id"/>
                <field name="reason"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <record id="zoo_animal_move_view_form" model="ir.ui.view">
        <field name="name">zoo.animal.move.form</field>
        <field name="model">zoo.animal.move</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="animal_id"/>
                            <field name="date"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="from_enclosure_id"/>
                            <field name="to_enclosure_id"/>
                            <field name="reason"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zoo_animal_move_view_search" model="ir.ui.view">
        <field name="name">zoo.animal.move.search</field>
        <field name="model">zoo.animal.move</field>
        <field name="arch" type="xml">
            <search>
                <field name="animal_id"/>
                <field name="from_enclosure_id"/>
                <field name="to_enclosure_id"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Animal" name="group_animal" context="{'group_by': 'animal_id'}"/>
                    <filter string="To Enclosure" name="group_to" context="{'group_by': 'to_enclosure_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zoo_animal_move_action" model="ir.actions.act_window">
        <field name="name">Moves</field>
        <field name="res_model">zoo.animal.move</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No moves yet</p>
            <p>A move is logged automatically whenever an animal's enclosure changes.</p>
        </field>
    </record>
</odoo>
