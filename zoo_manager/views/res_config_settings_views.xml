<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.zoo_manager</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Zoo Manager" id="zoo_manager" string="Zoo Manager" name="zoo_manager"
                     groups="zoo_manager.group_zoo_manager">
                    <block title="Feeds" id="zoo_feeds">
                        <setting id="zoo_feed_warehouses" string="Warehouses"
                                 help="Which Warehouse/s are feed items stored in?">
                            <field name="zoo_feed_warehouse_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </setting>
                        <setting id="zoo_feed_categories" string="Product Categories"
                                 help="Which Product Categories contain Feed items?">
                            <field name="zoo_feed_categ_ids" widget="many2many_tags"
                                   options="{'no_create': True}"/>
                        </setting>
                    </block>
                    <block title="Integrations" id="zoo_integrations" groups="base.group_system">
                        <setting id="zoo_wikimedia_oauth" string="Wikipedia (Wikipedia OAuth)"
                                 help="Authenticated access raises the Wikipedia picture lookups from 500 to 5,000 requests an hour. Register an OAuth 2.0 client (client credentials, or owner-only) on Meta-Wiki, then enter its details here.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="zoo_wikimedia_client_id" class="col-lg-4 o_light_label"/>
                                    <field name="zoo_wikimedia_client_id" class="col-lg-8"/>
                                </div>
                                <div class="row">
                                    <label for="zoo_wikimedia_client_secret" class="col-lg-4 o_light_label"/>
                                    <field name="zoo_wikimedia_client_secret" password="True" class="col-lg-8"/>
                                </div>
                                <div class="row">
                                    <label for="zoo_wikimedia_access_token" class="col-lg-4 o_light_label"/>
                                    <field name="zoo_wikimedia_access_token" password="True" class="col-lg-8"/>
                                </div>
                                <div class="mt8">
                                    <a href="https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration/propose/oauth2"
                                       target="_blank" class="me-3"><i class="oi oi-arrow-right"/> Register a client</a>
                                    <button name="action_zoo_test_wikimedia" type="object" string="Test Connection"
                                            class="btn-link" icon="fa-plug"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="zoo_manager_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'zoo_manager', 'bin_size': False}</field>
    </record>
</odoo>
