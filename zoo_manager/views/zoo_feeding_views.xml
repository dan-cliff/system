<odoo>
    <record id="zoo_feeding_view_list" model="ir.ui.view">
        <field name="name">zoo.feeding.list</field>
        <field name="model">zoo.feeding</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancelled'" decoration-danger="consumption == 'none'">
                <field name="scheduled_datetime"/>
                <field name="enclosure_id"/>
                <field name="animal_ids" widget="many2many_tags" optional="show"/>
                <field name="user_id"/>
                <field name="fed_datetime" optional="hide"/>
                <field name="consumption"/>
                <field name="state" widget="badge" decoration-info="state == 'planned'"
                       decoration-success="state == 'done'"/>
                <button name="action_mark_fed" type="object" string="Mark Fed" icon="fa-check"
                        class="btn-link" invisible="state != 'planned'"/>
            </list>
        </field>
    </record>

    <record id="zoo_feeding_view_calendar" model="ir.ui.view">
        <field name="name">zoo.feeding.calendar</field>
        <field name="model">zoo.feeding</field>
        <field name="arch" type="xml">
            <calendar date_start="scheduled_datetime" color="enclosure_id" mode="week" quick_create="0">
                <field name="enclosure_id" filters="1"/>
                <field name="user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="zoo_feeding_view_form" model="ir.ui.view">
        <field name="name">zoo.feeding.form</field>
        <field name="model">zoo.feeding</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_fed" type="object" string="Mark Fed" class="btn-primary"
                            invisible="state != 'planned'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'planned'"/>
                    <button name="action_reset_to_planned" type="object" string="Reset to Planned"
                            invisible="state == 'planned'"/>
                    <field name="state" widget="statusbar" statusbar_visible="planned,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="enclosure_id" readonly="state != 'planned'"/>
                            <field name="scheduled_datetime" readonly="state != 'planned'"/>
                            <field name="fed_datetime" invisible="state != 'done'"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="consumption"/>
                        </group>
                    </group>
                    <field name="animal_ids">
                        <list>
                            <field name="name"/>
                            <field name="species_id"/>
                            <field name="diet_id"/>
                        </list>
                    </field>
                    <group>
                        <field name="food_given"/>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zoo_feeding_view_search" model="ir.ui.view">
        <field name="name">zoo.feeding.search</field>
        <field name="model">zoo.feeding</field>
        <field name="arch" type="xml">
            <search>
                <field name="enclosure_id"/>
                <field name="animal_ids"/>
                <field name="user_id"/>
                <filter string="Planned" name="planned" domain="[('state', '=', 'planned')]"/>
                <filter string="Fed" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="My Feedings" name="mine" domain="[('user_id', '=', uid)]"/>
                <filter string="Food Refused" name="refused" domain="[('consumption', '=', 'none')]"/>
                <separator/>
                <filter string="Scheduled" name="filter_scheduled" date="scheduled_datetime"/>
                <group>
                    <filter string="Enclosure" name="group_enclosure" context="{'group_by': 'enclosure_id'}"/>
                    <filter string="Keeper" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'scheduled_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zoo_feeding_action" model="ir.actions.act_window">
        <field name="name">Feeding Rounds</field>
        <field name="res_model">zoo.feeding</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Plan a feeding round</p>
            <p>Schedule feeds per enclosure, then mark them fed and note how much was eaten.</p>
        </field>
    </record>

    <!-- Weights -->
    <record id="zoo_animal_weight_view_list" model="ir.ui.view">
        <field name="name">zoo.animal.weight.list</field>
        <field name="model">zoo.animal.weight</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="date"/>
                <field name="animal_id"/>
                <field name="species_id" optional="show"/>
                <field name="weight"/>
                <field name="user_id"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <record id="zoo_animal_weight_view_form" model="ir.ui.view">
        <field name="name">zoo.animal.weight.form</field>
        <field name="model">zoo.animal.weight</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="animal_id"/>
                        <field name="date"/>
                        <field name="weight"/>
                        <field name="user_id"/>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zoo_animal_weight_view_graph" model="ir.ui.view">
        <field name="name">zoo.animal.weight.graph</field>
        <field name="model">zoo.animal.weight</field>
        <field name="arch" type="xml">
            <graph type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="animal_id"/>
                <field name="weight" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="zoo_animal_weight_view_search" model="ir.ui.view">
        <field name="name">zoo.animal.weight.search</field>
        <field name="model">zoo.animal.weight</field>
        <field name="arch" type="xml">
            <search>
                <field name="animal_id"/>
                <field name="species_id"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Animal" name="group_animal" context="{'group_by': 'animal_id'}"/>
                    <filter string="Species" name="group_species" context="{'group_by': 'species_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zoo_animal_weight_action" model="ir.actions.act_window">
        <field name="name">Weights</field>
        <field name="res_model">zoo.animal.weight</field>
        <field name="view_mode">list,graph,form</field>
    </record>
</odoo>
