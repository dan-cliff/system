<odoo>
    <record id="zoo_species_view_list" model="ir.ui.view">
        <field name="name">zoo.species.list</field>
        <field name="model">zoo.species</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="scientific_name" class="fst-italic"/>
                <field name="animal_class"/>
                <field name="conservation_status"/>
                <field name="default_diet_id" optional="hide"/>
                <field name="animal_count" string="Animals"/>
            </list>
        </field>
    </record>

    <record id="zoo_species_view_form" model="ir.ui.view">
        <field name="name">zoo.species.form</field>
        <field name="model">zoo.species</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Red Panda"/></h1>
                        <h3><field name="scientific_name" class="fst-italic" placeholder="e.g. Ailurus fulgens"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="animal_class"/>
                            <field name="conservation_status"/>
                        </group>
                        <group>
                            <field name="default_diet_id"/>
                            <field name="animal_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zoo_species_view_search" model="ir.ui.view">
        <field name="name">zoo.species.search</field>
        <field name="model">zoo.species</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('scientific_name', 'ilike', self)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Class" name="group_class" context="{'group_by': 'animal_class'}"/>
                    <filter string="Conservation Status" name="group_status" context="{'group_by': 'conservation_status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="zoo_species_action" model="ir.actions.act_window">
        <field name="name">Species</field>
        <field name="res_model">zoo.species</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
