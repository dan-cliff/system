<odoo>
    <record id="zoo_species_view_list" model="ir.ui.view">
        <field name="name">zoo.species.list</field>
        <field name="model">zoo.species</field>
        <field name="arch" type="xml">
            <list>
                <field name="image_128" widget="image" options="{'size': [32, 32]}" optional="show"/>
                <field name="prefix_code"/>
                <field name="name"/>
                <field name="scientific_name" class="fst-italic"/>
                <field name="class_id"/>
                <field name="species_code"/>
                <field name="include_on_annual_return" optional="show"/>
                <field name="conservation_status_id" optional="show"/>
                <field name="default_diet_id" optional="hide"/>
                <field name="animal_count" string="Animals"/>
            </list>
        </field>
    </record>

    <record id="zoo_species_view_form" model="ir.ui.view">
        <field name="name">zoo.species.form</field>
        <field name="model">zoo.species</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_lookup_classification" type="object" string="Look Up Classification"
                            icon="fa-search" invisible="not scientific_name" groups="zoo_manager.group_zoo_manager"
                            help="Fill in empty classification fields and pictures from the scientific name (GBIF and Wikipedia)."/>
                    <button name="action_check_conservation_status" type="object" string="Check Conservation Status"
                            icon="fa-leaf" invisible="not scientific_name" groups="zoo_manager.group_zoo_manager"
                            help="Update the conservation status from the IUCN Red List (via GBIF)."/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Red Panda"/></h1>
                        <label for="scientific_name"/>
                        <h3><field name="scientific_name" class="fst-italic" placeholder="e.g. Ailurus fulgens"/></h3>
                    </div>
                    <group>
                        <group>
                            <field name="class_id"/>
                            <field name="prefix_code"/>
                            <field name="species_code"/>
                            <field name="include_on_annual_return"/>
                            <field name="conservation_status_id" options="{'no_create': True}"/>
                            <field name="conservation_checked" options="{'numeric': True}" invisible="not conservation_checked"/>
                        </group>
                        <group>
                            <field name="default_diet_id"/>
                            <field name="animal_count"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="status" invisible="not lookup_pending">
                        Missing classification and pictures will be looked up from the scientific name shortly.
                    </div>
                    <group>
                        <group string="Scientific Classification" name="scientific_classification">
                            <field name="taxon_kingdom"/>
                            <field name="taxon_phylum"/>
                            <field name="taxon_class"/>
                            <field name="taxon_order"/>
                            <field name="taxon_family"/>
                            <field name="taxon_genus" class="fst-italic"/>
                            <field name="taxon_species" class="fst-italic"/>
                            <field name="reference_url" widget="url"/>
                            <field name="lookup_pending" invisible="1"/>
                        </group>
                        <group string="Geographic Distribution" name="distribution">
                            <field name="distribution_image" widget="image" nolabel="1" colspan="2"
                                   options="{'size': [0, 300]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="zoo_species_view_search" model="ir.ui.view">
        <field name="name">zoo.species.search</field>
        <field name="model">zoo.species</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', '|', ('name', 'ilike', self), ('scientific_name', 'ilike', self), ('species_code', 'ilike', self), ('prefix_code', 'ilike', self)]"/>
                <field name="class_id"/>
                <filter string="On Annual Wildlife Return" name="annual_return" domain="[('include_on_annual_return', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Class" name="group_class" context="{'group_by': 'class_id'}"/>
                    <filter string="Conservation Status" name="group_status" context="{'group_by': 'conservation_status_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Classes -->
    <record id="zoo_animal_class_view_list" model="ir.ui.view">
        <field name="name">zoo.animal.class.list</field>
        <field name="model">zoo.animal.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="prefix_code"/>
                <field name="name"/>
                <field name="species_count" string="Species"/>
            </list>
        </field>
    </record>

    <record id="zoo_animal_class_view_form" model="ir.ui.view">
        <field name="name">zoo.animal.class.form</field>
        <field name="model">zoo.animal.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Mammals"/></h1>
                    </div>
                    <group>
                        <field name="prefix_code"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="species_ids" readonly="1">
                        <list>
                            <field name="prefix_code"/>
                            <field name="name"/>
                            <field name="scientific_name"/>
                            <field name="species_code"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zoo_animal_class_view_search" model="ir.ui.view">
        <field name="name">zoo.animal.class.search</field>
        <field name="model">zoo.animal.class</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('prefix_code', 'ilike', self)]"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="zoo_animal_class_action" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">zoo.animal.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="zoo_species_action" model="ir.actions.act_window">
        <field name="name">Species</field>
        <field name="res_model">zoo.species</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
