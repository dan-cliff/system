<odoo>
    <record id="view_partner_form_zoo" model="ir.ui.view">
        <field name="name">res.partner.form.zoo_manager</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- Below the main contact details (the group holding tags). -->
            <xpath expr="//field[@name='category_id'][not(ancestor::field)]/../.." position="after">
                <group string="Wildlife Licensing Details" name="wildlife_licensing">
                    <group>
                        <field name="wildlife_license_number"/>
                        <field name="jurisdiction_ids" widget="many2many_tags" options="{'no_create': True}"
                               placeholder="e.g. Victoria"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
