<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_zoo_species_lookup" model="ir.cron">
        <field name="name">Zoo Manager: Look up species classification and pictures</field>
        <field name="model_id" ref="model_zoo_species"/>
        <field name="state">code</field>
        <field name="code">model._cron_lookup_classification()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- The nightly jobs run as the administrator so 3am/4am are in their timezone. -->
    <record id="ir_cron_zoo_species_nightly_check" model="ir.cron">
        <field name="name">Zoo Manager: Nightly check for missing species classification</field>
        <field name="model_id" ref="model_zoo_species"/>
        <field name="state">code</field>
        <field name="code">model._cron_nightly_classification_check()</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_zoo_species_conservation_check" model="ir.cron">
        <field name="name">Zoo Manager: Nightly conservation status check (IUCN Red List)</field>
        <field name="model_id" ref="model_zoo_species"/>
        <field name="state">code</field>
        <field name="code">model._cron_nightly_conservation_check()</field>
        <field name="user_id" ref="base.user_admin"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>

    <function model="zoo.species" name="_schedule_cron_at"
              eval="['zoo_manager.ir_cron_zoo_species_nightly_check', 3]"/>
    <function model="zoo.species" name="_schedule_cron_at"
              eval="['zoo_manager.ir_cron_zoo_species_conservation_check', 4]"/>
</odoo>
