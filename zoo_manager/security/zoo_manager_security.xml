<odoo>
    <record id="res_groups_privilege_zoo_manager" model="res.groups.privilege">
        <field name="name">Zoo Manager</field>
        <field name="category_id" ref="base.module_category_services"/>
    </record>

    <!-- Keepers: day-to-day care. Register and move animals, log feedings, weights
         and health records. Read-only on species, enclosures and diets. -->
    <record id="group_zoo_keeper" model="res.groups">
        <field name="name">Keeper</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_zoo_manager"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Administrators: everything keepers can do, plus configuration (species,
         enclosures, diets) and deleting records. -->
    <record id="group_zoo_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_zoo_manager"/>
        <field name="implied_ids" eval="[(4, ref('group_zoo_keeper'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
