<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_action_form_risk" model="ir.ui.view">
        <field name="name">advanced.action.form.risk</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_checklist_id']" position="after">
                <field name="risk_line_id" invisible="source_app != 'risk'"
                       required="source_app == 'risk'" options="{'no_create': True}"/>
                <field name="risk_assessment_id" invisible="source_app != 'risk'"/>
            </xpath>
        </field>
    </record>

    <record id="view_advanced_action_search_risk" model="ir.ui.view">
        <field name="name">advanced.action.search.risk</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='checklist_template_id']" position="after">
                <field name="risk_assessment_id"/>
                <field name="risk_line_id"/>
            </xpath>
            <xpath expr="//filter[@name='app_checklists']" position="after">
                <filter name="app_risk" string="Risk Management" domain="[('source_app', '=', 'risk')]"/>
            </xpath>
            <xpath expr="//filter[@name='group_app']" position="after">
                <filter name="group_risk_assessment" string="Risk Assessment"
                        context="{'group_by': 'risk_assessment_id'}"/>
            </xpath>
        </field>
    </record>

    <record id="view_advanced_action_list_risk" model="ir.ui.view">
        <field name="name">advanced.action.list.risk</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="risk_assessment_id" optional="show"/>
                <field name="risk_line_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='source_app']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='source_display']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Risk Management › Actions: filtered to Risk Management, filter removable. -->
    <record id="action_advanced_action_risk" model="ir.actions.act_window">
        <field name="name">Actions</field>
        <field name="res_model">advanced.action</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_advanced_action_list_risk')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'}),
            (0, 0, {'view_mode': 'activity'})]"/>
        <field name="context">{'search_default_app_risk': 1, 'search_default_my_actions': 1, 'search_default_open': 1, 'default_source_app': 'risk'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No actions yet</p>
            <p>Actions are added to the risks of a Risk Assessment, from its Risk Templates'
               Standard Actions, by AI or by hand. Remove the Risk Management filter to see
               actions from every app.</p>
        </field>
    </record>

    <record id="risk_management.menu_risk_actions" model="ir.ui.menu">
        <field name="action" ref="action_advanced_action_risk"/>
    </record>
</odoo>
