<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_geocode_locations" model="ir.cron">
        <field name="name">Live Sales Counter: Geocode Buyer Locations</field>
        <field name="model_id" ref="model_live_counter_location"/>
        <field name="state">code</field>
        <field name="code">model._cron_geocode()</field>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
