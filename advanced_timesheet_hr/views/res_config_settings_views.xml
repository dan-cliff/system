<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.advanced_timesheet_hr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="advanced_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="advanced_timesheet_period" position="after">
                <setting id="advanced_timesheet_manager_approval"
                         help="Submitted timesheets wait for the employee's Manager (set on the employee), who approves them or sends them back. Managers need the Timesheets: Approve permission.">
                    <field name="advanced_timesheet_manager_approval"/>
                </setting>
            </setting>
        </field>
    </record>
</odoo>
