<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lms_scorm_import_wizard_form" model="ir.ui.view">
        <field name="name">lms.scorm.import.wizard.form</field>
        <field name="model">lms.scorm.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Presentation">
                <field name="state" invisible="1"/>
                <field name="has_slides" invisible="1"/>
                <field name="course_id" invisible="1"/>
                <div invisible="state != 'upload'">
                    <p class="text-muted">
                        Each slide becomes an editable slide: text boxes, pictures, shapes, tables,
                        video and speaker notes come across. The file is checked first; old .ppt files,
                        password-protected files and non-presentations are refused.
                    </p>
                    <group>
                        <field name="source" widget="radio"/>
                        <field name="file" filename="filename" invisible="source != 'file'"
                               required="source == 'file' and state == 'upload'"/>
                        <field name="filename" invisible="1"/>
                        <field name="google_url" invisible="source != 'google'" required="source == 'google' and state == 'upload'"
                               placeholder="https://docs.google.com/presentation/d/…"/>
                        <field name="mode" widget="radio" invisible="not has_slides"/>
                    </group>
                    <div class="alert alert-info" role="status" invisible="source != 'google'">
                        Share the presentation as <strong>Anyone with the link – Viewer</strong>, or
                        download it with <em>File › Download › Microsoft PowerPoint (.pptx)</em> and
                        upload the file instead.
                    </div>
                </div>
                <div invisible="state != 'done'">
                    <div class="alert alert-success" role="status">
                        <field name="result_summary" nolabel="1"/>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="not result_warnings">
                        <strong>Things to check:</strong>
                        <field name="result_warnings" nolabel="1"/>
                    </div>
                </div>
                <footer>
                    <button name="action_import" type="object" string="Check &amp; Import" class="btn-primary"
                            invisible="state != 'upload'"/>
                    <button name="action_open_editor" type="object" string="Open Editor" class="btn-primary"
                            invisible="state != 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_lms_scorm_approval_wizard_form" model="ir.ui.view">
        <field name="name">lms.scorm.approval.wizard.form</field>
        <field name="model">lms.scorm.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Approve or Request Changes">
                <field name="course_id" invisible="1"/>
                <div class="alert alert-warning" role="status" invisible="not open_comment_count">
                    This course still has <field name="open_comment_count" class="oe_inline"/> open
                    review comment(s).
                </div>
                <group>
                    <field name="note" placeholder="Required when requesting changes"/>
                </group>
                <footer>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"/>
                    <button name="action_reject" type="object" string="Request Changes" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
