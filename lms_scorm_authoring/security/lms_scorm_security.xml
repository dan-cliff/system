<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every permission below is its
         own privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical SCORM Authoring user group,
         which holds the ACLs and a deny rule per operation, so users can only
         do what a permission opens. Slides, review comments and approvals
         follow their course. -->
    <data noupdate="1">
        <record id="module_category_scorm_authoring" model="ir.module.category">
            <field name="name">SCORM Authoring</field>
            <field name="description">Design, review, approve and publish SCORM eLearning courses.</field>
            <field name="sequence">53</field>
        </record>
    </data>

    <record id="group_scorm_user" model="res.groups">
        <field name="name">SCORM Authoring: User</field>
        <field name="comment">Technical: given by every SCORM Authoring permission. Opens the app; what users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_scorm_course_create_only" model="res.groups.privilege">
        <field name="name">SCORM Courses: Create Only</field>
        <field name="category_id" ref="module_category_scorm_authoring"/>
        <field name="sequence">20</field>
        <field name="description">Create SCORM courses, and view the ones they created (no editing after saving).</field>
    </record>
    <record id="group_scorm_course_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_scorm_course_create_only"/>
        <field name="comment">Create SCORM courses, and view the ones they created (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_scorm_user'))]"/>
    </record>

    <record id="privilege_scorm_course_edit_own" model="res.groups.privilege">
        <field name="name">SCORM Courses: Create and Edit Own</field>
        <field name="category_id" ref="module_category_scorm_authoring"/>
        <field name="sequence">30</field>
        <field name="description">Create SCORM courses, and view and edit the ones they created.</field>
    </record>
    <record id="group_scorm_course_edit_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_scorm_course_edit_own"/>
        <field name="comment">Create SCORM courses, and view and edit the ones they created.</field>
        <field name="implied_ids" eval="[(4, ref('group_scorm_user'))]"/>
