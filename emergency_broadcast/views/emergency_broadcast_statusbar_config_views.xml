<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ──────────────────────────────────────────────────────── -->
    <record id="view_eb_statusbar_cfg_list" model="ir.ui.view">
        <field name="name">emergency.broadcast.statusbar.config.list</field>
        <field name="model">emergency.broadcast.statusbar.config</field>
        <field name="arch" type="xml">
            <list string="Statusbar Banner Configurations">
                <field name="id" string="ID"/>
                <field name="status_id"/>
                <field name="show_banner"/>
                <field name="banner_type"/>
                <field name="banner_color"/>
                <field name="banner_icon"/>
                <field name="banner_message_template"/>
            </list>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────────── -->
    <record id="view_eb_statusbar_cfg_form" model="ir.ui.view">
        <field name="name">emergency.broadcast.statusbar.config.form</field>
        <field name="model">emergency.broadcast.statusbar.config</field>
        <field name="arch" type="xml">
            <form string="Statusbar Banner Configuration">
                <sheet>
                    <div class="oe_title">
                        <label for="status_id" string="Status"/>
                        <h1><field name="status_id" placeholder="Select a status..."/></h1>
                    </div>
                    <group>
                        <group string="Banner Display">
                            <field name="show_banner"/>
                            <field name="banner_type"/>
                            <field name="banner_color"
                                   placeholder="#FF0000 (leave blank for type default)"/>
                            <field name="banner_icon"
                                   placeholder="fa-exclamation-triangle"/>
                        </group>
                        <group string="Message">
                            <field name="banner_message_template" colspan="2"
                                   placeholder="e.g.  🚨 {{name}} — {{status_id.name}}"/>
                        </group>
                    </group>
                    <group string="Available Placeholders">
                        <div colspan="2" class="text-muted small">
                            <p>Use the following <code>{{placeholder}}</code> values in the Message Template:</p>
                            <ul>
                                <li><code>{{name}}</code> — Broadcast title</li>
                                <li><code>{{status_id.name}}</code> — Status name</li>
                                <li><code>{{priority_label}}</code> — Priority (e.g. Critical)</li>
                                <li><code>{{sent_date}}</code> — Date/time the broadcast was sent</li>
                                <li><code>{{message_plain}}</code> — First 200 characters of the message (plain text)</li>
                            </ul>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────── -->
    <record id="action_eb_statusbar_cfg" model="ir.actions.act_window">
        <field name="name">Statusbar Banner Configuration</field>
        <field name="res_model">emergency.broadcast.statusbar.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
