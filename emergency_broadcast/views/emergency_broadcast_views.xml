<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ──────────────────────────────────────────────────────── -->
    <record id="view_eb_list" model="ir.ui.view">
        <field name="name">emergency.broadcast.list</field>
        <field name="model">emergency.broadcast</field>
        <field name="arch" type="xml">
            <list string="Emergency Broadcasts" decoration-danger="priority == '3'"
                  decoration-warning="priority == '2'"
                  decoration-info="state == 'draft'"
                  decoration-muted="state == 'complete'">
                <field name="id" string="ID"/>
                <field name="name"/>
                <field name="status_id"/>
                <field name="priority" widget="priority"/>
                <field name="channel_ids" widget="many2many_tags"/>
                <field name="recipient_filter"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'complete'"
                       decoration-primary="state == 'sent'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="sent_date" options='{"numeric": true}'/>
                <field name="total_recipients"/>
                <field name="total_acknowledged"/>
                <field name="acknowledgement_rate" widget="percentage" string="Ack %"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="created_by_id"/>
                <field name="requested_by_id" optional="show" string="Assistance Requested By"/>
                <field name="incident_id" optional="show" string="Related Incident"/>
            </list>
        </field>
    </record>

    <!-- ── Form ──────────────────────────────────────────────────────── -->
    <record id="view_eb_form" model="ir.ui.view">
        <field name="name">emergency.broadcast.form</field>
        <field name="model">emergency.broadcast</field>
        <field name="arch" type="xml">
            <form string="Emergency Broadcast">
                <header>
                    <button name="action_send" string="Send Broadcast" type="object"
                            class="btn-danger"
                            invisible="state != 'draft'"/>
                    <button name="action_resolve" string="Resolve" type="object"
                            class="btn-success"
                            invisible="state != 'sent'"
                            confirm="Mark this broadcast as resolved?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'draft'" confirm="Cancel this broadcast?"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled' and state != 'complete'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,complete,cancelled"/>
                </header>
                <sheet>
                    <!-- Priority stars (top-right) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_recipients" type="object"
                                class="oe_stat_button" icon="fa-users"
                                invisible="total_recipients == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_recipients"/>
                                </span>
                                <span class="o_stat_text">Recipients</span>
                            </div>
                        </button>
                        <button name="action_view_recipients" type="object"
                                class="oe_stat_button" icon="fa-check-circle"
                                invisible="not requires_acknowledgement or total_recipients == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_acknowledged"/>/<field name="total_recipients"/>
                                </span>
                                <span class="o_stat_text">Acknowledged</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Title"/>
                        <h1>
                            <field name="name" placeholder="Broadcast title..."/>
                        </h1>
                    </div>

                    <group>
                        <group string="Broadcast Details">
                            <field name="status_id" options='{"no_create": false}'/>
                            <field name="priority" widget="priority"/>
                            <field name="channel_ids" widget="many2many_tags"
                                   options='{"no_create": true}'/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="created_by_id" readonly="1"/>
                            <field name="requested_by_id" readonly="1"
                                   invisible="not requested_by_id"
                                   string="Assistance Requested By"/>
                            <field name="incident_id"
                                   options='{"no_create": true}'
                                   invisible="not incident_id"/>
                            <field name="sent_date" readonly="1" options='{"numeric": true}'
                                   invisible="state == 'draft'"/>
                        </group>
                        <group string="Recipient Filter">
                            <field name="recipient_filter" widget="radio"/>
                            <field name="company_ids" widget="many2many_tags"
                                   invisible="recipient_filter != 'company'"/>
                            <field name="specific_user_ids" widget="many2many_tags"
                                   invisible="recipient_filter != 'users'"/>
                        </group>
                    </group>

                    <group string="Message">
                        <field name="message_body" colspan="2"/>
                    </group>

                    <!-- Acknowledgement Stats (only shown when dialog channel is selected) -->
                    <group string="Acknowledgement Summary" invisible="not requires_acknowledgement or state == 'draft'">
                        <group>
                            <field name="total_recipients" string="Total Sent To"/>
                            <field name="total_acknowledged"/>
                            <field name="total_pending"/>
                            <field name="acknowledgement_rate" widget="percentage" string="Acknowledgement Rate"/>
                        </group>
                    </group>

                    <!-- Recipient Lines -->
                    <notebook invisible="state == 'draft'">
                        <page string="Recipients" name="recipients">
                            <field name="recipient_line_ids" readonly="1">
                                <list string="Recipients" decoration-success="acknowledged"
                                      decoration-muted="not acknowledged">
                                    <field name="id" string="ID"/>
                                    <field name="user_id"/>
                                    <field name="sent_date" options='{"numeric": true}'/>
                                    <field name="acknowledged"/>
                                    <field name="acknowledged_date" options='{"numeric": true}'/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search ────────────────────────────────────────────────────── -->
    <record id="view_eb_search" model="ir.ui.view">
        <field name="name">emergency.broadcast.search</field>
        <field name="model">emergency.broadcast</field>
        <field name="arch" type="xml">
            <search string="Search Broadcasts">
                <field name="name" string="Title"/>
                <field name="status_id"/>
                <field name="created_by_id" string="Created By"/>
                <filter name="filter_sent" string="Sent" domain="[('state','=','sent')]"/>
                <filter name="filter_complete" string="Complete" domain="[('state','=','complete')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="filter_cancelled" string="Cancelled" domain="[('state','=','cancelled')]"/>
                <separator/>
                <filter name="filter_critical" string="Critical" domain="[('priority','=','3')]"/>
                <filter name="filter_urgent" string="Urgent" domain="[('priority','=','2')]"/>
                <separator/>
                <filter name="filter_requires_ack" string="Requires Acknowledgement"
                        domain="[('requires_acknowledgement','=',True)]"/>
                <group>
                    <filter name="group_status" string="Status" context="{'group_by': 'status_id'}"/>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                    <filter name="group_created_by" string="Created By" context="{'group_by': 'created_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Kanban ─────────────────────────────────────────────────────── -->
    <record id="view_eb_kanban" model="ir.ui.view">
        <field name="name">emergency.broadcast.kanban</field>
        <field name="model">emergency.broadcast</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status_id"
                    records_draggable="0">
                <field name="id"/>
                <field name="name"/>
                <field name="status_id"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="channel_ids"/>
                <field name="total_recipients"/>
                <field name="total_acknowledged"/>
                <field name="requires_acknowledgement"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="channel_ids" widget="many2many_tags"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span t-if="record.state.raw_value == 'sent'" class="badge text-bg-primary">Sent</span>
                                        <span t-elif="record.state.raw_value == 'complete'" class="badge text-bg-success">Complete</span>
                                        <span t-elif="record.state.raw_value == 'draft'" class="badge text-bg-warning">Draft</span>
                                        <span t-else="" class="badge text-bg-secondary">Cancelled</span>
                                    </div>
                                    <div class="oe_kanban_bottom_right" t-if="record.requires_acknowledgement.raw_value">
                                        <span class="text-muted small">
                                            <t t-esc="record.total_acknowledged.value"/>/<t t-esc="record.total_recipients.value"/> ack
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Main Action ───────────────────────────────────────────────── -->
    <record id="action_eb_broadcast" model="ir.actions.act_window">
        <field name="name">Emergency Broadcasts</field>
        <field name="res_model">emergency.broadcast</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_filter_sent': 1}</field>
    </record>

</odoo>
