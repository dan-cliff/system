<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="channel_email" model="emergency.broadcast.channel">
            <field name="name">Email</field>
            <field name="technical_type">email</field>
            <field name="sequence">1</field>
            <field name="icon">fa-envelope</field>
            <field name="description">Delivers the broadcast as an email to recipient mail addresses.</field>
        </record>

        <record id="channel_sms" model="emergency.broadcast.channel">
            <field name="name">SMS</field>
            <field name="technical_type">sms</field>
            <field name="sequence">2</field>
            <field name="icon">fa-mobile</field>
            <field name="description">Delivers the broadcast as an SMS text message.</field>
        </record>

        <record id="channel_popup" model="emergency.broadcast.channel">
            <field name="name">Popup Notification</field>
            <field name="technical_type">popup</field>
            <field name="sequence">3</field>
            <field name="icon">fa-bell</field>
            <field name="description">Displays a temporary notification toast on all logged-in workstations that meet the recipient filter.</field>
        </record>

        <record id="channel_dialog" model="emergency.broadcast.channel">
            <field name="name">Dialogue Box</field>
            <field name="technical_type">dialog</field>
            <field name="sequence">4</field>
            <field name="icon">fa-exclamation-circle</field>
            <field name="description">Opens a modal dialogue on all logged-in workstations requiring the user to click Acknowledge. Acknowledgements are tracked and timestamped.</field>
        </record>

    </data>
</odoo>
