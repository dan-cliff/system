<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Per-model access levels are in access_levels.xml (generated from access_levels.py). -->

    <!--
        Generate Emergency Broadcast — cross-module permission.
        Appears under the Incident Management Incident Reports privilege so it is visible
        alongside the other Incident Management permissions in Settings > Users.
        Implies creating and updating Emergency Broadcasts so the user can manage
        broadcasts generated from incident reports.
    -->
    <record id="group_eb_generate_from_incident" model="res.groups">
        <field name="name">Generate Emergency Broadcast</field>
        <field name="privilege_id" ref="incident_management.privilege_incident_report"/>
        <field name="sequence">60</field>
        <field name="comment">Can generate Emergency Broadcast records from an Incident Management report. Implies Emergency Broadcasts / Create and Update.</field>
        <field name="implied_ids" eval="[(4, ref('emergency_broadcast.group_eb_broadcast_create')), (4, ref('emergency_broadcast.group_eb_broadcast_update'))]"/>
    </record>

    <!-- Broadcasts are visible within the user's active companies (or with no company). -->
    <record id="rule_eb_broadcast_company" model="ir.rule">
        <field name="name">Emergency Broadcast: active companies</field>
        <field name="model_id" ref="model_emergency_broadcast"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
