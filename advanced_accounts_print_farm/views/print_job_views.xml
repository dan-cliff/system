<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_job_form" model="ir.ui.view">
        <field name="name">print.job.form.advanced_accounts</field>
        <field name="model">print.job</field>
        <field name="inherit_id" ref="print_farm_jobs.view_print_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group[1]" position="inside">
                <field name="adv_account_id" options="{'no_quick_create': True}"/>
                <field name="adv_contact_id" options="{'no_quick_create': True}"
                       context="{'default_account_id': adv_account_id}"/>
            </xpath>
        </field>
    </record>

    <record id="view_print_job_list" model="ir.ui.view">
        <field name="name">print.job.list.advanced_accounts</field>
        <field name="model">print.job</field>
        <field name="inherit_id" ref="print_farm_jobs.view_print_job_list"/>
        <field name="arch" type="xml">
            <field name="job_filename" position="before">
                <field name="adv_account_id" optional="show"/>
                <field name="adv_contact_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_print_job_search" model="ir.ui.view">
        <field name="name">print.job.search.advanced_accounts</field>
        <field name="model">print.job</field>
        <field name="inherit_id" ref="print_farm_jobs.view_print_job_search"/>
        <field name="arch" type="xml">
            <field name="job_filename" position="before">
                <field name="adv_account_id"/>
                <field name="adv_contact_id"/>
            </field>
            <xpath expr="//search" position="inside">
                <group>
                    <filter name="group_adv_account" string="Account" context="{'group_by': 'adv_account_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
