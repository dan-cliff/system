<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_dashboard_widget_type_list" model="ir.ui.view">
        <field name="name">custom.dashboard.widget.type.list</field>
        <field name="model">custom.dashboard.widget.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="code" optional="hide"/>
                <field name="description" optional="show"/>
                <field name="default_width" optional="hide"/>
                <field name="default_height" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_custom_dashboard_widget_type_form" model="ir.ui.view">
        <field name="name">custom.dashboard.widget.type.form</field>
        <field name="model">custom.dashboard.widget.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="icon"/>
                            <field name="description"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Size when added">
                            <field name="default_width"/>
                            <field name="default_height"/>
                        </group>
                    </group>
                    <group string="Technical" groups="base.group_no_one">
                        <group>
                            <field name="code"/>
                            <field name="data_mode"/>
                        </group>
                        <group>
                            <field name="supports_series"/>
                            <field name="requires_series"/>
                            <field name="uses_second_measure"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_dashboard_widget_type_search" model="ir.ui.view">
        <field name="name">custom.dashboard.widget.type.search</field>
        <field name="model">custom.dashboard.widget.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="category_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_custom_dashboard_widget_type" model="ir.actions.act_window">
        <field name="name">Widget Types</field>
        <field name="res_model">custom.dashboard.widget.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No widget types</p>
            <p>Rename, re-order or archive the widgets offered in the dashboard editor.</p>
        </field>
    </record>
</odoo>
