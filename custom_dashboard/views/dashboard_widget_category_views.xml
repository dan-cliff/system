<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_custom_dashboard_widget_category_list" model="ir.ui.view">
        <field name="name">custom.dashboard.widget.category.list</field>
        <field name="model">custom.dashboard.widget.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_custom_dashboard_widget_category_form" model="ir.ui.view">
        <field name="name">custom.dashboard.widget.category.form</field>
        <field name="model">custom.dashboard.widget.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <field name="type_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="code"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_custom_dashboard_widget_category_search" model="ir.ui.view">
        <field name="name">custom.dashboard.widget.category.search</field>
        <field name="model">custom.dashboard.widget.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_custom_dashboard_widget_category" model="ir.actions.act_window">
        <field name="name">Widget Categories</field>
        <field name="res_model">custom.dashboard.widget.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a widget category</p>
            <p>Categories group widget types in the dashboard editor's palette.</p>
        </field>
    </record>
</odoo>
