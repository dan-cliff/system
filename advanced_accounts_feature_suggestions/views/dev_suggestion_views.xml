<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dev_suggestion_view_form" model="ir.ui.view">
        <field name="name">dev.suggestion.form.advanced_accounts</field>
        <field name="model">dev.suggestion</field>
        <field name="inherit_id" ref="dev_feature_suggestions.dev_suggestion_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group/field[@name='partner_id']" position="before">
                <field name="adv_account_id" options="{'no_quick_create': True}"/>
                <field name="adv_contact_id" string="Suggested By" options="{'no_quick_create': True}"
                       context="{'default_account_id': adv_account_id}"/>
            </xpath>
            <xpath expr="//sheet/group/group/field[@name='partner_id']" position="attributes">
                <attribute name="invisible">adv_account_id or adv_contact_id or not partner_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="dev_suggestion_view_list" model="ir.ui.view">
        <field name="name">dev.suggestion.list.advanced_accounts</field>
        <field name="model">dev.suggestion</field>
        <field name="inherit_id" ref="dev_feature_suggestions.dev_suggestion_view_list"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id" optional="show"/>
                <field name="adv_contact_id" string="Suggested By (Contact)" optional="show"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <record id="dev_suggestion_view_search" model="ir.ui.view">
        <field name="name">dev.suggestion.search.advanced_accounts</field>
        <field name="model">dev.suggestion</field>
        <field name="inherit_id" ref="dev_feature_suggestions.dev_suggestion_view_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id"/>
                <field name="adv_contact_id" string="Suggested By (Contact)"/>
            </field>
            <xpath expr="//search" position="inside">
                <group>
                    <filter name="group_adv_account" string="Account" context="{'group_by': 'adv_account_id'}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
