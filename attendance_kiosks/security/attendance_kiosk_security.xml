<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="rule_attendance_kiosk_company" model="ir.rule">
            <field name="name">Attendance Kiosk: multi-company</field>
            <field name="model_id" ref="model_attendance_kiosk"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_kiosk_rule_company" model="ir.rule">
            <field name="name">Attendance Kiosk Rule: multi-company</field>
            <field name="model_id" ref="model_attendance_kiosk_rule"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_kiosk_questionnaire_line_company" model="ir.rule">
            <field name="name">Attendance Kiosk Questionnaire Trigger: multi-company</field>
            <field name="model_id" ref="model_attendance_kiosk_questionnaire_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_kiosk_questionnaire_company" model="ir.rule">
            <field name="name">Attendance Kiosk Questionnaire: multi-company</field>
            <field name="model_id" ref="model_attendance_kiosk_questionnaire"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_kiosk_response_company" model="ir.rule">
            <field name="name">Attendance Kiosk Response: multi-company</field>
            <field name="model_id" ref="model_attendance_kiosk_response"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- Sign in / out alerts: company aware, officers see their own, administrators see all -->
        <record id="rule_attendance_alert_company" model="ir.rule">
            <field name="name">Attendance Alert: multi-company</field>
            <field name="model_id" ref="model_attendance_alert"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_alert_condition_company" model="ir.rule">
            <field name="name">Attendance Alert Condition: multi-company</field>
            <field name="model_id" ref="model_attendance_alert_condition"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_alert_log_company" model="ir.rule">
            <field name="name">Attendance Alert History: multi-company</field>
            <field name="model_id" ref="model_attendance_alert_log"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_attendance_alert_own" model="ir.rule">
            <field name="name">Attendance Alert: own alerts</field>
            <field name="model_id" ref="model_attendance_alert"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        </record>

        <record id="rule_attendance_alert_all" model="ir.rule">
            <field name="name">Attendance Alert: administrators see all</field>
            <field name="model_id" ref="model_attendance_alert"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        </record>

        <record id="rule_attendance_alert_condition_own" model="ir.rule">
            <field name="name">Attendance Alert Condition: own alerts</field>
            <field name="model_id" ref="model_attendance_alert_condition"/>
            <field name="domain_force">[('alert_id.requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        </record>

        <record id="rule_attendance_alert_condition_all" model="ir.rule">
            <field name="name">Attendance Alert Condition: administrators see all</field>
            <field name="model_id" ref="model_attendance_alert_condition"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        </record>

        <record id="rule_attendance_alert_log_own" model="ir.rule">
            <field name="name">Attendance Alert History: own alerts</field>
            <field name="model_id" ref="model_attendance_alert_log"/>
            <field name="domain_force">[('requester_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_officer'))]"/>
        </record>

        <record id="rule_attendance_alert_log_all" model="ir.rule">
            <field name="name">Attendance Alert History: administrators see all</field>
            <field name="model_id" ref="model_attendance_alert_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
        </record>

    </data>
</odoo>
