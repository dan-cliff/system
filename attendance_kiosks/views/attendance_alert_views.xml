<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Alerts -->
    <record id="view_attendance_alert_list" model="ir.ui.view">
        <field name="name">attendance.alert.list</field>
        <field name="model">attendance.alert</field>
        <field name="arch" type="xml">
            <list string="Sign In / Out Alerts" decoration-muted="not active">
                <field name="name"/>
                <field name="employee_ids" widget="many2many_tags" invisible="all_employees"/>
                <field name="all_employees" optional="hide"/>
                <field name="recurrence"/>
                <field name="requester_id" widget="many2one_avatar_user" optional="show"/>
                <field name="channel_ids" widget="many2many_tags" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="last_triggered" options="{'numeric': True}" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_alert_form" model="ir.ui.view">
        <field name="name">attendance.alert.form</field>
        <field name="model">attendance.alert</field>
        <field name="arch" type="xml">
            <form string="Sign In / Out Alert">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Sent"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Tell me when Alice arrives"/></h1>
                    </div>
                    <group>
                        <group string="Who">
                            <field name="all_employees"/>
                            <field name="employee_ids" widget="many2many_avatar_employee"
                                   invisible="all_employees" required="not all_employees"
                                   options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Send To">
                            <field name="requester_id" widget="many2one_avatar_user" options="{'no_create': True}"
                                   groups="hr_attendance.group_hr_attendance_manager"/>
                            <field name="requester_id" widget="many2one_avatar_user" readonly="1"
                                   groups="!hr_attendance.group_hr_attendance_manager"/>
                            <field name="notify_requester"/>
                            <field name="channel_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="note" placeholder="Optional extra text added to the message"/>
                        </group>
                    </group>
                    <separator string="When"/>
                    <field name="condition_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="event"/>
                            <field name="location_ids" widget="many2many_tags" placeholder="Any site"
                                   options="{'no_create': True}"/>
                            <field name="company_id" column_invisible="1"/>
                        </list>
                    </field>
                    <p class="text-muted">
                        The alert runs when any one of these happens. A site is the work location of the
                        kiosk used; sign ins made elsewhere count as at the employee's own work location.
                    </p>
                    <group>
                        <group string="Runs">
                            <field name="recurrence" widget="radio"/>
                            <field name="last_triggered" options="{'numeric': True}" invisible="not last_triggered"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Schedule">
                            <label for="date_start" string="Dates"/>
                            <div class="o_row">
                                <field name="date_start" options="{'numeric': True}" placeholder="From now"/>
                                <span>to</span>
                                <field name="date_end" options="{'numeric': True}" placeholder="No end"/>
                            </div>
                            <label for="mon" string="Days"/>
                            <div class="d-flex flex-wrap gap-3">
                                <span class="d-inline-flex align-items-center gap-1"><field name="mon" nolabel="1"/>Mon</span>
                                <span class="d-inline-flex align-items-center gap-1"><field name="tue" nolabel="1"/>Tue</span>
                                <span class="d-inline-flex align-items-center gap-1"><field name="wed" nolabel="1"/>Wed</span>
                                <span class="d-inline-flex align-items-center gap-1"><field name="thu" nolabel="1"/>Thu</span>
                                <span class="d-inline-flex align-items-center gap-1"><field name="fri" nolabel="1"/>Fri</span>
                                <span class="d-inline-flex align-items-center gap-1"><field name="sat" nolabel="1"/>Sat</span>
                                <span class="d-inline-flex align-items-center gap-1"><field name="sun" nolabel="1"/>Sun</span>
                            </div>
                            <label for="time_from" string="Times"/>
                            <div class="o_row">
                                <field name="time_from" widget="float_time"/>
                                <span>to</span>
                                <field name="time_to" widget="float_time"/>
                            </div>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_attendance_alert_search" model="ir.ui.view">
        <field name="name">attendance.alert.search</field>
        <field name="model">attendance.alert</field>
        <field name="arch" type="xml">
            <search string="Sign In / Out Alerts">
                <field name="name"/>
                <field name="employee_ids"/>
                <field name="requester_id"/>
                <field name="channel_ids"/>
                <filter string="My Alerts" name="my_alerts" domain="[('requester_id', '=', uid)]"/>
                <separator/>
                <filter string="Once" name="once" domain="[('recurrence', '=', 'once')]"/>
                <filter string="Recurring" name="recurring" domain="[('recurrence', '=', 'recurring')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Requested By" name="group_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_attendance_alert" model="ir.actions.act_window">
        <field name="name">Sign In / Out Alerts</field>
        <field name="res_model">attendance.alert</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_alerts': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Get a message when someone arrives or leaves</p>
            <p>Choose who to watch and when, e.g. their first sign in today or every sign out at a site.
               You get a Discuss message, and arrivals and departures can also be posted to channels.</p>
        </field>
    </record>

    <!-- History -->
    <record id="view_attendance_alert_log_list" model="ir.ui.view">
        <field name="name">attendance.alert.log.list</field>
        <field name="model">attendance.alert.log</field>
        <field name="arch" type="xml">
            <list string="Alert History" create="false" edit="false" delete="false">
                <field name="date" options="{'numeric': True}"/>
                <field name="alert_id"/>
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="event"/>
                <field name="work_location_id"/>
                <field name="attendance_id" optional="hide"/>
                <field name="requester_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_alert_log_search" model="ir.ui.view">
        <field name="name">attendance.alert.log.search</field>
        <field name="model">attendance.alert.log</field>
        <field name="arch" type="xml">
            <search string="Alert History">
                <field name="alert_id"/>
                <field name="employee_id"/>
                <field name="work_location_id"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Alert" name="group_alert" context="{'group_by': 'alert_id'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Site" name="group_site" context="{'group_by': 'work_location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_attendance_alert_log" model="ir.actions.act_window">
        <field name="name">Alert History</field>
        <field name="res_model">attendance.alert.log</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No alerts sent yet</p>
        </field>
    </record>

    <!-- Employee form: shortcut to create an alert for this employee -->
    <record id="action_attendance_alert_for_employee" model="ir.actions.act_window">
        <field name="name">Sign In / Out Alerts</field>
        <field name="res_model">attendance.alert</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_ids', 'in', [active_id])]</field>
        <field name="context">{'default_employee_ids': [active_id]}</field>
    </record>

    <record id="view_employee_form_attendance_alert" model="ir.ui.view">
        <field name="name">hr.employee.form.attendance.alert</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="%(action_attendance_alert_for_employee)d" type="action"
                        class="oe_stat_button" icon="fa-bell"
                        groups="hr_attendance.group_hr_attendance_officer">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Alerts</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
