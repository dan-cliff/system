<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="role_talent_admin" model="permission.role">
            <field name="name">Talent – Administrator</field>
            <field name="description">Everything in Talent: every job position and application, deleting them, Configuration and every Talent permission.</field>
            <field name="line_ids" eval="[
                (0, 0, {'privilege_id': ref('hr_recruitment.res_groups_privilege_recruitment'), 'group_id': ref('hr_recruitment.group_hr_recruitment_manager')})
            ]"/>
        </record>
        <record id="role_talent_manager" model="permission.role">
            <field name="name">Talent – Manager</field>
            <field name="description">Create, view and edit every job position and application. No Configuration.</field>
            <field name="line_ids" eval="[
                (0, 0, {'privilege_id': ref('hr_recruitment.res_groups_privilege_recruitment'), 'group_id': ref('hr_recruitment.group_hr_recruitment_user')})
            ]"/>
        </record>
        <record id="role_talent_employee" model="permission.role">
            <field name="name">Talent – Employee</field>
            <field name="description">View and edit the applications and job positions they are an interviewer for.</field>
            <field name="line_ids" eval="[
                (0, 0, {'privilege_id': ref('hr_recruitment.res_groups_privilege_recruitment'), 'group_id': ref('hr_recruitment.group_hr_recruitment_interviewer')})
            ]"/>
        </record>
    </data>
</odoo>
