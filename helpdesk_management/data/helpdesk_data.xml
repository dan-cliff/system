<?xml version="1.0" encoding="utf-8"?>
<!-- Starting stages, ticket types and team. noupdate so edits are kept. -->
<odoo noupdate="1">
    <!-- Stages -->
    <record id="stage_new" model="helpdesk.stage">
        <field name="name">New</field>
        <field name="sequence">0</field>
        <field name="template_id" ref="ticket_received_email_template"/>
    </record>
    <record id="stage_in_progress" model="helpdesk.stage">
        <field name="name">In Progress</field>
        <field name="sequence">10</field>
    </record>
    <record id="stage_on_hold" model="helpdesk.stage">
        <field name="name">On Hold</field>
        <field name="sequence">20</field>
        <field name="description">Waiting on the customer or a third party.</field>
    </record>
    <record id="stage_solved" model="helpdesk.stage">
        <field name="name">Solved</field>
        <field name="sequence">30</field>
        <field name="fold" eval="True"/>
        <field name="rating_template_id" ref="rating_ticket_request_email_template"/>
    </record>
    <record id="stage_cancelled" model="helpdesk.stage">
        <field name="name">Cancelled</field>
        <field name="sequence">40</field>
        <field name="fold" eval="True"/>
    </record>

    <!-- Ticket types -->
    <record id="ticket_type_question" model="helpdesk.ticket.type"><field name="name">Question</field><field name="sequence">10</field></record>
    <record id="ticket_type_issue" model="helpdesk.ticket.type"><field name="name">Issue</field><field name="sequence">20</field></record>
    <record id="ticket_type_request" model="helpdesk.ticket.type"><field name="name">Request</field><field name="sequence">30</field></record>
    <record id="ticket_type_feedback" model="helpdesk.ticket.type"><field name="name">Feedback</field><field name="sequence">40</field></record>

    <!-- A first team, using every stage above -->
    <record id="helpdesk_team_customer_care" model="helpdesk.team">
        <field name="name">Customer Care</field>
        <field name="sequence">1</field>
        <field name="member_ids" eval="[(6, 0, [ref('base.user_admin')])]"/>
        <field name="stage_ids" eval="[(6, 0, [ref('stage_new'), ref('stage_in_progress'), ref('stage_on_hold'), ref('stage_solved'), ref('stage_cancelled')])]"/>
    </record>
</odoo>
