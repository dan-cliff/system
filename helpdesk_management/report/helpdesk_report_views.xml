<odoo>
    <record id="helpdesk_ticket_view_pivot" model="ir.ui.view">
        <field name="name">helpdesk.ticket.pivot</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <pivot string="Ticket Analysis" sample="1">
                <field name="team_id" type="row"/>
                <field name="stage_id" type="col"/>
                <field name="close_hours" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="helpdesk_ticket_view_graph" model="ir.ui.view">
        <field name="name">helpdesk.ticket.graph</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <graph string="Ticket Analysis" type="bar" sample="1">
                <field name="create_date" interval="month"/>
                <field name="team_id"/>
            </graph>
        </field>
    </record>

    <record id="helpdesk_ticket_action_analysis" model="ir.actions.act_window">
        <field name="name">Ticket Analysis</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('helpdesk_ticket_view_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('helpdesk_ticket_view_pivot')})]"/>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No data yet</p>
            <p>Analyse ticket volumes and how long they take to assign and close, by team, agent or customer.</p>
        </field>
    </record>

    <record id="helpdesk_sla_status_action_analysis" model="ir.actions.act_window">
        <field name="name">SLA Status Analysis</field>
        <field name="res_model">helpdesk.sla.status</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No data yet</p>
            <p>See which SLA policies are reached on time and which fail, by team or agent.</p>
        </field>
    </record>
</odoo>
