<odoo>
    <record id="helpdesk_stage_view_list" model="ir.ui.view">
        <field name="name">helpdesk.stage.list</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="team_ids" widget="many2many_tags"/>
                <field name="fold"/>
                <field name="template_id" optional="show"/>
                <field name="rating_template_id" optional="show"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_stage_view_form" model="ir.ui.view">
        <field name="name">helpdesk.stage.form</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Waiting on Customer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_ids" widget="many2many_tags"/>
                            <field name="fold"/>
                            <field name="sequence" groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="template_id" context="{'default_model': 'helpdesk.ticket'}"/>
                            <field name="rating_template_id" context="{'default_model': 'helpdesk.ticket'}"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What this stage means for the team..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_stage_view_search" model="ir.ui.view">
        <field name="name">helpdesk.stage.search</field>
        <field name="model">helpdesk.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="team_ids"/>
                <filter string="Closing Stages" name="fold" domain="[('fold', '=', True)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="helpdesk_stage_action" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">helpdesk.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a stage</p>
            <p>Stages are the columns of the ticket board. Share them between teams, email the
               customer when a ticket reaches one, and mark closing stages to close tickets.</p>
        </field>
    </record>
</odoo>
