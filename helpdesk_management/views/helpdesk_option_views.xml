<odoo>
    <!-- Ticket types and tags: editable lists under Configuration. -->

    <record id="helpdesk_ticket_type_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.list</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_type_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.form</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_type_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.type.search</field>
        <field name="model">helpdesk.ticket.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="helpdesk_ticket_type_action" model="ir.actions.act_window">
        <field name="name">Ticket Types</field>
        <field name="res_model">helpdesk.ticket.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a ticket type</p>
            <p>Types such as Question, Issue or Request sort tickets and let SLA policies target them.</p>
        </field>
    </record>

    <record id="helpdesk_tag_view_list" model="ir.ui.view">
        <field name="name">helpdesk.tag.list</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_tag_view_form" model="ir.ui.view">
        <field name="name">helpdesk.tag.form</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_tag_view_search" model="ir.ui.view">
        <field name="name">helpdesk.tag.search</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="helpdesk_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a tag</p>
            <p>Tags label tickets for searching and reporting, and let SLA policies target them.</p>
        </field>
    </record>

    <!-- Ticket sources -->
    <record id="helpdesk_ticket_source_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.source.list</field>
        <field name="model">helpdesk.ticket.source</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_source_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.source.form</field>
        <field name="model">helpdesk.ticket.source</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_source_view_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.source.search</field>
        <field name="model">helpdesk.ticket.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="helpdesk_ticket_source_action" model="ir.actions.act_window">
        <field name="name">Ticket Sources</field>
        <field name="res_model">helpdesk.ticket.source</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a ticket source</p>
            <p>Sources record how tickets come in. Email, Website Form, Help Centre and Direct Entry
               are set automatically; add others (e.g. Phone) to pick by hand.</p>
        </field>
    </record>

    <!-- Customer sentiments -->
    <record id="helpdesk_sentiment_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sentiment.list</field>
        <field name="model">helpdesk.sentiment</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="score"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_sentiment_view_form" model="ir.ui.view">
        <field name="name">helpdesk.sentiment.form</field>
        <field name="model">helpdesk.sentiment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="score"/>
                        <field name="color" widget="color_picker"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_sentiment_view_search" model="ir.ui.view">
        <field name="name">helpdesk.sentiment.search</field>
        <field name="model">helpdesk.sentiment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="helpdesk_sentiment_action" model="ir.actions.act_window">
        <field name="name">Customer Sentiments</field>
        <field name="res_model">helpdesk.sentiment</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a customer sentiment</p>
            <p>Sentiments describe how a customer feels about their ticket. The score (1 to 5) is
               averaged in the dashboard charts; the AI picks one from this list.</p>
        </field>
    </record>
</odoo>
