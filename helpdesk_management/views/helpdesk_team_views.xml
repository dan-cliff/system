<odoo>
    <!-- Overview: one card per team with its ticket counts -->
    <record id="helpdesk_team_view_kanban" model="ir.ui.view">
        <field name="name">helpdesk.team.kanban.dashboard</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <kanban highlight_color="color" create="0" action="action_view_tickets" type="object"
                    class="o_kanban_dashboard" sample="1">
                <field name="use_rating"/>
                <field name="use_sla"/>
                <field name="use_website_form"/>
                <templates>
                    <t t-name="menu">
                        <div class="container">
                            <div class="row">
                                <div class="col-6">
                                    <h5 role="menuitem" class="o_kanban_card_manage_title"><span>View</span></h5>
                                    <div role="menuitem"><a name="action_view_tickets" type="object">Open Tickets</a></div>
                                    <div role="menuitem"><a name="action_view_my_tickets" type="object">My Tickets</a></div>
                                    <div role="menuitem"><a name="action_view_unassigned_tickets" type="object">Unassigned</a></div>
                                    <div role="menuitem" t-if="record.use_rating.raw_value">
                                        <a name="action_view_ratings" type="object">Customer Ratings</a>
                                    </div>
                                    <div role="menuitem" t-if="record.use_website_form.raw_value">
                                        <a name="action_open_website_form" type="object">Website Form</a>
                                    </div>
                                </div>
                                <div class="col-6" groups="helpdesk_management.group_helpdesk_team_update">
                                    <h5 role="menuitem" class="o_kanban_card_manage_title"><span>Configure</span></h5>
                                    <div role="menuitem"><a type="open">Settings</a></div>
                                </div>
                            </div>
                            <div class="o_kanban_card_manage_settings row" groups="helpdesk_management.group_helpdesk_team_update">
                                <div role="menuitem" aria-haspopup="true" class="col-12">
                                    <field name="color" widget="kanban_color_picker"/>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline">
                            <field name="name" class="fw-bold fs-4"/>
                            <field name="alias_email" class="ms-2 small text-muted" invisible="not alias_email"/>
                        </div>
                        <div class="row g-2 mt-2">
                            <div class="col-6">
                                <button class="btn btn-primary w-100" name="action_view_tickets" type="object">
                                    <field name="open_ticket_count"/> Open
                                </button>
                            </div>
                            <div class="col-6 d-flex flex-column small">
                                <a name="action_view_my_tickets" type="object">
                                    <field name="my_ticket_count"/> My Tickets
                                </a>
                                <a name="action_view_unassigned_tickets" type="object">
                                    <field name="unassigned_ticket_count"/> Unassigned
                                </a>
                                <a name="action_view_urgent_tickets" type="object">
                                    <field name="urgent_ticket_count"/> Urgent
                                </a>
                                <a name="action_view_sla_failed_tickets" type="object" t-if="record.use_sla.raw_value"
                                   t-att-class="record.sla_failed_ticket_count.raw_value ? 'text-danger' : ''">
                                    <field name="sla_failed_ticket_count"/> Failed SLA
                                </a>
                            </div>
                        </div>
                        <footer class="pt-2" t-if="record.use_rating.raw_value">
                            <a name="action_view_ratings" type="object" class="small">
                                <i class="fa fa-smile-o me-1" title="Customer Satisfaction"/>
                                <t t-if="record.rating_percentage_satisfaction.raw_value &gt;= 0">
                                    <field name="rating_percentage_satisfaction"/>% satisfied (last 30 days)
                                </t>
                                <t t-else="">No ratings yet</t>
                            </a>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="helpdesk_team_view_list" model="ir.ui.view">
        <field name="name">helpdesk.team.list</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="alias_email" optional="show"/>
                <field name="member_ids" widget="many2many_avatar_user" optional="show"/>
                <field name="assign_method" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_team_view_form" model="ir.ui.view">
        <field name="name">helpdesk.team.form</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <field name="open_ticket_count" widget="statinfo" string="Open Tickets"/>
                        </button>
                        <button name="action_open_website_form" type="object" class="oe_stat_button" icon="fa-globe"
                                invisible="not use_website_form or not id" string="Website Form"/>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Customer Care"/></h1>
                    </div>
                    <field name="description" placeholder="Team description, shown on the website form..."/>
                    <group>
                        <group string="Team">
                            <field name="member_ids" widget="many2many_avatar_user"
                                   options="{'no_create': True}"/>
                            <field name="assign_method" widget="radio"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Channels">
                            <label for="alias_name" string="Email Alias"/>
                            <div class="o_row">
                                <field name="alias_id" invisible="1"/>
                                <field name="alias_name" placeholder="e.g. support"/>
                                <span>@</span>
                                <field name="alias_domain_id" options="{'no_create': True, 'no_open': True}"
                                       placeholder="e.g. mycompany.com"/>
                            </div>
                            <field name="alias_contact" string="Accept Emails From" invisible="not alias_name"/>
                            <field name="use_website_form"/>
                            <field name="website_form_url" widget="url" invisible="not use_website_form or not id"/>
                            <field name="allow_portal_ticket_closing"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Stages" name="stages">
                            <field name="stage_ids" context="{'default_team_id': id}">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="fold"/>
                                    <field name="template_id"/>
                                    <field name="rating_template_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Performance" name="performance">
                            <group>
                                <group string="SLA Policies">
                                    <field name="use_sla"/>
                                    <field name="resource_calendar_id" options="{'no_create': True}"/>
                                </group>
                                <group string="Customer Ratings">
                                    <field name="use_rating"/>
                                    <div colspan="2" class="text-muted" invisible="not use_rating">
                                        Customers are asked to rate the service when a ticket reaches a stage
                                        with a Rating Request (by default: Solved).
                                    </div>
                                </group>
                            </group>
                            <field name="sla_ids" invisible="not use_sla" context="{'default_team_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="priority"/>
                                    <field name="ticket_type_ids" widget="many2many_tags"/>
                                    <field name="stage_id"/>
                                    <field name="time" widget="float_time"/>
                                </list>
                            </field>
                        </page>
                        <page string="Automatic Closing" name="auto_close">
                            <group>
                                <group>
                                    <field name="auto_close_ticket"/>
                                    <field name="auto_close_day" invisible="not auto_close_ticket"/>
                                    <field name="from_stage_ids" widget="many2many_tags" invisible="not auto_close_ticket"
                                           options="{'no_create': True}"/>
                                    <field name="to_stage_id" invisible="not auto_close_ticket"
                                           required="auto_close_ticket" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="helpdesk_team_view_search" model="ir.ui.view">
        <field name="name">helpdesk.team.search</field>
        <field name="model">helpdesk.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="member_ids"/>
                <filter string="My Teams" name="my_teams" domain="[('member_ids', 'in', uid)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="helpdesk_team_action_overview" model="ir.actions.act_window">
        <field name="name">Helpdesk Overview</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="helpdesk_team_view_kanban"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a helpdesk team</p>
            <p>Teams group tickets, agents, stages and SLA policies. Add one under Configuration.</p>
        </field>
    </record>

    <record id="helpdesk_team_action" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">helpdesk.team</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (0, 0, {'view_mode': 'list', 'view_id': ref('helpdesk_team_view_list')}), (0, 0, {'view_mode': 'form', 'view_id': ref('helpdesk_team_view_form')})]"/>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a helpdesk team</p>
            <p>Teams group tickets, agents, stages and SLA policies.</p>
        </field>
    </record>

    <!-- Customer ratings of tickets -->
    <record id="helpdesk_rating_action" model="ir.actions.act_window">
        <field name="name">Customer Ratings</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="domain">[('res_model', '=', 'helpdesk.ticket'), ('consumed', '=', True)]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer ratings yet</p>
            <p>Customers are asked to rate the service when their ticket reaches a stage with a
               Rating Request, for teams with Customer Ratings enabled.</p>
        </field>
    </record>
</odoo>
