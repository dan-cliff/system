<odoo>
    <record id="helpdesk_sla_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sla.list</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="team_id"/>
                <field name="priority" optional="show"/>
                <field name="ticket_type_ids" widget="many2many_tags" optional="show"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="hide"/>
                <field name="partner_ids" widget="many2many_tags" optional="hide"/>
                <field name="stage_id"/>
                <field name="time" widget="float_time"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_sla_view_form" model="ir.ui.view">
        <field name="name">helpdesk.sla.form</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_tickets" type="object" class="oe_stat_button" icon="fa-life-ring">
                            <field name="ticket_count" widget="statinfo" string="Open Tickets"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Urgent tickets answered within 4 hours"/></h1>
                    </div>
                    <group>
                        <group string="Applies to">
                            <field name="team_id"/>
                            <field name="priority" placeholder="Any priority"/>
                            <field name="ticket_type_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create': True}"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Target">
                            <field name="stage_id" options="{'no_create': True}"/>
                            <label for="time"/>
                            <div class="o_row">
                                <field name="time" widget="float_time"/>
                                <span>working hours</span>
                            </div>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe the policy..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_sla_view_search" model="ir.ui.view">
        <field name="name">helpdesk.sla.search</field>
        <field name="model">helpdesk.sla</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="team_id"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Team" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="Target Stage" name="group_stage" context="{'group_by': 'stage_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="helpdesk_sla_action" model="ir.actions.act_window">
        <field name="name">SLA Policies</field>
        <field name="res_model">helpdesk.sla</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an SLA policy</p>
            <p>An SLA policy sets how many working hours a team has to get tickets to a stage,
               for tickets of a given priority, type, tag or customer.</p>
        </field>
    </record>

    <!-- SLA statuses, shown on the ticket and in the SLA analysis -->
    <record id="helpdesk_sla_status_view_list" model="ir.ui.view">
        <field name="name">helpdesk.sla.status.list</field>
        <field name="model">helpdesk.sla.status</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0"
                  decoration-danger="status == 'failed'" decoration-success="status == 'reached'">
                <field name="ticket_id"/>
                <field name="sla_id"/>
                <field name="team_id" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="sla_stage_id"/>
                <field name="deadline" options="{'numeric': True}"/>
                <field name="reached_datetime" options="{'numeric': True}"/>
                <field name="exceeded_hours" widget="float_time" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'failed'" decoration-success="status == 'reached'"
                       decoration-info="status == 'ongoing'"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_sla_status_view_pivot" model="ir.ui.view">
        <field name="name">helpdesk.sla.status.pivot</field>
        <field name="model">helpdesk.sla.status</field>
        <field name="arch" type="xml">
            <pivot string="SLA Status Analysis" sample="1">
                <field name="team_id" type="row"/>
                <field name="reached_late" type="col"/>
                <field name="exceeded_hours" type="measure" widget="float_time"/>
            </pivot>
        </field>
    </record>

    <record id="helpdesk_sla_status_view_graph" model="ir.ui.view">
        <field name="name">helpdesk.sla.status.graph</field>
        <field name="model">helpdesk.sla.status</field>
        <field name="arch" type="xml">
            <graph string="SLA Status Analysis" type="bar" stacked="1" sample="1">
                <field name="sla_id"/>
                <field name="reached_late"/>
            </graph>
        </field>
    </record>

    <record id="helpdesk_sla_status_view_search" model="ir.ui.view">
        <field name="name">helpdesk.sla.status.search</field>
        <field name="model">helpdesk.sla.status</field>
        <field name="arch" type="xml">
            <search>
                <field name="ticket_id"/>
                <field name="sla_id"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <filter string="Ongoing" name="ongoing" domain="[('status', 'in', ['ongoing'])]"/>
                <filter string="Reached" name="reached" domain="[('status', 'in', ['reached'])]"/>
                <filter string="Failed" name="failed" domain="[('status', 'in', ['failed'])]"/>
                <separator/>
                <filter string="Deadline" name="filter_deadline" date="deadline"/>
                <group>
                    <filter string="Team" name="group_team" context="{'group_by': 'team_id'}"/>
                    <filter string="SLA Policy" name="group_sla" context="{'group_by': 'sla_id'}"/>
                    <filter string="Assigned to" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Deadline" name="group_deadline" context="{'group_by': 'deadline:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
