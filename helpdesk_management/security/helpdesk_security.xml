<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every ticket permission below is
         its own privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Helpdesk user group, which holds
         the ACLs and a deny rule, so users can only do what a permission opens.
         SLA statuses follow their ticket. Teams, stages, SLA policies and the
         Configuration lists: read for every Helpdesk user, full for Administrators.
         "Own" = created by them or assigned to them (the Agent). -->

    <record id="res_groups_privilege_helpdesk" model="res.groups.privilege">
        <field name="name">Helpdesk</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="sequence">10</field>
        <field name="description">Configuration of the Helpdesk app.</field>
    </record>

    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">Helpdesk: User</field>
        <field name="privilege_id" eval="False"/>
        <field name="comment">Technical: given by every Helpdesk permission. Opens the app; what users can do with tickets comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_helpdesk_ticket_create_only" model="res.groups.privilege">
        <field name="name">Tickets: Create Only</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="sequence">20</field>
        <field name="description">Create tickets, and view their own (no editing after saving).</field>
    </record>
    <record id="group_helpdesk_ticket_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_helpdesk_ticket_create_only"/>
        <field name="comment">Create tickets, and view their own (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="privilege_helpdesk_ticket_edit_own" model="res.groups.privilege">
        <field name="name">Tickets: Create and Edit Own</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="sequence">30</field>
        <field name="description">Create tickets, and view and edit their own (created by them or assigned to them).</field>
    </record>
    <record id="group_helpdesk_ticket_edit_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_helpdesk_ticket_edit_own"/>
        <field name="comment">Create tickets, and view and edit their own (created by them or assigned to them).</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="privilege_helpdesk_ticket_edit_team" model="res.groups.privilege">
        <field name="name">Tickets: Create and Edit My Team</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="sequence">40</field>
        <field name="description">Create tickets, and view and edit their own and their team&apos;s.</field>
    </record>
    <record id="group_helpdesk_ticket_edit_team" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_helpdesk_ticket_edit_team"/>
        <field name="comment">Create tickets, and view and edit their own and their team&apos;s.</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="privilege_helpdesk_ticket_edit_all" model="res.groups.privilege">
        <field name="name">Tickets: Create and Edit All</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="sequence">50</field>
        <field name="description">Create, view and edit every ticket.</field>
    </record>
    <record id="group_helpdesk_ticket_edit_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_helpdesk_ticket_edit_all"/>
        <field name="comment">Create, view and edit every ticket.</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="privilege_helpdesk_ticket_view_all" model="res.groups.privilege">
        <field name="name">Tickets: View All</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="sequence">60</field>
        <field name="description">View every ticket.</field>
    </record>
    <record id="group_helpdesk_ticket_view_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_helpdesk_ticket_view_all"/>
        <field name="comment">View every ticket.</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="privilege_helpdesk_ticket_delete_own" model="res.groups.privilege">
        <field name="name">Tickets: Delete Own</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="sequence">70</field>
        <field name="description">Delete their own tickets (created by them or assigned to them).</field>
    </record>
    <record id="group_helpdesk_ticket_delete_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_helpdesk_ticket_delete_own"/>
        <field name="comment">Delete their own tickets (created by them or assigned to them).</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="privilege_helpdesk_ticket_delete_all" model="res.groups.privilege">
        <field name="name">Tickets: Delete All</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
        <field name="sequence">80</field>
        <field name="description">Delete any ticket.</field>
    </record>
    <record id="group_helpdesk_ticket_delete_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_helpdesk_ticket_delete_all"/>
        <field name="comment">Delete any ticket.</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
    </record>

    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
        <field name="comment">Every Helpdesk permission, including deleting any ticket, plus Configuration (teams, stages, SLA policies, types, tags, sources and sentiments).</field>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_ticket_create_only')), (4, ref('group_helpdesk_ticket_edit_own')), (4, ref('group_helpdesk_ticket_edit_team')), (4, ref('group_helpdesk_ticket_edit_all')), (4, ref('group_helpdesk_ticket_view_all')), (4, ref('group_helpdesk_ticket_delete_own')), (4, ref('group_helpdesk_ticket_delete_all'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Without a permission, nothing -->
    <record id="rule_helpdesk_ticket_deny" model="ir.rule">
        <field name="name">Tickets: only through a permission</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <record id="rule_helpdesk_sla_status_deny" model="ir.rule">
        <field name="name">Ticket SLA Status: only through a permission</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <!-- Create Only -->
    <record id="rule_helpdesk_ticket_create_only" model="ir.rule">
        <field name="name">Tickets: Create Only</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_create_only'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_helpdesk_sla_status_create_only" model="ir.rule">
        <field name="name">Ticket SLA Status: Create Only</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_create_only'))]"/>
        <field name="domain_force">['|', ('ticket_id.create_uid', '=', user.id), ('ticket_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Create and Edit Own -->
    <record id="rule_helpdesk_ticket_edit_own" model="ir.rule">
        <field name="name">Tickets: Create and Edit Own</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_edit_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_helpdesk_sla_status_edit_own" model="ir.rule">
        <field name="name">Ticket SLA Status: Create and Edit Own</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_edit_own'))]"/>
        <field name="domain_force">['|', ('ticket_id.create_uid', '=', user.id), ('ticket_id.user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Create and Edit My Team -->
    <record id="rule_helpdesk_ticket_edit_team" model="ir.rule">
        <field name="name">Tickets: Create and Edit My Team</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_edit_team'))]"/>
        <field name="domain_force">['|', '|', '|', ('create_uid', '=', user.id), ('user_id', '=', user.id), ('create_uid.employee_ids', 'child_of', user.employee_ids.ids), ('user_id.employee_ids', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_helpdesk_sla_status_edit_team" model="ir.rule">
        <field name="name">Ticket SLA Status: Create and Edit My Team</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_edit_team'))]"/>
        <field name="domain_force">['|', '|', '|', ('ticket_id.create_uid', '=', user.id), ('ticket_id.user_id', '=', user.id), ('ticket_id.create_uid.employee_ids', 'child_of', user.employee_ids.ids), ('ticket_id.user_id.employee_ids', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Create and Edit All -->
    <record id="rule_helpdesk_ticket_edit_all" model="ir.rule">
        <field name="name">Tickets: Create and Edit All</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_helpdesk_sla_status_edit_all" model="ir.rule">
        <field name="name">Ticket SLA Status: Create and Edit All</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- View All -->
    <record id="rule_helpdesk_ticket_view_all" model="ir.rule">
        <field name="name">Tickets: View All</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_helpdesk_sla_status_view_all" model="ir.rule">
        <field name="name">Ticket SLA Status: View All</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- Delete Own -->
    <record id="rule_helpdesk_ticket_delete_own" model="ir.rule">
        <field name="name">Tickets: Delete Own</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_delete_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_helpdesk_sla_status_delete_own" model="ir.rule">
        <field name="name">Ticket SLA Status: Delete Own</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_delete_own'))]"/>
        <field name="domain_force">['|', ('ticket_id.create_uid', '=', user.id), ('ticket_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <!-- Delete All -->
    <record id="rule_helpdesk_ticket_delete_all" model="ir.rule">
        <field name="name">Tickets: Delete All</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_helpdesk_sla_status_delete_all" model="ir.rule">
        <field name="name">Ticket SLA Status: Delete All</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="groups" eval="[(4, ref('group_helpdesk_ticket_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

    <!-- Multi-company -->
    <record id="helpdesk_team_rule_company" model="ir.rule">
        <field name="name">Helpdesk Team: multi-company</field>
        <field name="model_id" ref="model_helpdesk_team"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="helpdesk_ticket_rule_company" model="ir.rule">
        <field name="name">Helpdesk Ticket: multi-company</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="helpdesk_sla_rule_company" model="ir.rule">
        <field name="name">Helpdesk SLA Policy: multi-company</field>
        <field name="model_id" ref="model_helpdesk_sla"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="helpdesk_sla_status_rule_company" model="ir.rule">
        <field name="name">Helpdesk SLA Status: multi-company</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Portal: customers see the tickets they, or anyone at their company,
         follow (the customer of a ticket follows it). -->
    <record id="helpdesk_ticket_rule_portal" model="ir.rule">
        <field name="name">Helpdesk Ticket: portal users see their company's tickets</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('message_partner_ids', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
