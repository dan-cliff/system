<odoo>
    <record id="res_groups_privilege_helpdesk" model="res.groups.privilege">
        <field name="name">Helpdesk</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
    </record>

    <!-- Users (agents): work on tickets of every team. Read-only on teams,
         stages, SLA policies and the Configuration lists. -->
    <record id="group_helpdesk_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Administrators: everything users can do, plus configuration (teams,
         stages, SLA policies, types, tags) and deleting tickets. -->
    <record id="group_helpdesk_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('group_helpdesk_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company -->
    <record id="helpdesk_team_rule_company" model="ir.rule">
        <field name="name">Helpdesk Team: multi-company</field>
        <field name="model_id" ref="model_helpdesk_team"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="helpdesk_ticket_rule_company" model="ir.rule">
        <field name="name">Helpdesk Ticket: multi-company</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="helpdesk_sla_rule_company" model="ir.rule">
        <field name="name">Helpdesk SLA Policy: multi-company</field>
        <field name="model_id" ref="model_helpdesk_sla"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="helpdesk_sla_status_rule_company" model="ir.rule">
        <field name="name">Helpdesk SLA Status: multi-company</field>
        <field name="model_id" ref="model_helpdesk_sla_status"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Portal: customers see the tickets they, or anyone at their company,
         follow (the customer of a ticket follows it). -->
    <record id="helpdesk_ticket_rule_portal" model="ir.rule">
        <field name="name">Helpdesk Ticket: portal users see their company's tickets</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('message_partner_ids', 'child_of', [user.commercial_partner_id.id])]</field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
