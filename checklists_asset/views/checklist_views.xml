<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="checklist_view_form" model="ir.ui.view">
        <field name="name">checklist.checklist.form.inherit.asset</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='checklist']/field[@name='template_id']" position="after">
                <field name="asset_enabled" invisible="1"/>
                <field name="asset_required" invisible="1"/>
                <field name="asset_domain" invisible="1"/>
                <!-- The label is the template's Asset Selector Label, or "Asset". -->
                <!-- Public submissions have no asset. -->
                <div class="o_td_label" invisible="not asset_enabled or is_public">
                    <label for="asset_id" string="Asset" invisible="asset_label"/>
                    <field name="asset_label" class="o_form_label" invisible="not asset_label"/>
                </div>
                <field name="asset_id" nolabel="1" invisible="not asset_enabled or is_public"
                       required="asset_enabled and asset_required and not is_public" readonly="state == 'done'"
                       domain="asset_domain" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="checklist_view_list" model="ir.ui.view">
        <field name="name">checklist.checklist.list.inherit.asset</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_list"/>
        <field name="arch" type="xml">
            <field name="template_id" position="after">
                <field name="asset_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="checklist_view_search" model="ir.ui.view">
        <field name="name">checklist.checklist.search.inherit.asset</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_search"/>
        <field name="arch" type="xml">
            <field name="template_id" position="after">
                <field name="asset_id"/>
            </field>
            <filter name="group_template" position="after">
                <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
            </filter>
        </field>
    </record>

</odoo>
