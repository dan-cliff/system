<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_account" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.advanced_expenses_account</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="advanced_expenses.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <setting id="expenses_account" position="inside">
                <div class="content-group mt-2" invisible="not module_advanced_expenses_account">
                    <div class="row">
                        <label for="expense_journal_id" class="col-lg-4 o_light_label"/>
                        <field name="expense_journal_id" options="{'no_create': True}"/>
                    </div>
                </div>
            </setting>
        </field>
    </record>
</odoo>
