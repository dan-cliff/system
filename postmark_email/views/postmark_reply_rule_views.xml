<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="postmark_reply_rule_view_list" model="ir.ui.view">
        <field name="name">postmark.reply.rule.list</field>
        <field name="model">postmark.reply.rule</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="model_id" options="{'no_create': True}"/>
                <field name="reply_to"/>
                <field name="stream_id" options="{'no_create': True}"/>
                <field name="alias_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="postmark_reply_rule_view_form" model="ir.ui.view">
        <field name="name">postmark.reply.rule.form</field>
        <field name="model">postmark.reply.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="reply_to"/>
                        </group>
                        <group>
                            <field name="stream_id" options="{'no_create': True}"/>
                            <field name="alias_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="postmark_reply_rule_view_search" model="ir.ui.view">
        <field name="name">postmark.reply.rule.search</field>
        <field name="model">postmark.reply.rule</field>
        <field name="arch" type="xml">
            <search>
                <field name="model_id"/>
                <field name="reply_to"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="postmark_reply_rule_action" model="ir.actions.act_window">
        <field name="name">Postmark Reply Addresses</field>
        <field name="res_model">postmark.reply.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a reply address for a model</p>
            <p>Emails sent from records of the model reply to this address, through the chosen
               message stream. Models without one use the fallback reply-to in Settings.</p>
        </field>
    </record>
</odoo>
