<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="postmark_message_stream_view_list" model="ir.ui.view">
        <field name="name">postmark.message.stream.list</field>
        <field name="model">postmark.message.stream</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stream_id"/>
                <field name="stream_type"/>
                <field name="alias_id" optional="show"/>
                <field name="description" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="postmark_message_stream_view_form" model="ir.ui.view">
        <field name="name">postmark.message.stream.form</field>
        <field name="model">postmark.message.stream</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="stream_id" readonly="id"/>
                            <field name="stream_type" readonly="id"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="alias_id"/>
                            <field name="webhook_id" groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <div class="text-muted">
                        New streams are created in Postmark when saved (Postmark allows 10 per
                        server). Renaming or archiving a stream here does the same in Postmark.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="postmark_message_stream_view_search" model="ir.ui.view">
        <field name="name">postmark.message.stream.search</field>
        <field name="model">postmark.message.stream</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="stream_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'stream_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="postmark_message_stream_action" model="ir.actions.act_window">
        <field name="name">Postmark Message Streams</field>
        <field name="res_model">postmark.message.stream</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
