            <field name="description">Everything in Payroll: every pay run, payslip and payroll employee permission, including deleting, approving and marking pay runs as paid, plus Configuration.</field>
            <field name="line_ids" eval="[
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_advanced_payroll'), 'group_id': ref('advanced_payroll.group_payroll_admin')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_run_create_only'), 'group_id': ref('advanced_payroll.group_run_create_only')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_run_edit_own'), 'group_id': ref('advanced_payroll.group_run_edit_own')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_run_edit_team'), 'group_id': ref('advanced_payroll.group_run_edit_team')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_run_edit_all'), 'group_id': ref('advanced_payroll.group_run_edit_all')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_run_view_all'), 'group_id': ref('advanced_payroll.group_run_view_all')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_run_delete_own'), 'group_id': ref('advanced_payroll.group_run_delete_own')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_run_delete_all'), 'group_id': ref('advanced_payroll.group_run_delete_all')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_slip_create_only'), 'group_id': ref('advanced_payroll.group_slip_create_only')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_slip_edit_own'), 'group_id': ref('advanced_payroll.group_slip_edit_own')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_slip_edit_team'), 'group_id': ref('advanced_payroll.group_slip_edit_team')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_slip_edit_all'), 'group_id': ref('advanced_payroll.group_slip_edit_all')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_slip_view_all'), 'group_id': ref('advanced_payroll.group_slip_view_all')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_slip_delete_own'), 'group_id': ref('advanced_payroll.group_slip_delete_own')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_slip_delete_all'), 'group_id': ref('advanced_payroll.group_slip_delete_all')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_employee_create_only'), 'group_id': ref('advanced_payroll.group_employee_create_only')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_employee_edit_own'), 'group_id': ref('advanced_payroll.group_employee_edit_own')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_employee_edit_team'), 'group_id': ref('advanced_payroll.group_employee_edit_team')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_employee_edit_all'), 'group_id': ref('advanced_payroll.group_employee_edit_all')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_employee_view_all'), 'group_id': ref('advanced_payroll.group_employee_view_all')}),
                (0, 0, {'privilege_id': ref('advanced_payroll.privilege_employee_delete_own'), 'group_id': ref('advanced_payroll.group_employee_delete_own')}),
