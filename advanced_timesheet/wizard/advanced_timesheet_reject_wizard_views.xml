<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_timesheet_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">advanced.timesheet.reject.wizard.form</field>
        <field name="model">advanced.timesheet.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Back">
                <group>
                    <field name="timesheet_id"/>
                    <field name="reason" placeholder="Tell them what to correct before they submit it again."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Send Back" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
