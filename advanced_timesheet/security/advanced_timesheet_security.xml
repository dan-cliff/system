<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every permission below is its
         own privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Timesheets user group,
         which holds the ACLs and a deny rule per operation, so users can only do
         what a permission opens. Entries follow their timesheet; removing an
         entry is editing the timesheet, so the edit permissions include it. "Own" is a
         timesheet they created or that is theirs (user_id). -->
    <data noupdate="1">
        <record id="module_category_advanced_timesheet" model="ir.module.category">
            <field name="name">Timesheets</field>
            <field name="description">Weekly, fortnightly or monthly timesheets, with optional manager approval.</field>
            <field name="sequence">46</field>
        </record>
    </data>

    <record id="group_timesheet_user" model="res.groups">
        <field name="name">Timesheets: User</field>
        <field name="comment">Technical: given by every Timesheets permission. Opens the app; what users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_timesheet_create_only" model="res.groups.privilege">
        <field name="name">Timesheets: Create Only</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">20</field>
        <field name="description">Create timesheets, and view their own (no editing after saving).</field>
    </record>
    <record id="group_timesheet_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_timesheet_create_only"/>
        <field name="comment">Create timesheets, and view their own (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
    </record>

    <record id="privilege_timesheet_edit_own" model="res.groups.privilege">
        <field name="name">Timesheets: Create and Edit Own</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">30</field>
        <field name="description">Create timesheets, and view and edit their own.</field>
    </record>
    <record id="group_timesheet_edit_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_timesheet_edit_own"/>
        <field name="comment">Create timesheets, and view and edit their own.</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
    </record>

    <record id="privilege_timesheet_edit_team" model="res.groups.privilege">
        <field name="name">Timesheets: Create and Edit My Team</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">40</field>
        <field name="description">Create timesheets, and view and edit their own and their team&apos;s.</field>
    </record>
    <record id="group_timesheet_edit_team" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_timesheet_edit_team"/>
        <field name="comment">Create timesheets, and view and edit their own and their team&apos;s.</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
    </record>

    <record id="privilege_timesheet_edit_all" model="res.groups.privilege">
        <field name="name">Timesheets: Create and Edit All</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">50</field>
        <field name="description">Create, view and edit every timesheet.</field>
    </record>
    <record id="group_timesheet_edit_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_timesheet_edit_all"/>
        <field name="comment">Create, view and edit every timesheet.</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
    </record>

    <record id="privilege_timesheet_view_all" model="res.groups.privilege">
        <field name="name">Timesheets: View All</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">60</field>
        <field name="description">View every timesheet.</field>
    </record>
    <record id="group_timesheet_view_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_timesheet_view_all"/>
        <field name="comment">View every timesheet.</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
    </record>

    <record id="privilege_timesheet_delete_own" model="res.groups.privilege">
        <field name="name">Timesheets: Delete Own</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">70</field>
        <field name="description">Delete their own timesheets.</field>
    </record>
    <record id="group_timesheet_delete_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_timesheet_delete_own"/>
        <field name="comment">Delete their own timesheets.</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
    </record>

    <record id="privilege_timesheet_delete_all" model="res.groups.privilege">
        <field name="name">Timesheets: Delete All</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">80</field>
        <field name="description">Delete any timesheet.</field>
    </record>
    <record id="group_timesheet_delete_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_timesheet_delete_all"/>
        <field name="comment">Delete any timesheet.</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
    </record>

    <record id="privilege_timesheet_approve" model="res.groups.privilege">
        <field name="name">Timesheets: Approve</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">90</field>
        <field name="description">Approve or send back the submitted timesheets of the employees they manage.</field>
    </record>
    <record id="group_timesheet_approve" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_timesheet_approve"/>
        <field name="comment">Approve or send back the submitted timesheets of the employees they manage.</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_user'))]"/>
    </record>

    <record id="privilege_advanced_timesheet" model="res.groups.privilege">
        <field name="name">Timesheets</field>
        <field name="category_id" ref="module_category_advanced_timesheet"/>
        <field name="sequence">10</field>
        <field name="description">Configuration of the Timesheets app.</field>
    </record>
    <record id="group_timesheet_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_advanced_timesheet"/>
        <field name="comment">Every Timesheets permission, including deleting any timesheet and approving or reopening anyone&apos;s, plus Configuration.</field>
        <field name="implied_ids" eval="[(4, ref('group_timesheet_create_only')), (4, ref('group_timesheet_edit_own')), (4, ref('group_timesheet_edit_team')), (4, ref('group_timesheet_edit_all')), (4, ref('group_timesheet_view_all')), (4, ref('group_timesheet_delete_own')), (4, ref('group_timesheet_delete_all')), (4, ref('group_timesheet_approve'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Without a permission, nothing -->
    <record id="rule_sheet_deny" model="ir.rule">
        <field name="name">Timesheets: only through a permission</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="groups" eval="[(4, ref('group_timesheet_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <record id="rule_line_deny" model="ir.rule">
        <field name="name">Timesheet Entries: only through a permission</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="groups" eval="[(4, ref('group_timesheet_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>

    <!-- Create Only -->
    <record id="rule_sheet_create_only" model="ir.rule">
        <field name="name">Timesheets: Create Only</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="groups" eval="[(4, ref('group_timesheet_create_only'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_line_create_only" model="ir.rule">
        <field name="name">Timesheet Entries: Create Only</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="groups" eval="[(4, ref('group_timesheet_create_only'))]"/>
        <field name="domain_force">['|', ('sheet_id.create_uid', '=', user.id), ('sheet_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Create and Edit Own -->
    <record id="rule_sheet_edit_own" model="ir.rule">
        <field name="name">Timesheets: Create and Edit Own</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="groups" eval="[(4, ref('group_timesheet_edit_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_line_edit_own" model="ir.rule">
        <field name="name">Timesheet Entries: Create and Edit Own</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="groups" eval="[(4, ref('group_timesheet_edit_own'))]"/>
        <field name="domain_force">['|', ('sheet_id.create_uid', '=', user.id), ('sheet_id.user_id', '=', user.id)]</field>
    </record>

    <!-- Create and Edit My Team -->
    <record id="rule_sheet_edit_team" model="ir.rule">
        <field name="name">Timesheets: Create and Edit My Team</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="groups" eval="[(4, ref('group_timesheet_edit_team'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_line_edit_team" model="ir.rule">
        <field name="name">Timesheet Entries: Create and Edit My Team</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="groups" eval="[(4, ref('group_timesheet_edit_team'))]"/>
        <field name="domain_force">['|', ('sheet_id.create_uid', '=', user.id), ('sheet_id.user_id', '=', user.id)]</field>
    </record>

    <!-- Create and Edit All -->
    <record id="rule_sheet_edit_all" model="ir.rule">
        <field name="name">Timesheets: Create and Edit All</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="groups" eval="[(4, ref('group_timesheet_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_line_edit_all" model="ir.rule">
        <field name="name">Timesheet Entries: Create and Edit All</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="groups" eval="[(4, ref('group_timesheet_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <!-- View All -->
    <record id="rule_sheet_view_all" model="ir.rule">
        <field name="name">Timesheets: View All</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="groups" eval="[(4, ref('group_timesheet_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_line_view_all" model="ir.rule">
        <field name="name">Timesheet Entries: View All</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="groups" eval="[(4, ref('group_timesheet_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Delete Own -->
    <record id="rule_sheet_delete_own" model="ir.rule">
        <field name="name">Timesheets: Delete Own</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="groups" eval="[(4, ref('group_timesheet_delete_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_line_delete_own" model="ir.rule">
        <field name="name">Timesheet Entries: Delete Own</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="groups" eval="[(4, ref('group_timesheet_delete_own'))]"/>
        <field name="domain_force">['|', ('sheet_id.create_uid', '=', user.id), ('sheet_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

    <!-- Delete All -->
    <record id="rule_sheet_delete_all" model="ir.rule">
        <field name="name">Timesheets: Delete All</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="groups" eval="[(4, ref('group_timesheet_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_line_delete_all" model="ir.rule">
        <field name="name">Timesheet Entries: Delete All</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="groups" eval="[(4, ref('group_timesheet_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

    <!-- Multi-company -->
    <record id="rule_sheet_company" model="ir.rule">
        <field name="name">Timesheets: multi-company</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_line_company" model="ir.rule">
        <field name="name">Timesheet Entries: multi-company</field>
        <field name="model_id" ref="model_advanced_timesheet_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
