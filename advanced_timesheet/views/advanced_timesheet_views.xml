<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_timesheet_view_list" model="ir.ui.view">
        <field name="name">advanced.timesheet.list</field>
        <field name="model">advanced.timesheet</field>
        <field name="arch" type="xml">
            <list string="Timesheets" decoration-muted="state == 'draft'" decoration-success="state == 'approved'">
                <field name="id" optional="show"/>
                <field name="person_name"/>
                <field name="user_id" optional="hide"/>
                <field name="date_start" options="{'numeric': True}"/>
                <field name="date_end" options="{'numeric': True}"/>
                <field name="period_type" optional="show"/>
                <field name="total_hours" widget="float_time" sum="Total"/>
                <field name="approver_user_id" optional="hide"/>
                <field name="submitted_date" optional="hide" options="{'numeric': True}"/>
                <field name="state" widget="badge" decoration-info="state == 'submitted'"
                       decoration-success="state == 'approved'"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="advanced_timesheet_view_form" model="ir.ui.view">
        <field name="name">advanced.timesheet.form</field>
        <field name="model">advanced.timesheet</field>
        <field name="arch" type="xml">
            <form string="Timesheet">
                <header>
                    <button name="action_submit" type="object" string="Submit" class="btn-primary"
                            invisible="not id or state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="not can_approve"/>
                    <button name="action_open_reject_wizard" type="object" string="Send Back"
                            invisible="not can_approve"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"
                            confirm="Reopen this timesheet for changes? It will need submitting again."/>
                    <button name="action_previous_period" type="object" string="Previous Period"
                            icon="fa-chevron-left" invisible="not id"/>
                    <button name="action_next_period" type="object" string="Next Period"
                            icon="fa-chevron-right" invisible="not id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted"/>
                </header>
                <sheet>
                    <field name="approval_required" invisible="1"/>
                    <field name="can_approve" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="person">
                            <field name="user_id" readonly="id" options="{'no_create': True}"/>
                            <field name="date_start" readonly="id" options="{'numeric': True}"/>
                            <field name="date_end" invisible="not id" options="{'numeric': True}"/>
                            <field name="period_type" invisible="not id"/>
                        </group>
                        <group name="status">
                            <field name="total_hours" widget="float_time"/>
                            <field name="approver_user_id" invisible="not approval_required"/>
                            <field name="submitted_date" invisible="not submitted_date" options="{'numeric': True}"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date" options="{'numeric': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="id"
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Timesheet" name="grid">
                            <widget name="advanced_timesheet_grid"/>
                        </page>
                        <page string="Entries" name="entries">
                            <field name="line_ids" readonly="state != 'draft'"
                                   context="{'default_date': date_start}"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="advanced_timesheet_view_search" model="ir.ui.view">
        <field name="name">advanced.timesheet.search</field>
        <field name="model">advanced.timesheet</field>
        <field name="arch" type="xml">
            <search string="Timesheets">
                <field name="person_name"/>
                <field name="user_id"/>
                <field name="date_start" options="{'numeric': True}"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="my_timesheets" string="My Timesheets" domain="[('user_id', '=', uid)]"/>
                <filter name="to_approve" string="To Approve"
                        domain="[('state', '=', 'submitted'), ('approver_user_id', '=', uid)]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('state', '=', 'submitted')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter name="filter_date_start" string="Period" date="date_start"/>
                <group>
                    <filter name="group_person" string="Name" context="{'group_by': 'person_name'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date_start" string="Period" context="{'group_by': 'date_start:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_advanced_timesheet" model="ir.actions.act_window">
        <field name="name">Timesheets</field>
        <field name="res_model">advanced.timesheet</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="advanced_timesheet_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No timesheets yet</p>
            <p>Open <b>My Timesheet</b> to fill in this period's hours on the grid.</p>
        </field>
    </record>

    <record id="action_my_timesheet" model="ir.actions.server">
        <field name="name">My Timesheet</field>
        <field name="model_id" ref="model_advanced_timesheet"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open_my_timesheet()</field>
    </record>
</odoo>
