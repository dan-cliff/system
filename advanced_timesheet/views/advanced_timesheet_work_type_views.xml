<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_timesheet_work_type_view_list" model="ir.ui.view">
        <field name="name">advanced.timesheet.work.type.list</field>
        <field name="model">advanced.timesheet.work.type</field>
        <field name="arch" type="xml">
            <list string="Work Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advanced_timesheet_work_type_view_form" model="ir.ui.view">
        <field name="name">advanced.timesheet.work.type.form</field>
        <field name="model">advanced.timesheet.work.type</field>
        <field name="arch" type="xml">
            <form string="Work Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name" placeholder="e.g. Workshop"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="advanced_timesheet_work_type_view_search" model="ir.ui.view">
        <field name="name">advanced.timesheet.work.type.search</field>
        <field name="model">advanced.timesheet.work.type</field>
        <field name="arch" type="xml">
            <search string="Work Types">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_advanced_timesheet_work_type" model="ir.actions.act_window">
        <field name="name">Work Types</field>
        <field name="res_model">advanced.timesheet.work.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a work type</p>
            <p>Work types are the rows of a timesheet: what the hours were spent on.</p>
        </field>
    </record>
</odoo>
