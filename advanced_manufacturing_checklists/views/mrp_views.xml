<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_qa" model="ir.ui.view">
        <field name="name">mrp.production.form.qa</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qa_checklists" type="object" class="oe_stat_button" icon="fa-check-square-o"
                        groups="checklists.group_checklist_user" invisible="not qa_checklist_count">
                    <field name="qa_checklist_count" widget="statinfo" string="QA Checks"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="stock_lot_form_qa" model="ir.ui.view">
        <field name="name">stock.lot.form.qa</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qa_checklists" type="object" class="oe_stat_button" icon="fa-check-square-o"
                        groups="checklists.group_checklist_user" invisible="not qa_checklist_count">
                    <field name="qa_checklist_count" widget="statinfo" string="QA Checks"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="product_template_form_qa" model="ir.ui.view">
        <field name="name">product.template.form.qa</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_qa_checklists" type="object" class="oe_stat_button" icon="fa-check-square-o"
                        groups="checklists.group_checklist_user" invisible="not qa_checklist_count">
                    <field name="qa_checklist_count" widget="statinfo" string="QA Checks"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
