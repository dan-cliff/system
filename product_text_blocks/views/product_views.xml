<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Insert Text Block" above the Quotation Description. -->
    <record id="product_template_form_text_block" model="ir.ui.view">
        <field name="name">product.template.form.text.block</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='description']/field[@name='description_sale']" position="before">
                <widget name="text_block_insert" colspan="2" options="{'field': 'description_sale'}"/>
            </xpath>
        </field>
    </record>
</odoo>
