<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_contract_type_view_list_seek" model="ir.ui.view">
        <field name="name">hr.contract.type.list.seek</field>
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="seek_work_type" optional="show"/>
            </field>
        </field>
    </record>

    <record id="hr_contract_type_view_form_seek" model="ir.ui.view">
        <field name="name">hr.contract.type.form.seek</field>
        <field name="model">hr.contract.type</field>
        <field name="inherit_id" ref="hr.hr_contract_type_view_form"/>
        <field name="arch" type="xml">
            <field name="country_id" position="after">
                <field name="seek_work_type"/>
            </field>
        </field>
    </record>
</odoo>
