<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="advanced_inventory_hs_code.HelpButton">
        <button type="button" class="btn btn-link btn-sm o_hs_code_help text-nowrap" t-on-click="onClick"
                title="Describe the product and let the AI find its HS code">
            <i class="fa fa-magic me-1"/>Help me
        </button>
    </t>

    <t t-name="advanced_inventory_hs_code.DescribeDialog">
        <Dialog title="'Find the HS code'" size="'md'">
            <p class="mb-2">
                Describe the product so the AI can find its HS code. Include what it is
                <strong>made of</strong> (fibre content with percentages, materials or ingredients),
                what it is <strong>for</strong> and how it is <strong>made</strong>.
            </p>
            <p class="text-muted small mb-2">
                e.g. "Knitted beanie, 80% merino wool 20% nylon, machine knitted, for adults" or
                "Scented candle, soy wax with fragrance oil, in a glass jar".
            </p>
            <textarea t-ref="description" class="form-control" rows="6" t-model="state.description"
                      t-on-keydown="onKeydown" placeholder="Describe the product..."/>
            <div class="small text-muted mt-1">Ctrl+Enter to search.</div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="submit" t-att-disabled="!canSubmit">
                    <i class="fa fa-search me-1"/>Find the HS Code
                </button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="advanced_inventory_hs_code.ResultDialog">
        <Dialog title="'Suggested HS codes'" size="'lg'">
            <p t-if="props.result.summary" class="mb-3" t-esc="props.result.summary"/>
            <div t-foreach="props.result.suggestions" t-as="s" t-key="s_index"
                 t-attf-class="o_hs_suggestion border rounded p-3 mb-2 {{ s_first ? 'border-primary' : '' }}">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                    <span class="fs-4 fw-bold font-monospace" t-esc="s.hs_code"/>
                    <span t-attf-class="badge rounded-pill {{ confidenceClass(s.confidence) }}" t-esc="confidenceLabel(s.confidence)"/>
                    <span t-if="s.hs_code === props.currentCode" class="badge rounded-pill text-bg-light">On the product</span>
                    <span class="flex-grow-1"/>
                    <button class="btn btn-primary btn-sm" t-on-click="() => this.use(s.hs_code)">Use this code</button>
                </div>
                <div t-if="s.title" class="fw-semibold mb-1" t-esc="s.title"/>
                <div t-if="s.national_code" class="d-flex align-items-center gap-2 mb-1 small">
                    <span class="text-muted"><t t-esc="props.result.country"/> tariff code:</span>
                    <span class="font-monospace fw-semibold" t-esc="s.national_code"/>
                    <button class="btn btn-link btn-sm p-0" t-on-click="() => this.use(s.national_code)">Use this one</button>
                </div>
                <div class="small text-muted" t-esc="s.reasoning"/>
            </div>
            <div t-if="props.result.questions.length" class="mt-3">
                <div class="fw-semibold small mb-1">What could change the classification</div>
                <ul class="small mb-0">
                    <li t-foreach="props.result.questions" t-as="q" t-key="q_index" t-esc="q"/>
                </ul>
            </div>
            <div t-if="props.result.sources.length" class="mt-3">
                <div class="fw-semibold small mb-1">Sources</div>
                <ul class="small mb-0">
                    <li t-foreach="props.result.sources" t-as="src" t-key="src_index">
                        <a t-att-href="src.url" target="_blank" rel="noopener noreferrer" t-esc="src.title"/>
                    </li>
                </ul>
            </div>
            <p t-if="!props.result.searched" class="small text-warning mt-3 mb-0">
                The AI could not search the web this time, so these come from its own knowledge.
            </p>
            <p class="small text-muted mt-3 mb-0">
                These are suggestions: check the classification (e.g. with your customs broker or the official tariff)
                before declaring goods.
            </p>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="retry"><i class="fa fa-refresh me-1"/>Describe Again</button>
                <button class="btn btn-secondary" t-on-click="props.close">Close</button>
            </t>
        </Dialog>
    </t>

    <t t-name="advanced_inventory_hs_code.ProgressOverlay">
        <div t-if="state.active" class="o_hs_ai_progress" role="status" aria-live="polite">
            <div class="o_hs_ai_progress_card">
                <div class="o_hs_ai_progress_orb" aria-hidden="true"><i class="fa fa-magic"/></div>
                <h3 class="mt-3 mb-3" t-esc="state.title"/>
                <ol class="list-unstyled text-start mb-3">
                    <li t-foreach="state.steps" t-as="step" t-key="step_index"
                        t-attf-class="o_hs_ai_progress_step o_hs_ai_progress_step_{{ stepStatus(step_index) }}">
                        <span class="o_hs_ai_progress_icon">
                            <i t-if="stepStatus(step_index) === 'done'" class="fa fa-check"/>
                            <i t-elif="stepStatus(step_index) === 'active'" class="fa fa-circle-o-notch fa-spin"/>
                            <i t-else="" class="fa fa-circle-thin"/>
                        </span>
                        <span t-esc="step"/>
                    </li>
                </ol>
                <p class="text-muted small mb-0">
                    This can take a few minutes - please keep this page open. <t t-esc="elapsed"/>
                </p>
            </div>
        </div>
    </t>
</templates>
