<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every permission below is its
         own privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Laser Jobbing user group, which
         holds the ACLs and a deny rule per operation, so users can only do what a
         permission opens. Job values follow their job. Templates, fonts and
         materials are Configuration: read for users, full for the Administrator.
         "Own" = jobs they created or are Responsible for. -->
    <record id="module_category_laser_jobbing" model="ir.module.category">
        <field name="name">Laser Jobbing</field>
        <field name="description">Personalised laser cutting, scoring and engraving jobs.</field>
        <field name="sequence">83</field>
    </record>

    <record id="group_laser_user" model="res.groups">
        <field name="name">Laser Jobbing: User</field>
        <field name="privilege_id" eval="False"/>
        <field name="comment">Technical: given by every Laser Jobbing permission. What users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_laser_job_create_only" model="res.groups.privilege">
        <field name="name">Laser Jobs: Create Only</field>
        <field name="category_id" ref="module_category_laser_jobbing"/>
        <field name="sequence">20</field>
        <field name="description">Create laser jobs, and view the ones they created or are responsible for (no editing after saving).</field>
    </record>
    <record id="group_laser_job_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_laser_job_create_only"/>
        <field name="comment">Create laser jobs, and view the ones they created or are responsible for (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_laser_user'))]"/>
    </record>

    <record id="privilege_laser_job_edit_own" model="res.groups.privilege">
        <field name="name">Laser Jobs: Create and Edit Own</field>
        <field name="category_id" ref="module_category_laser_jobbing"/>
        <field name="sequence">30</field>
        <field name="description">Create laser jobs, and view and edit the ones they created or are responsible for.</field>
    </record>
    <record id="group_laser_job_edit_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_laser_job_edit_own"/>
        <field name="comment">Create laser jobs, and view and edit the ones they created or are responsible for.</field>
        <field name="implied_ids" eval="[(4, ref('group_laser_user'))]"/>
    </record>

    <record id="privilege_laser_job_edit_team" model="res.groups.privilege">
        <field name="name">Laser Jobs: Create and Edit My Team</field>
        <field name="category_id" ref="module_category_laser_jobbing"/>
        <field name="sequence">40</field>
        <field name="description">Create laser jobs, and view and edit their own and their team&apos;s.</field>
    </record>
    <record id="group_laser_job_edit_team" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_laser_job_edit_team"/>
        <field name="comment">Create laser jobs, and view and edit their own and their team&apos;s.</field>
        <field name="implied_ids" eval="[(4, ref('group_laser_user'))]"/>
    </record>

    <record id="privilege_laser_job_edit_all" model="res.groups.privilege">
        <field name="name">Laser Jobs: Create and Edit All</field>
        <field name="category_id" ref="module_category_laser_jobbing"/>
        <field name="sequence">50</field>
        <field name="description">Create, view and edit every laser job.</field>
    </record>
    <record id="group_laser_job_edit_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_laser_job_edit_all"/>
        <field name="comment">Create, view and edit every laser job.</field>
        <field name="implied_ids" eval="[(4, ref('group_laser_user'))]"/>
    </record>

    <record id="privilege_laser_job_view_all" model="res.groups.privilege">
        <field name="name">Laser Jobs: View All</field>
        <field name="category_id" ref="module_category_laser_jobbing"/>
        <field name="sequence">60</field>
        <field name="description">View every laser job and download its file.</field>
    </record>
    <record id="group_laser_job_view_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_laser_job_view_all"/>
        <field name="comment">View every laser job and download its file.</field>
        <field name="implied_ids" eval="[(4, ref('group_laser_user'))]"/>
    </record>

    <record id="privilege_laser_job_delete_own" model="res.groups.privilege">
        <field name="name">Laser Jobs: Delete Own</field>
        <field name="category_id" ref="module_category_laser_jobbing"/>
        <field name="sequence">70</field>
        <field name="description">Delete the laser jobs they created or are responsible for.</field>
    </record>
    <record id="group_laser_job_delete_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_laser_job_delete_own"/>
        <field name="comment">Delete the laser jobs they created or are responsible for.</field>
        <field name="implied_ids" eval="[(4, ref('group_laser_user'))]"/>
    </record>

    <record id="privilege_laser_job_delete_all" model="res.groups.privilege">
        <field name="name">Laser Jobs: Delete All</field>
        <field name="category_id" ref="module_category_laser_jobbing"/>
        <field name="sequence">80</field>
        <field name="description">Delete any laser job.</field>
    </record>
    <record id="group_laser_job_delete_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_laser_job_delete_all"/>
        <field name="comment">Delete any laser job.</field>
        <field name="implied_ids" eval="[(4, ref('group_laser_user'))]"/>
    </record>

    <record id="privilege_laser_jobbing" model="res.groups.privilege">
        <field name="name">Laser Jobbing</field>
        <field name="category_id" ref="module_category_laser_jobbing"/>
        <field name="sequence">10</field>
        <field name="description">Configuration of Laser Jobbing: templates, fonts, materials and settings.</field>
    </record>
    <record id="group_laser_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_laser_jobbing"/>
        <field name="comment">Every Laser Jobbing permission, including deleting any job, plus Configuration (templates, fonts, materials, settings).</field>
        <field name="implied_ids" eval="[(4, ref('group_laser_job_create_only')), (4, ref('group_laser_job_edit_own')), (4, ref('group_laser_job_edit_team')), (4, ref('group_laser_job_edit_all')), (4, ref('group_laser_job_view_all')), (4, ref('group_laser_job_delete_own')), (4, ref('group_laser_job_delete_all'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Laser Jobs: without a permission, nothing -->
    <record id="rule_laser_job_deny" model="ir.rule">
        <field name="name">Laser Jobs: only through a permission</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="groups" eval="[(4, ref('group_laser_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <record id="rule_laser_job_create_only" model="ir.rule">
        <field name="name">Laser Jobs: Create Only</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="groups" eval="[(4, ref('group_laser_job_create_only'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_edit_own" model="ir.rule">
        <field name="name">Laser Jobs: Create and Edit Own</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="groups" eval="[(4, ref('group_laser_job_edit_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_edit_team" model="ir.rule">
        <field name="name">Laser Jobs: Create and Edit My Team</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="groups" eval="[(4, ref('group_laser_job_edit_team'))]"/>
        <field name="domain_force">['|', '|', ('create_uid', '=', user.id), ('user_id', '=', user.id), ('create_uid.employee_ids', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_edit_all" model="ir.rule">
        <field name="name">Laser Jobs: Create and Edit All</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="groups" eval="[(4, ref('group_laser_job_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_view_all" model="ir.rule">
        <field name="name">Laser Jobs: View All</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="groups" eval="[(4, ref('group_laser_job_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_delete_own" model="ir.rule">
        <field name="name">Laser Jobs: Delete Own</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="groups" eval="[(4, ref('group_laser_job_delete_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_laser_job_delete_all" model="ir.rule">
        <field name="name">Laser Jobs: Delete All</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="groups" eval="[(4, ref('group_laser_job_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <!-- Laser Job Values: without a permission, nothing -->
    <record id="rule_laser_job_value_deny" model="ir.rule">
        <field name="name">Laser Job Values: only through a permission</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="groups" eval="[(4, ref('group_laser_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <record id="rule_laser_job_value_create_only" model="ir.rule">
        <field name="name">Laser Job Values: Create Only</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="groups" eval="[(4, ref('group_laser_job_create_only'))]"/>
        <field name="domain_force">['|', ('job_id.create_uid', '=', user.id), ('job_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_value_edit_own" model="ir.rule">
        <field name="name">Laser Job Values: Create and Edit Own</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="groups" eval="[(4, ref('group_laser_job_edit_own'))]"/>
        <field name="domain_force">['|', ('job_id.create_uid', '=', user.id), ('job_id.user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_value_edit_team" model="ir.rule">
        <field name="name">Laser Job Values: Create and Edit My Team</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="groups" eval="[(4, ref('group_laser_job_edit_team'))]"/>
        <field name="domain_force">['|', '|', ('job_id.create_uid', '=', user.id), ('job_id.user_id', '=', user.id), ('job_id.create_uid.employee_ids', 'child_of', user.employee_ids.ids)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_value_edit_all" model="ir.rule">
        <field name="name">Laser Job Values: Create and Edit All</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="groups" eval="[(4, ref('group_laser_job_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_value_view_all" model="ir.rule">
        <field name="name">Laser Job Values: View All</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="groups" eval="[(4, ref('group_laser_job_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_laser_job_value_delete_own" model="ir.rule">
        <field name="name">Laser Job Values: Delete Own</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="groups" eval="[(4, ref('group_laser_job_delete_own'))]"/>
        <field name="domain_force">['|', ('job_id.create_uid', '=', user.id), ('job_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_laser_job_value_delete_all" model="ir.rule">
        <field name="name">Laser Job Values: Delete All</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="groups" eval="[(4, ref('group_laser_job_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>

    <!-- Multi-company -->
    <record id="rule_laser_job_company" model="ir.rule">
        <field name="name">Laser Jobs: multi-company</field>
        <field name="model_id" ref="model_laser_job"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_laser_job_value_company" model="ir.rule">
        <field name="name">Laser Job Values: multi-company</field>
        <field name="model_id" ref="model_laser_job_value"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_laser_template_company" model="ir.rule">
        <field name="name">Laser Templates: multi-company</field>
        <field name="model_id" ref="model_laser_template"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
