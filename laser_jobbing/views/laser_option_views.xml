<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fonts -->
    <record id="view_laser_font_list" model="ir.ui.view">
        <field name="name">laser.font.list</field>
        <field name="model">laser.font</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" optional="show"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="css_family"/>
                <field name="font_filename" string="Font File"/>
            </list>
        </field>
    </record>
    <record id="view_laser_font_form" model="ir.ui.view">
        <field name="name">laser.font.form</field>
        <field name="model">laser.font</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Great Vibes"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="font_file" filename="font_filename"/>
                            <field name="font_filename" invisible="1"/>
                            <field name="css_family"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_laser_font_search" model="ir.ui.view">
        <field name="name">laser.font.search</field>
        <field name="model">laser.font</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_laser_font" model="ir.actions.act_window">
        <field name="name">Laser Fonts</field>
        <field name="res_model">laser.font</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a font for laser text</p>
            <p>Upload a .ttf or .otf file so engraving text is drawn in it and cutting and scoring text is turned into outlines.</p>
        </field>
    </record>

    <!-- Materials -->
    <record id="view_laser_material_list" model="ir.ui.view">
        <field name="name">laser.material.list</field>
        <field name="model">laser.material</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" optional="show"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="thickness_mm"/>
                <field name="machine_settings" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_laser_material_form" model="ir.ui.view">
        <field name="name">laser.material.form</field>
        <field name="model">laser.material</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Birch Plywood 3 mm"/></h1>
                    </div>
                    <group>
                        <field name="thickness_mm"/>
                        <field name="machine_settings" placeholder="e.g. Engrave: 40% power, 300 mm/s, 1 pass. Cut: 100% power, 10 mm/s, 2 passes."/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_laser_material_search" model="ir.ui.view">
        <field name="name">laser.material.search</field>
        <field name="model">laser.material</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="action_laser_material" model="ir.actions.act_window">
        <field name="name">Laser Materials</field>
        <field name="res_model">laser.material</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a material</p>
            <p>Materials tell whoever runs a job what it is made from and which machine settings to use.</p>
        </field>
    </record>
</odoo>
