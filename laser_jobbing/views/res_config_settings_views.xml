<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.laser_jobbing</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="83"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Laser Jobbing" id="laser_jobbing" string="Laser Jobbing" name="laser_jobbing"
                     groups="laser_jobbing.group_laser_admin">
                    <block title="Visual Editor" id="laser_visual_editor">
                        <setting id="laser_visual_editor_internal"
                                 help="Employees drag a template's variable elements into place on its design, and see a live preview while they personalise a job.">
                            <field name="laser_visual_editor_internal"/>
                        </setting>
                        <setting id="laser_visual_editor_portal"
                                 help="Customers see their text and pictures on the design as they type, on the eCommerce product page. Without it they fill in a form and ask for a preview.">
                            <field name="laser_visual_editor_portal"/>
                            <div class="text-muted mt8" invisible="laser_website_installed">
                                Install the eCommerce app to personalise products on the website.
                            </div>
                        </setting>
                    </block>
                    <block title="Jobs" id="laser_jobs">
                        <setting id="laser_upload_limit" string="Upload Limit"
                                 help="Largest picture or artwork file customers and employees can upload for a job.">
                            <div class="content-group">
                                <field name="laser_max_upload_mb" class="oe_inline"/> MB
                            </div>
                        </setting>
                        <setting id="laser_configuration" string="Templates and Options"
                                 help="Base designs with their variable elements, and the fonts and materials they use.">
                            <div class="mt8 d-flex flex-column align-items-start">
                                <button name="%(laser_jobbing.action_laser_template)d" type="action"
                                        string="Laser Templates" class="btn-link" icon="oi-arrow-right"/>
                                <button name="%(laser_jobbing.action_laser_font)d" type="action"
                                        string="Laser Fonts" class="btn-link" icon="oi-arrow-right"/>
                                <button name="%(laser_jobbing.action_laser_material)d" type="action"
                                        string="Laser Materials" class="btn-link" icon="oi-arrow-right"/>
                                <button name="%(laser_jobbing.action_laser_job)d" type="action"
                                        string="Laser Jobs" class="btn-link" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_laser_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'laser_jobbing', 'bin_size': False}</field>
    </record>
</odoo>
