<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="video_production_project_link_view_form" model="ir.ui.view">
        <field name="name">video.production.project.link.form</field>
        <field name="model">video.production.project.link</field>
        <field name="arch" type="xml">
            <form>
                <field name="production_id" invisible="1"/>
                <group>
                    <field name="mode" widget="radio"/>
                </group>
                <group invisible="mode != 'link'">
                    <field name="project_id" options="{'no_create': True}" required="mode == 'link'"/>
                </group>
                <group invisible="mode != 'create'">
                    <group>
                        <field name="name" required="mode == 'create'"/>
                        <field name="template_id" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                    <group>
                        <field name="date_start" options="{'numeric': True}"/>
                        <field name="date_end" options="{'numeric': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
