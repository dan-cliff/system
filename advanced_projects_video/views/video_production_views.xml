<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_video_production_form_project" model="ir.ui.view">
        <field name="name">video.production.form.project</field>
        <field name="model">video.production</field>
        <field name="inherit_id" ref="video_production.view_video_production_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_link_project" type="object" string="Project"
                        class="btn-secondary" invisible="project_id"
                        groups="advanced_projects.group_advanced_project_user"
                        title="Create a new internal project for this production, or link an existing one"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-folder-open"
                        invisible="not project_id" groups="advanced_projects.group_advanced_project_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Project</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group invisible="not project_id">
                    <field name="project_id" options="{'no_create': True}"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_video_production_list_project" model="ir.ui.view">
        <field name="name">video.production.list.project</field>
        <field name="model">video.production</field>
        <field name="inherit_id" ref="video_production.view_video_production_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="project_id" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="advanced_project_view_form_video" model="ir.ui.view">
        <field name="name">advanced.project.form.video</field>
        <field name="model">advanced.project</field>
        <field name="inherit_id" ref="advanced_projects.advanced_project_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_team']" position="after">
                <button name="action_open_video_productions" type="object" class="oe_stat_button"
                        icon="fa-video-camera" invisible="not video_production_count"
                        groups="video_production.group_video_production_user">
                    <field name="video_production_count" widget="statinfo" string="Video Productions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
