<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every permission below is its
         own privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Payroll user group, which holds
         the ACLs and a deny rule per operation, so users can only do what a
         permission opens. Payslip lines follow their payslip. "Own" is what they
         created; "My Team" adds what the people under them in the org chart
         created. Approving, marking as paid and resetting pay runs are checked in
         code and write with sudo(). View My Payslips shows employees their own
         approved payslips. -->
    <data noupdate="1">
        <record id="module_category_advanced_payroll" model="ir.module.category">
            <field name="name">Payroll</field>
            <field name="description">Pay runs, payslips and payroll employees.</field>
            <field name="sequence">48</field>
        </record>
    </data>

