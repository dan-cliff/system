<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_payslip" model="ir.actions.report">
        <field name="name">Payslip</field>
        <field name="model">payroll.slip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advanced_payroll.report_payslip</field>
        <field name="report_file">advanced_payroll.report_payslip</field>
        <field name="print_report_name">'Payslip - %s' % (object.name or '')</field>
        <field name="binding_model_id" ref="model_payroll_slip"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_payslip_document">
        <t t-call="web.external_layout">
            <t t-set="ytd" t-value="slip._payroll_ytd()"/>
            <t t-set="currency" t-value="slip.currency_id"/>
            <div class="page">
                <h2>Payslip</h2>
                <div class="row mt-3 mb-3">
                    <div class="col-6">
                        <strong t-field="slip.employee_id.name"/>
                        <div t-if="slip.employee_id.job_title" t-field="slip.employee_id.job_title"/>
                        <div t-if="slip.employee_id.department_id" t-field="slip.employee_id.department_id.name"/>
                        <t t-call="advanced_payroll.report_payslip_employee_details"/>
                    </div>
                    <div class="col-6">
                        <div>Pay Period: <span t-esc="slip.date_start.strftime('%d/%m/%Y')"/> – <span t-esc="slip.date_end.strftime('%d/%m/%Y')"/></div>
                        <div>Payment Date: <span t-esc="slip.payment_date and slip.payment_date.strftime('%d/%m/%Y')"/></div>
                        <div>Pay Frequency: <span t-field="slip.pay_frequency_id.name"/></div>
                        <div>Pay Run: <span t-field="slip.run_id.reference"/></div>
                    </div>
                </div>
                <table class="table table-sm o_main_table">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Rate</th>
                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="[('earning', 'Earnings'), ('leave', 'Paid Leave'), ('allowance', 'Allowances'), ('reimbursement', 'Reimbursements'), ('tax', 'Tax'), ('deduction', 'Deductions')]" t-as="section">
                            <t t-set="lines" t-value="slip.line_ids.filtered(lambda l: l.category == section[0])"/>
                            <tr t-if="lines" class="o_line_section">
                                <td colspan="4"><strong t-esc="section[1]"/></td>
                            </tr>
                            <tr t-foreach="lines" t-as="line">
                                <td t-esc="line.name"/>
                                <td class="text-end"><span t-if="line.calculation == 'hours'" t-esc="'%.2f' % line.quantity"/></td>
                                <td class="text-end"><span t-if="line.calculation == 'hours'" t-esc="line.rate" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                <td class="text-end">
                                    <span t-if="line.is_deducted">-</span><span t-esc="line.amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <div class="row">
                    <div class="col-6">
                        <t t-set="employer" t-value="slip.line_ids.filtered(lambda l: l.category == 'employer')"/>
                        <table t-if="employer" class="table table-sm">
                            <thead><tr><th>Employer Contributions</th><th class="text-end">Amount</th></tr></thead>
                            <tbody>
                                <tr t-foreach="employer" t-as="line">
                                    <td t-esc="line.name"/>
                                    <td class="text-end" t-esc="line.amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-6">
                        <table class="table table-sm">
                            <thead><tr><th/><th class="text-end">This Pay</th><th class="text-end">Year to Date</th></tr></thead>
                            <tbody>
                                <tr><td>Gross Pay</td>
                                    <td class="text-end" t-esc="slip.gross_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    <td class="text-end" t-esc="ytd['gross_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr>
                                <tr><td>Tax</td>
                                    <td class="text-end" t-esc="slip.tax_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    <td class="text-end" t-esc="ytd['tax_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr>
                                <tr><td>Deductions</td>
                                    <td class="text-end" t-esc="slip.deduction_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    <td class="text-end" t-esc="ytd['deduction_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr>
                                <tr><td>Reimbursements</td>
                                    <td class="text-end" t-esc="slip.reimbursement_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                    <td class="text-end" t-esc="ytd['reimbursement_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr>
                                <tr class="border-top"><td><strong>Net Pay</strong></td>
                                    <td class="text-end"><strong t-esc="slip.net_amount" t-options="{'widget': 'monetary', 'display_currency': currency}"/></td>
                                    <td class="text-end" t-esc="ytd['net_amount']" t-options="{'widget': 'monetary', 'display_currency': currency}"/></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <p t-if="slip.note" t-field="slip.note"/>
            </div>
        </t>
    </template>

    <!-- Country apps add the employee's tax numbers etc. here. -->
    <template id="report_payslip_employee_details">
        <div/>
    </template>

    <template id="report_payslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="slip">
                <t t-set="o" t-value="slip"/>
                <t t-call="advanced_payroll.report_payslip_document" t-lang="slip.employee_id.work_contact_id.lang or user.lang"/>
            </t>
        </t>
    </template>
</odoo>
