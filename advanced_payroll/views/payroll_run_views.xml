<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payroll_run_view_list" model="ir.ui.view">
        <field name="name">payroll.run.list</field>
        <field name="model">payroll.run</field>
        <field name="arch" type="xml">
            <list string="Pay Runs">
                <field name="id" optional="show"/>
                <field name="reference"/>
                <field name="country_id" optional="show"/>
                <field name="pay_frequency_id" optional="show"/>
                <field name="date_start" options="{'numeric': True}"/>
                <field name="date_end" options="{'numeric': True}"/>
                <field name="payment_date" options="{'numeric': True}"/>
                <field name="slip_count" optional="show" string="Payslips"/>
                <field name="gross_amount" sum="Total" optional="show"/>
                <field name="tax_amount" sum="Total" optional="hide"/>
                <field name="net_amount" sum="Total"/>
                <field name="cost_amount" sum="Total" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state == 'approved'" decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="payroll_run_view_form" model="ir.ui.view">
        <field name="name">payroll.run.form</field>
        <field name="model">payroll.run</field>
        <field name="arch" type="xml">
            <form string="Pay Run">
                <header>
                    <button name="action_generate_slips" type="object" string="Generate Payslips" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_compute" type="object" string="Compute"
                            invisible="state != 'draft' or not slip_ids"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary"
                            invisible="state != 'draft' or not slip_ids"
                            groups="advanced_payroll.group_run_approve"/>
                    <button name="action_mark_paid" type="object" string="Mark as Paid" class="btn-primary"
                            invisible="state != 'approved'" groups="advanced_payroll.group_run_pay"/>
                    <button name="action_print_slips" type="object" string="Print Payslips"
                            invisible="not slip_ids or state == 'cancelled'"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state == 'draft'"
                            confirm="Reset this pay run to draft? Its payslips can then be changed again."
                            groups="advanced_payroll.group_run_approve,advanced_payroll.group_payroll_admin"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_slips" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="slip_count" widget="statinfo" string="Payslips"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="reference"/>
                        <h1><field name="reference"/></h1>
                    </div>
                    <group>
                        <group name="run">
                            <field name="country_id" readonly="state != 'draft' or slip_ids" options="{'no_create': True}"/>
                            <field name="pay_frequency_id" readonly="state != 'draft' or slip_ids" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="slip_ids"
                                   options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="period">
                            <field name="date_start" readonly="state != 'draft' or slip_ids" options="{'numeric': True}"/>
                            <field name="date_end" readonly="state != 'draft' or slip_ids" options="{'numeric': True}"/>
                            <field name="payment_date" readonly="state != 'draft'" options="{'numeric': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payslips" name="slips">
                            <field name="slip_ids" readonly="1">
                                <list>
                                    <field name="id" optional="show"/>
                                    <field name="employee_id"/>
                                    <field name="hours" optional="show" sum="Total"/>
                                    <field name="gross_amount" sum="Total"/>
                                    <field name="tax_amount" sum="Total"/>
                                    <field name="deduction_amount" optional="show" sum="Total"/>
                                    <field name="net_amount" sum="Total"/>
                                    <field name="employer_amount" optional="show" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="state" column_invisible="1"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" name="totals">
                                <field name="gross_amount"/>
                                <field name="tax_amount"/>
                                <field name="net_amount" class="oe_subtotal_footer_separator"/>
                                <field name="employer_amount"/>
                                <field name="cost_amount"/>
                            </group>
                        </page>
                        <page string="Approval" name="approval" invisible="state == 'draft'">
                            <group>
                                <field name="approved_by_id"/>
                                <field name="approved_date" options="{'numeric': True}"/>
                                <field name="paid_date" options="{'numeric': True}"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="payroll_run_view_search" model="ir.ui.view">
        <field name="name">payroll.run.search</field>
        <field name="model">payroll.run</field>
        <field name="arch" type="xml">
            <search string="Pay Runs">
                <field name="reference"/>
                <field name="country_id"/>
                <field name="pay_frequency_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="paid" string="Paid" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="date_start" string="Period" date="date_start"/>
                <group>
                    <filter name="group_country" string="Payroll Country" context="{'group_by': 'country_id'}"/>
                    <filter name="group_frequency" string="Pay Frequency" context="{'group_by': 'pay_frequency_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payroll_run" model="ir.actions.act_window">
        <field name="name">Pay Runs</field>
        <field name="res_model">payroll.run</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Start a pay run</p>
            <p>Pick the Payroll Country, pay frequency and a day of the pay period, then generate the payslips of everyone paid on that cycle.</p>
        </field>
    </record>
</odoo>
