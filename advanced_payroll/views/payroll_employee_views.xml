<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payroll_employee_view_list" model="ir.ui.view">
        <field name="name">payroll.employee.list</field>
        <field name="model">payroll.employee</field>
        <field name="arch" type="xml">
            <list string="Payroll Employees">
                <field name="id" optional="show"/>
                <field name="employee_id"/>
                <field name="country_id" optional="show"/>
                <field name="pay_frequency_id" optional="show"/>
                <field name="pay_basis" optional="show"/>
                <field name="annual_salary" optional="show"/>
                <field name="hourly_rate" optional="show"/>
                <field name="hours_per_week" optional="hide"/>
                <field name="date_start" optional="hide" options="{'numeric': True}"/>
                <field name="date_end" optional="hide" options="{'numeric': True}"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="payroll_employee_view_form" model="ir.ui.view">
        <field name="name">payroll.employee.form</field>
        <field name="model">payroll.employee</field>
        <field name="arch" type="xml">
            <form string="Payroll Employee">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_slips" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="slip_count" widget="statinfo" string="Payslips"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="employee_id"/>
                        <h1><field name="employee_id" placeholder="Employee" options="{'no_create': True}"/></h1>
                    </div>
                    <group>
                        <group name="payroll">
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="country_code" invisible="1"/>
                            <field name="pay_frequency_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group name="dates">
                            <field name="date_start" options="{'numeric': True}"/>
                            <field name="date_end" options="{'numeric': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Pay" name="pay">
                            <group>
                                <group name="pay_rate">
                                    <field name="pay_basis" widget="radio"/>
                                    <field name="annual_salary" invisible="pay_basis != 'salary'"
                                           required="pay_basis == 'salary'"/>
                                    <field name="hourly_rate" readonly="pay_basis == 'salary'"
                                           required="pay_basis == 'hourly'"/>
                                    <field name="hours_per_week"/>
                                </group>
                            </group>
                        </page>
                        <!-- Country apps add a page with their details here, shown for their country_code. -->
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="payroll_employee_view_search" model="ir.ui.view">
        <field name="name">payroll.employee.search</field>
        <field name="model">payroll.employee</field>
        <field name="arch" type="xml">
            <search string="Payroll Employees">
                <field name="employee_id"/>
                <field name="country_id"/>
                <field name="pay_frequency_id"/>
                <filter name="salary" string="Salaried" domain="[('pay_basis', '=', 'salary')]"/>
                <filter name="hourly" string="Hourly" domain="[('pay_basis', '=', 'hourly')]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_country" string="Payroll Country" context="{'group_by': 'country_id'}"/>
                    <filter name="group_frequency" string="Pay Frequency" context="{'group_by': 'pay_frequency_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payroll_employee" model="ir.actions.act_window">
        <field name="name">Payroll Employees</field>
        <field name="res_model">payroll.employee</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add an employee to payroll</p>
            <p>Each employee's Payroll Country, pay frequency, salary or hourly rate, and their country's tax details.</p>
        </field>
    </record>
</odoo>
