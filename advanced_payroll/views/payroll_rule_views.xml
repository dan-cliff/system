<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payroll_rule_view_list" model="ir.ui.view">
        <field name="name">payroll.rule.list</field>
        <field name="model">payroll.rule</field>
        <field name="arch" type="xml">
            <list string="Payroll Rules">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="country_id" optional="show"/>
                <field name="category"/>
                <field name="compute_method"/>
                <field name="base" optional="show"/>
                <field name="rate" optional="show"/>
                <field name="tax_table_id" optional="show"/>
                <field name="annual_cap" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="payroll_rule_view_form" model="ir.ui.view">
        <field name="name">payroll.rule.form</field>
        <field name="model">payroll.rule</field>
        <field name="arch" type="xml">
            <form string="Payroll Rule">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Income Tax"/></h1>
                    </div>
                    <group>
                        <group name="rule">
                            <field name="code"/>
                            <field name="country_id" options="{'no_create': True}"/>
                            <field name="category"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group name="computation">
                            <field name="compute_method"/>
                            <field name="base" invisible="compute_method == 'fixed'"/>
                            <field name="rate" invisible="compute_method != 'percentage'"/>
                            <field name="fixed_amount" invisible="compute_method != 'fixed'"/>
                            <field name="tax_table_id" invisible="compute_method != 'brackets'"
                                   required="compute_method == 'brackets'" options="{'no_create': True}"/>
                        </group>
                        <group name="limits" string="Limits" invisible="compute_method != 'percentage'">
                            <field name="annual_exemption"/>
                            <field name="annual_threshold"/>
                            <field name="annual_cap"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What the rule is for and where its figures come from..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="payroll_rule_view_search" model="ir.ui.view">
        <field name="name">payroll.rule.search</field>
        <field name="model">payroll.rule</field>
        <field name="arch" type="xml">
            <search string="Payroll Rules">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_country" string="Payroll Country" context="{'group_by': 'country_id'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payroll_rule" model="ir.actions.act_window">
        <field name="name">Payroll Rules</field>
        <field name="res_model">payroll.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_country': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a payroll rule</p>
            <p>Tax, levies and retirement contributions worked out on every payslip of their country.</p>
        </field>
    </record>
</odoo>
