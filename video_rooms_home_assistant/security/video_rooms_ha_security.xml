<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Room Controls and Presets follow their room (CLAUDE.md > Permissions): no access
         without a Rooms permission, and each permission opens them as it opens the room. -->
    <record id="rule_video_room_ha_control_deny" model="ir.rule">
        <field name="name">Room Controls: only through a Rooms permission</field>
        <field name="model_id" ref="model_video_room_ha_control"/>
        <field name="groups" eval="[(4, ref('video_rooms.group_video_rooms_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <record id="rule_video_room_ha_control_create_only" model="ir.rule">
        <field name="name">Room Controls: Rooms Create Only</field>
        <field name="model_id" ref="model_video_room_ha_control"/>
        <field name="groups" eval="[(4, ref('video_rooms.group_room_create_only'))]"/>
        <field name="domain_force">[('room_id.create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_video_room_ha_control_edit_own" model="ir.rule">
        <field name="name">Room Controls: Rooms Create and Edit Own</field>
