<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iot_node_pair_wizard_form" model="ir.ui.view">
        <field name="name">iot.node.pair.wizard.form</field>
        <field name="model">iot.node.pair.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    On the Node (a Raspberry Pi connected to the internet and the local network), open a
                    terminal and run this command. It installs the Node agent, pairs the Node with Odoo,
                    installs its role's program and starts it whenever the Node is switched on. From then on
                    the Node keeps its own rolling key and takes program updates over the air: you won't
                    need to pair it again.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not already_paired">
                    This replaces the key the Node already has: until it is paired with the new code,
                    the Node can't connect.
                </div>
                <field name="install_command" widget="CopyClipboardChar" class="font-monospace"/>
                <group>
                    <field name="node_id"/>
                    <field name="role"/>
                    <field name="code" widget="CopyClipboardChar"/>
                    <field name="expires" options="{'numeric': True}"/>
                    <field name="already_paired" invisible="1"/>
                </group>
                <p class="text-muted">The pairing code works once and expires after 24 hours.</p>
                <footer>
                    <button string="Done" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
