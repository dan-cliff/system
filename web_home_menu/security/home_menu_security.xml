<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- home.menu.folder: users read the default layout and their own,
             and only change their own; administrators manage every layout. -->
        <record id="home_menu_folder_rule_user_read" model="ir.rule">
            <field name="name">Home Screen Folder: read default + own</field>
            <field name="model_id" ref="model_home_menu_folder"/>
            <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="home_menu_folder_rule_user_write" model="ir.rule">
            <field name="name">Home Screen Folder: manage own layout</field>
            <field name="model_id" ref="model_home_menu_folder"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="home_menu_folder_rule_manager" model="ir.rule">
            <field name="name">Home Screen Folder: administrator full access</field>
            <field name="model_id" ref="model_home_menu_folder"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>

        <!-- home.menu.folder.app: same access as the folder it belongs to. -->
        <record id="home_menu_folder_app_rule_user_read" model="ir.rule">
            <field name="name">Home Screen Folder App: read default + own</field>
            <field name="model_id" ref="model_home_menu_folder_app"/>
            <field name="domain_force">['|', ('folder_id.user_id', '=', False), ('folder_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="home_menu_folder_app_rule_user_write" model="ir.rule">
            <field name="name">Home Screen Folder App: manage own layout</field>
            <field name="model_id" ref="model_home_menu_folder_app"/>
            <field name="domain_force">[('folder_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="home_menu_folder_app_rule_manager" model="ir.rule">
            <field name="name">Home Screen Folder App: administrator full access</field>
            <field name="model_id" ref="model_home_menu_folder_app"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>

        <!-- home.menu.quick.link: users see the buttons shown to everyone and
             their own, and only change their own; administrators manage all. -->
        <record id="home_menu_quick_link_rule_user_read" model="ir.rule">
            <field name="name">Home Screen Quick Launch: read everyone's + own</field>
            <field name="model_id" ref="model_home_menu_quick_link"/>
            <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="home_menu_quick_link_rule_user_write" model="ir.rule">
            <field name="name">Home Screen Quick Launch: manage own</field>
            <field name="model_id" ref="model_home_menu_quick_link"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="home_menu_quick_link_rule_manager" model="ir.rule">
            <field name="name">Home Screen Quick Launch: administrator full access</field>
            <field name="model_id" ref="model_home_menu_quick_link"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        </record>

    </data>
</odoo>
