<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_property_lease" model="ir.cron">
            <field name="name">Property: expire leases and schedule lease reminders</field>
            <field name="model_id" ref="model_property_lease"/>
            <field name="state">code</field>
            <field name="code">model._cron_lease_status_and_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_property_contract" model="ir.cron">
            <field name="name">Property: expire contracts and schedule contract reminders</field>
            <field name="model_id" ref="model_property_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_contract_status_and_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
