<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="property_floor_plan_view_form" model="ir.ui.view">
        <field name="name">property.floor.plan.form</field>
        <field name="model">property.floor.plan</field>
        <field name="arch" type="xml">
            <form string="Floor Plan">
                <sheet>
                    <field name="property_id" invisible="1"/>
                    <field name="file_kind" invisible="1"/>
                    <group>
                        <group>
                            <field name="name" placeholder="e.g. Ground Floor"/>
                            <field name="plan_file_name" invisible="1"/>
                            <field name="plan_file" filename="plan_file_name"
                                   options="{'accepted_file_extensions': '.pdf,image/*'}"/>
                        </group>
                        <group>
                            <field name="area"/>
                            <field name="revision_date" options="{'numeric': True}"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Notes about this plan…"/>
                    <div class="mt-3 text-center" invisible="file_kind != 'image'">
                        <field name="plan_image" widget="image" readonly="1" options="{'zoom': true}"/>
                    </div>
                    <div class="mt-3" invisible="file_kind != 'pdf'">
                        <field name="plan_pdf" widget="pdf_viewer" readonly="1"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
