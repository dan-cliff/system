<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Module Category ──────────────────────────────────────────── -->
        <record id="module_category_employee_healthcare" model="ir.module.category">
            <field name="name">Employee Healthcare</field>
            <field name="description">Manage employee healthcare information.</field>
            <field name="sequence">86</field>
        </record>

        <!-- ── Privilege (Odoo 19 — links groups to category in Settings) ── -->
        <record id="privilege_employee_healthcare" model="res.groups.privilege">
            <field name="name">Employee Healthcare</field>
            <field name="category_id" ref="module_category_employee_healthcare"/>
            <field name="sequence">10</field>
        </record>

        <!-- ── Security Groups ──────────────────────────────────────────── -->

        <!-- Employee: can view and edit their own healthcare information only -->
        <record id="group_employee_healthcare_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="privilege_employee_healthcare"/>
            <field name="sequence">10</field>
            <field name="comment">Can view and edit their own healthcare information.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager: can view and edit all employee healthcare records -->
        <record id="group_employee_healthcare_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_employee_healthcare"/>
            <field name="sequence">20</field>
            <field name="comment">Can view and manage all employee healthcare records. Cannot modify configuration.</field>
            <field name="implied_ids" eval="[(4, ref('group_employee_healthcare_employee'))]"/>
        </record>

        <!-- Administrator: full access including configuration and indicators -->
        <record id="group_employee_healthcare_administrator" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_employee_healthcare"/>
            <field name="sequence">30</field>
            <field name="comment">Full access including lookup table configuration and indicator rule management.</field>
            <field name="implied_ids" eval="[(4, ref('group_employee_healthcare_manager'))]"/>
        </record>

    </data>

    <!-- ── Record Rules ─────────────────────────────────────────────── -->
    <!-- Updateable block so rules refresh on every -u run              -->
    <data>

        <!--
            Employees can only read/write their own healthcare records.
            Managers and Administrators bypass this via their own rules.
        -->

        <!-- ── employee.healthcare (main record) ───────────────────── -->
        <record id="rule_healthcare_record_employee_own" model="ir.rule">
            <field name="name">Healthcare Record: Employee sees own record</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_healthcare_record_manager_all" model="ir.rule">
            <field name="name">Healthcare Record: Manager sees all</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_healthcare_record_administrator_all" model="ir.rule">
            <field name="name">Healthcare Record: Administrator sees all</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_administrator'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ── Medication ──────────────────────────────────────────── -->
        <record id="rule_healthcare_medication_employee_own" model="ir.rule">
            <field name="name">Healthcare Medication: Employee sees own records</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare_medication"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_healthcare_medication_manager_all" model="ir.rule">
            <field name="name">Healthcare Medication: Manager sees all</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare_medication"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ── Allergy ─────────────────────────────────────────────── -->
        <record id="rule_healthcare_allergy_employee_own" model="ir.rule">
            <field name="name">Healthcare Allergy: Employee sees own records</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare_allergy"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_healthcare_allergy_manager_all" model="ir.rule">
            <field name="name">Healthcare Allergy: Manager sees all</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare_allergy"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ── Health Alert ────────────────────────────────────────── -->
        <record id="rule_healthcare_alert_employee_own" model="ir.rule">
            <field name="name">Healthcare Alert: Employee sees own records</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare_alert"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_healthcare_alert_manager_all" model="ir.rule">
            <field name="name">Healthcare Alert: Manager sees all</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare_alert"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ── Directive ───────────────────────────────────────────── -->
        <record id="rule_healthcare_directive_employee_own" model="ir.rule">
            <field name="name">Healthcare Directive: Employee sees own records</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare_directive"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_healthcare_directive_manager_all" model="ir.rule">
            <field name="name">Healthcare Directive: Manager sees all</field>
            <field name="model_id" ref="employee_healthcare.model_employee_healthcare_directive"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_employee_healthcare_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
