        <field name="model">employee.healthcare.medication.type</field>
        <field name="arch" type="xml">
            <form string="Medication Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Medication type name..."/></h1>
