    <!-- ══════════════════════════════════════════════════════════
         Indicators
    ══════════════════════════════════════════════════════════ -->
    <record id="view_healthcare_indicator_form" model="ir.ui.view">
        <field name="name">employee.healthcare.indicator.form</field>
        <field name="model">employee.healthcare.indicator</field>
        <field name="arch" type="xml">
            <form string="Healthcare Indicator">
                <header>
                    <button name="action_reeval_all_employees"
                            type="object"
                            string="Re-evaluate All Employees"
                            icon="fa-refresh"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Indicator name..."/></h1>
                    </div>
                    <group>
                        <group string="Settings">
                            <field name="sequence"/>
                            <field name="color" widget="color_picker"/>
                            <field name="match_mode"/>
                            <field name="active"/>
                        </group>
                        <group string="Summary">
                            <field name="employee_count" readonly="1"/>
                        </group>
                    </group>
                    <group col="1">
                        <field name="description" placeholder="What does this indicator mean?"/>
                    </group>
                    <separator string="Rules"/>
                    <p class="text-muted" style="margin: 0 0 8px;">
                        Each rule is evaluated against the employee's healthcare record.
                        The <strong>Match Mode</strong> controls whether all rules or any single
                        rule must be satisfied to activate this indicator.
                    </p>
                    <field name="rule_ids" nolabel="1">
                        <list string="Rules" editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="rule_type"/>
                            <field name="relation_field"
                                   invisible="rule_type != 'relation'"/>
                            <field name="relation_condition"
                                   invisible="rule_type != 'relation'"/>
                            <field name="relation_domain"
                                   invisible="rule_type != 'relation'"/>
                            <field name="relation_count_threshold"
                                   invisible="rule_type != 'relation' or relation_condition not in ['count_gt','count_gte','count_eq','count_lt']"
                                   string="Threshold"/>
                            <field name="employee_field"
                                   invisible="rule_type != 'field'"/>
                            <field name="field_operator"
                                   invisible="rule_type != 'field'"/>
                            <field name="field_value"
                                   invisible="rule_type != 'field' or field_operator in ['set','not_set']"
                                   string="Value"/>
                            <field name="date_field"
                                   invisible="rule_type != 'date'"/>
                            <field name="date_condition"
                                   invisible="rule_type != 'date'"/>
                            <field name="date_threshold_days"
                                   invisible="rule_type != 'date' or date_condition in ['is_set','is_not_set']"
                                   string="Days"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_healthcare_indicator_list" model="ir.ui.view">
        <field name="name">employee.healthcare.indicator.list</field>
        <field name="model">employee.healthcare.indicator</field>
        <field name="arch" type="xml">
            <list string="Healthcare Indicators">
                <field name="id" string="ID"/>
                <field name="sequence" widget="handle"/>
                <field name="name" decoration-bf="1"/>
                <field name="match_mode"/>
                <field name="rule_ids" string="Rules" widget="many2many_tags"/>
                <field name="employee_count" string="Employees"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_healthcare_indicator" model="ir.actions.act_window">
        <field name="name">Healthcare Indicators</field>
        <field name="res_model">employee.healthcare.indicator</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No indicators defined yet — create one to start flagging employees automatically.
            </p>
        </field>
    </record>

