<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_project_view_form" model="ir.ui.view">
        <field name="name">advanced.project.form.advanced_accounts</field>
        <field name="model">advanced.project</field>
        <field name="inherit_id" ref="advanced_projects.advanced_project_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group/group/field[@name='partner_id']" position="before">
                <field name="adv_account_id" invisible="is_template or is_internal" options="{'no_quick_create': True}"/>
                <field name="adv_contact_id" invisible="is_template or is_internal" options="{'no_quick_create': True}"
                       context="{'default_account_id': adv_account_id}"/>
            </xpath>
            <xpath expr="//sheet/group/group/field[@name='partner_id']" position="attributes">
                <attribute name="invisible">is_template or is_internal or adv_account_id or adv_contact_id or not partner_id</attribute>
            </xpath>
        </field>
    </record>

    <record id="advanced_project_view_list" model="ir.ui.view">
        <field name="name">advanced.project.list.advanced_accounts</field>
        <field name="model">advanced.project</field>
        <field name="inherit_id" ref="advanced_projects.advanced_project_view_list"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id" optional="show"/>
                <field name="adv_contact_id" optional="show"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <record id="advanced_project_view_search" model="ir.ui.view">
        <field name="name">advanced.project.search.advanced_accounts</field>
        <field name="model">advanced.project</field>
        <field name="inherit_id" ref="advanced_projects.advanced_project_view_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id"/>
                <field name="adv_contact_id"/>
            </field>
            <xpath expr="//filter[@name='group_partner']" position="attributes">
                <attribute name="string">Account</attribute>
                <attribute name="context">{'group_by': 'adv_account_id'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
