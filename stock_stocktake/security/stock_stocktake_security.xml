<odoo>
    <record id="rule_stock_stocktake_company" model="ir.rule">
        <field name="name">Stocktake: multi-company</field>
        <field name="model_id" ref="model_stock_stocktake"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_stock_stocktake_line_company" model="ir.rule">
        <field name="name">Stocktake Line: multi-company</field>
        <field name="model_id" ref="model_stock_stocktake_line"/>
        <field name="domain_force">
            ['|', ('stocktake_id.company_id', '=', False), ('stocktake_id.company_id', 'in', company_ids)]
        </field>
    </record>
</odoo>
