<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="list_column_config.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//t[@t-set-slot='control-panel-additional-actions']" position="inside">
            <button t-if="canCustomiseListColumns and !hasSelectedRecords"
                    type="button"
                    class="btn btn-link px-1 o_list_column_config_button"
                    title="Customise columns"
                    aria-label="Customise columns"
                    t-on-click="onClickCustomiseListColumns">
                <i class="fa fa-columns" role="img"/>
            </button>
        </xpath>
    </t>
</templates>
