<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="list_column_config_view_list" model="ir.ui.view">
        <field name="name">list.column.config.list</field>
        <field name="model">list.column.config</field>
        <field name="arch" type="xml">
            <list string="List Column Layouts">
                <field name="id" optional="show"/>
                <field name="model_name"/>
                <field name="model" optional="show"/>
                <field name="view_id" optional="show"/>
                <field name="line_count"/>
                <field name="app_id" optional="show"/>
                <field name="write_uid" string="Last Changed By" optional="show"/>
                <field name="write_date" string="Last Changed On" options="{'numeric': True}" optional="show"/>
            </list>
        </field>
    </record>

    <record id="list_column_config_view_form" model="ir.ui.view">
        <field name="name">list.column.config.form</field>
        <field name="model">list.column.config</field>
        <field name="arch" type="xml">
            <form string="List Column Layout">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="model"/>
                            <field name="model_name"/>
                            <field name="view_id"/>
                        </group>
                        <group>
                            <field name="app_id"/>
                            <field name="write_uid" string="Last Changed By"/>
                            <field name="write_date" string="Last Changed On" options="{'numeric': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="line_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="id" optional="show"/>
                            <field name="field_name"/>
                            <field name="label"/>
                            <field name="visibility"/>
                            <field name="is_added"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="list_column_config_view_search" model="ir.ui.view">
        <field name="name">list.column.config.search</field>
        <field name="model">list.column.config</field>
        <field name="arch" type="xml">
            <search string="List Column Layouts">
                <field name="name"/>
                <field name="model"/>
                <field name="app_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_app" string="Last Changed In" context="{'group_by': 'app_id'}"/>
                    <filter name="group_model" string="Model" context="{'group_by': 'model'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_list_column_config" model="ir.actions.act_window">
        <field name="name">List Column Layouts</field>
        <field name="res_model">list.column.config</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No list has a custom column layout yet</p>
            <p>Open any list and click its "Customise columns" icon to choose the columns everyone sees.
               Archive or delete a layout here to go back to the list's own columns.</p>
        </field>
    </record>
</odoo>
