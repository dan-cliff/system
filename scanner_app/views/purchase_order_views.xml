<odoo>
    <record id="view_purchase_order_form_inherit_scanner" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.scanner</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_barcode_receive" type="object" string="Receive by Barcode"
                        invisible="not has_receivable_picking"/>
            </xpath>
        </field>
    </record>
</odoo>
