<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Module Category ───────────────────────────────────────────── -->
        <record id="module_category_dangerous_goods" model="ir.module.category">
            <field name="name">Dangerous Goods</field>
            <field name="description">Manage chemical and asbestos registers with GHS classification and Australian WHS compliance.</field>
            <field name="sequence">55</field>
        </record>

        <!-- ── Privilege ────────────────────────────────────────────────── -->
        <record id="privilege_dangerous_goods" model="res.groups.privilege">
            <field name="name">Dangerous Goods</field>
            <field name="category_id" ref="module_category_dangerous_goods"/>
            <field name="sequence">10</field>
        </record>

        <!-- ── Security Groups ───────────────────────────────────────────── -->

        <!-- User: can view chemical and asbestos registers -->
        <record id="group_dg_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_dangerous_goods"/>
            <field name="sequence">10</field>
            <field name="comment">Can view chemical and asbestos registers.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Manager: can create and edit register entries and inspections -->
        <record id="group_dg_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_dangerous_goods"/>
            <field name="sequence">20</field>
            <field name="comment">Can create and edit chemical and asbestos register entries.</field>
            <field name="implied_ids" eval="[(4, ref('group_dg_user'))]"/>
        </record>

        <!-- Administrator: full access including all configuration and GHS data -->
        <record id="group_dg_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_dangerous_goods"/>
            <field name="sequence">30</field>
            <field name="comment">Full access including configuration, lookup tables and GHS data management.</field>
            <field name="implied_ids" eval="[(4, ref('group_dg_manager'))]"/>
        </record>

    </data>
</odoo>
