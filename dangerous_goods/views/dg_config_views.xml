<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ CHEMICAL PIPELINE STAGES ═════════════════════════════ -->
    <record id="view_dg_chemical_stage_list" model="ir.ui.view">
        <field name="name">dg.chemical.stage.list</field>
        <field name="model">dg.chemical.stage</field>
        <field name="arch" type="xml">
            <list string="Chemical Register Stages" editable="top">
                <field name="sequence" widget="handle"/>
                <field name="id" string="ID" optional="show"/>
                <field name="name"/>
                <field name="code" readonly="1"/>
                <field name="fold"/>
                <field name="description"/>
            </list>
        </field>
    </record>
    <record id="view_dg_chemical_stage_form" model="ir.ui.view">
        <field name="name">dg.chemical.stage.form</field>
        <field name="model">dg.chemical.stage</field>
        <field name="arch" type="xml">
            <form string="Chemical Stage">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="fold"/>
                        </group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dg_chemical_stage" model="ir.actions.act_window">
        <field name="name">Chemical Register Stages</field>
        <field name="res_model">dg.chemical.stage</field>
        <field name="view_mode">list,form</field>
    </record>

