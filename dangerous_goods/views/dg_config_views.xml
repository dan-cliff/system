    <!-- ══ ASBESTOS REMOVALISTS ════════════════════════════════════ -->
    <record id="view_dg_asbestos_remover_list" model="ir.ui.view">
        <field name="name">dg.asbestos.remover.list</field>
        <field name="model">dg.asbestos.remover</field>
        <field name="arch" type="xml">
            <list string="Asbestos Removalists">
                <field name="id" string="ID" optional="show"/>
                <field name="name"/>
                <field name="licence_number"/>
                <field name="licence_class" widget="badge"
                       decoration-danger="licence_class == 'a'"
                       decoration-warning="licence_class == 'b'"/>
                <field name="licence_expiry"
                       decoration-danger="licence_expiry and licence_expiry &lt; context_today()"/>
                <field name="contact_name"/>
                <field name="phone"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="view_dg_asbestos_remover_form" model="ir.ui.view">
        <field name="name">dg.asbestos.remover.form</field>
        <field name="model">dg.asbestos.remover</field>
        <field name="arch" type="xml">
            <form string="Asbestos Removalist / Contractor">
                <sheet>
                    <group>
                        <group string="Company Details">
                            <field name="name"/>
                            <field name="contact_name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="active"/>
                        </group>
                        <group string="Licence Details">
                            <field name="licence_number"/>
                            <field name="licence_class"/>
                            <field name="licence_expiry"
                                   decoration-danger="licence_expiry and licence_expiry &lt; context_today()"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dg_asbestos_remover" model="ir.actions.act_window">
        <field name="name">Asbestos Removalists</field>
        <field name="res_model">dg.asbestos.remover</field>
        <field name="view_mode">list,form</field>
    </record>

