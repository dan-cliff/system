<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ══ CHEMICAL REGISTER STAGES ═════════════════════════════════ -->
        <record id="stage_chemical_active" model="dg.chemical.stage">
            <field name="name">Active</field>
            <field name="code">active</field>
            <field name="sequence">10</field>
            <field name="fold">False</field>
        </record>
        <record id="stage_chemical_review" model="dg.chemical.stage">
            <field name="name">Under Review</field>
            <field name="code">review</field>
            <field name="sequence">20</field>
            <field name="fold">False</field>
        </record>
        <record id="stage_chemical_discontinued" model="dg.chemical.stage">
            <field name="name">Discontinued</field>
            <field name="code">discontinued</field>
            <field name="sequence">30</field>
            <field name="fold">True</field>
        </record>
        <record id="stage_chemical_archived" model="dg.chemical.stage">
            <field name="name">Archived</field>
            <field name="code">archived</field>
            <field name="sequence">40</field>
            <field name="fold">True</field>
        </record>

