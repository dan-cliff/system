<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_job_view_form_linkedin" model="ir.ui.view">
        <field name="name">hr.job.form.linkedin</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_linkedin_share" type="object" string="Share on LinkedIn"
                        icon="fa-linkedin" invisible="not id or not website_published"
                        groups="hr_recruitment.group_hr_recruitment_user"/>
            </xpath>
            <xpath expr="//page[@name='job_description_page']" position="after">
                <page string="LinkedIn" name="talent_linkedin_page" groups="hr_recruitment.group_hr_recruitment_user">
                    <field name="website_published" invisible="1"/>
                    <group>
                        <group>
                            <field name="linkedin_listed"/>
                            <field name="linkedin_workplace_type" placeholder="From the Job Location"/>
                            <field name="linkedin_experience_level"/>
                        </group>
                        <group>
                            <div class="text-muted" colspan="2">
                                Listed jobs go into the LinkedIn job feed (Settings › Talent › Job Boards)
                                while they are published on the website. The job type comes from the
                                Employment Type.
                            </div>
                            <div class="alert alert-warning mb-0" role="alert" colspan="2"
                                 invisible="not linkedin_listed or website_published">
                                Publish the job position on the website for LinkedIn to list it.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_job_view_search_linkedin" model="ir.ui.view">
        <field name="name">hr.job.search.linkedin</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.view_job_filter_recruitment"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_favorite_jobs']" position="after">
                <filter name="linkedin_listed" string="Listed on LinkedIn" domain="[('linkedin_listed', '=', True)]"/>
            </xpath>
        </field>
    </record>
</odoo>
