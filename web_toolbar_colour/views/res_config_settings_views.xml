<odoo>
    <record id="res_config_settings_view_form_toolbar_colour" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.toolbar.colour</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='companies_setting_container']" position="inside">
                <setting id="toolbar_colour_setting" string="Toolbar colour" company_dependent="1"
                         help="Colour of the top toolbar for this company. Leave blank to use the Odoo default.">
                    <field name="toolbar_color" widget="toolbar_colour"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
