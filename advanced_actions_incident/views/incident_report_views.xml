<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_incident_report_form_advanced_actions" model="ir.ui.view">
        <field name="name">incident.report.form.advanced.actions</field>
        <field name="model">incident.report</field>
        <field name="inherit_id" ref="incident_management.view_incident_report_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']/button[field[@name='corrective_action_count']]" position="replace">
                <button name="action_open_corrective_actions" type="object"
                        class="oe_stat_button" icon="fa-check-square-o"
                        invisible="corrective_action_count == 0">
                    <field name="corrective_action_count" widget="statinfo" string="Actions"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='corrective_action_ids']" position="replace">
                <field name="corrective_action_ids" nolabel="1"
                       context="{'default_incident_id': id, 'default_source_app': 'incident'}">
                    <list editable="bottom" string="Corrective Actions"
                          decoration-danger="is_overdue"
                          decoration-success="state == 'done'"
                          decoration-muted="state == 'cancelled'">
                        <field name="id" optional="show" readonly="1"/>
                        <field name="priority" widget="priority" optional="show"/>
                        <field name="name" style="min-width:280px"/>
                        <field name="control_type_id" optional="show" options="{'no_create': True}"/>
                        <field name="icam_finding_id" optional="show"
                               domain="[('incident_id', '=', parent.id)]"
                               options="{'no_create': True}"/>
                        <field name="user_ids" widget="many2many_avatar_user"/>
                        <field name="date_deadline" options="{'numeric': True}"/>
                        <field name="checklist_template_id" optional="hide"/>
                        <field name="state" widget="badge"
                               decoration-success="state == 'done'"
                               decoration-warning="state == 'in_progress'"
                               decoration-danger="is_overdue"/>
                        <field name="date_done" optional="show" options="{'numeric': True}"/>
                        <field name="is_overdue" column_invisible="True"/>
                        <field name="checklist_state" column_invisible="True"/>
                        <button name="action_start" string="Start"
                                type="object" class="btn-sm btn-secondary"
                                invisible="state != 'open'"/>
                        <button name="action_done" string="Done"
                                type="object" class="btn-sm btn-primary"
                                invisible="state in ('done', 'cancelled') or (checklist_template_id and checklist_state != 'done')"/>
                    </list>
                </field>
            </xpath>
        </field>
    </record>
</odoo>
