<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Added to the "shared with me" rules: users also see the dashboards
             of their Permission Profile. -->
        <record id="rule_dashboard_profile" model="ir.rule">
            <field name="name">Dashboard: shared with my profile</field>
            <field name="model_id" ref="custom_dashboard.model_custom_dashboard"/>
            <field name="domain_force">[('permission_profile_ids', 'in', user.permission_profile_id.ids)]</field>
            <field name="groups" eval="[(4, ref('custom_dashboard.group_dashboard_user'))]"/>
        </record>

        <record id="rule_dashboard_widget_profile" model="ir.rule">
            <field name="name">Dashboard Widget: shared with my profile</field>
            <field name="model_id" ref="custom_dashboard.model_custom_dashboard_widget"/>
            <field name="domain_force">[('dashboard_id.permission_profile_ids', 'in', user.permission_profile_id.ids)]</field>
            <field name="groups" eval="[(4, ref('custom_dashboard.group_dashboard_user'))]"/>
        </record>
    </data>
</odoo>
