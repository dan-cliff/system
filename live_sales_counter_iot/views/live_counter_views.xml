<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_live_counter_form_displays" model="ir.ui.view">
        <field name="name">live.counter.form.displays</field>
        <field name="model">live.counter</field>
        <field name="inherit_id" ref="live_sales_counter.view_live_counter_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/widget[1]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_displays" type="object" class="oe_stat_button" icon="fa-television"
                            groups="iot_interfaces.group_iot_user"
                            invisible="not id">
                        <field name="display_count" widget="statinfo" string="Display Screens"/>
                    </button>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
