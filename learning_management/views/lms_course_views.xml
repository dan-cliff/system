<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Course Category ─── -->
    <record id="view_lms_course_category_list" model="ir.ui.view">
        <field name="name">lms.course.category.list</field>
        <field name="model">lms.course.category</field>
        <field name="arch" type="xml">
            <list string="Course Categories" editable="bottom">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="course_count" string="Courses"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_lms_course_category_form" model="ir.ui.view">
        <field name="name">lms.course.category.form</field>
        <field name="model">lms.course.category</field>
        <field name="arch" type="xml">
            <form string="Course Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Courses" name="courses">
                            <field name="course_ids" readonly="1">
                                <list>
                                    <field name="id" optional="show"/>
                                    <field name="name"/>
                                    <field name="course_type"/>
                                    <field name="delivery_mode"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lms_course_category" model="ir.actions.act_window">
        <field name="name">Course Categories</field>
        <field name="res_model">lms.course.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ─── Course ─── -->
    <record id="view_lms_course_list" model="ir.ui.view">
        <field name="name">lms.course.list</field>
        <field name="model">lms.course</field>
        <field name="arch" type="xml">
            <list string="Courses" decoration-muted="not active">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="course_type"/>
                <field name="delivery_mode"/>
                <field name="duration_hours"/>
                <field name="validity_months"/>
                <field name="is_mandatory"/>
                <field name="company_ids" widget="many2many_tags" optional="show"
                       groups="base.group_multi_company"/>
                <field name="session_count" string="Sessions"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_lms_course_kanban" model="ir.ui.view">
        <field name="name">lms.course.kanban</field>
        <field name="model">lms.course</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="course_type">
                <field name="name"/>
                <field name="course_type"/>
                <field name="delivery_mode"/>
                <field name="category_id"/>
                <field name="image"/>
                <field name="is_mandatory"/>
                <field name="session_count"/>
                <templates>
                    <t t-name="card">
                        <div class="o_kanban_image me-1" t-if="record.image.raw_value">
                            <img t-att-src="kanban_image('lms.course', 'image', record.id.raw_value)"
                                 alt="Course"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <div class="o_kanban_tags_section">
                                <field name="category_id" widget="many2one_tags"/>
                            </div>
                            <ul>
                                <li>Type: <field name="course_type"/></li>
                                <li>Delivery: <field name="delivery_mode"/></li>
                                <li t-if="record.session_count.raw_value">
                                    Sessions: <field name="session_count"/>
                                </li>
                            </ul>
                            <div t-if="record.is_mandatory.raw_value" class="badge bg-danger">Mandatory</div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_lms_course_form" model="ir.ui.view">
        <field name="name">lms.course.form</field>
        <field name="model">lms.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <header>
                    <button name="action_view_sessions" type="object" string="Sessions"
                            class="btn-secondary"
                            invisible="delivery_mode != 'in_person'"/>
                    <button name="action_view_records" type="object" string="Employee Records"
                            class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sessions" type="object" class="oe_stat_button"
                                icon="fa-calendar"
                                invisible="delivery_mode != 'in_person'">
                            <field name="session_count" widget="statinfo" string="Sessions"/>
                        </button>
                        <button name="action_view_records" type="object" class="oe_stat_button"
                                icon="fa-users">
                            <field name="record_count" widget="statinfo" string="Employees"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Course Name"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="code"/>
                            <field name="category_id"/>
                            <field name="course_type"/>
                            <field name="delivery_mode"/>
                            <field name="duration_hours" widget="float_time"/>
                            <field name="cost" widget="monetary"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="validity_months"
                                   help="0 = no expiry. Enter the number of months this licence/qualification remains valid."/>
                        </group>
                        <group string="Companies / Branches" name="companies"
                               groups="base.group_multi_company">
                            <field name="company_ids" widget="many2many_tags"
                                   placeholder="All companies"
                                   options="{'no_create': True}"/>
                            <field name="applicable_company_ids" widget="many2many_tags"
                                   invisible="not company_ids"/>
                        </group>
                        <group string="Settings">
                            <field name="is_mandatory"/>
                            <field name="requires_upload"/>
                            <field name="passing_score"
                                   invisible="delivery_mode not in ('scorm',)"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <!-- SCORM -->
                    <group string="SCORM Package" invisible="delivery_mode != 'scorm'">
                        <field name="scorm_package_id" widget="binary"
                               filename="scorm_package_filename"
                               string="SCORM Package (ZIP)"/>
                        <field name="scorm_package_filename" string="Uploaded File"
                               readonly="1"
                               invisible="not scorm_package_id"/>
                        <field name="scorm_launch_file"
                               placeholder="e.g. index.html (leave blank to auto-detect)"/>
                    </group>

                    <!-- Google Slides / Presentation -->
                    <group string="Presentation" invisible="delivery_mode != 'google_slides'">
                        <field name="google_slides_url"
                               placeholder="https://docs.google.com/presentation/d/xxx/embed"/>
                        <field name="slide_count"
                               help="Number of slides in this deck. Employees must advance through every slide before they can mark the training complete. Set to 0 to skip page-by-page tracking."/>
                        <div class="o_field_widget o_wrap_field" colspan="2">
                            <div class="alert alert-info" role="alert">
                                <strong>Tip:</strong> For Google Slides, use the embed URL:
                                open your presentation, go to
                                <em>File → Share → Publish to web</em>, select <em>Embed</em>
                                and copy the <code>src</code> URL from the iframe code.
                                Then set <strong>Number of Slides</strong> so employees must
                                view every page before completing.
                            </div>
                        </div>
                    </group>

                    <!-- Supporting Documents -->
                    <group string="Supporting Documents"
                           invisible="delivery_mode not in ('document', 'upload')">
                        <field name="document_ids" widget="many2many_binary" nolabel="1"/>
                    </group>

                    <!-- Assessment -->
                    <group string="Assessment" name="assessment_group">
                        <field name="assessment_template_id"/>
                        <field name="requires_assessment"
                               invisible="not assessment_template_id"/>
                    </group>

                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lms_course_search" model="ir.ui.view">
        <field name="name">lms.course.search</field>
        <field name="model">lms.course</field>
        <field name="arch" type="xml">
            <search string="Search Courses">
                <field name="name" string="Course" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="category_id"/>
                <field name="applicable_company_ids" string="Company / Branch"
                       groups="base.group_multi_company"/>
                <filter name="type_licence" string="Licences" domain="[('course_type', '=', 'licence')]"/>
                <filter name="type_qualification" string="Qualifications" domain="[('course_type', '=', 'qualification')]"/>
                <filter name="type_training" string="Training" domain="[('course_type', '=', 'training')]"/>
                <filter name="type_elearning" string="eLearning" domain="[('course_type', '=', 'elearning')]"/>
                <separator/>
                <filter name="mandatory" string="Mandatory" domain="[('is_mandatory', '=', True)]"/>
                <filter name="my_companies" string="My Companies"
                        domain="[('applicable_company_ids', 'in', allowed_company_ids)]"
                        groups="base.group_multi_company"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group name="group_by">
                    <filter name="group_type" string="Type" context="{'group_by': 'course_type'}"/>
                    <filter name="group_delivery" string="Delivery Mode" context="{'group_by': 'delivery_mode'}"/>
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lms_course" model="ir.actions.act_window">
        <field name="name">Course Library</field>
        <field name="res_model">lms.course</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_lms_course_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first course, licence, or qualification!
            </p>
            <p>
                Build a library of licences, qualifications, training and eLearning content.
                Then package them into Course Groups and assign them to employees.
            </p>
        </field>
    </record>
</odoo>
