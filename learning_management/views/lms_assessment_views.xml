<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Assessment Question (popup form) ─── -->
    <record id="view_lms_assessment_question_form" model="ir.ui.view">
        <field name="name">lms.assessment.question.form</field>
        <field name="model">lms.assessment.question</field>
        <field name="arch" type="xml">
            <form string="Question">
                <sheet>
                    <group>
                        <field name="question_type"/>
                        <field name="question_text"/>
                        <field name="marks"
                               invisible="question_type in ('checklist_item', 'short_text')"/>
                    </group>
                    <group string="Multiple Choice Options"
                           invisible="question_type != 'multiple_choice'">
                        <field name="option_ids" nolabel="1" colspan="2">
                            <list editable="bottom">
                                <field name="id" optional="show"/>
                                <field name="sequence" widget="handle"/>
                                <field name="text"/>
                            </list>
                        </field>
                        <field name="correct_option_id"
                               domain="[('id', 'in', option_ids)]"/>
                    </group>
                    <group string="True / False Answer"
                           invisible="question_type != 'true_false'">
                        <field name="correct_bool" string="Correct Answer is True"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ─── Assessment Template ─── -->
    <record id="view_lms_assessment_template_list" model="ir.ui.view">
        <field name="name">lms.assessment.template.list</field>
        <field name="model">lms.assessment.template</field>
        <field name="arch" type="xml">
            <list string="Assessment Templates">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="delivery_type"/>
                <field name="question_count" string="Questions"/>
                <field name="passing_score" string="Passing %"/>
                <field name="course_count" string="Courses"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_lms_assessment_template_form" model="ir.ui.view">
        <field name="name">lms.assessment.template.form</field>
        <field name="model">lms.assessment.template</field>
        <field name="arch" type="xml">
            <form string="Assessment Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_courses" type="object"
                                class="oe_stat_button" icon="fa-book">
                            <field name="course_count" widget="statinfo" string="Courses"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Template Name"/></h1>
                    </div>
                    <group>
                        <group string="Settings">
                            <field name="delivery_type"/>
                            <field name="passing_score"
                                   invisible="delivery_type == 'assessor_checklist'"/>
                        </group>
                        <group string="Status">
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Questions / Checklist Items" name="questions">
                            <field name="question_ids">
                                <list>
                                    <field name="id" optional="show"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_type"/>
                                    <field name="question_text"/>
                                    <field name="marks"
                                           invisible="question_type in ('checklist_item', 'short_text')"/>
                                    <field name="correct_bool" string="Correct = True"
                                           invisible="question_type != 'true_false'"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="question_type"/>
                                            <field name="question_text"/>
                                            <field name="marks"
                                                   invisible="question_type in ('checklist_item', 'short_text')"/>
                                        </group>
                                        <group string="Multiple Choice Options"
                                               invisible="question_type != 'multiple_choice'">
                                            <field name="option_ids" nolabel="1" colspan="2">
                                                <list editable="bottom">
                                                    <field name="id" optional="show"/>
                                                    <field name="sequence" widget="handle"/>
                                                    <field name="text"/>
                                                </list>
                                            </field>
                                            <field name="correct_option_id"
                                                   domain="[('id', 'in', option_ids)]"/>
                                        </group>
                                        <group string="True / False Answer"
                                               invisible="question_type != 'true_false'">
                                            <field name="correct_bool" string="Correct Answer is True"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lms_assessment_template_search" model="ir.ui.view">
        <field name="name">lms.assessment.template.search</field>
        <field name="model">lms.assessment.template</field>
        <field name="arch" type="xml">
            <search string="Search Assessment Templates">
                <field name="name"/>
                <filter name="electronic" string="Electronic"
                        domain="[('delivery_type', '=', 'electronic')]"/>
                <filter name="assessor_checklist" string="Assessor Checklist"
                        domain="[('delivery_type', '=', 'assessor_checklist')]"/>
                <separator/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_lms_assessment_template" model="ir.actions.act_window">
        <field name="name">Assessment Templates</field>
        <field name="res_model">lms.assessment.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lms_assessment_template_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first assessment template!
            </p>
            <p>
                Build electronic quizzes or assessor checklists and link them to courses.
            </p>
        </field>
    </record>

    <!-- ─── Assessment Instance ─── -->
    <record id="view_lms_assessment_list" model="ir.ui.view">
        <field name="name">lms.assessment.list</field>
        <field name="model">lms.assessment</field>
        <field name="arch" type="xml">
            <list string="Assessments"
                  decoration-success="passed"
                  decoration-danger="state == 'failed'"
                  decoration-warning="state in ('in_progress', 'submitted')">
                <field name="id" optional="show"/>
                <field name="employee_id"/>
                <field name="course_id"/>
                <field name="template_id"/>
                <field name="delivery_type"/>
                <field name="state"/>
                <field name="score"/>
                <field name="passed"/>
                <field name="assessor_id" optional="show"/>
                <field name="start_date" optional="show" options='{"format": "dd/MM/yyyy HH:mm"}'/>
                <field name="submit_date" optional="show" options='{"format": "dd/MM/yyyy HH:mm"}'/>
            </list>
        </field>
    </record>

    <record id="view_lms_assessment_form" model="ir.ui.view">
        <field name="name">lms.assessment.form</field>
        <field name="model">lms.assessment</field>
        <field name="arch" type="xml">
            <form string="Assessment">
                <header>
                    <button name="action_start" type="object" string="Start"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-success"
                            invisible="state != 'in_progress'"/>
                    <button name="action_pass" type="object" string="Pass"
                            class="btn-success"
                            invisible="state != 'submitted'"
                            groups="learning_management.group_lms_manager"/>
                    <button name="action_fail" type="object" string="Fail"
                            invisible="state != 'submitted'"
                            groups="learning_management.group_lms_manager"/>
                    <button name="action_reset" type="object" string="Reset"
                            invisible="state == 'draft'"
                            groups="learning_management.group_lms_admin"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,submitted,passed,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Assessment">
                            <field name="template_id"
                                   readonly="state != 'draft'"/>
                            <field name="delivery_type" readonly="1"/>
                            <field name="employee_record_id"/>
                            <field name="employee_id" readonly="1"/>
                            <field name="course_id" readonly="1"/>
                            <field name="assessor_id"/>
                        </group>
                        <group string="Result">
                            <field name="state" readonly="1"/>
                            <field name="score"/>
                            <field name="passed"/>
                            <field name="start_date" options='{"format": "dd/MM/yyyy HH:mm"}'/>
                            <field name="submit_date" options='{"format": "dd/MM/yyyy HH:mm"}'/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" colspan="2"/>
                    </group>
                    <notebook>
                        <page string="Answers / Checklist" name="answers">
                            <field name="answer_ids" readonly="state != 'in_progress'">
                                <list editable="bottom">
                                    <field name="id" optional="show"/>
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="question_text" readonly="1"/>
                                    <field name="question_type" readonly="1"/>
                                    <field name="selected_option_id"
                                           domain="[('question_id', '=', question_id)]"
                                           invisible="question_type != 'multiple_choice'"/>
                                    <field name="bool_answer"
                                           invisible="question_type != 'true_false'"/>
                                    <field name="text_answer"
                                           invisible="question_type != 'short_text'"/>
                                    <field name="is_checked"
                                           invisible="question_type != 'checklist_item'"/>
                                    <field name="is_correct" readonly="1"
                                           invisible="question_type in ('short_text', 'checklist_item')"/>
                                    <field name="question_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lms_assessment_search" model="ir.ui.view">
        <field name="name">lms.assessment.search</field>
        <field name="model">lms.assessment</field>
        <field name="arch" type="xml">
            <search string="Search Assessments">
                <field name="employee_id"/>
                <field name="course_id"/>
                <field name="template_id"/>
                <filter name="draft" string="Not Started" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="submitted" string="Awaiting Review" domain="[('state', '=', 'submitted')]"/>
                <filter name="passed" string="Passed" domain="[('state', '=', 'passed')]"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <filter name="electronic" string="Electronic"
                        domain="[('delivery_type', '=', 'electronic')]"/>
                <filter name="assessor_checklist" string="Assessor Checklist"
                        domain="[('delivery_type', '=', 'assessor_checklist')]"/>
                <group name="group_by">
                    <filter name="group_employee" string="Employee"
                            context="{'group_by': 'employee_id'}"/>
                    <filter name="group_course" string="Course"
                            context="{'group_by': 'course_id'}"/>
                    <filter name="group_state" string="State"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lms_assessment" model="ir.actions.act_window">
        <field name="name">Assessments</field>
        <field name="res_model">lms.assessment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lms_assessment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No assessments yet.
            </p>
            <p>
                Assessments are created from employee training records once an assessment template
                is linked to the course.
            </p>
        </field>
    </record>
</odoo>
