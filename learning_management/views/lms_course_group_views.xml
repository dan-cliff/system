<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ─── Course Group ─── -->
    <record id="view_lms_course_group_list" model="ir.ui.view">
        <field name="name">lms.course.group.list</field>
        <field name="model">lms.course.group</field>
        <field name="arch" type="xml">
            <list string="Training Packages">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="code"/>
                <field name="course_count" string="Courses"/>
                <field name="assignment_count" string="Assigned To"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_lms_course_group_kanban" model="ir.ui.view">
        <field name="name">lms.course.group.kanban</field>
        <field name="model">lms.course.group</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="color"/>
                <field name="course_count"/>
                <field name="assignment_count"/>
                <field name="image"/>
                <templates>
                    <t t-name="card" class="oe_kanban_card">
                        <div class="o_kanban_image me-1" t-if="record.image.raw_value">
                            <img t-att-src="kanban_image('lms.course.group', 'image', record.id.raw_value)"
                                 alt="Package"/>
                        </div>
                        <div class="oe_kanban_details">
                            <strong class="o_kanban_record_title">
                                <field name="name"/>
                            </strong>
                            <ul>
                                <li><field name="course_count"/> Courses</li>
                                <li><field name="assignment_count"/> Employees Assigned</li>
                            </ul>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_lms_course_group_form" model="ir.ui.view">
        <field name="name">lms.course.group.form</field>
        <field name="model">lms.course.group</field>
        <field name="arch" type="xml">
            <form string="Training Package">
                <header>
                    <button name="action_view_assignments" type="object"
                            string="View Assignments" class="btn-secondary"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assignments" type="object"
                                class="oe_stat_button" icon="fa-users">
                            <field name="assignment_count" widget="statinfo" string="Assignments"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Training Package Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="color" widget="color_picker"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" nolabel="1"/>
                    <notebook>
                        <page string="Courses in this Package" name="courses">
                            <field name="course_ids">
                                <list>
                                    <field name="id" optional="show"/>
                                    <field name="name"/>
                                    <field name="course_type"/>
                                    <field name="delivery_mode"/>
                                    <field name="duration_hours"/>
                                    <field name="validity_months"/>
                                    <field name="is_mandatory"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_lms_course_group" model="ir.actions.act_window">
        <field name="name">Training Packages</field>
        <field name="res_model">lms.course.group</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first training package!
            </p>
            <p>
                Group courses, licences, qualifications and eLearning into packages
                that can be assigned to employees.
            </p>
        </field>
    </record>

    <!-- ─── Assignment ─── -->
    <record id="view_lms_assignment_list" model="ir.ui.view">
        <field name="name">lms.course.group.assignment.list</field>
        <field name="model">lms.course.group.assignment</field>
        <field name="arch" type="xml">
            <list string="Training Package Assignments"
                  decoration-success="state == 'completed'"
                  decoration-warning="due_date and due_date &lt; context_today() and state != 'completed'">
                <field name="id" optional="show"/>
                <field name="employee_id"/>
                <field name="course_group_id"/>
                <field name="date_assigned" options='{"format": "dd/MM/yyyy"}'/>
                <field name="due_date" options='{"format": "dd/MM/yyyy"}'/>
                <field name="assigned_by"/>
                <field name="progress" widget="progressbar"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_lms_assignment_form" model="ir.ui.view">
        <field name="name">lms.course.group.assignment.form</field>
        <field name="model">lms.course.group.assignment</field>
        <field name="arch" type="xml">
            <form string="Training Package Assignment">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="in_progress,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_records" type="object"
                                class="oe_stat_button" icon="fa-list">
                            <field name="record_count" widget="statinfo" string="Records"/>
                        </button>
                    </div>
                    <group>
                        <group string="Assignment">
                            <field name="employee_id"/>
                            <field name="course_group_id"/>
                            <field name="date_assigned" options='{"format": "dd/MM/yyyy"}'/>
                            <field name="due_date" options='{"format": "dd/MM/yyyy"}'/>
                        </group>
                        <group string="Progress">
                            <field name="assigned_by" readonly="1"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="completed_count" readonly="1" string="Completed"/>
                            <field name="record_count" readonly="1" string="Total"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Course Records" name="records">
                            <field name="record_ids" readonly="1">
                                <list decoration-success="state == 'completed'"
                                      decoration-warning="state in ('in_progress', 'pending_upload', 'pending_verification')"
                                      decoration-danger="state in ('failed', 'expired')">
                                    <field name="id" optional="show"/>
                                    <field name="course_id"/>
                                    <field name="course_type"/>
                                    <field name="delivery_mode"/>
                                    <field name="state"/>
                                    <field name="completion_date" options='{"format": "dd/MM/yyyy"}'/>
                                    <field name="expiry_date" options='{"format": "dd/MM/yyyy"}'/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_lms_assignment_search" model="ir.ui.view">
        <field name="name">lms.course.group.assignment.search</field>
        <field name="model">lms.course.group.assignment</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="course_group_id"/>
                <filter name="in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="completed" string="Completed" domain="[('state', '=', 'completed')]"/>
                <filter name="overdue" string="Overdue"
                        domain="[('due_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', '!=', 'completed')]"/>
                <group name="group_by">
                    <filter name="group_employee" string="Employee" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_package" string="Package" context="{'group_by': 'course_group_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_lms_assignment" model="ir.actions.act_window">
        <field name="name">Training Assignments</field>
        <field name="res_model">lms.course.group.assignment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_lms_assignment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Assign a training package to an employee!
            </p>
        </field>
    </record>
</odoo>
