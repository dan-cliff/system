<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Module Category ─────────────────────────────────────────────── -->
        <record id="module_category_lms" model="ir.module.category">
            <field name="name">Learning Management System</field>
            <field name="description">Manage licences, qualifications, training and eLearning delivery.</field>
            <field name="sequence">52</field>
        </record>

        <!-- ── Privilege (Odoo 19 way to link groups to a category in Settings) ── -->
        <record id="privilege_lms" model="res.groups.privilege">
            <field name="name">Learning Management System</field>
            <field name="category_id" ref="module_category_lms"/>
            <field name="sequence">10</field>
            <field name="placeholder">No Access</field>
        </record>

        <!-- ── Security Groups ─────────────────────────────────────────────── -->
        <!-- Hierarchy: Employee → People Leader → Facilitator → Manager → Administrator -->

        <!-- Employee: view and complete own training via portal -->
        <record id="group_lms_employee" model="res.groups">
            <field name="name">Employee</field>
            <field name="privilege_id" ref="privilege_lms"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">
                Can view and complete their own assigned training via the portal.
                Can upload documents for licences and qualifications.
                Can self-enrol in open in-person sessions (subject to manager approval).
            </field>
        </record>

        <!-- People Leader: Employee + approve team enrolments, view team records -->
        <record id="group_lms_people_leader" model="res.groups">
            <field name="name">People Leader</field>
            <field name="privilege_id" ref="privilege_lms"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_lms_employee'))]"/>
            <field name="comment">
                All Employee permissions, plus:
                Can view and approve training records for their direct reports.
                Can approve or reject self-enrolment requests from their team.
            </field>
        </record>

        <!-- Training Facilitator: People Leader + manage sessions and attendance -->
        <record id="group_lms_facilitator" model="res.groups">
            <field name="name">Training Facilitator</field>
            <field name="privilege_id" ref="privilege_lms"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_lms_people_leader'))]"/>
            <field name="comment">
                All People Leader permissions, plus:
                Can create and manage in-person course sessions.
                Can record attendance and mark sessions complete.
                Can enrol employees in sessions directly.
            </field>
        </record>

        <!-- Training Manager: Facilitator + manage course library and assign packages -->
        <record id="group_lms_manager" model="res.groups">
            <field name="name">Training Manager</field>
            <field name="privilege_id" ref="privilege_lms"/>
            <field name="sequence">40</field>
            <field name="implied_ids" eval="[(4, ref('group_lms_facilitator'))]"/>
            <field name="comment">
                All Training Facilitator permissions, plus:
                Can create and edit courses, course groups, and SCORM/eLearning content.
                Can assign training packages to employees.
                Can verify uploaded licence and qualification documents.
            </field>
        </record>

        <!-- Administrator: full access to all LMS features -->
        <record id="group_lms_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="privilege_id" ref="privilege_lms"/>
            <field name="sequence">50</field>
            <field name="implied_ids" eval="[(4, ref('group_lms_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">
                Full access to all Learning Management System features,
                including notification templates, settings and system configuration.
            </field>
        </record>

    </data>

    <!-- ── Record Rules ────────────────────────────────────────────────────── -->
    <data>

        <!-- Employees can only see their OWN records -->
        <record id="rule_lms_record_employee" model="ir.rule">
            <field name="name">LMS: Employee sees own records only</field>
            <field name="model_id" ref="model_lms_employee_record"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_lms_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- People Leaders see their own records AND their direct reports' records -->
        <record id="rule_lms_record_people_leader" model="ir.rule">
            <field name="name">LMS: People Leader sees own + team records</field>
            <field name="model_id" ref="model_lms_employee_record"/>
            <field name="domain_force">[
                '|',
                ('user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_lms_people_leader'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Facilitators and above see all records -->
        <record id="rule_lms_record_facilitator" model="ir.rule">
            <field name="name">LMS: Facilitator/Manager/Admin sees all records</field>
            <field name="model_id" ref="model_lms_employee_record"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_lms_facilitator'))]"/>
        </record>

        <!-- Enrolment rules: employee sees own -->
        <record id="rule_lms_enrollment_employee" model="ir.rule">
            <field name="name">LMS: Employee sees own enrolments</field>
            <field name="model_id" ref="model_lms_session_enrollment"/>
            <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_lms_employee'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- People Leaders see own + team enrolments -->
        <record id="rule_lms_enrollment_people_leader" model="ir.rule">
            <field name="name">LMS: People Leader sees team enrolments</field>
            <field name="model_id" ref="model_lms_session_enrollment"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.parent_id.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_lms_people_leader'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Facilitators and above see all enrolments -->
        <record id="rule_lms_enrollment_facilitator" model="ir.rule">
            <field name="name">LMS: Facilitator/Manager/Admin sees all enrolments</field>
            <field name="model_id" ref="model_lms_session_enrollment"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_lms_facilitator'))]"/>
        </record>

    </data>
</odoo>
