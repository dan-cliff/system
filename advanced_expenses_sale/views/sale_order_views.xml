<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_advanced_expenses" model="ir.ui.view">
        <field name="name">sale.order.form.advanced_expenses</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_advanced_expenses" type="object" class="oe_stat_button" icon="fa-money"
                        invisible="not advanced_expense_count" groups="advanced_expenses.group_expenses_user">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="advanced_expense_count"/></span>
                        <span class="o_stat_text">Expenses</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
