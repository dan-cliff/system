<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Keeps the Public Holidays library up to date when Settings › Rostering ›
         Import Public Holidays is on (the job does nothing otherwise). -->
    <record id="ir_cron_import_public_holidays" model="ir.cron">
        <field name="name">Rostering: Import Public Holidays</field>
        <field name="model_id" ref="model_rostering_public_holiday"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_public_holidays()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">weeks</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
