<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every permission below is its
         own privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Rostering user group, which
         holds the ACLs and a deny rule per operation, so users can only do what
         a permission opens. Shifts and breaks follow their roster: adding or
         removing them is editing the roster. "Own" leave is a request they
         created or that is theirs (user_id); Personnel (advanced_rostering_hr)
         adds the org chart to "My Team" and the employee's Manager as approver.
         Publishing and unpublishing are checked in code and write with sudo(). -->
    <data noupdate="1">
        <record id="module_category_advanced_rostering" model="ir.module.category">
            <field name="name">Rostering</field>
            <field name="description">Rosters, shifts and leave requests.</field>
            <field name="sequence">47</field>
        </record>
    </data>

    <record id="group_rostering_user" model="res.groups">
        <field name="name">Rostering: User</field>
        <field name="comment">Technical: given by every Rostering permission. Opens the app; what users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

