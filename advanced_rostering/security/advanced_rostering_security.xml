        <field name="sequence">120</field>
        <field name="description">Request leave, and view their own requests (no editing after saving).</field>
    </record>
    <record id="group_leave_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_leave_create_only"/>
        <field name="comment">Request leave, and view their own requests (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_rostering_user'))]"/>
