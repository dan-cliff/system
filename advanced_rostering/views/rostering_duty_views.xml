<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rostering_duty_view_list" model="ir.ui.view">
        <field name="name">rostering.duty.list</field>
        <field name="model">rostering.duty</field>
        <field name="arch" type="xml">
            <list string="Duties">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="description" optional="show"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="rostering_duty_view_form" model="ir.ui.view">
        <field name="name">rostering.duty.form</field>
        <field name="model">rostering.duty</field>
        <field name="arch" type="xml">
            <form string="Duty">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Front Counter"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What the person on this duty does..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rostering_duty_view_search" model="ir.ui.view">
        <field name="name">rostering.duty.search</field>
        <field name="model">rostering.duty</field>
        <field name="arch" type="xml">
            <search string="Duties">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rostering_duty" model="ir.actions.act_window">
        <field name="name">Duties</field>
        <field name="res_model">rostering.duty</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a duty</p>
            <p>Duties say what each shift is for (e.g. Front Counter, Kitchen, Cleaning).</p>
        </field>
    </record>
</odoo>
