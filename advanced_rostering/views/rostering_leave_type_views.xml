<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rostering_leave_type_view_list" model="ir.ui.view">
        <field name="name">rostering.leave.type.list</field>
        <field name="model">rostering.leave.type</field>
        <field name="arch" type="xml">
            <list string="Leave Types">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="color" widget="color_picker" optional="show"/>
                <field name="description" optional="show"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="rostering_leave_type_view_form" model="ir.ui.view">
        <field name="name">rostering.leave.type.form</field>
        <field name="model">rostering.leave.type</field>
        <field name="arch" type="xml">
            <form string="Leave Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Annual Leave"/></h1>
                    </div>
                    <group>
                        <group name="main">
                            <field name="color" widget="color_picker"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="When this leave applies..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="rostering_leave_type_view_search" model="ir.ui.view">
        <field name="name">rostering.leave.type.search</field>
        <field name="model">rostering.leave.type</field>
        <field name="arch" type="xml">
            <search string="Leave Types">
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_rostering_leave_type" model="ir.actions.act_window">
        <field name="name">Leave Types</field>
        <field name="res_model">rostering.leave.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a leave type</p>
            <p>The kinds of leave people can request.</p>
        </field>
    </record>
</odoo>
