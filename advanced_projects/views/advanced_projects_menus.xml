<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_advanced_projects_root"
              name="Project"
              web_icon="advanced_projects,static/description/icon.png"
              action="advanced_project_action"
              groups="group_advanced_project_user"
              sequence="60"/>

    <menuitem id="menu_advanced_projects_projects" name="Projects" parent="menu_advanced_projects_root"
              action="advanced_project_action" sequence="10"/>

    <menuitem id="menu_advanced_projects_tasks" name="Tasks" parent="menu_advanced_projects_root" sequence="20"/>
    <menuitem id="menu_advanced_projects_task_my" name="My Tasks" parent="menu_advanced_projects_tasks"
              action="advanced_project_task_action_my" sequence="10"/>
    <menuitem id="menu_advanced_projects_task_all" name="All Tasks" parent="menu_advanced_projects_tasks"
              action="advanced_project_task_action_all" sequence="20"/>

    <menuitem id="menu_advanced_projects_ratings" name="Ratings" parent="menu_advanced_projects_root"
              action="advanced_project_rating_action" sequence="30"/>

    <!-- Where Report Builder saves this app's reports (CLAUDE.md > Reports menu).
         It has no action, so Odoo hides it until a report is placed under it. -->
    <menuitem id="menu_advanced_projects_reports" name="Reports" parent="menu_advanced_projects_root" sequence="85"/>

    <menuitem id="menu_advanced_projects_config" name="Configuration" parent="menu_advanced_projects_root"
              groups="group_advanced_project_manager" sequence="90"/>
    <menuitem id="menu_advanced_projects_templates" name="Project Templates" parent="menu_advanced_projects_config"
              action="advanced_project_template_action" sequence="10"/>
    <menuitem id="menu_advanced_projects_type" name="Project Types" parent="menu_advanced_projects_config"
              action="advanced_project_type_action" sequence="15"/>
    <menuitem id="menu_advanced_projects_budget_category" name="Budget Categories" parent="menu_advanced_projects_config"
              action="advanced_project_budget_category_action" sequence="17"/>
    <menuitem id="menu_advanced_projects_stage" name="Project Stages" parent="menu_advanced_projects_config"
              action="advanced_project_stage_action" sequence="20"/>
    <menuitem id="menu_advanced_projects_status" name="Project Statuses" parent="menu_advanced_projects_config"
              action="advanced_project_status_action" sequence="30"/>
    <menuitem id="menu_advanced_projects_task_stage" name="Task Stages" parent="menu_advanced_projects_config"
              action="advanced_project_task_stage_action" sequence="40"/>
    <!-- Hidden while Workflow Automation is installed (see ir.ui.menu in
         advanced_project_notification.py). -->
    <menuitem id="menu_advanced_projects_notification" name="Notification Templates"
              parent="menu_advanced_projects_config" action="advanced_project_notification_action" sequence="60"/>
    <menuitem id="menu_advanced_projects_tag" name="Tags" parent="menu_advanced_projects_config"
              action="advanced_project_tag_action" sequence="50"/>
</odoo>
