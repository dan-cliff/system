<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configure an Overview widget (opened in a dialog from the Overview). -->
    <record id="advanced_project_overview_widget_view_form" model="ir.ui.view">
        <field name="name">advanced.project.overview.widget.form</field>
        <field name="model">advanced.project.overview.widget</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="widget_type"/>
                        <field name="name" placeholder="Default title"/>
                        <field name="width"/>
                    </group>
                    <group invisible="widget_type != 'task_counts'">
                        <field name="upcoming_days"/>
                    </group>
                    <group invisible="widget_type != 'task_list'">
                        <field name="task_filter"/>
                        <field name="days" invisible="task_filter not in ('upcoming', 'completed')"/>
                        <field name="task_limit"/>
                    </group>
                </group>
                <group invisible="widget_type != 'task_list'">
                    <group string="Filters">
                        <field name="phase_ids" widget="many2many_tags" options="{'no_create': True}"
                               domain="[('project_id', '=', project_id)]"/>
                        <field name="user_ids" widget="many2many_avatar_user" options="{'no_create': True}"
                               domain="[('share', '=', False)]"/>
                        <field name="customer_visible_only"/>
                    </group>
                    <group string="Columns">
                        <field name="show_assignees"/>
                        <field name="show_dates"/>
                        <field name="show_phase"/>
                        <field name="show_stage"/>
                    </group>
                </group>
                <field name="note" invisible="widget_type != 'note'" placeholder="Goals, links, key contacts..."/>
                <field name="project_id" invisible="1"/>
            </form>
        </field>
    </record>
</odoo>
