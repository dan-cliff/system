<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ratings of projects and tasks, given at any point of a project. Requested
         ratings are sent by Workflow Automation (Rating Link). -->
    <record id="advanced_project_rating_view_list" model="ir.ui.view">
        <field name="name">advanced.project.rating.list</field>
        <field name="model">advanced.project.rating</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'requested'">
                <field name="id" optional="show"/>
                <field name="project_id"/>
                <field name="task_id" optional="show"/>
                <field name="partner_id"/>
                <field name="score" widget="priority" readonly="1"/>
                <field name="feedback" optional="show"/>
                <field name="date_requested" options="{'numeric': True}" optional="hide"/>
                <field name="date_rated" options="{'numeric': True}" optional="show"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-info="state == 'requested'"
                       decoration-success="state == 'done'"/>
                <field name="score_value" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="advanced_project_rating_view_form" model="ir.ui.view">
        <field name="name">advanced.project.rating.form</field>
        <field name="model">advanced.project.rating</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" options="{'no_create': True}"/>
                            <field name="task_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="score" widget="priority"/>
                        </group>
                        <group>
                            <field name="date_requested" options="{'numeric': True}"/>
                            <field name="date_rated" options="{'numeric': True}" invisible="not date_rated"/>
                            <field name="requested_by_id" widget="many2one_avatar_user"/>
                            <field name="rating_url" widget="CopyClipboardChar" invisible="not id or state != 'requested'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="feedback" placeholder="What went well, what could be better..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="advanced_project_rating_view_search" model="ir.ui.view">
        <field name="name">advanced.project.rating.search</field>
        <field name="model">advanced.project.rating</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="partner_id"/>
                <filter string="Rated" name="rated" domain="[('state', '=', 'done')]"/>
                <filter string="Requested" name="requested" domain="[('state', '=', 'requested')]"/>
                <separator/>
                <filter string="Low (1–2 stars)" name="low" domain="[('state', '=', 'done'), ('score', 'in', ('1', '2'))]"/>
                <separator/>
                <filter string="Rated On" name="date_rated" date="date_rated"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Rated By" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Rating" name="group_score" context="{'group_by': 'score'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advanced_project_rating_view_graph" model="ir.ui.view">
        <field name="name">advanced.project.rating.graph</field>
        <field name="model">advanced.project.rating</field>
        <field name="arch" type="xml">
            <graph type="bar">
                <field name="project_id"/>
                <field name="score_value" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="advanced_project_rating_action" model="ir.actions.act_window">
        <field name="name">Ratings</field>
        <field name="res_model">advanced.project.rating</field>
        <field name="view_mode">list,form,graph</field>
        <field name="context">{'search_default_rated': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No ratings yet</p>
            <p>Record how a project is going at any point, or tick "Request a Rating on Completion" on a task
                to ask its customer when it is done.</p>
        </field>
    </record>

    <!-- Tasks: request a rating when done. -->
    <record id="advanced_project_task_view_form_rating" model="ir.ui.view">
        <field name="name">advanced.project.task.form.rating</field>
        <field name="model">advanced.project.task</field>
        <field name="inherit_id" ref="advanced_projects.advanced_project_task_view_form"/>
        <field name="arch" type="xml">
            <field name="customer_visible" position="after">
                <field name="request_rating"/>
                <field name="rating_partner_id" invisible="not request_rating" required="request_rating"/>
            </field>
            <xpath expr="//page[@name='links']" position="after">
                <page string="Ratings" name="ratings" invisible="not project_rating_ids">
                    <field name="project_rating_ids" readonly="1">
                        <list>
                            <field name="id" optional="show"/>
                            <field name="partner_id"/>
                            <field name="score" widget="priority"/>
                            <field name="feedback"/>
                            <field name="date_rated" options="{'numeric': True}"/>
                            <field name="state" widget="badge" decoration-info="state == 'requested'"
                                   decoration-success="state == 'done'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Projects: their ratings and average. -->
    <record id="advanced_project_view_form_rating" model="ir.ui.view">
        <field name="name">advanced.project.form.rating</field>
        <field name="model">advanced.project</field>
        <field name="inherit_id" ref="advanced_projects.advanced_project_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_team']" position="after">
                <button name="action_open_ratings" type="object" class="oe_stat_button" icon="fa-star"
                        invisible="is_template">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="project_rating_avg"/> / 5</span>
                        <span class="o_stat_text"><field name="project_rating_count"/> Ratings</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
