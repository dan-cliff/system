<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Notification Templates (Configuration). Hidden, and not sent, while
         Workflow Automation is installed: project notifications are workflows then. -->
    <record id="advanced_project_notification_view_list" model="ir.ui.view">
        <field name="name">advanced.project.notification.list</field>
        <field name="model">advanced.project.notification</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="event"/>
                <field name="project_type_ids" widget="many2many_tags" optional="show"/>
                <field name="subject" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="advanced_project_notification_view_form" model="ir.ui.view">
        <field name="name">advanced.project.notification.form</field>
        <field name="model">advanced.project.notification</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="render_model" invisible="1"/>
                    <field name="is_project_event" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Task assigned to you"/></h1>
                    </div>
                    <group>
                        <group string="When">
                            <field name="event"/>
                            <field name="days_before" invisible="event != 'task_due_soon'"/>
                            <field name="project_type_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group string="To">
                            <field name="notify_assignees" invisible="is_project_event"/>
                            <field name="notify_manager"/>
                            <field name="notify_team"/>
                            <field name="notify_customers" invisible="not is_project_event"/>
                            <field name="partner_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Email" name="email">
                            <group>
                                <field name="subject" placeholder="e.g. {{ object.name }}"/>
                            </group>
                            <field name="body_html" widget="html_mail" class="oe-bordered-editor"
                                   options="{'codeview': true, 'dynamic_placeholder': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="advanced_project_notification_action" model="ir.actions.act_window">
        <field name="name">Notification Templates</field>
        <field name="res_model">advanced.project.notification</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a notification template</p>
            <p>Emails sent when tasks are assigned, due soon, overdue or done, when a Project Update is
               published or when a project changes stage. When Workflow Automation is installed, set
               project notifications up as workflows instead.</p>
        </field>
    </record>
</odoo>
