<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Choice lists under Configuration (CLAUDE.md > Choice fields): editable lists,
         archived options stay on the records that use them. -->

    <record id="advanced_project_task_stage_view_list" model="ir.ui.view">
        <field name="name">advanced.project.task.stage.list</field>
        <field name="model">advanced.project.task.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="category"/>
                <field name="color" widget="color"/>
                <field name="fold"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="advanced_project_task_stage_view_form" model="ir.ui.view">
        <field name="name">advanced.project.task.stage.form</field>
        <field name="model">advanced.project.task.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="category"/>
                        <field name="color" widget="color"/>
                        <field name="fold"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="advanced_project_task_stage_view_search" model="ir.ui.view">
        <field name="name">advanced.project.task.stage.search</field>
        <field name="model">advanced.project.task.stage</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="advanced_project_task_stage_action" model="ir.actions.act_window">
        <field name="name">Task Stages</field>
        <field name="res_model">advanced.project.task.stage</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a task stage</p>
            <p>Stages are the columns of the task Kanban. Each has a category (To Do, In Progress, Blocked, Done or Cancelled) that the Overview, Project Updates and Gantt chart use.</p>
        </field>
    </record>

