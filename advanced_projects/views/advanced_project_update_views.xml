<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project Updates: drafted in the block editor (text and task widgets dragged
         in from a palette), then published with their task lists frozen. -->
    <record id="advanced_project_update_view_list" model="ir.ui.view">
        <field name="name">advanced.project.update.list</field>
        <field name="model">advanced.project.update</field>
        <field name="arch" type="xml">
            <list sample="1">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="project_id" column_invisible="context.get('default_project_id')"/>
                <field name="date" options="{'numeric': True}"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="status_id" optional="show"/>
                <field name="customer_visible" optional="show"/>
                <field name="published_date" options="{'numeric': True}" optional="hide"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="state" widget="badge" decoration-success="state == 'published'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="advanced_project_update_view_form" model="ir.ui.view">
        <field name="name">advanced.project.update.form</field>
        <field name="model">advanced.project.update</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"
                            invisible="state != 'draft' or not can_publish"
                            confirm="Publish this update? Its task lists are frozen as they are now, and it is posted on the project."/>
                    <button name="action_reset_draft" type="object" string="Back to Draft"
                            invisible="state != 'published' or not can_publish"/>
                    <button name="action_preview" type="object" string="Customer Preview"
                            invisible="state != 'published' or not customer_visible"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_project" type="object" class="oe_stat_button" icon="fa-folder-open">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Project</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Weekly update" readonly="state == 'published'"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id" readonly="id"/>
                            <field name="date" options="{'numeric': True}" readonly="state == 'published'"/>
                            <field name="user_id" widget="many2one_avatar_user" readonly="state == 'published'"/>
                        </group>
                        <group>
                            <field name="status_id" readonly="state == 'published'" options="{'no_create': True}"/>
                            <field name="customer_visible" readonly="state == 'published'"/>
                            <field name="published_date" options="{'numeric': True}" invisible="not published_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="summary" placeholder="A line or two: how is the project going?"
                           readonly="state == 'published'"/>
                    <widget name="advanced_project_update_editor" invisible="state != 'draft'"/>
                    <field name="body_html" invisible="state != 'published'" class="o_adv_update_document"/>
                    <field name="can_publish" invisible="1"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="advanced_project_update_view_search" model="ir.ui.view">
        <field name="name">advanced.project.update.search</field>
        <field name="model">advanced.project.update</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <filter string="Drafts" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Published" name="published" domain="[('state', '=', 'published')]"/>
                <separator/>
                <filter string="Shared with Customers" name="customer_visible" domain="[('customer_visible', '=', True)]"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status_id'}"/>
                    <filter string="Author" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Opened per project from its form. -->
    <record id="advanced_project_update_action" model="ir.actions.act_window">
        <field name="name">Project Updates</field>
        <field name="res_model">advanced.project.update</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Draft the first Project Update</p>
            <p>Write a summary and drag in task widgets (completed, upcoming, blocked, ...) to show where the
                project stands, then publish it to the team and customers.</p>
        </field>
    </record>
</odoo>
