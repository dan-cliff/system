<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_project_invitation" model="mail.template">
            <field name="name">Project: Invitation</field>
            <field name="model_id" ref="model_advanced_project_collaborator"/>
            <field name="subject">You have been invited to {{ object.project_id.name }}</field>
            <field name="email_from">{{ (user.email_formatted or object.project_id.company_id.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px; font-size: 13px;">
    <p style="margin: 0px; padding: 0px;">
        Hello <t t-out="object.partner_id.name or ''">Jo</t>,
        <br/><br/>
        <t t-out="user.name or ''">Alex</t> has invited you to the project
        <strong t-out="object.project_id.name or ''">Website Launch</strong>
        <t t-if="object.collaborator_type == 'customer'">as a customer</t><t t-else="">as a colleague</t>.
    </p>
    <p t-if="ctx.get('invitation_message')" style="margin: 16px 0px; padding: 0px; white-space: pre-wrap;" t-out="ctx.get('invitation_message')"/>
    <div style="margin: 16px 0px 16px 0px;">
        <a t-att-href="object._invitation_url()"
           style="background-color: #0A6CF0; padding: 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size: 13px;">
            Open the Project
        </a>
    </div>
    <p t-if="object.collaborator_type == 'customer'" style="margin: 0px; padding: 0px;">
        There you can follow the plan, read project updates and leave comments for the team.
    </p>
</div>
            </field>
        </record>
    </data>
</odoo>
