<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchasing takes the Purchase app's place on the home screen. Purchase's
         menus and actions are reloaded when it upgrades, and this module (which
         depends on it) is upgraded with it, so these come back each time. The
         uninstall hook gives Purchase its own back. -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="name">Purchasing</field>
        <field name="web_icon">advanced_purchasing,static/description/icon.png</field>
    </record>

    <!-- Orders open as a list (with the overview cards on top) or a form only. -->
    <record id="purchase.purchase_rfq" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
    </record>
    <record id="purchase.purchase_form_action" model="ir.actions.act_window">
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="view_ids" eval="[(5, 0, 0)]"/>
    </record>

    <!-- The Purchase Order PDF is Purchasing's (on the Print menu and the
         form's Print button); Odoo's is taken off the Print menu. -->
    <function model="ir.actions.report" name="write"
              eval="[[ref('purchase.action_report_purchase_order')], {'binding_model_id': False}]"/>
</odoo>
