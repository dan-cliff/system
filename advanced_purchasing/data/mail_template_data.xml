<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- "Send PO" on a confirmed order: the supplier gets this email with the
         Purchase Order PDF (report/purchasing_order_report.xml) attached. -->
    <data noupdate="1">
        <record id="email_template_purchasing_order" model="mail.template">
            <field name="name">Purchasing: Purchase Order</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">{{ object.company_id.name }} Purchase Order {{ object.name or 'n/a' }}</field>
            <field name="partner_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent to the supplier with the Purchase Order PDF attached</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear <t t-out="object.partner_id.name or ''">Brandon Freeman</t>
        <t t-if="object.partner_id.parent_id">
            (<t t-out="object.partner_id.parent_id.name or ''">Azure Interior</t>)
        </t>,
        <br/><br/>
        Please find attached our purchase order <span style="font-weight:bold;" t-out="object.name or ''">P00015</span>
        <t t-if="object.partner_ref">
            (your reference <t t-out="object.partner_ref or ''">REF_XXX</t>)
        </t>
        for <span style="font-weight:bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 10.00</span>.
        <br/><br/>
        <t t-if="object.date_planned">
            We expect delivery by <span style="font-weight:bold;" t-out="object.get_localized_date_planned().strftime('%d/%m/%Y')">05/05/2026</span>.
            <br/><br/>
            Please confirm that you have received this order:
            <br/><br/>
            <a t-att-href="object.get_acknowledge_url()" target="_blank"
               style="padding: 5px 10px; color: #FFFFFF; text-decoration: none; background-color: #5B3DB8; border: 1px solid #5B3DB8; border-radius: 3px">
                Acknowledge</a>
            <br/><br/>
        </t>
        Please quote <t t-out="object.name or ''">P00015</t> on all delivery dockets and invoices.
        <t t-if="not is_html_empty(object.user_id.signature)">
            <br/><br/>
            <div>--<br/><t t-out="object.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
        <br/><br/>
    </p>
</div></field>
            <field name="report_template_ids" eval="[(4, ref('advanced_purchasing.action_report_purchasing_order'))]"/>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
