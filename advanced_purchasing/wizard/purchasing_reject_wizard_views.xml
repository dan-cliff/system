<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchasing_reject_wizard_view_form" model="ir.ui.view">
        <field name="name">advanced.purchasing.reject.wizard.form</field>
        <field name="model">advanced.purchasing.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Send Back">
                <field name="order_ids" invisible="1"/>
                <p>The order goes back to the buyer as a draft, with your reason.</p>
                <group>
                    <field name="reason" placeholder="What needs to change before you can approve it?"/>
                </group>
                <footer>
                    <button name="action_send_back" type="object" string="Send Back" class="btn-primary" data-hotkey="q"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
