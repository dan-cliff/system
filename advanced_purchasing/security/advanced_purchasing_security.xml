    <record id="rule_purchase_order_line_edit_own" model="ir.rule">
        <field name="name">Purchase Order Lines: Create and Edit Own</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_edit_own'))]"/>
        <field name="domain_force">['|', ('order_id.create_uid', '=', user.id), ('order_id.user_id', '=', user.id)]</field>
