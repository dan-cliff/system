    <!-- Spend Levels: multi-company (shared levels have no company) -->
    <record id="rule_spend_level_company" model="ir.rule">
        <field name="name">Spend Levels: multi-company</field>
        <field name="model_id" ref="model_advanced_purchasing_spend_level"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
