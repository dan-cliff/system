<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions). Every permission is its own
         privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Purchasing user group, which
         holds the ACLs (Odoo's Purchase user group) and a deny rule per
         operation, so users can only do what a permission opens. Order lines
         follow their order. "Own" orders are the ones they created or whose
         Buyer (user_id) they are. advanced_purchasing_hr widens My Team to the
         org chart.

         Approvals are workflow privileges: Approve lets users approve or send
         back the orders routed to them (read access to those orders included),
         Approve Any every order waiting for approval. Users of Odoo's Purchase
         groups who have none of these permissions keep Purchase's own access. -->
    <data noupdate="1">
        <record id="module_category_purchasing" model="ir.module.category">
            <field name="name">Purchasing</field>
            <field name="description">Purchase orders, spend levels and approvals.</field>
            <field name="sequence">36</field>
        </record>
    </data>

    <record id="group_purchasing_user" model="res.groups">
        <field name="name">Purchasing: User</field>
        <field name="comment">Technical: given by every Purchasing permission. Opens the app; what users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('purchase.group_purchase_user'))]"/>
    </record>
    <!-- ══ Purchase Orders ══ -->
    <record id="privilege_purchase_order_create_only" model="res.groups.privilege">
        <field name="name">Purchase Orders: Create Only</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">120</field>
        <field name="description">Create purchase orders, and view their own (no editing after saving).</field>
    </record>
    <record id="group_purchase_order_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_create_only"/>
        <field name="comment">Create purchase orders, and view their own (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <record id="privilege_purchase_order_edit_own" model="res.groups.privilege">
        <field name="name">Purchase Orders: Create and Edit Own</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">130</field>
        <field name="description">Create purchase orders, and view and edit their own.</field>
    </record>
    <record id="group_purchase_order_edit_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_edit_own"/>
        <field name="comment">Create purchase orders, and view and edit their own.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <record id="privilege_purchase_order_edit_team" model="res.groups.privilege">
        <field name="name">Purchase Orders: Create and Edit My Team</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">140</field>
        <field name="description">Create purchase orders, and view and edit their own and their team&apos;s.</field>
    </record>
    <record id="group_purchase_order_edit_team" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_edit_team"/>
        <field name="comment">Create purchase orders, and view and edit their own and their team&apos;s.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <record id="privilege_purchase_order_edit_all" model="res.groups.privilege">
        <field name="name">Purchase Orders: Create and Edit All</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">150</field>
        <field name="description">Create, view and edit every purchase order.</field>
    </record>
    <record id="group_purchase_order_edit_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_edit_all"/>
        <field name="comment">Create, view and edit every purchase order.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <record id="privilege_purchase_order_view_all" model="res.groups.privilege">
        <field name="name">Purchase Orders: View All</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">160</field>
        <field name="description">View every purchase order.</field>
    </record>
    <record id="group_purchase_order_view_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_view_all"/>
        <field name="comment">View every purchase order.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <record id="privilege_purchase_order_delete_own" model="res.groups.privilege">
        <field name="name">Purchase Orders: Delete Own</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">170</field>
        <field name="description">Delete their own purchase orders.</field>
    </record>
    <record id="group_purchase_order_delete_own" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_delete_own"/>
        <field name="comment">Delete their own purchase orders.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <record id="privilege_purchase_order_delete_all" model="res.groups.privilege">
        <field name="name">Purchase Orders: Delete All</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">180</field>
        <field name="description">Delete any purchase order.</field>
    </record>
    <record id="group_purchase_order_delete_all" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_delete_all"/>
        <field name="comment">Delete any purchase order.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <!-- ══ Approvals (workflow privileges) ══ -->
    <record id="privilege_purchase_order_approve" model="res.groups.privilege">
        <field name="name">Purchase Orders: Approve</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">200</field>
        <field name="description">Approve or send back the purchase orders their Spend Levels route to them (with Personnel: as the buyer&apos;s 1st to 4th Up Manager).</field>
    </record>
    <record id="group_purchase_order_approve" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_approve"/>
        <field name="comment">Approve or send back the purchase orders their Spend Levels route to them (with Personnel: as the buyer&apos;s 1st to 4th Up Manager).</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <record id="privilege_purchase_order_approve_any" model="res.groups.privilege">
        <field name="name">Purchase Orders: Approve Any</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">210</field>
        <field name="description">Approve or send back any purchase order waiting for approval. Orders that no manager can approve go to these users.</field>
    </record>
    <record id="group_purchase_order_approve_any" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_purchase_order_approve_any"/>
        <field name="comment">Approve or send back any purchase order waiting for approval. Orders that no manager can approve go to these users.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>
    <!-- ══ Spend Delegations (workflow privilege) ══ -->
    <record id="privilege_spend_delegation_manage" model="res.groups.privilege">
        <field name="name">Spend Delegations: Manage</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">220</field>
        <field name="description">Set employees&apos; spend delegations (the Purchases Rules tab of Personnel employees). Without it the tab is read-only.</field>
    </record>
    <record id="group_spend_delegation_manage" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_spend_delegation_manage"/>
        <field name="comment">Set employees&apos; spend delegations (the Purchases Rules tab of Personnel employees). Without it the tab is read-only.</field>
        <field name="implied_ids" eval="[(4, ref('group_purchasing_user'))]"/>
    </record>

    <!-- ══ Purchasing Administrator ══ -->
    <record id="privilege_purchasing" model="res.groups.privilege">
        <field name="name">Purchasing</field>
        <field name="category_id" ref="module_category_purchasing"/>
        <field name="sequence">10</field>
        <field name="description">Configuration of the Purchasing app.</field>
    </record>
    <record id="group_purchasing_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_purchasing"/>
        <field name="comment">Every Purchasing permission, including deleting any purchase order, approving any order and setting spend delegations, plus Configuration (Spend Levels, vendor pricelists, settings, ...).</field>
        <field name="implied_ids" eval="[(4, ref('group_purchase_order_create_only')), (4, ref('group_purchase_order_edit_own')), (4, ref('group_purchase_order_edit_team')), (4, ref('group_purchase_order_edit_all')), (4, ref('group_purchase_order_view_all')), (4, ref('group_purchase_order_delete_own')), (4, ref('group_purchase_order_delete_all')), (4, ref('group_purchase_order_approve')), (4, ref('group_purchase_order_approve_any')), (4, ref('group_spend_delegation_manage')), (4, ref('purchase.group_purchase_manager'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>


    <!-- Purchase Orders: without a permission, nothing -->
    <record id="rule_purchase_order_deny" model="ir.rule">
        <field name="name">Purchase Orders: only through a permission</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchasing_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <record id="rule_purchase_order_create_only" model="ir.rule">
        <field name="name">Purchase Orders: Create Only</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_create_only'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_purchase_order_edit_own" model="ir.rule">
        <field name="name">Purchase Orders: Create and Edit Own</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_edit_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_purchase_order_edit_team" model="ir.rule">
        <field name="name">Purchase Orders: Create and Edit My Team</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_edit_team'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_purchase_order_edit_all" model="ir.rule">
        <field name="name">Purchase Orders: Create and Edit All</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_purchase_order_view_all" model="ir.rule">
        <field name="name">Purchase Orders: View All</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_view_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_purchase_order_delete_own" model="ir.rule">
        <field name="name">Purchase Orders: Delete Own</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_delete_own'))]"/>
        <field name="domain_force">['|', ('create_uid', '=', user.id), ('user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_purchase_order_delete_all" model="ir.rule">
        <field name="name">Purchase Orders: Delete All</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_purchase_order_approve" model="ir.rule">
        <field name="name">Purchase Orders: Approve (orders routed to them)</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_approve'))]"/>
        <field name="domain_force">[('purchasing_approver_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_purchase_order_approve_any" model="ir.rule">
        <field name="name">Purchase Orders: Approve Any (orders waiting for approval)</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_approve_any'))]"/>
        <field name="domain_force">[('state', '=', 'to approve')]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Purchase Order Lines: without a permission, nothing -->
    <record id="rule_purchase_order_line_deny" model="ir.rule">
        <field name="name">Purchase Order Lines: only through a permission</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchasing_user'))]"/>
        <field name="domain_force">[(0, '=', 1)]</field>
    </record>
    <record id="rule_purchase_order_line_create_only" model="ir.rule">
        <field name="name">Purchase Order Lines: Create Only</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_create_only'))]"/>
        <field name="domain_force">['|', ('order_id.create_uid', '=', user.id), ('order_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
