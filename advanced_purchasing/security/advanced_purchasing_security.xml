    <record id="rule_purchase_order_line_edit_team" model="ir.rule">
        <field name="name">Purchase Order Lines: Create and Edit My Team</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_edit_team'))]"/>
        <field name="domain_force">['|', ('order_id.create_uid', '=', user.id), ('order_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_purchase_order_line_edit_all" model="ir.rule">
        <field name="name">Purchase Order Lines: Create and Edit All</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_edit_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_purchase_order_line_view_all" model="ir.rule">
        <field name="name">Purchase Order Lines: View All</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_view_all'))]"/>
