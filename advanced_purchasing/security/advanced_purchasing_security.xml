    <record id="rule_purchase_order_line_delete_own" model="ir.rule">
        <field name="name">Purchase Order Lines: Delete Own</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_delete_own'))]"/>
        <field name="domain_force">['|', ('order_id.create_uid', '=', user.id), ('order_id.user_id', '=', user.id)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_purchase_order_line_delete_all" model="ir.rule">
        <field name="name">Purchase Order Lines: Delete All</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_delete_all'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_purchase_order_line_approve" model="ir.rule">
        <field name="name">Purchase Order Lines: Approve (orders routed to them)</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_approve'))]"/>
        <field name="domain_force">[('order_id.purchasing_approver_ids', 'in', [user.id])]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_purchase_order_line_approve_any" model="ir.rule">
        <field name="name">Purchase Order Lines: Approve Any (orders waiting for approval)</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_order_approve_any'))]"/>
        <field name="domain_force">[('order_id.state', '=', 'to approve')]</field>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
