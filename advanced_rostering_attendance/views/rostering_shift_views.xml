<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rostering_shift_view_list" model="ir.ui.view">
        <field name="name">rostering.shift.list.attendance</field>
        <field name="model">rostering.shift</field>
        <field name="inherit_id" ref="advanced_rostering.rostering_shift_view_list"/>
        <field name="arch" type="xml">
            <field name="on_leave" position="before">
                <field name="attendance_check_in" options="{'numeric': True}" optional="hide"/>
                <field name="attendance_check_out" options="{'numeric': True}" optional="hide"/>
                <field name="attended_hours" widget="float_time" optional="show"/>
                <field name="attendance_status" widget="badge" optional="show"
                       decoration-success="attendance_status == 'attended'"
                       decoration-info="attendance_status == 'in_progress'"
                       decoration-warning="attendance_status == 'late'"
                       decoration-danger="attendance_status == 'absent'"/>
            </field>
        </field>
    </record>

    <record id="rostering_shift_view_form" model="ir.ui.view">
        <field name="name">rostering.shift.form.attendance</field>
        <field name="model">rostering.shift</field>
        <field name="inherit_id" ref="advanced_rostering.rostering_shift_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="after">
                <group string="On Site" name="attendance" invisible="not employee_id">
                    <group>
                        <field name="attendance_status" widget="badge"
                               decoration-success="attendance_status == 'attended'"
                               decoration-info="attendance_status == 'in_progress'"
                               decoration-warning="attendance_status == 'late'"
                               decoration-danger="attendance_status == 'absent'"/>
                        <field name="late_minutes" invisible="not late_minutes"/>
                    </group>
                    <group>
                        <field name="attendance_check_in" options="{'numeric': True}"/>
                        <field name="attendance_check_out" options="{'numeric': True}"/>
                        <field name="attended_hours" widget="float_time"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="rostering_roster_view_form" model="ir.ui.view">
        <field name="name">rostering.roster.form.attendance</field>
        <field name="model">rostering.roster</field>
        <field name="inherit_id" ref="advanced_rostering.rostering_roster_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='shift_ids']/list/field[@name='on_leave']" position="before">
                <field name="attendance_status" widget="badge" optional="hide"
                       decoration-success="attendance_status == 'attended'"
                       decoration-info="attendance_status == 'in_progress'"
                       decoration-warning="attendance_status == 'late'"
                       decoration-danger="attendance_status == 'absent'"/>
            </xpath>
        </field>
    </record>
</odoo>
