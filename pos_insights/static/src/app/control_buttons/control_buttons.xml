<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_insights.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="showPosInsights" class="o_pos_insights_button" t-att-class="buttonClass"
                t-on-click="() => this.clickPosInsightsReports()">
                <i class="fa fa-bar-chart me-1" role="img" aria-label="Reports" title="Reports"/>
                Reports
            </button>
        </xpath>
    </t>
</templates>
