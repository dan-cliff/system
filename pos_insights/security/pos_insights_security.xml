<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A workflow permission (not CRUD): its own privilege with one
         "Allowed" group, checked in code with has_group. It implies the
         Point of Sale User group so the cashier can open the POS. -->
    <record id="res_groups_privilege_pos_insights" model="res.groups.privilege">
        <field name="name">POS Insights</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <record id="group_pos_insights" model="res.groups">
        <field name="name">Allowed</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_pos_insights"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
        <field name="comment">Print the current session's Orders, Sales Details and Session Report from the POS Actions menu.</field>
    </record>
</odoo>
