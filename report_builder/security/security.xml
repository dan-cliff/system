<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Privilege (groups both roles into one row on the user form) -->
        <record id="privilege_report_builder" model="res.groups.privilege">
            <field name="name">Report Builder</field>
            <field name="sequence">50</field>
            <field name="placeholder">No access</field>
            <field name="category_id" ref="base.module_category_technical"/>
        </record>

        <!-- Security Groups -->
        <record id="group_report_builder_user" model="res.groups">
            <field name="name">User</field>
            <field name="sequence">10</field>
            <field name="privilege_id" ref="privilege_report_builder"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_report_builder_manager" model="res.groups">
            <field name="name">Manager / Report Author</field>
            <field name="sequence">20</field>
            <field name="privilege_id" ref="privilege_report_builder"/>
            <field name="implied_ids" eval="[(4, ref('group_report_builder_user'))]"/>
        </record>
    </data>
</odoo>
