<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="seq_asset_asset" model="ir.sequence">
            <field name="name">Asset Number</field>
            <field name="code">asset.asset</field>
            <field name="prefix">AST-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_asset_defect" model="ir.sequence">
            <field name="name">Asset Defect Reference</field>
            <field name="code">asset.defect</field>
            <field name="prefix">DEF-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_asset_maintenance_log" model="ir.sequence">
            <field name="name">Asset Maintenance Log Reference</field>
            <field name="code">asset.maintenance.log</field>
            <field name="prefix">MNT-</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
