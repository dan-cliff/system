<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Module Category ───────────────────────────────────────────── -->
        <record id="module_category_asset_management" model="ir.module.category">
            <field name="name">Asset Management</field>
            <field name="description">Manage physical assets, usage, defects and maintenance.</field>
            <field name="sequence">20</field>
        </record>

        <!-- ── Privilege (Odoo 19 way to link groups to a category in Settings) ── -->
        <record id="privilege_asset_management" model="res.groups.privilege">
            <field name="name">Asset Management</field>
            <field name="category_id" ref="module_category_asset_management"/>
            <field name="sequence">10</field>
        </record>

        <!-- ── Security Groups ───────────────────────────────────────────── -->
        <record id="group_asset_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="privilege_asset_management"/>
            <field name="sequence">10</field>
            <field name="comment">Can view and create assets, log usage, defects and maintenance.</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_asset_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_asset_management"/>
            <field name="sequence">20</field>
            <field name="comment">Full asset management access including configuration of types and sub-types.</field>
            <field name="implied_ids" eval="[(4, ref('group_asset_user'))]"/>
        </record>

    </data>
</odoo>
