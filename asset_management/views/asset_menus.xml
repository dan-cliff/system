    <menuitem id="menu_asset_maintenance_type"
              name="Maintenance Types"
              parent="menu_asset_config"
              action="action_asset_maintenance_type"
              sequence="40"
              groups="asset_management.group_asset_maintenance_type_create,asset_management.group_asset_maintenance_type_update,asset_management.group_asset_maintenance_type_delete"/>

    <menuitem id="menu_asset_defect_severity"
              name="Defect Severities"
              parent="menu_asset_config"
              action="action_asset_defect_severity"
              sequence="50"
              groups="asset_management.group_asset_defect_severity_create,asset_management.group_asset_defect_severity_update,asset_management.group_asset_defect_severity_delete"/>

</odoo>
