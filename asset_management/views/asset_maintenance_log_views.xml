<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_maintenance_log_list" model="ir.ui.view">
        <field name="name">asset.maintenance.log.list</field>
        <field name="model">asset.maintenance.log</field>
        <field name="arch" type="xml">
            <list string="Maintenance Logs" default_order="date desc">
                <field name="id" string="ID"/>
                <field name="name"/>
                <field name="date" options='{"numeric": true}'/>
                <field name="asset_id"/>
                <field name="performed_by"/>
                <field name="maintenance_type_id" widget="badge"/>
                <field name="description"/>
                <field name="next_due_date" options='{"numeric": true}'/>
                <field name="cost" optional="show"/>
                <field name="source" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_asset_maintenance_log_form" model="ir.ui.view">
        <field name="name">asset.maintenance.log.form</field>
        <field name="model">asset.maintenance.log</field>
        <field name="arch" type="xml">
            <form string="Maintenance Log">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="asset_id"/>
                            <field name="date" options='{"numeric": true}'/>
                            <field name="date_due" options='{"numeric": true}'/>
                            <field name="maintenance_type_id"/>
                            <field name="source" readonly="1"/>
                        </group>
                        <group>
                            <field name="performed_by"/>
                            <field name="performed_by_name" invisible="performed_by"/>
                            <field name="supplier_id"/>
                            <field name="cost"/>
                            <field name="next_due_date" options='{"numeric": true}'/>
                            <field name="next_due_reading"/>
                        </group>
                    </group>
                    <group string="Work Performed">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Parts / Materials">
                        <field name="parts_used" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_maintenance_log_search" model="ir.ui.view">
        <field name="name">asset.maintenance.log.search</field>
        <field name="model">asset.maintenance.log</field>
        <field name="arch" type="xml">
            <search string="Maintenance Logs">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="performed_by"/>
                <field name="maintenance_type_id"/>
                <separator/>
                <filter name="overdue" string="Next Due Overdue"
                        domain="[('next_due_date','&lt;',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="from_pwa" string="From Control Plane" domain="[('source','=','control_plane')]"/>
                <group name="group_by">
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_type" string="Maintenance Type" context="{'group_by': 'maintenance_type_id'}"/>
                    <filter name="group_date" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_maintenance_log" model="ir.actions.act_window">
        <field name="name">Maintenance Logs</field>
        <field name="res_model">asset.maintenance.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_maintenance_log_search"/>
    </record>

</odoo>
