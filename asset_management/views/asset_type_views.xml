<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Asset Type: List ─────────────────────────────────────────────── -->
    <record id="view_asset_type_list" model="ir.ui.view">
        <field name="name">asset.type.list</field>
        <field name="model">asset.type</field>
        <field name="arch" type="xml">
            <list string="Asset Types">
                <field name="id" string="ID"/>
                <field name="name"/>
                <field name="usage_unit_id" optional="show"/>
                <field name="has_maintenance" optional="show"/>
                <field name="has_usage_tracking" optional="show"/>
                <field name="has_risk_assessments" optional="show"/>
                <field name="has_hazardous" optional="show"/>
                <field name="has_project" optional="show"/>
                <field name="has_location_tracking" optional="show"/>
                <field name="has_software" optional="show"/>
                <field name="subtype_count" string="Sub-Types"/>
            </list>
        </field>
    </record>

    <!-- ── Asset Type: Form ─────────────────────────────────────────────── -->
    <record id="view_asset_type_form" model="ir.ui.view">
        <field name="name">asset.type.form</field>
        <field name="model">asset.type</field>
        <field name="arch" type="xml">
            <form string="Asset Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Type Name…"/></h1>
                    </div>

                    <group>
                        <group string="Usage">
                            <field name="usage_unit_id"
                                   options="{'no_create': False, 'no_open': False}"
                                   help="Setting a usage unit here will automatically apply it to all sub-types and assets of this type."/>
                        </group>
                    </group>

                    <group string="Management Features">
                        <group>
                            <field name="has_maintenance"/>
                            <field name="has_usage_tracking"/>
                            <field name="has_risk_assessments"/>
                        </group>
                        <group>
                            <field name="has_hazardous"/>
                            <field name="has_project"/>
                            <field name="has_location_tracking"/>
                            <field name="has_software"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Sub-Types" name="subtypes">
                            <field name="subtype_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="usage_unit_id"/>
                                    <field name="has_maintenance"/>
                                    <field name="has_usage_tracking"/>
                                    <field name="has_risk_assessments"/>
                                    <field name="has_hazardous"/>
                                    <field name="has_project"/>
                                    <field name="has_location_tracking"/>
                                    <field name="has_software"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Asset Type: Search ───────────────────────────────────────────── -->
    <record id="view_asset_type_search" model="ir.ui.view">
        <field name="name">asset.type.search</field>
        <field name="model">asset.type</field>
        <field name="arch" type="xml">
            <search string="Asset Types">
                <field name="name"/>
                <filter name="has_usage" string="Usage Tracking" domain="[('has_usage_tracking','=',True)]"/>
                <filter name="has_maintenance" string="Maintenance" domain="[('has_maintenance','=',True)]"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- ── Asset Type: Action ───────────────────────────────────────────── -->
    <record id="action_asset_type" model="ir.actions.act_window">
        <field name="name">Asset Types</field>
        <field name="res_model">asset.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_type_search"/>
    </record>

</odoo>
