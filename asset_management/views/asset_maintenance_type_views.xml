<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Asset Maintenance Type: List ──────────────────────────────────── -->
    <record id="view_asset_maintenance_type_list" model="ir.ui.view">
        <field name="name">asset.maintenance.type.list</field>
        <field name="model">asset.maintenance.type</field>
        <field name="arch" type="xml">
            <list string="Maintenance Types" editable="bottom">
                <field name="id" string="ID"/>
                <field name="name"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- ── Asset Maintenance Type: Form ──────────────────────────────────── -->
    <record id="view_asset_maintenance_type_form" model="ir.ui.view">
        <field name="name">asset.maintenance.type.form</field>
        <field name="model">asset.maintenance.type</field>
        <field name="arch" type="xml">
            <form string="Maintenance Type">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Type Name…"/></h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Asset Maintenance Type: Search ────────────────────────────────── -->
    <record id="view_asset_maintenance_type_search" model="ir.ui.view">
        <field name="name">asset.maintenance.type.search</field>
        <field name="model">asset.maintenance.type</field>
        <field name="arch" type="xml">
            <search string="Maintenance Types">
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active','=',False)]"/>
            </search>
        </field>
    </record>

    <!-- ── Asset Maintenance Type: Action ────────────────────────────────── -->
    <record id="action_asset_maintenance_type" model="ir.actions.act_window">
        <field name="name">Maintenance Types</field>
        <field name="res_model">asset.maintenance.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_maintenance_type_search"/>
    </record>

</odoo>
