<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_usage_unit_list" model="ir.ui.view">
        <field name="name">asset.usage.unit.list</field>
        <field name="model">asset.usage.unit</field>
        <field name="arch" type="xml">
            <list string="Usage Units">
                <field name="id" string="ID"/>
                <field name="name"/>
                <field name="short_code"/>
            </list>
        </field>
    </record>

    <record id="view_asset_usage_unit_form" model="ir.ui.view">
        <field name="name">asset.usage.unit.form</field>
        <field name="model">asset.usage.unit</field>
        <field name="arch" type="xml">
            <form string="Usage Unit">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Hours, Kilometres, Cycles…"/></h1>
                    </div>
                    <group>
                        <field name="short_code" placeholder="e.g. hr, km, cyc"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_usage_unit" model="ir.actions.act_window">
        <field name="name">Usage Units</field>
        <field name="res_model">asset.usage.unit</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
