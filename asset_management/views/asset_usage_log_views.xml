<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_asset_usage_log_list" model="ir.ui.view">
        <field name="name">asset.usage.log.list</field>
        <field name="model">asset.usage.log</field>
        <field name="arch" type="xml">
            <list string="Usage Logs" default_order="date desc">
                <field name="id" string="ID"/>
                <field name="date" options='{"numeric": true}'/>
                <field name="asset_id"/>
                <field name="asset_number" optional="show"/>
                <field name="asset_type_id" optional="show"/>
                <field name="user_id"/>
                <field name="reading"/>
                <field name="unit" readonly="1"/>
                <field name="notes" optional="show"/>
                <field name="source" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_asset_usage_log_form" model="ir.ui.view">
        <field name="name">asset.usage.log.form</field>
        <field name="model">asset.usage.log</field>
        <field name="arch" type="xml">
            <form string="Usage Log Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="asset_id" domain="[('eff_usage_tracking', '=', True)]"/>
                            <field name="date" options='{"numeric": true}'/>
                            <field name="user_id"/>
                            <field name="source" readonly="1"/>
                        </group>
                        <group>
                            <field name="reading"/>
                            <field name="unit" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Optional notes…"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_asset_usage_log_search" model="ir.ui.view">
        <field name="name">asset.usage.log.search</field>
        <field name="model">asset.usage.log</field>
        <field name="arch" type="xml">
            <search string="Usage Logs">
                <field name="asset_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="from_pwa" string="From Control Plane" domain="[('source','=','control_plane')]"/>
                <group name="group_by">
                    <filter name="group_asset" string="Asset" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_type" string="Asset Type" context="{'group_by': 'asset_type_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_asset_usage_log" model="ir.actions.act_window">
        <field name="name">Usage Logs</field>
        <field name="res_model">asset.usage.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_asset_usage_log_search"/>
    </record>

</odoo>
