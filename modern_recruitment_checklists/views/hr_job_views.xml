<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_job_view_form_talent_checklists" model="ir.ui.view">
        <field name="name">hr.job.form.talent.checklists</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_talent_questionnaires" type="object" class="oe_stat_button"
                        icon="fa-check-square-o" invisible="not talent_checklist_count"
                        groups="modern_recruitment_checklists.group_talent_questionnaire">
                    <field name="talent_checklist_count" widget="statinfo" string="Questionnaires"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
