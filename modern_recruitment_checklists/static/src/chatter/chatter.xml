<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.Chatter" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-mail-Chatter-logNote')]" position="after">
            <button t-if="talentState.canSendQuestionnaire and state.thread.id"
                    class="o-mail-Chatter-talentQuestionnaire btn btn-secondary text-nowrap me-1"
                    t-att-class="{ 'my-2': !props.compactHeight }"
                    title="Send a screening questionnaire to the applicant"
                    t-on-click="onClickTalentQuestionnaire">
                <i class="fa fa-check-square-o me-1" role="img" aria-hidden="true"/>Send Questionnaire
            </button>
        </xpath>
    </t>
</templates>
