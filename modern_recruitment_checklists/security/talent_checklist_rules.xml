<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Questionnaires: the checklists sent to applicants. Rules of different
         groups are OR-ed, so this only opens those (on top of any Checklists
         permissions the user has), and never deleting them. -->
    <record id="rule_checklist_talent_questionnaire" model="ir.rule">
        <field name="name">Checklists: Talent questionnaires</field>
        <field name="model_id" ref="checklists.model_checklist_checklist"/>
        <field name="groups" eval="[(4, ref('group_talent_questionnaire'))]"/>
        <field name="domain_force">[('talent_applicant_id', '!=', False)]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_checklist_line_talent_questionnaire" model="ir.rule">
        <field name="name">Checklist Checks: Talent questionnaires</field>
        <field name="model_id" ref="checklists.model_checklist_line"/>
        <field name="groups" eval="[(4, ref('group_talent_questionnaire'))]"/>
        <field name="domain_force">[('checklist_id.talent_applicant_id', '!=', False)]</field>
    </record>
</odoo>
