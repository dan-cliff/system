<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hide product_import's unlabelled Image URL field next to the product name. -->
    <record id="product_template_form_hide_image_url" model="ir.ui.view">
        <field name="name">product.template.form.hide.image.url</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product_import.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="image_url" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="product_product_form_hide_image_url" model="ir.ui.view">
        <field name="name">product.product.form.hide.image.url</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product_import.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="image_url" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>
</odoo>
