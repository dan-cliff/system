<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_mrp_on_site" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.advanced_manufacturing_attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="advanced_manufacturing.res_config_settings_view_form_manufacturing"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='mrp_terminal_idle']" position="after">
                <setting id="mrp_terminal_require_on_site" string="Only Workers On Site" company_dependent="1"
                         help="Workers must be signed in at work (On Site) to sign in to a Work Centre app.">
                    <field name="mrp_terminal_require_on_site"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
