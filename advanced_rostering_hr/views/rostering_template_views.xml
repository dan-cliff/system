<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rostering_template_view_form" model="ir.ui.view">
        <field name="name">rostering.template.form.hr</field>
        <field name="model">rostering.template</field>
        <field name="inherit_id" ref="advanced_rostering.rostering_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='line_ids']/list/field[@name='user_id']" position="replace">
                <field name="employee_id" widget="many2one_avatar_employee" options="{'no_create': True}"/>
                <field name="company_id" column_invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
