<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Settings > Organisation, right after Users & Companies (sequence 1, ordered by id). -->
    <menuitem id="menu_org_structure_settings"
              name="Organisation"
              parent="base.menu_administration"
              groups="group_org_admin"
              sequence="1"/>

    <menuitem id="menu_org_division"
              name="Divisions"
              parent="menu_org_structure_settings"
              action="action_org_division"
              sequence="10"/>

    <menuitem id="menu_org_business_unit"
              name="Business Units"
              parent="menu_org_structure_settings"
              action="action_org_business_unit"
              sequence="20"/>

    <menuitem id="menu_org_location"
              name="Locations"
              parent="menu_org_structure_settings"
              action="action_org_location"
              sequence="30"/>

    <menuitem id="menu_org_department"
              name="Departments"
              parent="menu_org_structure_settings"
              action="action_org_department"
              sequence="40"/>

    <!-- The standalone Organisation app menus from 19.0.1.0.0. -->
    <delete model="ir.ui.menu" id="menu_org_structure"/>
    <delete model="ir.ui.menu" id="menu_org_structure_root"/>
</odoo>
