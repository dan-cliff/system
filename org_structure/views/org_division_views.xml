<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="org_division_view_list" model="ir.ui.view">
        <field name="name">org.division.list</field>
        <field name="model">org.division</field>
        <field name="arch" type="xml">
            <list string="Divisions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="show"/>

                <field name="manager_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="org_division_view_form" model="ir.ui.view">
        <field name="name">org.division.form</field>
        <field name="model">org.division</field>
        <field name="arch" type="xml">
            <form string="Division">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_org_business_unit)d" type="action" class="oe_stat_button" icon="fa-sitemap"
                                context="{'search_default_division_id': id, 'default_division_id': id}">
                            <field name="business_unit_count" widget="statinfo" string="Business Units"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. North"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="code"/>
                            <field name="manager_id" options="{'no_create': True}"/>
                            <field name="sequence"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="business_unit_ids" string="Business Units">
                            <field name="business_unit_ids" context="{'default_division_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="manager_id"/>
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="org_division_view_search" model="ir.ui.view">
        <field name="name">org.division.search</field>
        <field name="model">org.division</field>
        <field name="arch" type="xml">
            <search string="Divisions">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>

                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>

                    <filter name="groupby_company_id" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
