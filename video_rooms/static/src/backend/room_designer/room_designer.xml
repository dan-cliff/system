<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="video_rooms.RoomDesigner">
        <div class="o_action o_vr_designer_action h-100 overflow-auto">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between px-3 pt-3">
                <div>
                    <h2 class="m-0">Room Designer</h2>
                    <a href="#" class="text-muted" t-on-click.prevent="openRoom" t-esc="state.name"/>
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <span t-if="state.dirty" class="text-warning">Not published yet</span>
                    <button class="btn btn-primary" t-on-click="publish" t-att-disabled="state.saving or !state.dirty">Publish</button>
                </div>
            </div>
            <div t-if="state.error" class="alert alert-warning m-3" t-esc="state.error"/>
            <div t-ref="editor" class="px-3 pb-4"/>
        </div>
    </t>
</templates>
