<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (CLAUDE.md > Permissions). Generated from one table so every
         permission follows the same pattern: each is its own privilege with one
         "Allowed" group whose record rules give it its meaning. Every "Allowed" group
         implies the technical Video Rooms User group, which holds the ACLs and a deny
         rule per operation, so users can only do what a permission opens. Screens
         follow their room. Commands are only written by code (sudo) after a check. -->
    <data noupdate="1">
        <record id="module_category_video_rooms" model="ir.module.category">
            <field name="name">Video Rooms</field>
            <field name="description">Meeting rooms that join Teams, Zoom, Google Meet, Webex, Odoo Discuss and Jitsi calls, with room booking, door screens and Room Boards.</field>
            <field name="sequence">58</field>
        </record>
    </data>

    <record id="group_video_rooms_user" model="res.groups">
        <field name="name">Video Rooms: User</field>
        <field name="comment">Technical: given by every Video Rooms permission. Opens the app; what users can do comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_video_rooms_tablet" model="res.groups">
        <field name="name">Video Rooms: Tablet</field>
        <field name="comment">Technical: the portal users that Console, Presence and Room Board tablets sign in as. They reach only their own room or board, through the tablet pages.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_portal'))]"/>
    </record>

