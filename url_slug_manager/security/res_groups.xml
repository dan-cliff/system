<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Per-model access levels are in access_levels.xml (generated from access_levels.py).

         Odoo's Settings administrators (group_system) get full URL Slug access, so anyone
         with Settings > Technical access can use the slug manager without a separate
         assignment. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[
            (4, ref('group_url_slug_config_create')),
            (4, ref('group_url_slug_config_update')),
            (4, ref('group_url_slug_config_delete')),
        ]"/>
    </record>
</odoo>
