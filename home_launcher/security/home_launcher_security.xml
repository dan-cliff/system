<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- home.toolbox record rules                                    -->
        <!-- ============================================================ -->

        <!-- Internal users: read the global default and their own override -->
        <record id="home_toolbox_rule_user_read" model="ir.rule">
            <field name="name">Home Toolbox: read global + own</field>
            <field name="model_id" ref="model_home_toolbox"/>
            <field name="domain_force">['|', ('user_id', '=', False), ('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Internal users: only manage their own override rows -->
        <record id="home_toolbox_rule_user_write" model="ir.rule">
            <field name="name">Home Toolbox: manage own override</field>
            <field name="model_id" ref="model_home_toolbox"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Managers: full access (incl. global default rows) -->
        <record id="home_toolbox_rule_manager" model="ir.rule">
            <field name="name">Home Toolbox: manager full access</field>
            <field name="model_id" ref="model_home_toolbox"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- ============================================================ -->
        <!-- home.toolbox.app record rules (mirror the parent toolbox)     -->
        <!-- ============================================================ -->

        <record id="home_toolbox_app_rule_user_read" model="ir.rule">
            <field name="name">Home Toolbox App: read global + own</field>
            <field name="model_id" ref="model_home_toolbox_app"/>
            <field name="domain_force">['|', ('toolbox_id.user_id', '=', False), ('toolbox_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="home_toolbox_app_rule_user_write" model="ir.rule">
            <field name="name">Home Toolbox App: manage own override</field>
            <field name="model_id" ref="model_home_toolbox_app"/>
            <field name="domain_force">[('toolbox_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="home_toolbox_app_rule_manager" model="ir.rule">
            <field name="name">Home Toolbox App: manager full access</field>
            <field name="model_id" ref="model_home_toolbox_app"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
