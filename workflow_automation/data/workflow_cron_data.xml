<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Scheduled action: run all 'scheduled' trigger workflows          -->
    <!-- Active = False by default — enable manually when needed.        -->
    <!-- ================================================================ -->
    <record id="ir_cron_wf_scheduled_workflows" model="ir.cron">
        <field name="name">Workflow Engine: Run Scheduled Workflows</field>
        <field name="model_id" ref="model_wf_automation"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_scheduled_workflows()</field>
        <field name="active" eval="False"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
    </record>

</odoo>
