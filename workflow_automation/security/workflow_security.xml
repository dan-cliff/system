<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Workflow Engine Security Groups                                   -->
    <!-- ================================================================ -->

    <record id="privilege_workflow_automation" model="res.groups.privilege">
        <field name="name">Workflow Automation</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>

    <record id="group_workflow_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_workflow_automation"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Read-only access to workflows and execution logs.</field>
    </record>

    <record id="group_workflow_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_workflow_automation"/>
        <field name="implied_ids" eval="[Command.link(ref('workflow_automation.group_workflow_user'))]"/>
        <field name="comment">Full create/edit/delete access to workflows, steps, and logs.</field>
    </record>

</odoo>
