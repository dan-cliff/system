<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================ -->
    <!-- Workflow Engine Security Groups                                   -->
    <!-- ================================================================ -->

    <record id="group_workflow_user" model="res.groups">
        <field name="name">Workflow: User</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Read-only access to workflows and execution logs.</field>
    </record>

    <record id="group_workflow_manager" model="res.groups">
        <field name="name">Workflow: Manager</field>
        <field name="implied_ids" eval="[Command.link(ref('workflow_automation.group_workflow_user'))]"/>
        <field name="comment">Full create/edit/delete access to workflows, steps, and logs.</field>
    </record>

</odoo>
