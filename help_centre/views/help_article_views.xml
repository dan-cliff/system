<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List ─────────────────────────────────────────────────────────────── -->

    <record id="view_help_article_list" model="ir.ui.view">
        <field name="name">help.article.list</field>
        <field name="model">help.article</field>
        <field name="arch" type="xml">
            <list string="Help Articles" multi_edit="1"
                  decoration-muted="state == 'draft'"
                  decoration-success="state == 'published'">
                <header>
                    <button name="action_run_generate_articles"
                            type="object"
                            string="Generate Missing Articles"
                            display="always"
                            icon="fa-magic"
                            groups="help_centre.group_help_centre_manager"/>
                </header>
                <field name="id" string="ID"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="audience" widget="badge"
                       decoration-info="audience == 'internal'"
                       decoration-success="audience == 'external'"
                       decoration-warning="audience == 'both'"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'published'"/>
                <field name="is_featured" string="Featured"/>
                <field name="read_time_minutes" string="Read (min)"/>
                <field name="view_count" string="Views"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="publish_date" string="Scheduled Publish"
                       options='{"numeric": true}' optional="show"/>
                <field name="write_date" string="Updated" options='{"numeric": true}'/>
            </list>
        </field>
    </record>

    <!-- ── Form ─────────────────────────────────────────────────────────────── -->

    <record id="view_help_article_form" model="ir.ui.view">
        <field name="name">help.article.form</field>
        <field name="model">help.article</field>
        <field name="arch" type="xml">
            <form string="Help Article">

                <header>
                    <button name="action_publish" string="Publish"
                            type="object" class="btn-success"
                            invisible="state == 'published'"
                            groups="help_centre.group_help_centre_editor"/>
                    <button name="action_open_schedule_publish_wizard" string="Schedule Publish"
                            type="object"
                            invisible="state == 'published'"
                            groups="help_centre.group_help_centre_editor"/>
                    <button name="action_unpublish" string="Unpublish"
                            type="object"
                            invisible="state == 'draft'"
                            groups="help_centre.group_help_centre_editor"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published"/>
                </header>

                <sheet>
                    <!-- Smart buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_open_website"
                                class="oe_stat_button" icon="fa-globe"
                                invisible="not is_public">
                            <div class="o_stat_info">
                                <span class="o_stat_text">View on Website</span>
                            </div>
                        </button>
                        <button type="object" name="action_open_website"
                                class="oe_stat_button" icon="fa-eye"
                                invisible="is_public">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="view_count" nolabel="1"/></span>
                                <span class="o_stat_text">Views</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-eye" type="object" name="action_open_website"
                                invisible="not is_public">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="view_count" nolabel="1"/></span>
                                <span class="o_stat_text">Views</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" icon="fa-thumbs-up" type="object" name="action_open_website"
                                invisible="not is_public">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="helpful_count" nolabel="1"/></span>
                                <span class="o_stat_text">Helpful</span>
                            </div>
                        </button>
                    </div>

                    <!-- Scheduled publish banner -->
                    <div class="alert alert-info d-flex align-items-center gap-2 mb-3"
                         role="status" invisible="not publish_date or state == 'published'">
                        <i class="fa fa-clock-o"/>
                        <span>
                            Scheduled to publish automatically on
                            <strong><field name="publish_date" nolabel="1" readonly="1"
                                           options='{"numeric": true}'/></strong>.
                            <a href="#" class="ms-2" name="action_open_schedule_publish_wizard"
                               type="object">Change</a>
                        </span>
                    </div>

                    <!-- Audience banner -->
                    <div class="alert alert-secondary d-flex align-items-center gap-2 mb-3"
                         role="status" invisible="audience != 'internal'">
                        <i class="fa fa-lock text-muted" title="Internal Only"/>
                        <span><strong>Internal Only</strong> — accessible only to authenticated Odoo users.</span>
                    </div>
                    <div class="alert alert-success d-flex align-items-center gap-2 mb-3"
                         role="status" invisible="audience != 'external'">
                        <i class="fa fa-globe text-success" title="External / Public"/>
                        <span><strong>External / Public</strong> — visible on the public website without login.</span>
                    </div>
                    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3"
                         role="status" invisible="audience != 'both'">
                        <i class="fa fa-users text-warning" title="Both audiences"/>
                        <span><strong>Both</strong> — visible to internal users and publicly on the website.</span>
                    </div>

                    <!-- Title -->
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Article title…"/></h1>
                    </div>

                    <group>
                        <group string="Classification">
                            <field name="audience" widget="radio" options='{"horizontal": true}'/>
                            <field name="category_id"/>
                            <field name="tag_ids" widget="many2many_tags"
                                   options='{"color_field": "color"}'/>
                            <field name="module_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Settings">
                            <field name="slug" placeholder="auto-generated-from-title"/>
                            <field name="sequence"/>
                            <field name="is_featured"/>
                            <field name="author_id" widget="many2one_avatar_user"/>
                            <field name="read_time_minutes"/>
                            <field name="publish_date" options='{"numeric": true}'
                                   invisible="state == 'published'"/>
                        </group>
                    </group>

                    <!-- Summary -->
                    <div class="mb-3">
                        <label for="summary"/>
                        <field name="summary"
                               placeholder="Brief description shown in the KC Bot search results and article listings…"/>
                    </div>

                    <!-- AI Generate button -->
                    <div class="d-flex align-items-center gap-3 mb-3"
                         groups="help_centre.group_help_centre_editor">
                        <button name="action_open_generate_wizard" type="object"
                                string="✨  Generate with AI"
                                class="btn btn-outline-primary btn-sm"/>
                        <span class="text-muted small" invisible="not ai_generated">
                            <i class="fa fa-robot" title="AI generated"/> Content was AI-generated
                            — prompt: <field name="ai_prompt" nolabel="1" class="d-inline" readonly="1"/>
                        </span>
                    </div>

                    <!-- HTML Content editor -->
                    <div class="o_field_html" style="min-height: 400px;">
                        <field name="content" nolabel="1"/>
                    </div>

                </sheet>

                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Search ────────────────────────────────────────────────────────────── -->

    <record id="view_help_article_search" model="ir.ui.view">
        <field name="name">help.article.search</field>
        <field name="model">help.article</field>
        <field name="arch" type="xml">
            <search string="Search Articles">
                <field name="name" string="Title"/>
                <field name="summary"/>
                <field name="category_id"/>
                <field name="tag_ids"/>
                <field name="author_id"/>
                <separator/>
                <filter name="published" string="Published" domain="[('state','=','published')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <separator/>
                <filter name="internal" string="Internal" domain="[('audience','=','internal')]"/>
                <filter name="external" string="External" domain="[('audience','=','external')]"/>
                <filter name="both" string="Both" domain="[('audience','=','both')]"/>
                <separator/>
                <filter name="featured" string="Featured" domain="[('is_featured','=',True)]"/>
                <filter name="ai_generated" string="AI Generated" domain="[('ai_generated','=',True)]"/>
                <filter name="scheduled" string="Scheduled Publish"
                        domain="[('publish_date','!=',False),('state','=','draft')]"/>
                <group name="group_by">
                    <filter name="by_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="by_audience" string="Audience" context="{'group_by': 'audience'}"/>
                    <filter name="by_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="by_author" string="Author" context="{'group_by': 'author_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────────────── -->

    <record id="action_help_article" model="ir.actions.act_window">
        <field name="name">Articles</field>
        <field name="res_model">help.article</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_published': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Help Centre article
            </p>
            <p>
                Articles can be written manually in the HTML editor or generated using AI.
                Set the audience to control whether an article is internal-only or public.
            </p>
        </field>
    </record>

    <!-- ── Server action: Bulk Update (list Action menu) ──────────────────── -->

    <record id="action_help_article_bulk_update" model="ir.actions.server">
        <field name="name">Bulk Update</field>
        <field name="model_id" ref="model_help_article"/>
        <field name="binding_model_id" ref="model_help_article"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
action = {
    'type': 'ir.actions.act_window',
    'name': 'Bulk Update Articles',
    'res_model': 'help.bulk.update.wizard',
    'view_mode': 'form',
    'target': 'new',
    'context': {'default_article_ids': [(6, 0, env.context.get('active_ids', []))]},
}
        </field>
    </record>

    <!-- ── Server actions: bulk Publish / Unpublish (list Action menu) ──────── -->

    <record id="action_help_article_publish" model="ir.actions.server">
        <field name="name">Publish</field>
        <field name="model_id" ref="model_help_article"/>
        <field name="binding_model_id" ref="model_help_article"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_publish()</field>
    </record>

    <record id="action_help_article_unpublish" model="ir.actions.server">
        <field name="name">Unpublish</field>
        <field name="model_id" ref="model_help_article"/>
        <field name="binding_model_id" ref="model_help_article"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">records.action_unpublish()</field>
    </record>

</odoo>
