<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Module category (keeps groups out of the main category filter) -->
        <record id="module_category_help_centre" model="ir.module.category">
            <field name="name">Help Centre</field>
            <field name="description">Manage Help Centre articles, categories, and AI chatbot.</field>
            <field name="sequence">100</field>
            <field name="visible" eval="False"/>
        </record>

        <!-- Privilege — renders as a single dropdown row on the user Access Rights tab -->
        <record id="privilege_help_centre" model="res.groups.privilege">
            <field name="name">Help Centre</field>
            <field name="category_id" ref="module_category_help_centre"/>
            <field name="sequence">10</field>
            <field name="placeholder">No access</field>
        </record>

        <!-- Groups -->
        <record id="group_help_centre_editor" model="res.groups">
            <field name="name">Editor</field>
            <field name="privilege_id" ref="privilege_help_centre"/>
            <field name="sequence">10</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_help_centre_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="privilege_id" ref="privilege_help_centre"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_help_centre_editor'))]"/>
        </record>

    </data>
</odoo>
