<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Configuration option lists (CLAUDE.md > Choice fields): users add, rename and archive options. -->

    <record id="dev_ticket_type_view_list" model="ir.ui.view">
        <field name="name">dev.ticket.type.list</field>
        <field name="model">dev.ticket.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="branch_prefix"/>
                <field name="active" widget="boolean_toggle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dev_ticket_type_view_form" model="ir.ui.view">
        <field name="name">dev.ticket.type.form</field>
        <field name="model">dev.ticket.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="icon"/>
                        <field name="branch_prefix"/>
                        <field name="color" widget="color_picker"/>
                        <field name="description"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="dev_ticket_type_action" model="ir.actions.act_window">
        <field name="name">Ticket Types</field>
        <field name="res_model">dev.ticket.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add ticket types</p>
            <p>Kinds of ticket: Story, Task, Bug, ...</p>
        </field>
    </record>

