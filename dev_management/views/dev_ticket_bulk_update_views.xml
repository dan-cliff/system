<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="dev_ticket_bulk_update_view_form" model="ir.ui.view">
        <field name="name">dev.ticket.bulk.update.form</field>
        <field name="model">dev.ticket.bulk.update</field>
        <field name="arch" type="xml">
            <form>
                <div class="text-muted mb-3">
                    Tick each field to change on the <field name="ticket_count" class="fw-bold"/> selected tickets.
                    A ticked field left empty is cleared.
                </div>
                <field name="ticket_ids" invisible="1"/>
                <group name="fields">
                    <group name="planning" string="Planning">
                        <label for="epic_id"/>
                        <div class="d-flex gap-2 align-items-center">
                            <field name="update_epic" nolabel="1" class="w-auto"/>
                            <field name="epic_id" readonly="not update_epic" placeholder="No epic" options="{'no_create': True}"/>
                        </div>
                        <label for="release_id"/>
                        <div class="d-flex gap-2 align-items-center">
                            <field name="update_release" nolabel="1" class="w-auto"/>
                            <field name="release_id" readonly="not update_release" placeholder="No release" options="{'no_create': True}"/>
                        </div>
                        <field name="sprint_mode"/>
                        <field name="sprint_from_ids" widget="many2many_tags" invisible="sprint_mode != 'replace'"
                               placeholder="Their planned and active sprints" options="{'no_create': True}"/>
                        <field name="sprint_ids" widget="many2many_tags" invisible="sprint_mode == 'none'"
                               string="With" placeholder="No sprint (back to the backlog)"
                               domain="[('state', '!=', 'closed')]" options="{'no_create': True}"/>
                        <label for="date_deadline"/>
                        <div class="d-flex gap-2 align-items-center">
                            <field name="update_date_deadline" nolabel="1" class="w-auto"/>
                            <field name="date_deadline" readonly="not update_date_deadline" options="{'numeric': True}"/>
                        </div>
                    </group>
                    <group name="details" string="Details">
                        <label for="user_id"/>
                        <div class="d-flex gap-2 align-items-center">
                            <field name="update_user" nolabel="1" class="w-auto"/>
                            <field name="user_id" readonly="not update_user" placeholder="Unassigned"
                                   widget="many2one_avatar_user" options="{'no_create': True}"/>
                        </div>
                        <label for="type_id"/>
                        <div class="d-flex gap-2 align-items-center">
                            <field name="update_type" nolabel="1" class="w-auto"/>
                            <field name="type_id" readonly="not update_type" options="{'no_create': True}"/>
                        </div>
                        <label for="story_points"/>
                        <div class="d-flex gap-2 align-items-center">
                            <field name="update_story_points" nolabel="1" class="w-auto"/>
                            <field name="story_points" readonly="not update_story_points"/>
                        </div>
                        <field name="tag_mode"/>
                        <field name="tag_ids" widget="many2many_tags" invisible="tag_mode == 'none'"
                               options="{'color_field': 'color'}"/>
                        <label for="company_id" groups="base.group_multi_company"/>
                        <div class="d-flex gap-2 align-items-center" groups="base.group_multi_company">
                            <field name="update_company" nolabel="1" class="w-auto"/>
                            <field name="company_id" readonly="not update_company" required="update_company"
                                   options="{'no_create': True}"/>
                        </div>
                    </group>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Update Tickets" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="dev_ticket_bulk_update_action" model="ir.actions.act_window">
        <field name="name">Bulk Update</field>
        <field name="res_model">dev.ticket.bulk.update</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_dev_ticket"/>
        <!-- The list has its own Bulk Update button. -->
        <field name="binding_view_types">kanban</field>
    </record>
</odoo>
