<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Spaces -->
    <record id="dev_space_view_list" model="ir.ui.view">
        <field name="name">dev.space.list</field>
        <field name="model">dev.space</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="key" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="repository_id" optional="hide"/>
                <field name="page_count"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="dev_space_view_kanban" model="ir.ui.view">
        <field name="name">dev.space.kanban</field>
        <field name="model">dev.space</field>
        <field name="arch" type="xml">
            <kanban action="action_open_home" type="object" sample="1">
                <field name="color"/>
                <templates>
                    <t t-name="menu">
                        <a t-if="widget.editable" role="menuitem" type="open" class="dropdown-item">Settings</a>
                        <a role="menuitem" type="object" name="action_open_pages" class="dropdown-item">All Pages</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge text-bg-secondary" t-if="record.key.raw_value"><field name="key"/></span>
                            <field name="name" class="fw-bold fs-5"/>
                        </div>
                        <field name="description" class="small text-muted"/>
                        <footer>
                            <a name="action_open_pages" type="object" class="small">
                                <field name="page_count"/> pages
                            </a>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="dev_space_view_form" model="ir.ui.view">
        <field name="name">dev.space.form</field>
        <field name="model">dev.space</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_pages" type="object" class="oe_stat_button" icon="fa-book">
                            <field name="page_count" widget="statinfo" string="Pages"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Engineering Handbook"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="key" placeholder="e.g. ENG"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="repository_id" options="{'no_create': True}"/>
                            <field name="home_page_id" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="What is documented in this space?"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dev_space_view_search" model="ir.ui.view">
        <field name="name">dev.space.search</field>
        <field name="model">dev.space</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('key', 'ilike', self)]"/>
                <field name="user_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dev_space_action" model="ir.actions.act_window">
        <field name="name">Spaces</field>
        <field name="res_model">dev.space</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first documentation space</p>
            <p>A space holds a tree of pages: product requirements, technical designs, meeting notes, how-tos and
                release notes, all linked to your features, tickets and releases.</p>
        </field>
    </record>

    <!-- Pages -->
    <record id="dev_page_view_list" model="ir.ui.view">
        <field name="name">dev.page.list</field>
        <field name="model">dev.page</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="breadcrumb" optional="show"/>
                <field name="space_id" optional="hide"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                <field name="release_id" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="last_editor_id" widget="many2one_avatar_user" optional="hide"/>
                <field name="date_edited" options="{'numeric': True}"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="dev_page_view_hierarchy" model="ir.ui.view">
        <field name="name">dev.page.hierarchy</field>
        <field name="model">dev.page</field>
        <field name="arch" type="xml">
            <hierarchy child_field="child_ids" draggable="1" icon="fa-file-text-o">
                <field name="name"/>
                <field name="child_count"/>
                <templates>
                    <t t-name="hierarchy-box">
                        <div class="o_hierarchy_node_header d-flex justify-content-center align-items-center">
                            <field name="name"/>
                        </div>
                        <div class="o_hierarchy_node_body d-flex flex-column small text-muted p-1">
                            <field name="last_editor_id" widget="many2one_avatar_user"/>
                            <field name="date_edited" options="{'numeric': True}"/>
                        </div>
                    </t>
                </templates>
            </hierarchy>
        </field>
    </record>

    <record id="dev_page_view_form" model="ir.ui.view">
        <field name="name">dev.page.form</field>
        <field name="model">dev.page</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_add_child" type="object" string="Add Child Page" icon="fa-plus"
                            invisible="not id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_children" type="object" class="oe_stat_button" icon="fa-files-o"
                                invisible="not child_count">
                            <field name="child_count" widget="statinfo" string="Child Pages"/>
                        </button>
                        <button name="action_open_versions" type="object" class="oe_stat_button" icon="fa-history"
                                invisible="not version_count">
                            <field name="version_count" widget="statinfo" string="History"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="text-muted small"><field name="breadcrumb"/></div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Page title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="space_id" options="{'no_create': True}"/>
                            <field name="parent_id" options="{'no_create': True}"/>
                            <field name="template_id" options="{'no_create': True}"
                                   invisible="id and body" placeholder="Start from a template"/>
                            <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="release_id" options="{'no_create': True}"/>
                            <field name="feature_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="ticket_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="last_editor_id" widget="many2one_avatar_user" invisible="not last_editor_id"/>
                            <field name="date_edited" options="{'numeric': True}" invisible="not date_edited"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="body" options="{'collaborative': true, 'resizable': false}" class="o_dev_page_body"
                           placeholder="Write here, or pick a template. Type / for headings, tables, checklists, images and more."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="dev_page_view_search" model="ir.ui.view">
        <field name="name">dev.page.search</field>
        <field name="model">dev.page</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="body" string="Content"/>
                <field name="space_id"/>
                <field name="tag_ids"/>
                <field name="release_id"/>
                <field name="feature_ids"/>
                <field name="ticket_ids"/>
                <filter name="top_level" string="Top-level Pages" domain="[('parent_id', '=', False)]"/>
                <filter name="mine" string="My Pages" domain="[('user_id', '=', uid)]"/>
                <filter name="recent" string="Edited in the Last 7 Days"
                        domain="[('date_edited', '&gt;=', (context_today() - relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_space" string="Space" context="{'group_by': 'space_id'}"/>
                    <filter name="group_parent" string="Parent Page" context="{'group_by': 'parent_id'}"/>
                    <filter name="group_user" string="Owner" context="{'group_by': 'user_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="dev_page_action" model="ir.actions.act_window">
        <field name="name">Pages</field>
        <field name="res_model">dev.page</field>
        <field name="view_mode">list,hierarchy,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write your first page</p>
            <p>Start from a template (requirements, technical design, meeting notes, decision record, retrospective,
                how-to or release notes) and link the page to its features, tickets and release.</p>
        </field>
    </record>

    <!-- Page history -->
    <record id="dev_page_version_view_list" model="ir.ui.view">
        <field name="name">dev.page.version.list</field>
        <field name="model">dev.page.version</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="id" optional="show"/>
                <field name="date" options="{'numeric': True}"/>
                <field name="author_id" widget="many2one_avatar_user"/>
                <field name="name"/>
                <button name="action_restore" type="object" string="Restore" icon="fa-undo"
                        confirm="Put this version back as the page's content? The current content stays in the history."/>
            </list>
        </field>
    </record>

    <record id="dev_page_version_view_form" model="ir.ui.view">
        <field name="name">dev.page.version.form</field>
        <field name="model">dev.page.version</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_restore" type="object" string="Restore this Version" class="btn-primary"
                            confirm="Put this version back as the page's content? The current content stays in the history."/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="page_id"/>
                        </group>
                        <group>
                            <field name="author_id" widget="many2one_avatar_user"/>
                            <field name="date" options="{'numeric': True}"/>
                        </group>
                    </group>
                    <field name="body"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
