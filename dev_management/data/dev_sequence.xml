<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_dev_ticket" model="ir.sequence">
        <field name="name">Development Ticket</field>
        <field name="code">dev.ticket</field>
        <field name="prefix">DEV-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dev_feature" model="ir.sequence">
        <field name="name">Development Feature</field>
        <field name="code">dev.feature</field>
        <field name="prefix">FEAT-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dev_epic" model="ir.sequence">
        <field name="name">Development Epic</field>
        <field name="code">dev.epic</field>
        <field name="prefix">EPIC-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dev_sprint" model="ir.sequence">
        <field name="name">Development Sprint</field>
        <field name="code">dev.sprint</field>
        <field name="prefix">Sprint %(range_year)s-</field>
        <field name="padding">3</field>
        <field name="use_date_range" eval="True"/>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
