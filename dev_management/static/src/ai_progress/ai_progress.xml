<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="dev_management.AiActionButton">
        <button type="button" t-attf-class="btn {{ props.btnClass or 'btn-secondary' }}" t-on-click="onClick">
            <i t-attf-class="fa {{ props.icon or 'fa-magic' }} me-1"/><t t-esc="props.label or 'AI'"/>
        </button>
    </t>

    <t t-name="dev_management.AiPromptDialog">
        <Dialog title="props.title" size="'md'">
            <p t-if="props.help" class="text-muted" t-esc="props.help"/>
            <div t-if="props.selectedText" class="o_dev_ai_selected_text mb-3">
                <div class="small text-muted mb-1">Selected text</div>
                <blockquote class="border-start border-3 ps-2 mb-0 small" t-esc="props.selectedText"/>
            </div>
            <textarea t-ref="prompt" class="form-control" rows="5" t-model="state.prompt" t-on-keydown="onKeydown"
                      t-att-placeholder="props.placeholder or 'Tell the AI what to change...'"/>
            <div class="small text-muted mt-1">Ctrl+Enter to submit.</div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="submit" t-att-disabled="!canSubmit">
                    <i class="fa fa-magic me-1"/><t t-esc="props.submitLabel or 'Submit'"/>
                </button>
                <button class="btn btn-secondary" t-on-click="props.close">Cancel</button>
            </t>
        </Dialog>
    </t>

    <t t-name="dev_management.AiProgressOverlay">
        <div t-if="state.active" class="o_dev_ai_progress" role="status" aria-live="polite">
            <div class="o_dev_ai_progress_card">
                <div class="o_dev_ai_progress_orb" aria-hidden="true">
                    <i class="fa fa-magic"/>
                </div>
                <h3 class="mt-3 mb-3" t-esc="state.title"/>
                <ol class="o_dev_ai_progress_steps list-unstyled text-start mb-3">
                    <li t-foreach="state.steps" t-as="step" t-key="step_index"
                        t-attf-class="o_dev_ai_progress_step o_dev_ai_progress_step_{{ stepStatus(step_index) }}">
                        <span class="o_dev_ai_progress_icon">
                            <i t-if="stepStatus(step_index) === 'done'" class="fa fa-check"/>
                            <i t-elif="stepStatus(step_index) === 'active'" class="fa fa-circle-o-notch fa-spin"/>
                            <i t-else="" class="fa fa-circle-thin"/>
                        </span>
                        <span t-esc="step"/>
                    </li>
                </ol>
                <p class="text-muted small mb-0">
                    This can take a few minutes - please keep this page open. <t t-esc="elapsed"/>
                </p>
            </div>
        </div>
    </t>
</templates>
