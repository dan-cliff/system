<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_view_form_dev" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.dev_management</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_management.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_create_dev_tickets" type="object" string="Create Dev Tickets" icon="fa-code"
                        groups="dev_management.group_dev_user"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_dev_tickets" type="object" class="oe_stat_button" icon="fa-code"
                        groups="dev_management.group_dev_user" invisible="not dev_ticket_count">
                    <field name="dev_ticket_count" widget="statinfo" string="Dev Tickets"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
