<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="signr_request_view_list" model="ir.ui.view">
        <field name="name">signr.request.list</field>
        <field name="model">signr.request</field>
        <field name="arch" type="xml">
            <list string="Sign Requests" decoration-muted="state in ('cancelled', 'expired')"
                  decoration-danger="state == 'declined'" decoration-success="state == 'signed'">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="title"/>
                <field name="template_id" optional="show"/>
                <field name="app_id" optional="hide"/>
                <field name="res_model_id" optional="show"/>
                <field name="res_name" optional="show"/>
                <field name="recipient_names" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="sent_date" options="{'numeric': True}" optional="show"/>
                <field name="signed_date" options="{'numeric': True}" optional="show"/>
                <field name="expiry_date" options="{'numeric': True}" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="state" widget="badge" decoration-info="state == 'sent'"
                       decoration-success="state == 'signed'" decoration-danger="state == 'declined'"/>
            </list>
        </field>
    </record>

    <record id="signr_request_view_kanban" model="ir.ui.view">
        <field name="name">signr.request.kanban</field>
        <field name="model">signr.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" group_create="false" records_draggable="false">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <field name="title" class="fw-bold"/>
                        <div class="text-muted small"><field name="name"/> · <field name="res_model_id"/></div>
                        <field name="recipient_names" class="small"/>
                        <footer>
                            <field name="sent_date" options="{'numeric': True}" class="small text-muted"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="signr_request_view_form" model="ir.ui.view">
        <field name="name">signr.request.form</field>
        <field name="model">signr.request</field>
        <field name="arch" type="xml">
            <form string="Sign Request">
                <header>
                    <button name="action_send" type="object" string="Send for Signature" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_preview" type="object" string="Preview"
                            invisible="state != 'draft' or not template_id or not res_reference"/>
                    <button name="action_send_reminder" type="object" string="Send Reminder"
                            invisible="state != 'sent'"/>
                    <button name="action_cancel" type="object" string="Cancel Request"
                            invisible="state not in ('draft', 'sent')"
                            confirm="Withdraw this request? Signers can no longer sign it."/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state not in ('cancelled', 'declined', 'expired')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,sent,signed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_record" type="object" class="oe_stat_button" icon="fa-external-link"
                                invisible="not res_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Source</span>
                                <span class="o_stat_text">Record</span>
                            </div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Signed" bg_color="text-bg-success" invisible="state != 'signed'"/>
                    <widget name="web_ribbon" title="Declined" bg_color="text-bg-danger" invisible="state != 'declined'"/>
                    <div class="oe_title">
                        <div class="text-muted"><field name="name" readonly="1"/></div>
                        <h1><field name="title" placeholder="e.g. Employment Contract – Jane Smith"
                                   readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group string="Document">
                            <field name="template_id" options="{'no_create': True}" readonly="state != 'draft'"
                                   domain="[('model_name', '=', res_model)] if res_model else []"/>
                            <field name="document_type_id"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                            <field name="res_reference" string="Raised From" readonly="state != 'draft'"
                                   options="{'model_field': 'res_model'}"
                                   required="template_id" invisible="not template_id"/>
                            <field name="app_id" invisible="not app_id" options="{'no_open': True}"/>
                            <field name="res_model_id" invisible="not res_model_id" options="{'no_open': True}"/>
                        </group>
                        <group string="Sending">
                            <field name="user_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="sign_in_order" readonly="state != 'draft'"/>
                            <field name="expiry_date" options="{'numeric': True}" readonly="state != 'draft'"/>
                            <field name="sent_date" options="{'numeric': True}" invisible="not sent_date"/>
                            <field name="signed_date" options="{'numeric': True}" invisible="not signed_date"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"
                                   readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signers" name="signers">
                            <field name="signer_ids" readonly="state != 'draft'">
                                <list editable="bottom" decoration-success="state == 'signed'"
                                      decoration-danger="state == 'declined'">
                                    <field name="sequence" widget="handle" column_invisible="not parent.sign_in_order"/>
                                    <field name="role" placeholder="e.g. Employee"/>
                                    <field name="partner_id" required="1"/>
                                    <field name="email"/>
                                    <field name="is_internal" optional="hide"/>
                                    <field name="sent_on" options="{'numeric': True}" optional="show"/>
                                    <field name="viewed_on" options="{'numeric': True}" optional="hide"/>
                                    <field name="signed_on" options="{'numeric': True}" optional="show"/>
                                    <field name="signed_by" optional="hide"/>
                                    <field name="signer_ip" optional="hide"/>
                                    <field name="state" widget="badge" decoration-info="state == 'sent'"
                                           decoration-success="state == 'signed'" decoration-danger="state == 'declined'"/>
                                </list>
                                <form string="Signer">
                                    <group>
                                        <group>
                                            <field name="role"/>
                                            <field name="partner_id"/>
                                            <field name="email"/>
                                            <field name="sequence"/>
                                            <field name="state"/>
                                        </group>
                                        <group>
                                            <field name="sent_on" options="{'numeric': True}"/>
                                            <field name="viewed_on" options="{'numeric': True}"/>
                                            <field name="signed_on" options="{'numeric': True}"/>
                                            <field name="signed_by"/>
                                            <field name="signer_ip"/>
                                            <field name="sign_url" widget="CopyClipboardChar" groups="base.group_system"
                                                   invisible="not sign_url"/>
                                        </group>
                                    </group>
                                    <field name="signature" widget="image" invisible="not signature"/>
                                    <group invisible="not decline_reason">
                                        <field name="decline_reason"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Signed Document" name="signed" invisible="not signed_pdf">
                            <field name="signed_pdf_filename" invisible="1"/>
                            <field name="signed_pdf" widget="pdf_viewer" filename="signed_pdf_filename"/>
                        </page>
                        <page string="Document Sent" name="document" invisible="not document_pdf">
                            <group>
                                <field name="document_pdf_filename" invisible="1"/>
                                <field name="document_docx_filename" invisible="1"/>
                                <field name="document_docx" filename="document_docx_filename"/>
                                <field name="document_hash"/>
                            </group>
                            <field name="document_pdf" widget="pdf_viewer" filename="document_pdf_filename"/>
                        </page>
                        <page string="Email" name="email">
                            <group>
                                <field name="email_subject" readonly="state != 'draft'"
                                       placeholder="Leave empty for &quot;Please sign: &lt;document&gt;&quot;"/>
                                <field name="email_message" readonly="state != 'draft'"
                                       placeholder="A note added to the email asking each signer to sign"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Request Signature, opened from the smart button on linked records -->
    <record id="signr_request_view_form_quick" model="ir.ui.view">
        <field name="name">signr.request.form.quick</field>
        <field name="model">signr.request</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Request Signature">
                <field name="state" invisible="1"/>
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="res_reference" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="template_id" options="{'no_create': True}"
                               domain="[('model_name', '=', res_model)]"/>
                        <field name="title" required="1"/>
                    </group>
                    <group>
                        <field name="sign_in_order"/>
                        <field name="expiry_date" options="{'numeric': True}"/>
                    </group>
                </group>
                <field name="signer_ids">
                    <list editable="bottom">
                        <field name="sequence" widget="handle" column_invisible="not parent.sign_in_order"/>
                        <field name="role" placeholder="e.g. Employee"/>
                        <field name="partner_id" required="1"/>
                        <field name="email"/>
                    </list>
                </field>
                <group>
                    <field name="email_message" placeholder="A note added to the email asking each signer to sign"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send for Signature" class="btn-primary"
                            data-hotkey="q"/>
                    <button name="action_preview" type="object" string="Preview" data-hotkey="p"
                            invisible="not template_id"/>
                    <button string="Discard" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="signr_request_view_search" model="ir.ui.view">
        <field name="name">signr.request.search</field>
        <field name="model">signr.request</field>
        <field name="arch" type="xml">
            <search string="Sign Requests">
                <field name="name" string="Request" filter_domain="['|', '|', ('name', 'ilike', self), ('title', 'ilike', self), ('res_name', 'ilike', self)]"/>
                <field name="signer_ids" string="Signer" filter_domain="[('signer_ids.partner_id', 'ilike', self)]"/>
                <field name="template_id"/>
                <field name="res_name" string="Source Record"/>
                <field name="user_id"/>
                <filter name="my" string="Sent by Me" domain="[('user_id', '=', uid)]"/>
                <filter name="to_sign" string="Waiting for My Signature"
                        domain="[('state', '=', 'sent'), ('signer_ids', 'any', [('partner_id.user_ids', 'in', [uid]), ('state', '=', 'sent')])]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="sent" string="Waiting for Signatures" domain="[('state', '=', 'sent')]"/>
                <filter name="signed" string="Signed" domain="[('state', '=', 'signed')]"/>
                <filter name="declined" string="Declined" domain="[('state', '=', 'declined')]"/>
                <filter name="closed" string="Cancelled or Expired" domain="[('state', 'in', ('cancelled', 'expired'))]"/>
                <separator/>
                <filter name="filter_sent_date" string="Sent On" date="sent_date"/>
                <filter name="filter_signed_date" string="Signed On" date="signed_date"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_template" string="Template" context="{'group_by': 'template_id'}"/>
                    <filter name="group_type" string="Document Type" context="{'group_by': 'document_type_id'}"/>
                    <filter name="group_app" string="App" context="{'group_by': 'app_id'}"/>
                    <filter name="group_model" string="Source Model" context="{'group_by': 'res_model_id'}"/>
                    <filter name="group_user" string="Sender" context="{'group_by': 'user_id'}"/>
                    <filter name="group_sent" string="Sent On" context="{'group_by': 'sent_date'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_signr_request" model="ir.actions.act_window">
        <field name="name">Sign Requests</field>
        <field name="res_model">signr.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="signr_request_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('signr_request_view_list')}),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('signr_request_view_kanban')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('signr_request_view_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Send your first document for signature</p>
            <p>Pick a template and the record it is for: the document is filled in from the record and emailed
                to each signer, who signs it online. The signed PDF is kept here and on the record.</p>
        </field>
    </record>

    <!-- Settings › Sign'r -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.signr</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="93"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Sign'r" id="signr" string="Sign'r" name="signr" groups="signr.group_signr_admin">
                    <block title="Integrations" id="signr_integrations"
                           help="Raise sign requests straight from these apps' records. Each one you switch on adds a Request Signature and a Sign Requests button to the app's form, and offers the record's fields as merge codes.">
                        <setting id="signr_integration_applicant" string="Talent Applications"
                                 help="Send offer letters, employment contracts and other documents to applicants for signature, from their application in Talent.">
                            <field name="signr_available_applicant" invisible="1"/>
                            <field name="signr_integration_applicant" readonly="not signr_available_applicant"/>
                            <div class="text-muted small" invisible="signr_available_applicant">Install Talent to use this.</div>
                        </setting>
                        <setting id="signr_integration_crm_opportunity" string="CRM Opportunities"
                                 help="Send proposals, order forms and agreements for signature from an opportunity in CRM.">
                            <field name="signr_available_crm_opportunity" invisible="1"/>
                            <field name="signr_integration_crm_opportunity" readonly="not signr_available_crm_opportunity"/>
                            <div class="text-muted small" invisible="signr_available_crm_opportunity">Install CRM to use this.</div>
                        </setting>
                        <setting id="signr_integration_crm_contract" string="CRM Sales"
                                 help="Send documents for signature from the contracts under CRM › Sales, e.g. variations, change requests and renewals.">
                            <field name="signr_available_crm_contract" invisible="1"/>
                            <field name="signr_integration_crm_contract" readonly="not signr_available_crm_contract"/>
                            <div class="text-muted small" invisible="signr_available_crm_contract">Install CRM to use this.</div>
                        </setting>
                        <setting id="signr_integration_sale_order" string="Sales"
                                 help="Send order forms, quotes and terms of trade for signature from a quotation or sales order.">
                            <field name="signr_available_sale_order" invisible="1"/>
                            <field name="signr_integration_sale_order" readonly="not signr_available_sale_order"/>
                            <div class="text-muted small" invisible="signr_available_sale_order">Install Sales to use this.</div>
                        </setting>
                        <setting id="signr_integration_employee_contract" string="Employee Contracts"
                                 help="Send employment contracts and contract variations for signature from an employee's contract, filled in with its job, dates and pay.">
                            <field name="signr_available_employee_contract" invisible="1"/>
                            <field name="signr_integration_employee_contract" readonly="not signr_available_employee_contract"/>
                            <div class="text-muted small" invisible="signr_available_employee_contract">Employee contracts are not available in this database.</div>
                        </setting>
                        <setting id="signr_integration_employee" string="Employees"
                                 help="Send policies, acknowledgements, change requests and other documents for signature from an employee record.">
                            <field name="signr_available_employee" invisible="1"/>
                            <field name="signr_integration_employee" readonly="not signr_available_employee"/>
                            <div class="text-muted small" invisible="signr_available_employee">Install Employees to use this.</div>
                        </setting>
                        <setting id="signr_integration_incident" string="Incidents"
                                 help="Send witness statements, incident reports and sign-offs for signature from an incident.">
                            <field name="signr_available_incident" invisible="1"/>
                            <field name="signr_integration_incident" readonly="not signr_available_incident"/>
                            <div class="text-muted small" invisible="signr_available_incident">Install Incident Management to use this.</div>
                        </setting>
                        <setting id="signr_integration_injury" string="Injury Management"
                                 help="Send return to work plans, consent forms and declarations for signature from a return to work case.">
                            <field name="signr_available_injury" invisible="1"/>
                            <field name="signr_integration_injury" readonly="not signr_available_injury"/>
                            <div class="text-muted small" invisible="signr_available_injury">Install Injury Management to use this.</div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_signr_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'signr', 'bin_size': False}</field>
    </record>
</odoo>
