<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="mail_template_signr_request" model="mail.template">
            <field name="name">Sign'r: Signature Request</field>
            <field name="model_id" ref="signr.model_signr_request_signer"/>
            <field name="subject">{{ ctx.get('signr_reminder') and 'Reminder: ' or '' }}{{ object.request_id.email_subject or ('Please sign: %s' % object.request_id.title) }}</field>
            <field name="email_from">{{ (object.request_id.user_id.email_formatted or object.request_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent to each signer when it is their turn to sign</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello <t t-out="object.partner_id.name or ''">Brandon Freeman</t>,
        <br/><br/>
        <t t-if="ctx.get('signr_reminder')">This is a reminder: </t>
        <t t-out="object.request_id.user_id.name or object.request_id.company_id.name or ''">Mitchell Admin</t>
        has sent you <strong t-out="object.request_id.title or ''">Employment Contract</strong>
        to sign<t t-if="object.role"> as <t t-out="object.role or ''">Employee</t></t>.
    </p>
    <div t-if="not is_html_empty(object.request_id.email_message)" style="margin: 12px 0px 0px 0px; font-size: 13px;">
        <t t-out="object.request_id.email_message or ''"/>
    </div>
    <div style="margin: 16px 0px 16px 0px;">
        <a t-att-href="object.sign_url"
           style="background-color: #5B3DB8; padding: 10px 18px; text-decoration: none; color: #fff; border-radius: 6px; font-size: 13px;">
            Review and Sign
        </a>
    </div>
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        <t t-if="object.request_id.expiry_date">Please sign before <t t-out="object.request_id.expiry_date.strftime('%d/%m/%Y')">31/12/2026</t>.<br/></t>
        This link is personal to you: please do not forward it.
        <t t-if="not is_html_empty(object.request_id.user_id.signature)">
            <br/><br/>
            <div>--<br/><t t-out="object.request_id.user_id.signature or ''">Mitchell Admin</t></div>
        </t>
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

        <record id="mail_template_signr_completed" model="mail.template">
            <field name="name">Sign'r: Document Signed</field>
            <field name="model_id" ref="signr.model_signr_request"/>
            <field name="subject">Signed: {{ object.title }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ ','.join(str(pid) for pid in (object.signer_ids.partner_id | object.user_id.partner_id).ids) }}</field>
            <field name="description">Sent to every signer and the sender, with the signed PDF, once everyone has signed</field>
            <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello,
        <br/><br/>
        Everyone has signed <strong t-out="object.title or ''">Employment Contract</strong>.
        The signed copy is attached to this email for your records.
    </p>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
