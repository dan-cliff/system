<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Set date display format to DD/MM/YYYY for English (US) language.
             noupdate="1" prevents this from being overwritten on module upgrade
             if an administrator has manually changed the language settings. -->
        <record id="base.lang_en" model="res.lang">
            <field name="date_format">%d/%m/%Y</field>
        </record>
    </data>
</odoo>
