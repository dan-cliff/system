<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every permission below is its
         own privilege with one "Allowed" group, whose record rules give it its
         meaning. All of them imply the technical Sign'r user group, which holds
         the ACLs and a deny rule per operation, so users can only do what a
         permission opens. Template signers and merge codes follow their
         template, request signers follow their request. Everyone who can raise
         sign requests can read the templates to pick one. -->
    <data noupdate="1">
        <record id="module_category_signr" model="ir.module.category">
            <field name="name">Sign'r</field>
            <field name="description">Send documents made from Word templates for digital signature.</field>
            <field name="sequence">55</field>
        </record>
    </data>

