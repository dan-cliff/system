<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_inventory" model="ir.ui.view">
        <field name="name">stock.picking.form.advanced_inventory</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='do_print_picking']" position="after">
                <field name="walk_kind" invisible="1"/>
                <button name="action_print_walk_list" type="object" string="Walk List" icon="fa-map-signs"
                        invisible="state not in ('assigned', 'confirmed', 'waiting')" groups="stock.group_stock_user"/>
            </xpath>
            <xpath expr="//sheet//field[@name='scheduled_date']" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </xpath>
            <xpath expr="//sheet//group/field[@name='date_deadline']" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </xpath>
            <xpath expr="//sheet//field[@name='date_done']" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_picking_tree_inventory" model="ir.ui.view">
        <field name="name">stock.picking.list.advanced_inventory</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='priority']" position="before">
                <field name="id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='date_done']" position="attributes">
                <attribute name="options">{'numeric': True}</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_print_walk_list" type="object" string="Walk List"/>
            </xpath>
        </field>
    </record>
</odoo>
