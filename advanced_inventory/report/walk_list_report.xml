<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pick or put-away list in walk order: one pass through the warehouse for
         every selected transfer. -->
    <record id="action_report_walk_list" model="ir.actions.report">
        <field name="name">Walk List (Pick / Put Away)</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">advanced_inventory.report_walk_list</field>
        <field name="report_file">advanced_inventory.report_walk_list</field>
        <field name="print_report_name">'Walk List - %s' % (object.name if len(docs) == 1 else 'Transfers')</field>
        <field name="binding_model_id" ref="stock.model_stock_picking"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_walk_list">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-set="lines" t-value="docs.move_line_ids.sorted(lambda l: (l.walk_sequence, l.picking_id.id, l.id))"/>
                <div class="page">
                    <h2>
                        <t t-if="all(p.walk_kind == 'putaway' for p in docs)">Put Away List</t>
                        <t t-elif="all(p.walk_kind == 'pick' for p in docs)">Pick List</t>
                        <t t-else="">Walk List</t>
                    </h2>
                    <p class="text-muted">
                        <t t-esc="', '.join(docs.mapped('name'))"/> ·
                        Printed <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"/>
                    </p>
                    <table class="table table-sm o_main_table">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>Go To</th>
                                <th>Product</th>
                                <th t-if="any(lines.mapped('lot_id'))">Lot/Serial</th>
                                <th class="text-end">Quantity</th>
                                <th t-if="len(docs) &gt; 1">Transfer</th>
                                <th class="text-center">Done</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="lines" t-as="line">
                                <td class="text-center"><t t-esc="line_index + 1"/></td>
                                <td>
                                    <strong t-esc="line.walk_location_id.layout_code or line.walk_location_id.name"/>
                                    <div class="small text-muted" t-esc="line.walk_location_id.complete_name"/>
                                </td>
                                <td>
                                    <span t-esc="line.product_id.display_name"/>
                                    <div class="small text-muted" t-if="line.product_id.barcode" t-esc="line.product_id.barcode"/>
                                </td>
                                <td t-if="any(lines.mapped('lot_id'))"><t t-esc="line.lot_id.name or ''"/></td>
                                <td class="text-end"><t t-esc="line.quantity"/> <t t-esc="line.product_uom_id.name"/></td>
                                <td t-if="len(docs) &gt; 1"><t t-esc="line.picking_id.name"/></td>
                                <td class="text-center">☐</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
