<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.property.checklists</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="property_management.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='property_reminders']" position="after">
                <block title="Checklists" name="property_checklists">
                    <setting id="property_checklist_setting" string="Integrate Checklists with Property"
                             company_dependent="1"
                             help="Link checklists to the property they are for, such as inspections and condition reports.">
                        <field name="property_checklist_enabled"/>
                        <div class="content-group mt-2" invisible="not property_checklist_enabled">
                            <div class="row">
                                <label for="property_checklist_group_ids" string="Checklist Groups"
                                       class="col-lg-4 o_light_label"/>
                                <field name="property_checklist_group_ids" widget="many2many_tags"
                                       class="col-lg-8" options="{'no_create': True}"
                                       placeholder="The groups accessible from Property"/>
                            </div>
                            <div class="text-muted small mt-1">
                                Checklists from templates in these groups get a Property field, and
                                properties list their checklists.
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
