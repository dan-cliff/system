<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="checklist_view_form_property" model="ir.ui.view">
        <field name="name">checklist.checklist.form.property</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='checklist']/field[@name='template_id']" position="after">
                <!-- Only for templates in a Checklist Group linked to Property
                     (or when one is already set, so it is never hidden away). -->
                <field name="property_visible" invisible="1"/>
                <field name="property_id" invisible="not property_visible and not property_id"
                       readonly="state == 'done'" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

    <record id="checklist_view_list_property" model="ir.ui.view">
        <field name="name">checklist.checklist.list.property</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_list"/>
        <field name="arch" type="xml">
            <field name="template_id" position="after">
                <field name="property_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="checklist_view_search_property" model="ir.ui.view">
        <field name="name">checklist.checklist.search.property</field>
        <field name="model">checklist.checklist</field>
        <field name="inherit_id" ref="checklists.checklist_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//searchpanel" position="before">
                <field name="property_id"/>
                <filter name="property_checklists" string="Property Checklists"
                        domain="[('property_id', '!=', False)]"/>
                <filter name="group_by_property" string="Property" context="{'group_by': 'property_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
