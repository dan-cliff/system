        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_advanced_accounts"/>
        <field name="comment">Every Advanced Accounts permission, including deleting any Account or Contact and creating users for Contacts, plus Configuration.</field>
        <field name="implied_ids" eval="[(4, ref('group_advanced_account_create_only')), (4, ref('group_advanced_account_edit_own')), (4, ref('group_advanced_account_edit_team')), (4, ref('group_advanced_account_edit_all')), (4, ref('group_advanced_account_view_all')), (4, ref('group_advanced_account_delete_own')), (4, ref('group_advanced_account_delete_all')), (4, ref('group_advanced_contact_create_only')), (4, ref('group_advanced_contact_edit_own')), (4, ref('group_advanced_contact_edit_team')), (4, ref('group_advanced_contact_edit_all')), (4, ref('group_advanced_contact_view_all')), (4, ref('group_advanced_contact_delete_own')), (4, ref('group_advanced_contact_delete_all')), (4, ref('group_advanced_contact_create_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

