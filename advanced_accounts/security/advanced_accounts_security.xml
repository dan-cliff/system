<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions): every Account and Contact
         permission below is its own privilege with one "Allowed" group, whose
         record rules give it its meaning. All of them imply the technical
         Advanced Accounts user group, which holds the ACLs and a deny rule.
         "Own" = created by them or owned by them (the Account / Contact Owner).

         Every internal user can read and pick Accounts and Contacts: they are
         the customer list every app selects from, as Odoo's partners are. The
         permissions decide who creates, edits and deletes them. -->

    <record id="module_category_advanced_accounts" model="ir.module.category">
        <field name="name">Advanced Accounts</field>
        <field name="description">Accounts and the Contacts who work at them.</field>
        <field name="sequence">7</field>
    </record>

    <record id="res_groups_privilege_advanced_accounts" model="res.groups.privilege">
        <field name="name">Advanced Accounts</field>
        <field name="category_id" ref="module_category_advanced_accounts"/>
        <field name="sequence">10</field>
        <field name="description">Configuration of the Advanced Accounts app.</field>
    </record>

    <record id="group_advanced_accounts_user" model="res.groups">
        <field name="name">Advanced Accounts: User</field>
        <field name="privilege_id" eval="False"/>
        <field name="comment">Technical: given by every Advanced Accounts permission. Opens the app; what users can do with Accounts and Contacts comes from their permissions.</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="privilege_advanced_account_create_only" model="res.groups.privilege">
        <field name="name">Accounts: Create Only</field>
        <field name="category_id" ref="module_category_advanced_accounts"/>
        <field name="sequence">20</field>
        <field name="description">Create accounts, and view their own (no editing after saving).</field>
    </record>
    <record id="group_advanced_account_create_only" model="res.groups">
        <field name="name">Allowed</field>
        <field name="privilege_id" ref="privilege_advanced_account_create_only"/>
        <field name="comment">Create accounts, and view their own (no editing after saving).</field>
        <field name="implied_ids" eval="[(4, ref('group_advanced_accounts_user'))]"/>
    </record>

