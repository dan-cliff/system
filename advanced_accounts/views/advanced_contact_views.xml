<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_contact_view_list" model="ir.ui.view">
        <field name="name">advanced.contact.list</field>
        <field name="model">advanced.contact</field>
        <field name="arch" type="xml">
            <list string="Contacts">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="account_id" optional="show"/>
                <field name="function" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="city" optional="hide"/>
                <field name="country_id" optional="hide"/>
                <field name="login_user_id" optional="hide"/>
                <field name="user_id" string="Contact Owner" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="create_date" string="Created On" options="{'numeric': True}" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="advanced_contact_view_kanban" model="ir.ui.view">
        <field name="name">advanced.contact.kanban</field>
        <field name="model">advanced.contact</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="avatar_128"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="d-flex align-items-center me-2">
                            <field name="avatar_128" widget="image" options="{'img_class': 'object-fit-cover'}"
                                   class="o_kanban_image_fill w-100"/>
                        </aside>
                        <main class="ps-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="function" class="text-muted"/>
                            <field name="account_id"/>
                            <field name="email" class="text-truncate"/>
                            <field name="phone"/>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="advanced_contact_view_form" model="ir.ui.view">
        <field name="name">advanced.contact.form</field>
        <field name="model">advanced.contact</field>
        <field name="arch" type="xml">
            <form string="Contact">
                <header>
                    <button name="action_create_user" type="object" string="Create User"
                            invisible="login_user_id" groups="advanced_accounts.group_advanced_contact_create_user"
                            help="Give this Contact a portal login. The user shares the Contact's name, email and phone."/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_user" type="object" class="oe_stat_button" icon="fa-user"
                                invisible="not login_user_id" groups="base.group_erp_manager">
                            <div class="o_stat_info"><span class="o_stat_text">User</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title mb24">
                        <h1><field name="name" placeholder="e.g. Jane Smith" required="1"/></h1>
                        <field name="account_id" placeholder="Account" options="{'no_quick_create': True}"/>
                    </div>
                    <group>
                        <group>
                            <field name="function" string="Job Title" placeholder="e.g. Purchasing Manager"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="lang" string="Language"/>
                            <field name="login_user_id" invisible="not login_user_id"/>
                        </group>
                        <group>
                            <span class="o_form_label o_td_label" name="address_name"><b>Address</b></span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State"
                                       options="{'no_open': True, 'no_quick_create': True}"
                                       context="{'default_country_id': country_id}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country"
                                       options="{'no_open': True, 'no_create': True}"/>
                            </div>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}"
                                   string="Tags"/>
                            <field name="user_id" string="Contact Owner" widget="many2one_avatar_user"
                                   domain="[('share', '=', False)]"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="advanced_contact_view_search" model="ir.ui.view">
        <field name="name">advanced.contact.search</field>
        <field name="model">advanced.contact</field>
        <field name="arch" type="xml">
            <search string="Contacts">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('email', 'ilike', self)]"/>
                <field name="account_id"/>
                <field name="function" string="Job Title"/>
                <field name="user_id" string="Contact Owner"/>
                <field name="category_id" string="Tags"/>
                <filter name="my_contacts" string="My Contacts" domain="[('user_id', '=', uid)]"/>
                <filter name="no_account" string="Without Account" domain="[('account_id', '=', False)]"/>
                <filter name="has_user" string="With a User" domain="[('partner_id.user_ids', '!=', False)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_account" string="Account" context="{'group_by': 'account_id'}"/>
                    <filter name="group_owner" string="Contact Owner" context="{'group_by': 'user_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advanced_contact_action" model="ir.actions.act_window">
        <field name="name">Contacts</field>
        <field name="res_model">advanced.contact</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first Contact</p>
            <p>Contacts are the people you deal with. Link each one to their Account.</p>
        </field>
    </record>

    <record id="advanced_account_type_view_list" model="ir.ui.view">
        <field name="name">advanced.account.type.list</field>
        <field name="model">advanced.account.type</field>
        <field name="arch" type="xml">
            <list string="Account Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <record id="advanced_account_type_view_form" model="ir.ui.view">
        <field name="name">advanced.account.type.form</field>
        <field name="model">advanced.account.type</field>
        <field name="arch" type="xml">
            <form string="Account Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="advanced_account_type_action" model="ir.actions.act_window">
        <field name="name">Account Types</field>
        <field name="res_model">advanced.account.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <record id="view_users_form_advanced_contact" model="ir.ui.view">
        <field name="name">res.users.form.advanced_contact</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_adv_contact" type="object" class="oe_stat_button" icon="fa-address-card"
                        invisible="not adv_contact_id">
                    <div class="o_stat_info"><span class="o_stat_text">Contact</span></div>
                </button>
            </div>
        </field>
    </record>
</odoo>
