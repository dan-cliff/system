              action="advanced_accounts_settings_action" groups="base.group_system" sequence="10"/>
    <menuitem id="menu_advanced_accounts_account_types" name="Account Types" parent="menu_advanced_accounts_config"
              action="advanced_account_type_action" sequence="20"/>
    <menuitem id="menu_advanced_accounts_industries" name="Industries" parent="menu_advanced_accounts_config"
              action="base.res_partner_industry_action" sequence="30"/>
    <menuitem id="menu_advanced_accounts_tags" name="Tags" parent="menu_advanced_accounts_config"
              action="base.action_partner_category_form" sequence="40"/>
