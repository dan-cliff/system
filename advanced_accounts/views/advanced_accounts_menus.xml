    <menuitem id="menu_advanced_accounts_reports" name="Reports" parent="menu_advanced_accounts_root"
              sequence="80"/>

    <menuitem id="menu_advanced_accounts_config" name="Configuration" parent="menu_advanced_accounts_root"
