<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <menuitem id="menu_advanced_accounts_root"
              name="Accounts"
              web_icon="advanced_accounts,static/description/icon.png"
              action="advanced_account_action"
              groups="base.group_user"
              sequence="20"/>

    <menuitem id="menu_advanced_accounts_accounts" name="Accounts" parent="menu_advanced_accounts_root"
              action="advanced_account_action" sequence="10"/>
