<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_account_view_list" model="ir.ui.view">
        <field name="name">advanced.account.list</field>
        <field name="model">advanced.account</field>
        <field name="arch" type="xml">
            <list string="Accounts">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="account_type_id" optional="show"/>
                <field name="industry_id" optional="show"/>
                <field name="phone" optional="show"/>
                <field name="email" optional="show"/>
                <field name="website" optional="hide"/>
                <field name="city" optional="show"/>
                <field name="country_id" optional="show"/>
                <field name="contact_count" string="Contacts" optional="show"/>
                <field name="user_id" string="Account Owner" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
                <field name="create_date" string="Created On" options="{'numeric': True}" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="advanced_account_view_kanban" model="ir.ui.view">
        <field name="name">advanced.account.kanban</field>
        <field name="model">advanced.account</field>
        <field name="arch" type="xml">
            <kanban sample="1">
                <field name="avatar_128"/>
                <templates>
                    <t t-name="card" class="flex-row">
                        <aside class="d-flex align-items-center me-2">
                            <field name="avatar_128" widget="image" options="{'img_class': 'object-fit-cover'}"
                                   class="o_kanban_image_fill w-100"/>
                        </aside>
                        <main class="ps-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <field name="account_type_id" class="text-muted"/>
                            <field name="email" class="text-truncate"/>
                            <field name="phone"/>
                            <div><field name="city"/> <field name="country_id"/></div>
                        </main>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="advanced_account_view_form" model="ir.ui.view">
        <field name="name">advanced.account.form</field>
        <field name="model">advanced.account</field>
        <field name="arch" type="xml">
            <form string="Account">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_contacts" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="contact_count" widget="statinfo" string="Contacts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'avatar_128'}"/>
                    <div class="oe_title mb24">
                        <h1><field name="name" placeholder="e.g. Acme Pty Ltd" required="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <span class="o_form_label o_td_label" name="address_name"><b>Address</b></span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State"
                                       options="{'no_open': True, 'no_quick_create': True}"
                                       context="{'default_country_id': country_id}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country"
                                       options="{'no_open': True, 'no_create': True}"/>
                            </div>
                            <field name="vat" placeholder="e.g. ABN"/>
                            <field name="ref" string="Reference"/>
                        </group>
                        <group>
                            <field name="account_type_id" options="{'no_create': True}"/>
                            <field name="industry_id" options="{'no_create': True}"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url" placeholder="e.g. https://www.example.com"/>
                            <field name="category_id" widget="many2many_tags" options="{'color_field': 'color'}"
                                   string="Tags"/>
                            <field name="user_id" string="Account Owner" widget="many2one_avatar_user"
                                   domain="[('share', '=', False)]"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contacts" name="contacts">
                            <field name="contact_ids" context="{'default_account_id': id}">
                                <list>
                                    <field name="id" optional="show"/>
                                    <field name="name"/>
                                    <field name="function" optional="show"/>
                                    <field name="email" optional="show"/>
                                    <field name="phone" optional="show"/>
                                    <field name="login_user_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="comment" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="advanced_account_view_search" model="ir.ui.view">
        <field name="name">advanced.account.search</field>
        <field name="model">advanced.account</field>
        <field name="arch" type="xml">
            <search string="Accounts">
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('email', 'ilike', self), ('ref', 'ilike', self)]"/>
                <field name="account_type_id"/>
                <field name="industry_id"/>
                <field name="user_id" string="Account Owner"/>
                <field name="category_id" string="Tags"/>
                <filter name="my_accounts" string="My Accounts" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_type" string="Account Type" context="{'group_by': 'account_type_id'}"/>
                    <filter name="group_industry" string="Industry" context="{'group_by': 'industry_id'}"/>
                    <filter name="group_owner" string="Account Owner" context="{'group_by': 'user_id'}"/>
                    <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="advanced_account_action" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">advanced.account</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first Account</p>
            <p>Accounts are the companies and organisations you do business with. Link their people to them as Contacts.</p>
        </field>
    </record>
</odoo>
