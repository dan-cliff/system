<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="embroidery_submission_company_rule" model="ir.rule">
            <field name="name">Embroidery Submissions: multi-company</field>
            <field name="model_id" ref="model_embroidery_submission"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="embroidery_submission_color_company_rule" model="ir.rule">
            <field name="name">Embroidery Submission Colours: multi-company</field>
            <field name="model_id" ref="model_embroidery_submission_color"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="embroidery_pricing_profile_company_rule" model="ir.rule">
            <field name="name">Embroidery Pricing Profiles: multi-company</field>
            <field name="model_id" ref="model_embroidery_pricing_profile"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
