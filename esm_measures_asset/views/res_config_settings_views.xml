<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.esm_measures_asset</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="esm_measures.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='esm_fak_inspections']" position="inside">
                <setting id="esm_fak_asset_types" string="Visible Asset Types"
                         help="Assets with these types will be accessible from the First Aid Kit Inspection.">
                    <field name="esm_fak_asset_type_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
                <setting id="esm_fak_asset_subtypes" string="Visible Asset Subtypes"
                         help="Assets with these subtypes will be accessible from the First Aid Kit Inspection.">
                    <field name="esm_fak_asset_subtype_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
            <xpath expr="//block[@id='esm_eed_inspections']" position="inside">
                <setting id="esm_eed_asset_types" string="Visible Asset Types"
                         help="Assets with these types will be accessible from the Emergency Egress Door Inspection.">
                    <field name="esm_eed_asset_type_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
                <setting id="esm_eed_asset_subtypes" string="Visible Asset Subtypes"
                         help="Assets with these subtypes will be accessible from the Emergency Egress Door Inspection.">
                    <field name="esm_eed_asset_subtype_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
            <xpath expr="//block[@id='esm_sma_inspections']" position="inside">
                <setting id="esm_sma_asset_types" string="Visible Asset Types"
                         help="Assets with these types will be accessible from the Smoke Alarm Inspection.">
                    <field name="esm_sma_asset_type_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
                <setting id="esm_sma_asset_subtypes" string="Visible Asset Subtypes"
                         help="Assets with these subtypes will be accessible from the Smoke Alarm Inspection.">
                    <field name="esm_sma_asset_subtype_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
            <xpath expr="//block[@id='esm_evp_inspections']" position="inside">
                <setting id="esm_evp_asset_types" string="Visible Asset Types"
                         help="Assets with these types will be accessible from the Evacuation Plan Inspection.">
                    <field name="esm_evp_asset_type_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
                <setting id="esm_evp_asset_subtypes" string="Visible Asset Subtypes"
                         help="Assets with these subtypes will be accessible from the Evacuation Plan Inspection.">
                    <field name="esm_evp_asset_subtype_ids" widget="many2many_tags"
                           options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
