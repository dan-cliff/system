<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Asset options on each inspection type's template. -->
    <record id="esm_fak_template_view_form" model="ir.ui.view">
        <field name="name">esm.fak.template.form.inherit.asset</field>
        <field name="model">esm.fak.template</field>
        <field name="inherit_id" ref="esm_measures.esm_fak_template_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Asset" name="asset">
                    <group>
                        <group>
                            <field name="esm_asset_enabled"/>
                            <field name="esm_asset_required" invisible="not esm_asset_enabled"/>
                            <field name="esm_asset_label" invisible="not esm_asset_enabled"
                                   placeholder="First Aid Kit"/>
                        </group>
                    </group>
                    <group invisible="not esm_asset_enabled">
                        <field name="esm_asset_domain" widget="domain"
                               options="{'model': 'asset.asset', 'in_dialog': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

