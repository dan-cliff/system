<odoo>
    <record id="view_api_model_endpoint_tree" model="ir.ui.view">
      <field name="name">api.model.endpoint.tree</field>
      <field name="model">api.model.endpoint</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="model_id"/>
          <field name="require_api_key"/>
          <field name="rate_limit_enabled"/>
          <field name="rate_limit_per_minute"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="view_api_model_endpoint_form" model="ir.ui.view">
      <field name="name">api.model.endpoint.form</field>
      <field name="model">api.model.endpoint</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="model_id"/>
              <field name="endpoint_url" readonly="1"/>
              <field name="require_api_key"/>
              <field name="active"/>
            </group>
            <group>
              <field name="rate_limit_enabled"/>
              <field name="rate_limit_per_minute" invisible="not rate_limit_enabled"/>
            </group>
            <notebook>
              <page string="Fields">
                <group>
                  <field name="select_all_fields"/>
                </group>
                <field name="field_ids" widget="many2many_tags" domain="[('model_id','=',model_id)]" placeholder="Select fields..."/>
              </page>
              <page string="Related Models">
                <field name="relation_ids" mode="list,form" context="{'default_select_all_fields': True}">
                  <list>
                    <field name="related_model_id"/>
                    <field name="field_ids" widget="many2many_tags"/>
                  </list>
                  <kanban class="o_kanban_small_column">
                    <field name="relation_field_id"/>
                    <field name="related_model_id"/>
                    <field name="select_all_fields"/>
                    <field name="field_ids"/>
                    <templates>
                      <t t-name="card">
                        <div class="o_kanban_record">
                          <div class="o_kanban_record_title">
                            <field name="relation_field_id"/>
                          </div>
                          <div>
                            <field name="related_model_id"/>
                          </div>
                          <div>
                            <field name="select_all_fields"/>
                          </div>
                          <div t-if="not record.select_all_fields.raw_value">
                            <field name="field_ids" widget="many2many_tags"/>
                          </div>
                        </div>
                      </t>
                    </templates>
                  </kanban>
                  <form>
                    <sheet>
                      <group>
                        <field name="relation_field_id" domain="[('model_id','=',parent.model_id),('ttype','in',('one2many','many2many','many2one'))]"/>
                        <field name="related_model_id" readonly="1"/>
                        <field name="select_all_fields"/>
                      </group>
                      <group>
                        <field name="field_ids" widget="many2many_tags" domain="[('model_id','=',related_model_id)]" placeholder="Select fields..."/>
                      </group>
                    </sheet>
                  </form>
                </field>
              </page>
              <page string="Filters">
                <group>
                  <field name="domain" placeholder="[('state','=','sale')]"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_api_model_endpoint" model="ir.actions.act_window">
      <field name="name">Model Endpoints</field>
      <field name="res_model">api.model.endpoint</field>
      <field name="view_mode">list,form</field>
    </record>
</odoo>
