<odoo>
    <record id="view_api_app_key_tree" model="ir.ui.view">
      <field name="name">api.app.key.tree</field>
      <field name="model">api.app.key</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="key"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="view_api_app_key_form" model="ir.ui.view">
      <field name="name">api.app.key.form</field>
      <field name="model">api.app.key</field>
      <field name="arch" type="xml">
        <form>
          <header>
            <button name="action_generate_key" type="object" string="Generate Key" class="btn-primary"/>
          </header>
          <sheet>
            <group>
              <field name="name"/>
              <field name="key" readonly="1"/>
              <field name="active"/>
            </group>
            <group>
              <field name="note"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_api_app_key" model="ir.actions.act_window">
      <field name="name">API App Keys</field>
      <field name="res_model">api.app.key</field>
      <field name="view_mode">list,form</field>
    </record>
</odoo>
