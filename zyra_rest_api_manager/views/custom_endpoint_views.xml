<odoo>
    <record id="view_api_custom_endpoint_tree" model="ir.ui.view">
      <field name="name">api.custom.endpoint.tree</field>
      <field name="model">api.custom.endpoint</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="full_route"/>
          <field name="response_type"/>
          <field name="require_api_key"/>
          <field name="rate_limit_enabled"/>
          <field name="rate_limit_per_minute"/>
          <field name="active"/>
        </list>
      </field>
    </record>

    <record id="view_api_custom_endpoint_form" model="ir.ui.view">
      <field name="name">api.custom.endpoint.form</field>
      <field name="model">api.custom.endpoint</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="route"/>
              <field name="full_route" readonly="1"/>
              <field name="response_type"/>
              <field name="require_api_key"/>
              <field name="active"/>
            </group>
            <group>
              <field name="rate_limit_enabled"/>
              <field name="rate_limit_per_minute" invisible="not rate_limit_enabled"/>
            </group>
            <group>
              <field name="response_body" placeholder='{"status":"ok"}'/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_api_custom_endpoint" model="ir.actions.act_window">
      <field name="name">Custom Endpoints</field>
      <field name="res_model">api.custom.endpoint</field>
      <field name="view_mode">list,form</field>
    </record>
</odoo>
