    <!-- Risk Assessments and their Risks are visible across the user's allowed companies. -->
    <record id="rule_risk_assessment_company" model="ir.rule">
        <field name="name">Risk Assessment: allowed companies</field>
        <field name="model_id" ref="model_risk_assessment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_risk_assessment_line_company" model="ir.rule">
        <field name="name">Risk Assessment Lines: allowed companies</field>
        <field name="model_id" ref="model_risk_assessment_line"/>
        <field name="domain_force">[('assessment_id.company_id', 'in', company_ids)]</field>
    </record>

    <!-- Create and Edit Own Only: within those companies, only the assessments (and their
         Risks) the user created or is the Owner, Approver or a Collaborator on. -->
    <record id="rule_risk_assessment_own" model="ir.rule">
        <field name="name">Risk Assessment: own, owned, approving or collaborating</field>
        <field name="model_id" ref="model_risk_assessment"/>
        <field name="groups" eval="[(4, ref('group_risk_assessment_own'))]"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('create_uid', '=', user.id),
            ('assessor_id', '=', user.id),
            ('approver_id', '=', user.id),
            ('collaborator_ids', 'in', [user.id]),
        ]</field>
    </record>
    <record id="rule_risk_assessment_line_own" model="ir.rule">
        <field name="name">Risk Assessment Lines: own, owned, approving or collaborating</field>
        <field name="model_id" ref="model_risk_assessment_line"/>
        <field name="groups" eval="[(4, ref('group_risk_assessment_own'))]"/>
        <field name="domain_force">[
            '|', '|', '|',
            ('assessment_id.create_uid', '=', user.id),
            ('assessment_id.assessor_id', '=', user.id),
            ('assessment_id.approver_id', '=', user.id),
            ('assessment_id.collaborator_ids', 'in', [user.id]),
        ]</field>
    </record>
</odoo>
