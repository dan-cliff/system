<odoo>
    <record id="module_category_risk_management" model="ir.module.category">
        <field name="name">Risk Management</field>
        <field name="sequence">25</field>
    </record>

    <!-- One privilege per risk model, each holding View Only / Create / Update / Delete
         groups, so they read as "Risk Templates / Create" etc. Create, Update and Delete
         each imply View Only for the same model. Roles combining them for Administrator,
         Risk Manager, Manager, Employee and View Only are defined in access_levels.py and
         created in Permission Management when that app is installed. -->

    <!-- Risk Assessments -->
    <record id="privilege_risk_assessment" model="res.groups.privilege">
        <field name="name">Risk Assessments</field>
        <field name="category_id" ref="module_category_risk_management"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_risk_assessment_view" model="res.groups">
        <field name="name">View Only</field>
        <field name="privilege_id" ref="privilege_risk_assessment"/>
        <field name="comment">Can view Risk Assessments.</field>
    </record>
    <record id="group_risk_assessment_create" model="res.groups">
        <field name="name">Create</field>
        <field name="privilege_id" ref="privilege_risk_assessment"/>
        <field name="comment">Can create Risk Assessments.</field>
        <field name="implied_ids" eval="[(4, ref('group_risk_assessment_view'))]"/>
    </record>
    <record id="group_risk_assessment_update" model="res.groups">
        <field name="name">Update</field>
        <field name="privilege_id" ref="privilege_risk_assessment"/>
        <field name="comment">Can edit Risk Assessments.</field>
        <field name="implied_ids" eval="[(4, ref('group_risk_assessment_view'))]"/>
    </record>
    <record id="group_risk_assessment_delete" model="res.groups">
        <field name="name">Delete</field>
        <field name="privilege_id" ref="privilege_risk_assessment"/>
        <field name="comment">Can delete and archive Risk Assessments, and approve or reject any submitted Risk Assessment.</field>
        <field name="implied_ids" eval="[(4, ref('group_risk_assessment_view'))]"/>
    </record>
    <record id="group_risk_assessment_own" model="res.groups">
        <field name="name">Create and Edit Own Only</field>
        <field name="privilege_id" ref="privilege_risk_assessment"/>
        <field name="comment">Can create and edit Risk Assessments, but only sees the ones they created or are the Risk Assessment Owner, Risk Approver or a Collaborator on.</field>
        <field name="implied_ids" eval="[(4, ref('group_risk_assessment_view'))]"/>
    </record>

