<odoo>
    <record id="view_risk_control_list" model="ir.ui.view">
        <field name="name">risk.control.list</field>
        <field name="model">risk.control</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" readonly="1"/>
                <field name="name"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="hierarchy_id"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_risk_control_form" model="ir.ui.view">
        <field name="name">risk.control.form</field>
        <field name="model">risk.control</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="hierarchy_id"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_control" model="ir.actions.act_window">
        <field name="name">Controls</field>
        <field name="res_model">risk.control</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a control</p>
            <p>The control library is reused across Risk Templates and Risk Assessments, e.g.
               "First Aid Kit On Site", "Adult Supervision Ratio Maintained".</p>
        </field>
    </record>
</odoo>
