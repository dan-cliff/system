<odoo>
    <record id="view_risk_matrix_wizard_form" model="ir.ui.view">
        <field name="name">risk.matrix.wizard.form</field>
        <field name="model">risk.matrix.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="matrix_html" readonly="1"/>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_risk_matrix_wizard" model="ir.actions.act_window">
        <field name="name">Risk Matrix</field>
        <field name="res_model">risk.matrix.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
