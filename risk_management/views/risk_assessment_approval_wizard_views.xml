<odoo>
    <record id="view_risk_assessment_approval_wizard_form" model="ir.ui.view">
        <field name="name">risk.assessment.approval.wizard.form</field>
        <field name="model">risk.assessment.approval.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="assessment_id" invisible="1"/>
                <group>
                    <field name="decision" widget="radio"/>
                    <field name="comment" placeholder="Optional note..."/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
