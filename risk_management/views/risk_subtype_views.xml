<odoo>
    <record id="view_risk_subtype_list" model="ir.ui.view">
        <field name="name">risk.subtype.list</field>
        <field name="model">risk.subtype</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" readonly="1"/>
                <field name="risk_type_id"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_risk_subtype_form" model="ir.ui.view">
        <field name="name">risk.subtype.form</field>
        <field name="model">risk.subtype</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="risk_type_id"/>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_subtype" model="ir.actions.act_window">
        <field name="name">Risk Subtypes</field>
        <field name="res_model">risk.subtype</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a risk subtype</p>
            <p>Each Risk Subtype belongs to one Risk Type - selecting a Risk Type on a risk narrows
               the Risk Subtype options down to that type's own subtypes.</p>
        </field>
    </record>
</odoo>
