<odoo>
    <record id="view_risk_assessment_stage_list" model="ir.ui.view">
        <field name="name">risk.assessment.stage.list</field>
        <field name="model">risk.assessment.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" readonly="1"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="stage_type"/>
            </list>
        </field>
    </record>

    <record id="view_risk_assessment_stage_form" model="ir.ui.view">
        <field name="name">risk.assessment.stage.form</field>
        <field name="model">risk.assessment.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="stage_type"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_assessment_stage" model="ir.actions.act_window">
        <field name="name">Risk Assessment Stages</field>
        <field name="res_model">risk.assessment.stage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a stage</p>
            <p>Stages drive the statusbar on a Risk Assessment. Keep exactly one stage per
               Stage Type (Draft, In Progress, Submitted for Approval, Approved, Completed) -
               that's what the workflow buttons look up to move an assessment forward.</p>
        </field>
    </record>
</odoo>
