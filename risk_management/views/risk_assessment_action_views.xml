<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_risk_assessment_action_list" model="ir.ui.view">
        <field name="name">risk.assessment.action.list</field>
        <field name="model">risk.assessment.action</field>
        <field name="arch" type="xml">
            <list decoration-muted="state != 'open'" decoration-danger="state == 'open' and date_deadline and date_deadline &lt; current_date">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="assessment_id" optional="show"/>
                <field name="line_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="date_deadline" options="{'numeric': True}" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'open'"/>
                <field name="company_id" optional="show" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_risk_assessment_action_form" model="ir.ui.view">
        <field name="name">risk.assessment.action.form</field>
        <field name="model">risk.assessment.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="state == 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Check the first aid kit"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="line_id"/>
                            <field name="assessment_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="date_deadline" options="{'numeric': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Details"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_risk_assessment_action_search" model="ir.ui.view">
        <field name="name">risk.assessment.action.search</field>
        <field name="model">risk.assessment.action</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="assessment_id"/>
                <field name="line_id"/>
                <field name="user_id"/>
                <filter name="my_actions" string="My Actions" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter name="overdue" string="Overdue"
                        domain="[('state', '=', 'open'), ('date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_assessment" string="Risk Assessment" context="{'group_by': 'assessment_id'}"/>
                    <filter name="group_user" string="Assigned To" context="{'group_by': 'user_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_risk_assessment_action" model="ir.actions.act_window">
        <field name="name">Actions</field>
        <field name="res_model">risk.assessment.action</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_my_actions': 1, 'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No actions yet</p>
            <p>Actions are added to the risks of a Risk Assessment, from its Risk Templates'
               Standard Actions, by AI or by hand.</p>
        </field>
    </record>
</odoo>
