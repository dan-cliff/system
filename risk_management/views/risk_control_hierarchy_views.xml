<odoo>
    <record id="view_risk_control_hierarchy_list" model="ir.ui.view">
        <field name="name">risk.control.hierarchy.list</field>
        <field name="model">risk.control.hierarchy</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" readonly="1"/>
                <field name="sequence" widget="handle"/>
                <field name="icon" widget="image" options="{'size': [32, 32]}"/>
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_risk_control_hierarchy_form" model="ir.ui.view">
        <field name="name">risk.control.hierarchy.form</field>
        <field name="model">risk.control.hierarchy</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="icon" widget="image" class="oe_avatar" options="{'size': [128, 128]}"/>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_control_hierarchy" model="ir.actions.act_window">
        <field name="name">Hierarchy of Controls</field>
        <field name="res_model">risk.control.hierarchy</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a hierarchy of controls level</p>
            <p>E.g. Elimination, Substitution, Engineering Controls, Administrative Controls, PPE -
               ordered by Sequence, from most to least effective. Link each Control to the level
               it represents.</p>
        </field>
    </record>
</odoo>
