<odoo>
    <record id="view_risk_likelihood_list" model="ir.ui.view">
        <field name="name">risk.likelihood.list</field>
        <field name="model">risk.likelihood</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" readonly="1"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="value"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_risk_likelihood_form" model="ir.ui.view">
        <field name="name">risk.likelihood.form</field>
        <field name="model">risk.likelihood</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="value"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_likelihood" model="ir.actions.act_window">
        <field name="name">Likelihood</field>
        <field name="res_model">risk.likelihood</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a likelihood band</p>
            <p>Likelihood is one axis of the Risk Matrix, e.g. Rare (1) to Almost Certain (5).</p>
        </field>
    </record>
</odoo>
