<odoo>
    <record id="view_risk_score_list" model="ir.ui.view">
        <field name="name">risk.score.list</field>
        <field name="model">risk.score</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" readonly="1"/>
                <field name="likelihood_id"/>
                <field name="consequence_id"/>
                <field name="severity_id"/>
                <field name="score"/>
                <field name="label"/>
                <field name="bg_color" widget="color" readonly="1"/>
                <field name="text_color" widget="color" readonly="1"/>
            </list>
        </field>
    </record>

    <record id="view_risk_score_form" model="ir.ui.view">
        <field name="name">risk.score.form</field>
        <field name="model">risk.score</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="likelihood_id"/>
                        <field name="consequence_id"/>
                        <field name="severity_id"/>
                        <field name="score"/>
                        <field name="label"/>
                        <field name="bg_color" widget="color" readonly="1"/>
                        <field name="text_color" widget="color" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_score" model="ir.actions.act_window">
        <field name="name">Risk Score</field>
        <field name="res_model">risk.score</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Define a risk score cell</p>
            <p>One record per Likelihood/Consequence combination: its Label and Score are shown
               on every risk that matches that combination, coloured using its Risk Severity.
               See "View Risk Matrix" for the full grid.</p>
        </field>
    </record>
</odoo>
