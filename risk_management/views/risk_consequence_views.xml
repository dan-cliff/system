<odoo>
    <record id="view_risk_consequence_list" model="ir.ui.view">
        <field name="name">risk.consequence.list</field>
        <field name="model">risk.consequence</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" readonly="1"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="value"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_risk_consequence_form" model="ir.ui.view">
        <field name="name">risk.consequence.form</field>
        <field name="model">risk.consequence</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="value"/>
                        <field name="sequence"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_consequence" model="ir.actions.act_window">
        <field name="name">Consequence</field>
        <field name="res_model">risk.consequence</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create a consequence band</p>
            <p>Consequence is the other axis of the Risk Matrix, e.g. Insignificant (1) to Catastrophic (5).</p>
        </field>
    </record>
</odoo>
