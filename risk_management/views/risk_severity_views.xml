<odoo>
    <record id="view_risk_severity_list" model="ir.ui.view">
        <field name="name">risk.severity.list</field>
        <field name="model">risk.severity</field>
        <field name="arch" type="xml">
            <list>
                <field name="id" readonly="1"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="bg_color" widget="color"/>
                <field name="text_color" widget="color"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_risk_severity_form" model="ir.ui.view">
        <field name="name">risk.severity.form</field>
        <field name="model">risk.severity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="bg_color" widget="color"/>
                        <field name="text_color" widget="color"/>
                        <field name="active"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_risk_severity" model="ir.actions.act_window">
        <field name="name">Risk Severity</field>
        <field name="res_model">risk.severity</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Define a risk severity band</p>
            <p>Severity bands (e.g. Low, Medium, High, Extreme) drive the colour coding of the
               risk matrix cells: Background Colour fills the cell, and Text Colour is applied
               to the cell's label, so pick a pair with good contrast.</p>
        </field>
    </record>
</odoo>
