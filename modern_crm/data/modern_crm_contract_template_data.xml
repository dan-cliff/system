<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A starting contract; admins edit it (or add more) under
         CRM > Configuration > Contract Templates. "object" is the contract. -->
    <data noupdate="1">
        <record id="contract_template_services" model="modern.crm.contract.template">
            <field name="name">Sales Agreement</field>
            <field name="sequence">10</field>
            <field name="term_months">12</field>
            <field name="body" type="html">
<div>
    <h2>Sales Agreement</h2>
    <p>This agreement is made between <strong t-out="object.company_id.name or ''">Our Company</strong>
        ("the Supplier") and <strong t-out="object.partner_id.commercial_partner_id.name or ''">The Customer</strong>
        ("the Customer").</p>
    <h3>1. Term</h3>
    <p>The agreement starts on <t t-out="format_date(object.start_date)">01/01/2026</t> and runs for
        <t t-out="object.term_months">12</t> months, until <t t-out="format_date(object.end_date)">31/12/2026</t>.</p>
    <h3>2. Products and Services</h3>
    <t t-if="object.quote_id">
        <p>The Supplier provides the products and services in quote <strong t-out="object.quote_id.name or ''">S00001</strong>:</p>
        <table class="table table-sm" style="width: 100%; border-collapse: collapse;">
            <thead>
                <tr>
                    <th style="text-align: left; border-bottom: 1px solid #ccc;">Description</th>
                    <th style="text-align: right; border-bottom: 1px solid #ccc;">Quantity</th>
                    <th style="text-align: right; border-bottom: 1px solid #ccc;">Amount</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="object.quote_id.order_line.filtered(lambda l: not l.display_type)" t-as="line">
                    <td t-out="line.name or ''">Product</td>
                    <td style="text-align: right;" t-out="'%g' % line.product_uom_qty">1</td>
                    <td style="text-align: right;" t-out="format_amount(line.price_subtotal, line.currency_id)">$0.00</td>
                </tr>
            </tbody>
        </table>
        <p>Total (excluding taxes): <strong t-out="format_amount(object.quote_id.amount_untaxed, object.quote_id.currency_id)">$0.00</strong>.
            Total (including taxes): <strong t-out="format_amount(object.quote_id.amount_total, object.quote_id.currency_id)">$0.00</strong>.</p>
    </t>
    <p t-else="">The Supplier provides the products and services agreed in the opportunity
        <t t-out="object.opportunity_id.name or ''">Opportunity</t>.</p>
    <h3>3. Payment</h3>
    <p>The Customer pays each invoice within the payment terms shown on it
        <t t-if="object.quote_id.payment_term_id">(<t t-out="object.quote_id.payment_term_id.name or ''">30 Days</t>)</t>.</p>
    <h3>4. Ending the Agreement</h3>
    <p>Either party may end this agreement with 30 days' written notice, or straight away if the
        other party seriously breaches it and does not put it right within 14 days of being asked to.</p>
    <h3>5. Signatures</h3>
    <p>By signing, each party confirms they have read and accept this agreement.</p>
</div>
            </field>
        </record>

        <record id="base.main_company" model="res.company">
            <field name="modern_crm_contract_template_id" ref="contract_template_services"/>
        </record>
    </data>
</odoo>
