<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="modern_crm_opportunity_view_list" model="ir.ui.view">
        <field name="name">modern.crm.opportunity.list</field>
        <field name="model">modern.crm.opportunity</field>
        <field name="arch" type="xml">
            <list string="Opportunities" sample="1" multi_edit="1">
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="stage_id"/>
                <field name="close_date" options="{'numeric': True}"/>
                <field name="amount" sum="Total Amount"/>
                <field name="probability" optional="show" avg="Average Probability"/>
                <field name="expected_revenue" optional="show" sum="Total Expected Revenue"/>
                <field name="forecast_category_id" optional="show"/>
                <field name="type_id" optional="hide"/>
                <field name="next_step" optional="hide"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="team_id" optional="hide"/>
                <field name="activity_ids" widget="list_activity" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="modern_crm_opportunity_view_kanban" model="ir.ui.view">
        <field name="name">modern.crm.opportunity.kanban</field>
        <field name="model">modern.crm.opportunity</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" highlight_color="color" sample="1"
                    quick_create_view="modern_crm.modern_crm_opportunity_view_form_quick_create"
                    class="o_kanban_small_column">
                <field name="currency_id"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'
                             sum_field="amount"/>
                <templates>
                    <t t-name="menu">
                        <a role="menuitem" type="open" class="dropdown-item">Edit</a>
                        <a t-if="widget.deletable" role="menuitem" type="delete" class="dropdown-item">Delete</a>
                        <field name="color" widget="kanban_color_picker"/>
                    </t>
                    <t t-name="card">
                        <field name="name" class="fw-bold fs-5"/>
                        <field name="partner_id" class="text-muted"/>
                        <div class="d-flex gap-2 small">
                            <field name="amount" widget="monetary" class="fw-bold"/>
                            <span class="text-muted">
                                <i class="fa fa-calendar me-1" title="Close Date"/>
                                <field name="close_date" options="{'numeric': True}"/>
                            </span>
                        </div>
                        <field name="next_step" class="small text-muted"/>
                        <footer class="pt-1">
                            <div class="d-flex align-items-center gap-1">
                                <field name="activity_ids" widget="kanban_activity"/>
                                <field name="probability" class="small text-muted"/><span class="small text-muted">%</span>
                            </div>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="modern_crm_opportunity_view_form_quick_create" model="ir.ui.view">
        <field name="name">modern.crm.opportunity.form.quick_create</field>
        <field name="model">modern.crm.opportunity</field>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name" placeholder="e.g. 50 seats of the yearly plan"/>
                    <field name="partner_id"/>
                    <field name="amount"/>
                    <field name="close_date" options="{'numeric': True}"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="modern_crm_opportunity_view_form" model="ir.ui.view">
        <field name="name">modern.crm.opportunity.form</field>
        <field name="model">modern.crm.opportunity</field>
        <field name="arch" type="xml">
            <form string="Opportunity">
                <header>
                    <button name="action_new_quote" type="object" string="New Quote"
                            class="btn-primary" invisible="is_closed or quotation_count"
                            groups="modern_crm.group_modern_crm_quote_create"/>
                    <button name="action_new_quote" type="object" string="New Quote"
                            invisible="is_closed or not quotation_count"
                            groups="modern_crm.group_modern_crm_quote_create"/>
                    <button name="action_confirm_sale" type="object" string="Confirm Sale"
                            class="btn-primary" invisible="is_lost or not quotation_count"
                            groups="modern_crm.group_modern_crm_sale_order"
                            confirm="Confirm the primary quote as a sales order?"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            class="btn-primary" invisible="not can_invoice"
                            groups="modern_crm.group_modern_crm_invoice"/>
                    <button name="action_set_won" type="object" string="Closed Won"
                            invisible="is_closed"/>
                    <button name="action_set_lost" type="object" string="Closed Lost"
                            invisible="is_closed"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="not is_closed"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1', 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_quotations" type="object" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="not quotation_count">
                            <field name="quotation_count" widget="statinfo" string="Quotes"/>
                        </button>
                        <button name="action_view_sale_orders" type="object" class="oe_stat_button"
                                icon="fa-dollar" invisible="not sale_order_count">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="sale_amount_total" widget="monetary"/></span>
                                <span class="o_stat_text">Orders</span>
                            </div>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button"
                                icon="fa-file-text-o" invisible="not invoice_count"
                                groups="account.group_account_invoice">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Won" bg_color="text-bg-success" invisible="not is_won"/>
                    <widget name="web_ribbon" title="Lost" bg_color="text-bg-danger" invisible="not is_lost"/>
                    <field name="is_won" invisible="1"/>
                    <field name="is_lost" invisible="1"/>
                    <field name="is_closed" invisible="1"/>
                    <field name="can_invoice" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. 50 seats of the yearly plan"/></h1>
                    </div>
                    <div class="alert alert-info mb-3" role="status" invisible="is_closed or not stage_guidance">
                        <strong>Guidance for Success</strong>
                        <field name="stage_guidance" readonly="1"/>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'default_is_company': True}"/>
                            <field name="contact_id" context="{'default_parent_id': partner_id}"/>
                            <field name="amount" readonly="line_ids"/>
                            <field name="probability"/>
                            <field name="expected_revenue"/>
                            <field name="close_date" options="{'numeric': True}"/>
                            <field name="next_step" placeholder="e.g. Demo with their IT team on Friday"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="team_id"/>
                            <field name="type_id"/>
                            <field name="forecast_category_id"/>
                            <field name="lead_source_id"/>
                            <field name="primary_quote_id" invisible="not order_ids"
                                   options="{'no_create': True}"/>
                            <field name="order_ids" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group invisible="not is_lost">
                        <group>
                            <field name="lost_reason_id"/>
                            <field name="lost_note"/>
                        </group>
                        <group>
                            <field name="date_closed" options="{'numeric': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Products" name="products">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="id" optional="hide"/>
                                    <field name="product_id"/>
                                    <field name="name" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" optional="show" groups="uom.group_uom"/>
                                    <field name="price_unit"/>
                                    <field name="discount" optional="show"/>
                                    <field name="price_subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="company_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Contact Roles" name="contact_roles">
                            <field name="contact_role_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="id" optional="hide"/>
                                    <field name="partner_id" context="{'default_parent_id': parent.partner_id}"/>
                                    <field name="role_id"/>
                                    <field name="email" optional="show"/>
                                    <field name="phone" optional="show"/>
                                    <field name="is_primary"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="The customer's situation, what they need and why they will buy..."/>
                        </page>
                        <page string="Marketing" name="marketing">
                            <group>
                                <group>
                                    <field name="campaign_id"/>
                                    <field name="medium_id"/>
                                    <field name="source_id"/>
                                    <field name="lead_id" invisible="not lead_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="modern_crm_opportunity_view_search" model="ir.ui.view">
        <field name="name">modern.crm.opportunity.search</field>
        <field name="model">modern.crm.opportunity</field>
        <field name="arch" type="xml">
            <search string="Opportunities">
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'child_of', self)]"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <field name="team_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <filter name="my_opportunities" string="My Opportunities" domain="[('user_id', '=', uid)]"/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id', '=', False)]"/>
                <separator/>
                <filter name="open" string="Open" domain="[('is_closed', '=', False)]"/>
                <filter name="won" string="Won" domain="[('is_won', '=', True)]"/>
                <filter name="lost" string="Lost" domain="[('is_lost', '=', True)]"/>
                <separator/>
                <filter name="close_date" string="Close Date" date="close_date"/>
                <filter name="create_date" string="Created On" date="create_date"/>
                <separator/>
                <filter name="activities_overdue" string="Late Activities"
                        domain="[('my_activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group>
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_user" string="Opportunity Owner" context="{'group_by': 'user_id'}"/>
                    <filter name="group_team" string="Sales Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_partner" string="Account" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_forecast" string="Forecast Category" context="{'group_by': 'forecast_category_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_close_date" string="Close Date" context="{'group_by': 'close_date:month'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="modern_crm_opportunity_view_pivot" model="ir.ui.view">
        <field name="name">modern.crm.opportunity.pivot</field>
        <field name="model">modern.crm.opportunity</field>
        <field name="arch" type="xml">
            <pivot string="Pipeline" sample="1">
                <field name="stage_id" type="row"/>
                <field name="close_date" interval="month" type="col"/>
                <field name="amount" type="measure"/>
                <field name="expected_revenue" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="modern_crm_opportunity_view_graph" model="ir.ui.view">
        <field name="name">modern.crm.opportunity.graph</field>
        <field name="model">modern.crm.opportunity</field>
        <field name="arch" type="xml">
            <graph string="Pipeline" type="bar" stacked="1" sample="1">
                <field name="close_date" interval="month"/>
                <field name="forecast_category_id"/>
                <field name="expected_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="modern_crm_opportunity_view_calendar" model="ir.ui.view">
        <field name="name">modern.crm.opportunity.calendar</field>
        <field name="model">modern.crm.opportunity</field>
        <field name="arch" type="xml">
            <calendar string="Close Dates" date_start="close_date" color="user_id" mode="month" quick_create="0">
                <field name="partner_id"/>
                <field name="amount"/>
            </calendar>
        </field>
    </record>

    <record id="modern_crm_opportunity_action" model="ir.actions.act_window">
        <field name="name">Pipeline</field>
        <field name="res_model">modern.crm.opportunity</field>
        <field name="view_mode">kanban,list,form,calendar,pivot,graph,activity</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first opportunity</p>
            <p>Opportunities are deals you are working on: move them through the stages, add the products,
                send a quote, confirm the sale and close them won.</p>
        </field>
    </record>

    <record id="modern_crm_opportunity_action_my" model="ir.actions.act_window">
        <field name="name">My Opportunities</field>
        <field name="res_model">modern.crm.opportunity</field>
        <field name="view_mode">list,kanban,form,calendar,activity</field>
        <field name="context">{'search_default_my_opportunities': 1, 'search_default_open': 1}</field>
    </record>

    <record id="modern_crm_opportunity_action_analysis" model="ir.actions.act_window">
        <field name="name">Pipeline Analysis</field>
        <field name="res_model">modern.crm.opportunity</field>
        <field name="view_mode">graph,pivot,list</field>
    </record>
</odoo>
