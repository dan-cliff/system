<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Option lists under CRM > Configuration (CLAUDE.md > Choice fields). -->

    <record id="modern_crm_lead_source_view_list" model="ir.ui.view">
        <field name="name">modern.crm.lead.source.list</field>
        <field name="model">modern.crm.lead.source</field>
        <field name="arch" type="xml">
            <list string="Lead Sources" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="modern_crm_lead_source_view_form" model="ir.ui.view">
        <field name="name">modern.crm.lead.source.form</field>
        <field name="model">modern.crm.lead.source</field>
        <field name="arch" type="xml">
            <form string="Lead Source">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="sequence"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="modern_crm_lead_source_view_search" model="ir.ui.view">
        <field name="name">modern.crm.lead.source.search</field>
        <field name="model">modern.crm.lead.source</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>
    <record id="modern_crm_lead_source_action" model="ir.actions.act_window">
        <field name="name">Lead Sources</field>
        <field name="res_model">modern.crm.lead.source</field>
        <field name="view_mode">list,form</field>
    </record>

