<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Web-to-Lead -->
    <template id="web_to_lead_form" name="CRM: Web-to-Lead Form">
        <t t-call="web.frontend_layout">
            <div class="container py-5" style="max-width: 720px;">
                <h2>Contact Us</h2>
                <p class="text-muted">Tell us a little about yourself and what you are looking for, and we will be in touch.</p>
                <form action="/crm/web-to-lead" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="first_name">First Name</label>
                            <input type="text" class="form-control" name="first_name" id="first_name" t-att-value="post.get('first_name')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="last_name">Last Name *</label>
                            <input type="text" t-attf-class="form-control #{'is-invalid' if errors.get('last_name') else ''}"
                                   name="last_name" id="last_name" required="required" t-att-value="post.get('last_name')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="email">Email *</label>
                            <input type="email" t-attf-class="form-control #{'is-invalid' if errors.get('email') else ''}"
                                   name="email" id="email" required="required" t-att-value="post.get('email')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="phone">Phone</label>
                            <input type="tel" class="form-control" name="phone" id="phone" t-att-value="post.get('phone')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="company_name">Company</label>
                            <input type="text" class="form-control" name="company_name" id="company_name" t-att-value="post.get('company_name')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="job_title">Job Title</label>
                            <input type="text" class="form-control" name="job_title" id="job_title" t-att-value="post.get('job_title')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="city">City</label>
                            <input type="text" class="form-control" name="city" id="city" t-att-value="post.get('city')"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="description">How can we help?</label>
                            <textarea class="form-control" name="description" id="description" rows="4" t-out="post.get('description')"/>
                        </div>
                        <!-- left empty by people, filled in by bots -->
                        <div class="d-none" aria-hidden="true">
                            <input type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Send</button>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="web_to_lead_thanks" name="CRM: Web-to-Lead Thanks">
        <t t-call="web.frontend_layout">
            <div class="container py-5 text-center">
                <h2>Thank you</h2>
                <p class="text-muted">We have your details and will be in touch soon.</p>
            </div>
        </t>
    </template>
</odoo>
