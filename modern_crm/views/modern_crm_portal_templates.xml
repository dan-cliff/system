<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Contract signing page: each signer opens it from their own link. -->
    <template id="contract_sign_page" name="CRM: Sign Contract">
        <t t-call="web.frontend_layout">
            <t t-set="title" t-value="contract.title"/>
            <div class="container o_modern_crm_sign py-4">
                <div t-if="message == 'signed'" class="alert alert-success" role="status">
                    Thank you, <t t-out="signer.signed_by"/>: your signature has been recorded.
                    <t t-if="contract.state in ('signed', 'activated')">Everyone has now signed; a signed copy is on its way to you.</t>
                    <t t-else="">We will send you the signed copy once everyone has signed.</t>
                </div>
                <div t-if="message == 'declined'" class="alert alert-warning" role="status">
                    You declined to sign this contract. We have let <t t-out="contract.user_id.name or contract.company_id.name"/> know.
                </div>
                <div t-if="contract.state == 'cancelled' or (signer.state == 'cancelled' and not message)" class="alert alert-secondary" role="status">
                    This signature request was withdrawn. Contact <t t-out="contract.user_id.name or contract.company_id.name"/> if you have any questions.
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <div class="text-muted small" t-out="company.name"/>
                        <h2 class="mb-0" t-out="contract.title"/>
                        <div class="text-muted" t-out="contract.name"/>
                    </div>
                    <a class="btn btn-secondary" t-attf-href="/crm/contract/sign/#{signer.id}/#{token}/pdf" target="_blank">
                        <i class="fa fa-download me-1"/> Download PDF
                    </a>
                </div>

                <div class="card mb-4">
                    <div class="card-body o_modern_crm_contract_body">
                        <div class="row mb-3 small">
                            <div class="col-auto me-3">
                                <strong>Customer</strong>
                                <div t-out="contract.partner_id.commercial_partner_id.name"/>
                            </div>
                            <div class="col-auto me-3">
                                <strong>Start Date</strong>
                                <div t-out="contract.start_date.strftime('%d/%m/%Y') if contract.start_date else ''"/>
                            </div>
                            <div class="col-auto me-3" t-if="contract.end_date">
                                <strong>End Date</strong>
                                <div t-out="contract.end_date.strftime('%d/%m/%Y')"/>
                            </div>
                        </div>
                        <div t-out="contract.body"/>
                        <div t-if="contract.special_terms" class="mt-3">
                            <h4>Special Terms</h4>
                            <p class="text-break" style="white-space: pre-wrap;" t-out="contract.special_terms"/>
                        </div>
                    </div>
                </div>

                <h4>Signatures</h4>
                <ul class="list-group mb-4">
                    <li t-foreach="contract.signer_ids" t-as="s" class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <strong t-out="s.signed_by or s.partner_id.name"/>
                            <span t-if="s.role" class="text-muted"> - <t t-out="s.role"/></span>
                            <div t-if="s.signed_on" class="small text-muted">Signed <t t-out="s._format_signed_on()"/></div>
                        </div>
                        <span t-if="s.state == 'signed'" class="badge text-bg-success">Signed</span>
                        <span t-elif="s.state == 'declined'" class="badge text-bg-danger">Declined</span>
                        <span t-elif="s.state == 'sent'" class="badge text-bg-info">Awaiting signature</span>
                        <span t-elif="s.state == 'waiting'" class="badge text-bg-light">Waiting</span>
                    </li>
                </ul>

                <div t-if="can_sign" class="row g-4">
                    <div class="col-lg-7">
                        <div class="card">
                            <div class="card-body">
                                <h4>Sign</h4>
                                <p class="text-muted">Type your full name and draw or adopt your signature. By signing you
                                    accept the contract above.</p>
                                <t t-call="portal.signature_form">
                                    <t t-set="call_url" t-value="'/crm/contract/sign/%s/%s/accept' % (signer.id, token)"/>
                                    <t t-set="default_name" t-value="signer.partner_id.name"/>
                                    <t t-set="send_label">Sign Contract</t>
                                </t>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5">
                        <div class="card">
                            <div class="card-body">
                                <h4>Decline</h4>
                                <form t-attf-action="/crm/contract/sign/#{signer.id}/#{token}/decline" method="post">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <textarea name="decline_reason" class="form-control mb-2" rows="3"
                                              placeholder="Tell us why, or what you would like changed"/>
                                    <button type="submit" class="btn btn-outline-danger">Decline to Sign</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
                <div t-elif="signer.state in ('waiting', 'sent') and contract.state == 'out_for_signature'" class="alert alert-info" role="status">
                    Someone else signs before you: we will email you when it is your turn.
                </div>
            </div>
        </t>
    </template>

    <template id="contract_sign_invalid" name="CRM: Invalid Signing Link">
        <t t-call="web.frontend_layout">
            <div class="container py-5 text-center">
                <h2>This signing link is not valid</h2>
                <p class="text-muted">It may have been replaced by a newer request. Use the link in the latest
                    email you received, or contact the sender.</p>
            </div>
        </t>
    </template>

    <!-- Web-to-Lead -->
    <template id="web_to_lead_form" name="CRM: Web-to-Lead Form">
        <t t-call="web.frontend_layout">
            <div class="container py-5" style="max-width: 720px;">
                <h2>Contact Us</h2>
                <p class="text-muted">Tell us a little about yourself and what you are looking for, and we will be in touch.</p>
                <form action="/crm/web-to-lead" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="first_name">First Name</label>
                            <input type="text" class="form-control" name="first_name" id="first_name" t-att-value="post.get('first_name')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="last_name">Last Name *</label>
                            <input type="text" t-attf-class="form-control #{'is-invalid' if errors.get('last_name') else ''}"
                                   name="last_name" id="last_name" required="required" t-att-value="post.get('last_name')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="email">Email *</label>
                            <input type="email" t-attf-class="form-control #{'is-invalid' if errors.get('email') else ''}"
                                   name="email" id="email" required="required" t-att-value="post.get('email')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="phone">Phone</label>
                            <input type="tel" class="form-control" name="phone" id="phone" t-att-value="post.get('phone')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="company_name">Company</label>
                            <input type="text" class="form-control" name="company_name" id="company_name" t-att-value="post.get('company_name')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="job_title">Job Title</label>
                            <input type="text" class="form-control" name="job_title" id="job_title" t-att-value="post.get('job_title')"/>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="city">City</label>
                            <input type="text" class="form-control" name="city" id="city" t-att-value="post.get('city')"/>
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="description">How can we help?</label>
                            <textarea class="form-control" name="description" id="description" rows="4" t-out="post.get('description')"/>
                        </div>
                        <!-- left empty by people, filled in by bots -->
                        <div class="d-none" aria-hidden="true">
                            <input type="text" name="website_url" tabindex="-1" autocomplete="off"/>
                        </div>
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Send</button>
                        </div>
                    </div>
                </form>
            </div>
        </t>
    </template>

    <template id="web_to_lead_thanks" name="CRM: Web-to-Lead Thanks">
        <t t-call="web.frontend_layout">
            <div class="container py-5 text-center">
                <h2>Thank you</h2>
                <p class="text-muted">We have your details and will be in touch soon.</p>
            </div>
        </t>
    </template>
</odoo>
