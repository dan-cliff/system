<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="modern_crm_contract_template_view_list" model="ir.ui.view">
        <field name="name">modern.crm.contract.template.list</field>
        <field name="model">modern.crm.contract.template</field>
        <field name="arch" type="xml">
            <list string="Contract Templates">
                <field name="sequence" widget="handle"/>
                <field name="id" optional="show"/>
                <field name="name"/>
                <field name="term_months"/>
                <field name="countersigner_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="modern_crm_contract_template_view_form" model="ir.ui.view">
        <field name="name">modern.crm.contract.template.form</field>
        <field name="model">modern.crm.contract.template</field>
        <field name="arch" type="xml">
            <form string="Contract Template">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Sales Agreement"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="term_months"/>
                            <field name="countersigner_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Text" name="body">
                            <div class="alert alert-info" role="status">
                                Type <strong>/</strong> and pick <em>Dynamic Placeholder</em> to fill in details of
                                the contract, its account, opportunity or quote (for example the account name or the
                                start date). They are filled in when a contract is created from this template.
                            </div>
                            <field name="render_model" invisible="1"/>
                            <field name="body" class="oe-bordered-editor"
                                   options="{'codeview': true, 'dynamic_placeholder': true, 'dynamic_placeholder_model_reference_field': 'render_model'}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="modern_crm_contract_template_action" model="ir.actions.act_window">
        <field name="name">Contract Templates</field>
        <field name="res_model">modern.crm.contract.template</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
