        <field name="comment">Technical: given by every CRM permission. Opens the app; what users can do with leads and opportunities comes from their permissions. Gives Contact Creation, as salespeople create accounts and contacts (e.g. converting leads).</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('base.group_partner_manager'))]"/>
