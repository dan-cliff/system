<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Access model (see CLAUDE.md > Permissions). Generated: every permission
         below is its own privilege with one "Allowed" group, whose record rules
         give it its meaning. All of them imply the technical CRM user group, which
         holds the ACLs and a deny rule per operation, so users can only do what a
         permission opens. Opportunity products and contact roles follow their
         opportunity (editing the opportunity includes removing them). "Own" =
         created by them or owned by them (Lead / Opportunity Owner). Workflow
         actions (quotes, sales orders, invoices) each have their own privilege,
         checked in code. Stages and the Configuration lists: read for every CRM
         user, full for Administrators. -->
    <data noupdate="1">
        <record id="module_category_modern_crm" model="ir.module.category">
            <field name="name">CRM</field>
            <field name="description">Leads, opportunities, quotes and sales.</field>
            <field name="sequence">6</field>
        </record>
    </data>

