        <record id="role_onsite_manager" model="permission.role">
            <field name="name">On Site – Manager</field>
            <field name="description">Create, view and edit their own and their team&apos;s attendances, kiosks and alerts, and sign in from Odoo. No deleting.</field>
            <field name="line_ids" eval="[
                (0, 0, {'privilege_id': ref('advanced_attendance.privilege_attendance_edit_team'), 'group_id': ref('advanced_attendance.group_attendance_edit_team')}),
                (0, 0, {'privilege_id': ref('advanced_attendance.privilege_kiosk_edit_team'), 'group_id': ref('advanced_attendance.group_kiosk_edit_team')}),
                (0, 0, {'privilege_id': ref('advanced_attendance.privilege_alert_edit_team'), 'group_id': ref('advanced_attendance.group_alert_edit_team')}),
                (0, 0, {'privilege_id': ref('advanced_attendance.privilege_attendance_systray'), 'group_id': ref('advanced_attendance.group_onsite_systray')})
            ]"/>
        </record>
        <record id="role_onsite_employee" model="permission.role">
            <field name="name">On Site – Employee</field>
            <field name="description">Create, view and edit their own attendances, kiosks and alerts, and sign in from Odoo. No deleting.</field>
            <field name="line_ids" eval="[
                (0, 0, {'privilege_id': ref('advanced_attendance.privilege_attendance_edit_own'), 'group_id': ref('advanced_attendance.group_attendance_edit_own')}),
