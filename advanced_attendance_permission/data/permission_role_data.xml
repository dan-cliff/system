        <record id="role_onsite_approver" model="permission.role">
            <field name="name">On Site – Extra Hours Approver</field>
            <field name="description">Approve or refuse the extra hours of the attendances they can see (give it with Manager when extra hours are approved by a manager).</field>
            <field name="line_ids" eval="[
                (0, 0, {'privilege_id': ref('advanced_attendance.privilege_attendance_approve'), 'group_id': ref('advanced_attendance.group_attendance_approve')})
            ]"/>
        </record>
        <record id="role_onsite_warden" model="permission.role">
            <field name="name">On Site – Evacuation Warden</field>
            <field name="description">See everyone on site and sign them out by hand from the On Site Now board, e.g. during an evacuation roll call.</field>
            <field name="line_ids" eval="[
                (0, 0, {'privilege_id': ref('advanced_attendance.privilege_attendance_view_all'), 'group_id': ref('advanced_attendance.group_attendance_view_all')}),
                (0, 0, {'privilege_id': ref('advanced_attendance.privilege_attendance_manual_sign_out'), 'group_id': ref('advanced_attendance.group_attendance_manual_sign_out')})
            ]"/>
