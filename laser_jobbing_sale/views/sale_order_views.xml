<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form.laser_jobbing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <button name="action_laser_personalise" type="object" string="Personalise"
                        groups="laser_jobbing.group_laser_user"
                        invisible="not laser_jobs_missing or state not in ('draft', 'sent')"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_laser_jobs" type="object" class="oe_stat_button" icon="fa-bolt"
                        groups="laser_jobbing.group_laser_user" invisible="not laser_job_count">
                    <field name="laser_job_count" widget="statinfo" string="Laser Jobs"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='product_uom_qty']" position="before">
                <field name="laser_template_id" column_invisible="1"/>
                <field name="laser_job_id" optional="show" readonly="1"
                       groups="laser_jobbing.group_laser_user" invisible="not laser_template_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']" position="after">
                <field name="laser_jobs_missing" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
