<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_laser_job_form" model="ir.ui.view">
        <field name="name">laser.job.form.sale</field>
        <field name="model">laser.job</field>
        <field name="inherit_id" ref="laser_jobbing.view_laser_job_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-dollar"
                        groups="sales_team.group_sale_salesman" invisible="not sale_order_id">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Sales Order</span>
                        <field name="sale_order_id" class="o_stat_value" readonly="1" options="{'no_open': True}"/>
                    </div>
                </button>
            </div>
        </field>
    </record>

    <record id="view_laser_job_search" model="ir.ui.view">
        <field name="name">laser.job.search.sale</field>
        <field name="model">laser.job</field>
        <field name="inherit_id" ref="laser_jobbing.view_laser_job_search"/>
        <field name="arch" type="xml">
            <field name="origin" position="after">
                <field name="sale_order_id" groups="sales_team.group_sale_salesman"/>
            </field>
        </field>
    </record>
</odoo>
