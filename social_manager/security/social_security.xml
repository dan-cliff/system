<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_social_manager" model="ir.module.category">
        <field name="name">Social Manager</field>
        <field name="sequence">40</field>
    </record>
    <!-- The per Platform / Page permissions (created by code, see social_access.py) live here. -->
    <record id="module_category_social_manager_access" model="ir.module.category">
        <field name="name">Social Manager - Platforms and Pages</field>
        <field name="sequence">41</field>
    </record>

    <record id="privilege_social_manager" model="res.groups.privilege">
        <field name="name">Social Manager</field>
        <field name="category_id" ref="module_category_social_manager"/>
        <field name="sequence">10</field>
    </record>
    <record id="group_social_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="privilege_social_manager"/>
        <field name="comment">Opens Social Manager and sees the Platforms and Pages / Channels they hold a permission on. Every Platform / Page permission includes this.</field>
    </record>
    <record id="group_social_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_social_manager"/>
        <field name="comment">Full access to every Platform and Page / Channel, connects accounts and manages the configuration.</field>
        <field name="implied_ids" eval="[(4, ref('group_social_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Users only see the Platforms / Pages they hold a permission on (and their posts). -->
    <record id="rule_social_platform_user" model="ir.rule">
        <field name="name">Social Platform: platforms with a permission</field>
        <field name="model_id" ref="model_social_platform"/>
        <field name="domain_force">['|', '|', '|', '|', '|',
            ('group_draft_id', 'in', user.all_group_ids.ids),
            ('group_publish_id', 'in', user.all_group_ids.ids),
            ('group_approve_id', 'in', user.all_group_ids.ids),
            ('group_moderate_id', 'in', user.all_group_ids.ids),
            ('group_delete_id', 'in', user.all_group_ids.ids),
            ('channel_ids.access_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_social_user'))]"/>
    </record>
    <record id="rule_social_channel_user" model="ir.rule">
        <field name="name">Social Page / Channel: pages with a permission</field>
        <field name="model_id" ref="model_social_channel"/>
        <field name="domain_force">[('access_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_social_user'))]"/>
    </record>
    <record id="rule_social_account_user" model="ir.rule">
        <field name="name">Social Account: accounts of pages with a permission</field>
        <field name="model_id" ref="model_social_account"/>
        <field name="domain_force">[('channel_ids.access_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_social_user'))]"/>
    </record>
    <record id="rule_social_post_user" model="ir.rule">
        <field name="name">Social Post: posts on pages with a permission</field>
        <field name="model_id" ref="model_social_post"/>
        <field name="domain_force">['|', ('channel_ids', '=', False), ('channel_ids.access_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_social_user'))]"/>
    </record>
    <record id="rule_social_publication_user" model="ir.rule">
        <field name="name">Social Publication: pages with a permission</field>
        <field name="model_id" ref="model_social_post_publication"/>
        <field name="domain_force">[('channel_id.access_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_social_user'))]"/>
    </record>
    <record id="rule_social_comment_user" model="ir.rule">
        <field name="name">Social Comment: pages with a permission</field>
        <field name="model_id" ref="model_social_comment"/>
        <field name="domain_force">[('channel_id.access_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_social_user'))]"/>
    </record>
    <record id="rule_social_income_user" model="ir.rule">
        <field name="name">Social Income: pages with a permission</field>
        <field name="model_id" ref="model_social_income"/>
        <field name="domain_force">[('channel_id.access_group_ids', 'in', user.all_group_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('group_social_user'))]"/>
    </record>

    <!-- Administrators see everything (within their companies). -->
    <record id="rule_social_platform_manager" model="ir.rule">
        <field name="name">Social Platform: administrators</field>
        <field name="model_id" ref="model_social_platform"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_social_manager'))]"/>
    </record>
    <record id="rule_social_channel_manager" model="ir.rule">
        <field name="name">Social Page / Channel: administrators</field>
        <field name="model_id" ref="model_social_channel"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_social_manager'))]"/>
    </record>
    <record id="rule_social_account_manager" model="ir.rule">
        <field name="name">Social Account: administrators</field>
        <field name="model_id" ref="model_social_account"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_social_manager'))]"/>
    </record>
    <record id="rule_social_post_manager" model="ir.rule">
        <field name="name">Social Post: administrators</field>
        <field name="model_id" ref="model_social_post"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_social_manager'))]"/>
    </record>
    <record id="rule_social_publication_manager" model="ir.rule">
        <field name="name">Social Publication: administrators</field>
        <field name="model_id" ref="model_social_post_publication"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_social_manager'))]"/>
    </record>
    <record id="rule_social_comment_manager" model="ir.rule">
        <field name="name">Social Comment: administrators</field>
        <field name="model_id" ref="model_social_comment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_social_manager'))]"/>
    </record>
    <record id="rule_social_income_manager" model="ir.rule">
        <field name="name">Social Income: administrators</field>
        <field name="model_id" ref="model_social_income"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_social_manager'))]"/>
    </record>

    <!-- Multi-company -->
    <record id="rule_social_platform_company" model="ir.rule">
        <field name="name">Social Platform: multi-company</field>
        <field name="model_id" ref="model_social_platform"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_social_account_company" model="ir.rule">
        <field name="name">Social Account: multi-company</field>
        <field name="model_id" ref="model_social_account"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_social_channel_company" model="ir.rule">
        <field name="name">Social Page / Channel: multi-company</field>
        <field name="model_id" ref="model_social_channel"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_social_post_company" model="ir.rule">
        <field name="name">Social Post: multi-company</field>
        <field name="model_id" ref="model_social_post"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_social_publication_company" model="ir.rule">
        <field name="name">Social Publication: multi-company</field>
        <field name="model_id" ref="model_social_post_publication"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_social_comment_company" model="ir.rule">
        <field name="name">Social Comment: multi-company</field>
        <field name="model_id" ref="model_social_comment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_social_income_company" model="ir.rule">
        <field name="name">Social Income: multi-company</field>
        <field name="model_id" ref="model_social_income"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_social_invoice_company" model="ir.rule">
        <field name="name">Social Monetisation Invoice: multi-company</field>
        <field name="model_id" ref="model_social_invoice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_social_event_company" model="ir.rule">
        <field name="name">Special Event / Release: multi-company</field>
        <field name="model_id" ref="model_social_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
