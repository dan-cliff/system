<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_comment_reply_wizard_form" model="ir.ui.view">
        <field name="name">social.comment.reply.wizard.form</field>
        <field name="model">social.comment.reply.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="author_name"/>
                    <field name="comment_message"/>
                    <field name="comment_id" invisible="1"/>
                    <field name="message" placeholder="Write your reply..."/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Send Reply" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
