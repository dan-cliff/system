<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_invoice_wizard_form" model="ir.ui.view">
        <field name="name">social.invoice.wizard.form</field>
        <field name="model">social.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert" invisible="integrate_accounts">
                    Turn on "Integrate to Accounts" in Settings > Social Manager to create invoices.
                </div>
                <p class="text-muted">
                    One invoice is created per Platform for its income not yet invoiced in the date range,
                    with a line per Page / Channel.
                </p>
                <group>
                    <field name="date_from" options="{'numeric': True}"/>
                    <field name="date_to" options="{'numeric': True}"/>
                    <field name="platform_ids" widget="many2many_tags"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="integrate_accounts" invisible="1"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Create Invoices" class="btn-primary"
                            invisible="not integrate_accounts"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_social_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Create Monetisation Invoices</field>
        <field name="res_model">social.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
