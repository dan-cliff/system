<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_social_account_list" model="ir.ui.view">
        <field name="name">social.account.list</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name"/>
                <field name="platform_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="channel_count" string="Pages / Channels"/>
                <field name="connected_date" options="{'numeric': True}"/>
                <field name="token_expiry" options="{'numeric': True}" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'connected'"
                       decoration-warning="state == 'expired'" decoration-danger="state == 'error'"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_social_account_form" model="ir.ui.view">
        <field name="name">social.account.form</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_sync_channels" type="object" string="Import Pages / Channels"
                            class="btn-primary" groups="social_manager.group_social_manager"/>
                    <button name="action_reconnect" type="object" string="Reconnect"
                            groups="social_manager.group_social_manager"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_channels" type="object" class="oe_stat_button" icon="fa-bullhorn">
                            <field name="channel_count" widget="statinfo" string="Pages / Channels"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="platform_id"/>
                            <field name="external_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="connected_date" options="{'numeric': True}"/>
                            <field name="token_expiry" options="{'numeric': True}"/>
                            <field name="granted_scopes"/>
                        </group>
                    </group>
                    <div class="alert alert-danger" role="alert" invisible="not last_error">
                        <field name="last_error"/>
                    </div>
                    <field name="channel_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="external_username"/>
                            <field name="follower_count"/>
                            <field name="connection_state"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_social_account_search" model="ir.ui.view">
        <field name="name">social.account.search</field>
        <field name="model">social.account</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="platform_id"/>
                <filter name="needs_attention" string="Needs Attention" domain="[('state', '!=', 'connected')]"/>
                <group>
                    <filter name="group_platform" string="Platform" context="{'group_by': 'platform_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_social_account" model="ir.actions.act_window">
        <field name="name">Connected Accounts</field>
        <field name="res_model">social.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No accounts connected yet</p>
            <p>Open a Platform and use Connect an Account to sign in with OAuth.</p>
        </field>
    </record>
</odoo>
