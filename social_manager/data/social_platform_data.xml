<?xml version="1.0" encoding="utf-8"?>
<!-- The six supported platforms. Their OAuth endpoints and scopes are filled in from the
     integration's defaults when created; the Client ID / Secret are entered on each Platform. -->
<odoo noupdate="1">
    <record id="platform_facebook" model="social.platform">
        <field name="name">Facebook</field>
        <field name="code">facebook</field>
        <field name="sequence">10</field>
        <field name="color">4</field>
    </record>
    <record id="platform_twitter" model="social.platform">
        <field name="name">X (Twitter)</field>
        <field name="code">twitter</field>
        <field name="sequence">20</field>
        <field name="color">0</field>
    </record>
    <record id="platform_linkedin" model="social.platform">
        <field name="name">LinkedIn</field>
        <field name="code">linkedin</field>
        <field name="sequence">30</field>
        <field name="color">8</field>
    </record>
    <record id="platform_instagram" model="social.platform">
        <field name="name">Instagram</field>
        <field name="code">instagram</field>
        <field name="sequence">40</field>
        <field name="color">9</field>
    </record>
    <record id="platform_tiktok" model="social.platform">
        <field name="name">TikTok</field>
        <field name="code">tiktok</field>
        <field name="sequence">50</field>
        <field name="color">1</field>
    </record>
    <record id="platform_youtube" model="social.platform">
        <field name="name">YouTube</field>
        <field name="code">youtube</field>
        <field name="sequence">60</field>
        <field name="color">1</field>
    </record>
</odoo>
