<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Per-model access levels are in access_levels.xml (generated from access_levels.py). -->

    <!-- Confidential Bypass: can view all confidential incident records regardless of access list -->
    <record id="group_incident_confidential_bypass" model="res.groups">
        <field name="name">Confidential Bypass</field>
        <field name="privilege_id" ref="privilege_incident_report"/>
        <field name="sequence">60</field>
        <field name="comment">Can view all confidential incident reports regardless of the per-record access list. Included in the Administrator role.</field>
        <field name="implied_ids" eval="[(4, ref('group_incident_report_view'))]"/>
    </record>

    <!--
        Confidentiality rule — applies to everyone (global, so it narrows the access level
        rules rather than widening them). A confidential record is only visible to:
          * the original reporter
          * the responsible manager
          * any user explicitly listed in confidential_user_ids
          * users with Confidential Bypass
        Non-confidential records are always visible.
    -->
    <record id="rule_incident_report_confidential" model="ir.rule">
        <field name="name">Incident: Confidentiality Filter</field>
        <field name="model_id" ref="model_incident_report"/>
        <field name="domain_force">(
            [(1, '=', 1)] if user.has_group('incident_management.group_incident_confidential_bypass') else
            ['|', '|', '|',
                ('is_confidential', '=', False),
                ('reporter_id', '=', user.id),
                ('responsible_manager_id', '=', user.id),
                ('confidential_user_ids', 'in', [user.id])
            ]
        )</field>
        <!-- Clears the group this rule used to be limited to, making it global. -->
        <field name="groups" eval="[(5, 0, 0)]"/>
        <field name="perm_read"   eval="True"/>
        <field name="perm_write"  eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
