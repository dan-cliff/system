        <!-- ═══════════════════════════════════════════════════════════════════
             SELECTION SUMMARY
             ═══════════════════════════════════════════════════════════════════ -->
        <div class="o_body_parts_summary" style="flex:1;min-width:160px;">
            <div class="fw-semibold mb-1 small text-muted">Selected body parts:</div>
            <t t-if="selectedParts.length === 0">
                <div class="text-muted fst-italic small">
                    Click body regions on the diagram to select them.
                </div>
            </t>
            <t t-else="">
                <div class="d-flex flex-wrap gap-1">
                    <t t-foreach="selectedParts" t-as="part" t-key="part.code">
                        <span class="badge rounded-pill bg-primary d-inline-flex align-items-center gap-1"
                              style="font-size:0.75rem;padding:4px 8px;">
                            <t t-esc="part.label"/>
                            <t t-if="!props.readonly">
                                <button type="button"
                                        class="btn-close btn-close-white"
                                        style="font-size:0.55rem;margin-left:2px;"
                                        t-on-click="() => this.removeTag(part.code)"/>
                            </t>
                        </span>
                    </t>
                </div>
            </t>
            <t t-if="!props.readonly">
                <div class="mt-2 small text-muted">
                    <i class="fa fa-info-circle me-1"/>
                    Selections persist across Front / Back toggle.
                </div>
            </t>
        </div>

