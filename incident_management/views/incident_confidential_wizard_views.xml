<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_incident_confidential_wizard_form" model="ir.ui.view">
        <field name="name">incident.confidential.wizard.form</field>
        <field name="model">incident.confidential.wizard</field>
        <field name="arch" type="xml">
            <form string="Manage Confidential Access">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <i class="fa fa-lock me-2 text-danger"/>
                            Confidential Access
                        </h1>
                        <h4 class="text-muted">
                            <field name="incident_name" readonly="1"/>
                        </h4>
                    </div>

                    <div class="alert alert-warning mb-3" role="alert">
                        <i class="fa fa-exclamation-triangle me-2"/>
                        This incident is marked <strong>Confidential</strong>. Only the
                        users listed below (plus the original reporter, the responsible
                        manager, and anyone with the <em>Confidential Bypass</em>
                        permission) will be able to view or edit this record.
                    </div>

                    <group string="Authorised Users">
                        <field name="incident_id" invisible="1"/>
                        <field name="user_ids"
                               widget="many2many_tags"
                               options="{'no_create': True, 'color_field': 'color'}"
                               placeholder="Add users who can view this record…"
                               nolabel="1" colspan="2"/>
                    </group>

                    <div class="text-muted small mt-2">
                        <i class="fa fa-info-circle me-1"/>
                        Changes take effect immediately and are logged in the incident
                        chatter. The reporter and responsible manager always have access
                        and do not need to be added here.
                    </div>
                </sheet>
                <footer>
                    <button string="Save Access List" type="object"
                            name="action_save" class="btn-primary"/>
                    <button string="Discard" type="object"
                            name="action_discard" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
