<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Root Application Menu ──────────────────────────────────────────── -->
    <menuitem id="menu_incident_root"
              name="Incidents"
              web_icon="incident_management,static/description/icon.png"
              sequence="75"/>

    <!-- ── Reporting Menu ─────────────────────────────────────────────────── -->
    <menuitem id="menu_incident_reporting"
              name="Reporting"
              parent="menu_incident_root"
              sequence="10"/>

    <menuitem id="menu_incident_my"
              name="My Incidents"
              parent="menu_incident_reporting"
              action="action_incident_report_my"
              sequence="10"/>

    <menuitem id="menu_incident_all"
              name="All Incidents"
              parent="menu_incident_reporting"
              action="action_incident_report_all"
              sequence="20"
              groups="incident_management.group_incident_manager"/>

    <!-- ── Management Menu ────────────────────────────────────────────────── -->
    <menuitem id="menu_incident_management"
              name="Management"
              parent="menu_incident_root"
              sequence="20"
              groups="incident_management.group_incident_manager"/>

    <menuitem id="menu_incident_pending"
              name="Pending Assignment"
              parent="menu_incident_management"
              action="action_incident_report_pending"
              sequence="10"
              groups="incident_management.group_incident_manager"/>

    <menuitem id="menu_incident_investigations"
              name="Open Investigations"
              parent="menu_incident_management"
              action="action_incident_report_investigations"
              sequence="20"
              groups="incident_management.group_incident_manager"/>

    <menuitem id="menu_corrective_actions"
              name="Corrective Actions"
              parent="menu_incident_management"
              action="action_incident_corrective_action_all"
              sequence="30"
              groups="incident_management.group_incident_manager"/>

    <!-- ── Analysis Menu ────────────────────────────────────────────────── -->
    <menuitem id="menu_incident_analysis"
              name="Analysis"
              parent="menu_incident_root"
              sequence="30"
              groups="incident_management.group_incident_manager"/>

    <menuitem id="menu_incident_analysis_status"
              name="By Status"
              parent="menu_incident_analysis"
              action="action_incident_analysis_by_status"
              sequence="10"
              groups="incident_management.group_incident_manager"/>

    <menuitem id="menu_incident_analysis_severity"
              name="By Severity"
              parent="menu_incident_analysis"
              action="action_incident_analysis_by_severity"
              sequence="20"
              groups="incident_management.group_incident_manager"/>

    <menuitem id="menu_incident_analysis_category"
              name="By Category"
              parent="menu_incident_analysis"
              action="action_incident_analysis_by_category"
              sequence="30"
              groups="incident_management.group_incident_manager"/>

    <menuitem id="menu_incident_analysis_trend"
              name="Trend Over Time"
              parent="menu_incident_analysis"
              action="action_incident_analysis_trend"
              sequence="40"
              groups="incident_management.group_incident_manager"/>

    <!-- ── Configuration Menu ────────────────────────────────────────────── -->
    <menuitem id="menu_incident_config"
              name="Configuration"
              parent="menu_incident_root"
              sequence="100"
              groups="incident_management.group_incident_admin"/>

    <menuitem id="menu_icam_categories"
              name="ICAM Categories"
              parent="menu_incident_config"
              action="action_icam_category"
              sequence="10"
              groups="incident_management.group_incident_admin"/>

    <menuitem id="menu_icam_factors"
              name="ICAM Factors"
              parent="menu_incident_config"
              action="action_icam_factor"
              sequence="20"
              groups="incident_management.group_incident_admin"/>

    <menuitem id="menu_incident_ai_settings"
              name="AI Settings"
              parent="menu_incident_config"
              action="action_incident_ai_settings"
              sequence="30"
              groups="incident_management.group_incident_admin"/>

</odoo>
