<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_recurring_payment_form" model="ir.ui.view">
        <field name="name">recurring.payment.form.advanced_accounts</field>
        <field name="model">recurring.payment</field>
        <field name="inherit_id" ref="advanced_accounting.view_recurring_payment_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id" required="not adv_contact_id and not partner_id"
                       options="{'no_quick_create': True}" placeholder="Type to find an Account..."/>
                <field name="adv_contact_id" options="{'no_quick_create': True}"
                       context="{'default_account_id': adv_account_id}"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="invisible">adv_account_id or adv_contact_id or not partner_id</attribute>
            </field>
        </field>
    </record>

    <record id="view_account_recurring_payment_tree" model="ir.ui.view">
        <field name="name">recurring.payment.list.advanced_accounts</field>
        <field name="model">recurring.payment</field>
        <field name="inherit_id" ref="advanced_accounting.view_account_recurring_payment_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id" optional="show" readonly="1"/>
                <field name="adv_contact_id" optional="show" readonly="1"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <record id="view_account_recurring_payment_search" model="ir.ui.view">
        <field name="name">recurring.payment.search.advanced_accounts</field>
        <field name="model">recurring.payment</field>
        <field name="inherit_id" ref="advanced_accounting.view_account_recurring_payment_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id"/>
                <field name="adv_contact_id"/>
            </field>
            <filter name="group_partner" position="before">
                <filter name="group_adv_account" string="Account" context="{'group_by': 'adv_account_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
