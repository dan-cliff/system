<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_asset_asset_form" model="ir.ui.view">
        <field name="name">account.asset.asset.form.advanced_accounts</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="advanced_accounting.view_account_asset_asset_form"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id" string="Vendor Account" readonly="state != 'draft'"
                       options="{'no_quick_create': True}" placeholder="Type to find a vendor Account..."/>
                <field name="adv_contact_id" readonly="state != 'draft'"
                       options="{'no_quick_create': True}" context="{'default_account_id': adv_account_id}"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="invisible">adv_account_id or adv_contact_id or not partner_id</attribute>
            </field>
        </field>
    </record>

    <record id="view_account_asset_asset_purchase_tree" model="ir.ui.view">
        <field name="name">account.asset.asset.list.advanced_accounts</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="advanced_accounting.view_account_asset_asset_purchase_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id" string="Vendor Account" optional="show" readonly="1"/>
                <field name="adv_contact_id" optional="show" readonly="1"/>
            </field>
            <field name="partner_id" position="attributes">
                <attribute name="optional">hide</attribute>
            </field>
        </field>
    </record>

    <record id="view_account_asset_search" model="ir.ui.view">
        <field name="name">account.asset.asset.search.advanced_accounts</field>
        <field name="model">account.asset.asset</field>
        <field name="inherit_id" ref="advanced_accounting.view_account_asset_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="before">
                <field name="adv_account_id"/>
                <field name="adv_contact_id"/>
            </field>
            <xpath expr="//search/group" position="inside">
                <filter name="group_adv_account" string="Account" context="{'group_by': 'adv_account_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
