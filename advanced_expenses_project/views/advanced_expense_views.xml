<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="advanced_expense_view_form_project" model="ir.ui.view">
        <field name="name">advanced.expense.form.project</field>
        <field name="model">advanced.expense</field>
        <field name="inherit_id" ref="advanced_expenses.advanced_expense_view_form"/>
        <field name="arch" type="xml">
            <field name="vendor_id" position="after">
                <field name="project_id" options="{'no_create': True}" readonly="state in ('paid',)"/>
                <field name="task_id" options="{'no_create': True}" invisible="not project_id"
                       readonly="state in ('paid',)"/>
            </field>
        </field>
    </record>

    <record id="advanced_expense_view_list_project" model="ir.ui.view">
        <field name="name">advanced.expense.list.project</field>
        <field name="model">advanced.expense</field>
        <field name="inherit_id" ref="advanced_expenses.advanced_expense_view_list"/>
        <field name="arch" type="xml">
            <field name="vendor_id" position="after">
                <field name="project_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="advanced_expense_view_search_project" model="ir.ui.view">
        <field name="name">advanced.expense.search.project</field>
        <field name="model">advanced.expense</field>
        <field name="inherit_id" ref="advanced_expenses.advanced_expense_view_search"/>
        <field name="arch" type="xml">
            <field name="vendor_id" position="after">
                <field name="project_id"/>
            </field>
            <filter name="group_category" position="after">
                <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
