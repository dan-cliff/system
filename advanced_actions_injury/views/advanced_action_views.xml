<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_action_form_injury" model="ir.ui.view">
        <field name="name">advanced.action.form.injury</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_checklist_id']" position="after">
                <field name="injury_case_id" invisible="source_app != 'injury'"/>
            </xpath>
        </field>
    </record>

    <record id="view_advanced_action_search_injury" model="ir.ui.view">
        <field name="name">advanced.action.search.injury</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='checklist_template_id']" position="after">
                <field name="injury_case_id"/>
            </xpath>
            <xpath expr="//filter[@name='app_checklists']" position="after">
                <filter name="app_injury" string="Injury Management" domain="[('source_app', '=', 'injury')]"/>
            </xpath>
        </field>
    </record>

    <record id="view_advanced_action_list_injury" model="ir.ui.view">
        <field name="name">advanced.action.list.injury</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="injury_case_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='source_app']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Injury Management › Actions: filtered to Injury Management, filter removable. -->
    <record id="action_advanced_action_injury" model="ir.actions.act_window">
        <field name="name">Actions</field>
        <field name="res_model">advanced.action</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_advanced_action_list_injury')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'}),
            (0, 0, {'view_mode': 'activity'})]"/>
        <field name="context">{'search_default_app_injury': 1, 'search_default_open': 1, 'default_source_app': 'injury'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Injury Management actions yet</p>
            <p>Remove the Injury Management filter to see actions from every app.</p>
        </field>
    </record>

    <menuitem id="menu_advanced_action_injury" name="Actions" parent="injury_management.menu_injury_root"
              action="action_advanced_action_injury" sequence="30"
              groups="injury_management.group_injury_user"/>

    <record id="injury_rtw_case_form_advanced_actions" model="ir.ui.view">
        <field name="name">injury.rtw.case.form.advanced.actions</field>
        <field name="model">injury.rtw.case</field>
        <field name="inherit_id" ref="injury_management.view_injury_rtw_case_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_actions" type="object" class="oe_stat_button" icon="fa-check-square-o">
                    <field name="action_open_count" widget="statinfo" string="Open Actions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
