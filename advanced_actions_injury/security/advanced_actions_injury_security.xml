<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Injury Management users work on Injury Management's actions (what they may do
         with them comes from the ACL, as for the app's own records). -->
    <record id="rule_advanced_action_injury" model="ir.rule">
        <field name="name">Actions: Injury Management users, Injury Management actions</field>
        <field name="model_id" ref="advanced_actions.model_advanced_action"/>
        <field name="groups" eval="[(4, ref('injury_management.group_injury_user'))]"/>
        <field name="domain_force">[('source_app', '=', 'injury')]</field>
    </record>
</odoo>
