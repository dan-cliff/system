<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_advanced_action_form_manufacturing" model="ir.ui.view">
        <field name="name">advanced.action.form.manufacturing</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_checklist_id']" position="after">
                <field name="production_id" invisible="source_app != 'manufacturing'"/>
            </xpath>
        </field>
    </record>

    <record id="view_advanced_action_search_manufacturing" model="ir.ui.view">
        <field name="name">advanced.action.search.manufacturing</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_search"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='checklist_template_id']" position="after">
                <field name="production_id"/>
            </xpath>
            <xpath expr="//filter[@name='app_checklists']" position="after">
                <filter name="app_manufacturing" string="Manufacturing" domain="[('source_app', '=', 'manufacturing')]"/>
            </xpath>
        </field>
    </record>

    <record id="view_advanced_action_list_manufacturing" model="ir.ui.view">
        <field name="name">advanced.action.list.manufacturing</field>
        <field name="model">advanced.action</field>
        <field name="inherit_id" ref="advanced_actions.view_advanced_action_list"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="production_id" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='source_app']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <!-- Manufacturing › Actions: filtered to Manufacturing, filter removable. -->
    <record id="action_advanced_action_manufacturing" model="ir.actions.act_window">
        <field name="name">Actions</field>
        <field name="res_model">advanced.action</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_advanced_action_list_manufacturing')}),
            (0, 0, {'view_mode': 'kanban'}),
            (0, 0, {'view_mode': 'form'}),
            (0, 0, {'view_mode': 'activity'})]"/>
        <field name="context">{'search_default_app_manufacturing': 1, 'search_default_open': 1, 'default_source_app': 'manufacturing'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No Manufacturing actions yet</p>
            <p>Remove the Manufacturing filter to see actions from every app.</p>
        </field>
    </record>

    <menuitem id="menu_advanced_action_manufacturing" name="Actions" parent="mrp.menu_mrp_manufacturing"
              action="action_advanced_action_manufacturing" sequence="30"
              groups="mrp.group_mrp_user"/>

    <record id="mrp_production_form_advanced_actions" model="ir.ui.view">
        <field name="name">mrp.production.form.advanced.actions</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_actions" type="object" class="oe_stat_button" icon="fa-check-square-o">
                    <field name="action_open_count" widget="statinfo" string="Open Actions"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
